<!doctype html><html data-theme="dark" lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wednesday — Chat (live)</title>
<style>
:root { color-scheme: dark;
  --surface-1:#1a1a19; --surface-2:#232322; --line:#33332f;
  --text-primary:#ffffff; --text-secondary:#c3c2b7; --text-muted:#8a897f;
  --series-1:#3987e5; --series-2:#d95926; --series-3:#199e70; }
:root[data-theme="light"] { color-scheme: light;
  --surface-1:#f7f7f4; --surface-2:#ffffff; --line:#dcdcd4;
  --text-primary:#1b1b19; --text-secondary:#4a4a44; --text-muted:#78776e;
  --series-1:#1f63b8; --series-2:#b8431a; --series-3:#127956; }
* { box-sizing:border-box; margin:0; }
html, body { height:100%; }
body { background:var(--surface-1); color:var(--text-primary);
  font:15px/1.55 -apple-system, "SF Pro Text", Helvetica, Arial, sans-serif;
  display:flex; flex-direction:column; }
.col { width:100%; max-width:46em; margin:0 auto; padding:0 18px; }
header { border-bottom:1px solid var(--line); background:var(--surface-1);
  flex:none; }
header .col { display:flex; align-items:baseline; gap:12px; padding-top:12px; padding-bottom:10px; }
header h1 { font-size:17px; font-weight:650; }
header a { color:var(--text-muted); font-size:12.5px; text-decoration:none; }
header a:hover { color:var(--text-primary); }
#live { margin-left:auto; font-size:12px; color:var(--text-muted); }
#live.on { color:var(--series-3); }
#autoplay, #stopvoice { background:var(--surface-2); border:1px solid var(--line); border-radius:7px;
  color:var(--text-muted); font:inherit; font-size:12px; padding:3px 10px; cursor:pointer; }
#autoplay:hover, #stopvoice:hover { color:var(--text-primary); }
#autoplay.on { color:var(--series-3); border-color:var(--series-3); }
#stopvoice:disabled { opacity:.5; cursor:default; }
.playbtn { background:none; border:none; color:var(--text-muted); cursor:pointer;
  font-size:11px; padding:0 2px; margin-left:4px; line-height:1; vertical-align:baseline; }
.playbtn:hover { color:var(--text-primary); }
.playbtn:disabled { opacity:.4; cursor:default; }
#log { flex:1; overflow-y:auto; scrollbar-width:thin; }
#log .col { padding-top:16px; padding-bottom:16px; }
.msg { margin:0 0 14px; max-width:88%; }
.msg .meta { font-size:11.5px; color:var(--text-muted); margin:0 2px 2px; }
.msg .who { font-weight:600; }
.msg.wednesday .who { color:var(--series-3); }
.msg.kam .who { color:var(--series-1); }
.msg .body { background:var(--surface-2); border:1px solid var(--line);
  border-radius:10px; padding:8px 12px; white-space:pre-wrap; word-break:break-word;
  color:var(--text-primary); }
.msg.kam { margin-left:auto; }
.msg.kam .meta { text-align:right; }
.msg.kam .body { border-color:color-mix(in srgb, var(--series-1) 35%, var(--line));
  border-radius:10px 10px 2px 10px; }
.msg.wednesday .body { border-radius:10px 10px 10px 2px; }
.msg .body a { color:var(--series-1); word-break:break-all; }
.msg .body strong { font-weight:650; }
.ackline { font-size:11.5px; color:var(--text-muted); margin:3px 2px 0; text-align:right; }
.ackline.done, .ackline.seen { color:var(--series-3); }
.ackline.actioning, .ackline.action_requested { color:var(--series-2); }
#empty { color:var(--text-muted); font-size:13px; padding:24px 0; }
#agenttoggle .use{font-weight:400;opacity:.75;font-size:.9em;letter-spacing:0}
#agenttoggle .use.stale{opacity:.45;font-style:italic}
/* project filter (Kam, 2026-09-07): which projects' Wednesday replies THIS browser shows */
header #projfilter { display:flex; align-items:center; gap:6px; flex-wrap:wrap;
  padding-top:0; padding-bottom:8px; font-size:11.5px; color:var(--text-muted); }
.pftog { background:var(--surface-2); border:1px solid var(--line); border-radius:999px;
  color:var(--text-muted); font:inherit; font-size:11px; padding:1px 9px; cursor:pointer; opacity:.7; }
.pftog:hover { color:var(--text-primary); }
.pftog.on { color:var(--series-3); border-color:var(--series-3); opacity:1; }
.msg .seat { font-size:10.5px; color:var(--text-muted); margin-left:6px;
  border:1px solid var(--line); border-radius:4px; padding:0 4px; }
footer { flex:none; border-top:1px solid var(--line); background:var(--surface-1); }
footer .col { display:flex; gap:8px; align-items:flex-end; padding-top:10px; padding-bottom:
  calc(12px + env(safe-area-inset-bottom, 0px)); }
#text { flex:1; background:var(--surface-2); border:1px solid var(--line);
  border-radius:8px; color:var(--text-primary); font:inherit; padding:8px 12px;
  /* 2026-09-10: was <input type=text> — it FLATTENED every newline (measured: 0 of
     Kam's 105 messages contained one) and capped at 2000 chars, so a pasted document
     arrived as a truncated single line. Textarea, auto-growing, capped at 40vh. */
  resize:vertical; min-height:38px; max-height:40vh; line-height:1.45;
  overflow-y:auto; white-space:pre-wrap; }
#text:focus { outline:none; border-color:var(--series-1); }
#send { background:var(--surface-2); color:var(--text-secondary); border:1px solid var(--line);
  border-radius:8px; font:inherit; font-size:14px; padding:8px 16px; cursor:pointer; }
#send:hover { color:var(--text-primary); }
#send:disabled { opacity:.5; cursor:default; }
/* ══ AGENT TOGGLE (Phase 1) ═══════════════════════════════════════════════
   The same control as /cockpit, sharing its localStorage key so the two
   surfaces can never disagree about which agent Kam is talking to. Without it
   this page would show Tuesday's Datasec conversation on the Wednesday view and
   quietly undo the isolation the cockpit's toggle provides. */
#agentbar { height:4px; background:var(--series-1); }
body.view-tuesday #agentbar { background:#e08a2b; }
body.view-friday #agentbar { background:var(--series-3); }   /* FRIDAY (2026-09-23): an existing token, no new colour */
#agenttoggle { margin-left:10px; display:inline-flex; align-items:center;
               border:1px solid var(--line); border-radius:7px; overflow:hidden;
               vertical-align:middle; }
#agenttoggle button { background:var(--surface-2); color:var(--text-muted);
               border:none; padding:4px 10px; font:inherit; font-size:11px;
               font-weight:700; letter-spacing:.05em; cursor:pointer; }
#agenttoggle button + button { border-left:1px solid var(--line); }
#agenttoggle button.on { color:#fff; background:var(--series-1); }
#agenttoggle button#ag-tuesday.on { background:#e08a2b; color:#241300; }
#agenttoggle button#ag-friday.on { background:var(--series-3); color:#fff; }
body.view-tuesday header { background:rgba(224,138,43,.10); }
body.view-tuesday header h1::after { content:" \00b7 TUESDAY (Datasec)"; color:#e08a2b;
               font-size:12px; font-weight:700; letter-spacing:.04em; }
body.view-friday header { background:color-mix(in srgb, var(--series-3) 10%, transparent); }
body.view-friday header h1::after { content:" \00b7 FRIDAY (laptop)"; color:var(--series-3);
               font-size:12px; font-weight:700; letter-spacing:.04em; }

/* ══ DRAG-AND-DROP ATTACHMENTS (Kam, 2026-09-08 14:10) ═══════════════════════
   The drop target is the whole conversation column, not a small button: Kam is
   dragging from Finder or another window and should not have to aim. */
.dropping { outline:2px dashed var(--series-1); outline-offset:-6px;
            background:color-mix(in srgb, var(--series-1) 7%, transparent); }
#pending { display:flex; flex-wrap:wrap; gap:6px; padding:0 18px 6px; }
#pending:empty { display:none; }
#pending .pf { display:flex; align-items:center; gap:6px; font-size:11.5px;
            background:var(--surface-2); border:1px solid var(--line);
            border-radius:6px; padding:2px 6px 2px 4px; color:var(--text-secondary); }
#pending .pf img { height:22px; width:22px; object-fit:cover; border-radius:3px; }
#pending .pf button { background:none; border:none; color:var(--text-muted);
            cursor:pointer; font-size:13px; line-height:1; padding:0 2px; }
#pending .pf button:hover { color:var(--series-2); }
.msg .atts { display:flex; flex-wrap:wrap; gap:8px; margin-top:6px; }
.msg .atts a { font-size:12px; color:var(--series-1); text-decoration:none;
            border:1px solid var(--line); border-radius:6px; padding:2px 8px;
            background:var(--surface-2); }
.msg .atts img { max-width:min(320px,100%); max-height:260px; border-radius:8px;
            border:1px solid var(--line); display:block; }
/* ══ LIVE-SITE ADDITIONS (Phase 2, 2026-09-21) — the only rules not copied from the local page ═══════
   The palette and every component above are the local cockpit.html / chat.html verbatim (Kam's 2026-09-02 design
   rule). What follows is the chrome the live site needs and the local one does not: the key bar (the rows are
   ciphertext until the key is present) and the honest "not synced yet" state for tiles whose data still lives on
   the Studio. Same tokens, same radii, same type sizes. */
#keybar { flex:none; display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:6px 18px;
  border-bottom:1px solid var(--line); font-size:12px; color:var(--text-muted); background:var(--surface-1); }
#keybar .kstate { font-weight:600; }
#keybar .kstate.ok { color:var(--series-3); }
#keybar .kstate.warn { color:var(--amber, #d99a26); }
#keybar .kstate.bad { color:var(--series-2); }
#keybar button { background:var(--surface-2); border:1px solid var(--line); border-radius:7px; color:var(--text-secondary);
  font:inherit; font-size:12px; padding:3px 10px; cursor:pointer; }
#keybar button:hover { color:var(--text-primary); }
#keybar button.primary { border-color:var(--series-1); color:var(--series-1); }
#keybar button:disabled { opacity:.5; cursor:default; }
#keybar input { background:var(--surface-2); border:1px solid var(--line); border-radius:7px; color:var(--text-primary);
  font:inherit; font-size:12px; padding:3px 8px; width:15em; }
#keybar .note { font-size:11.5px; color:var(--text-muted); }
#keybar input[type=file] { display:none; }
.msg .body.locked { color:var(--text-muted); font-style:italic; }
.msg .body.bad { color:var(--series-2); }
.msg .bf { font-size:10.5px; color:var(--text-muted); margin-left:6px; border:1px solid var(--line); border-radius:4px; padding:0 4px; }
.notsynced { border:1px dashed var(--line); border-radius:9px; background:var(--surface-2); padding:7px 11px 8px; margin:0 0 9px;
  font-size:12.5px; color:var(--text-muted); font-style:italic; }
.notsynced b { color:var(--text-secondary); font-style:normal; font-weight:600; }
#tally .tchip.notsynced { font-style:italic; border-style:dashed; color:var(--text-muted); padding:2px 8px; margin:0; }
/* ══ FILE DRAWER (2026-09-22, Kam 15:26 "download button next to autoplay replies and stop" + 15:31 upload) ═══════
   #filesbtn wears the auto-play / stop chrome verbatim; the drawer is a right-side panel in the same tokens. */
#filesbtn { background:var(--surface-2); border:1px solid var(--line); border-radius:7px;
  color:var(--text-muted); font:inherit; font-size:12px; padding:3px 10px; cursor:pointer; }
#filesbtn:hover { color:var(--text-primary); }
#filesbtn.on { color:var(--series-3); border-color:var(--series-3); }
#drawer { position:fixed; top:0; right:0; bottom:0; width:min(420px, 92vw); z-index:50; background:var(--surface-1);
  border-left:1px solid var(--line); box-shadow:-8px 0 24px rgba(0,0,0,.25); display:flex; flex-direction:column; }
/* 2026-09-23 (Kam 10:57:27 "the X that closes the files pop-up does not work"): the close button's listener
   fires and toggle(false) sets drawerEl.hidden = true — but the UA rule [hidden]{display:none} is a plain
   attribute selector and loses to the ID rule #drawer{display:flex} above. The attribute was set and ignored.
   ID + attribute outranks ID alone, so this one line makes hidden mean hidden. */
#drawer[hidden] { display:none; }
#drawer-h { display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid var(--line);
  font-size:12px; font-weight:650; letter-spacing:.06em; text-transform:uppercase; color:var(--text-muted); }
#drawer-h .note { font-weight:400; text-transform:none; letter-spacing:0; color:var(--text-dim); font-size:11.5px; }
#drawer-h button { margin-left:auto; background:none; border:1px solid var(--line); border-radius:6px; color:var(--text-muted); cursor:pointer; font-size:12px; padding:2px 7px; }
#drawer-h button:hover { color:var(--text-primary); }
#drawer-note { padding:6px 14px; font-size:11px; color:var(--text-dim); border-bottom:1px solid var(--line); }
#drawer-list { flex:1; overflow-y:auto; scrollbar-width:thin; padding:10px 14px; }
#drawer-list .empty { color:var(--text-dim); font-size:12px; font-style:italic; }
.frow { border:1px solid var(--line); border-radius:9px; background:var(--surface-2); padding:8px 11px; margin:0 0 9px; }
.frow.mine { border-style:dashed; }
.frow .fname { font-size:13px; color:var(--text-primary); font-weight:600; word-break:break-all; }
.frow .fmeta { font-size:11px; color:var(--text-dim); margin-top:2px; }
.frow .fnote { font-size:12px; color:var(--text-secondary); margin-top:4px; }
.frow .fdl { margin-top:7px; background:var(--surface-1); border:1px solid var(--line); border-radius:7px; color:var(--series-1);
  font:inherit; font-size:12px; padding:3px 10px; cursor:pointer; }
.frow .fdl:hover:not(:disabled) { color:var(--text-primary); border-color:var(--series-1); }
.frow .fdl:disabled { opacity:.5; cursor:default; }
#attach { background:var(--surface-2); border:1px solid var(--line); border-radius:7px; color:var(--text-muted); font:inherit; font-size:14px; padding:0 9px; cursor:pointer; }
#attach:hover { color:var(--text-primary); }
#attachfile { display:none; }
#pending .pf i { font-style:normal; color:var(--text-dim); }
</style></head><body>
<div id="agentbar" aria-hidden="true"></div>
<header><div class="col"><h1>Chat with Wednesday</h1>
 <a href="/">&larr; cockpit</a>
 <button id="autoplay" title="speak newly-arriving Wednesday replies aloud (this device's voice)">&#128266; auto-play replies</button>
 <button id="stopvoice" title="stop the voice that is speaking now (autoplay stays on)">&#9209; stop</button>
 <button id="filesbtn" type="button" title="files shared with you by a seat, and files you attached — download them from here (decrypted in this browser)">&#11015; files</button>
 <span id="live">&#9675; connecting&hellip;</span>
 <span id="agenttoggle" role="group" aria-label="which agent's view is live">
  <button id="ag-wednesday" type="button" title="Wednesday — Secuura and all general work">WEDNESDAY<span class="use" id="use-wednesday"></span></button>
  <button id="ag-tuesday" type="button" title="Tuesday — all Datasec projects">TUESDAY<span class="use" id="use-tuesday"></span></button>
  <button id="ag-friday" type="button" title="Friday — Kam's laptop seat (Secuura and Datasec work, its own conversation)">FRIDAY<span class="use" id="use-friday"></span></button>
 </span></div>
 <div class="col" id="projfilter"></div></header>
<div id="keybar">
 <span class="kstate" id="kstate">key: checking…</span>
 <button id="kunlock" type="button" class="primary" hidden>Unlock key (1 click)</button>
 <button id="kchoose" type="button" hidden>Choose the folder that holds the key…</button>
 <label id="kfilelbl" hidden>file <input id="kfilename" type="text" spellcheck="false" autocomplete="off"></label>
 <label id="kimportlbl" hidden><button id="kimport" type="button">Import key…</button><input id="kimportfile" type="file" accept=".pem,.key,.p8"></label>
 <button id="kforget" type="button" title="forget the remembered folder / imported key in this browser" hidden>Forget key</button>
 <span class="note" id="knote"></span>
 <span id="who" class="note" style="margin-left:auto"></span>
</div>
<div id="log"><div class="col" id="msgs"><p id="empty">no messages yet</p></div></div>
  <div id="pending"></div>
<footer><div class="col">
 <textarea id="text" rows="1" maxlength="100000" placeholder="message Wednesday&hellip;" autocomplete="off"></textarea>
 <input id="attachfile" type="file" multiple><button id="attach" type="button" title="attach a file (or drop it on the conversation) — encrypted here, readable by you and the seat">&#128206;</button>
 <button id="send">send</button></div></footer>
<script src="/static/common.js"></script>
<script src="/static/drawer.js"></script>
<script>
"use strict";
/* DATA SOURCE — the one difference from the local chat.html: rows come encrypted from /api/messages and are decrypted
   here; Kam's replies are encrypted here and POSTed to /api/kam/messages; speech is this device's speechSynthesis.
   Everything rendered below is the local page's own render code. */
const log = document.getElementById("log");
const msgsEl = document.getElementById("msgs");
const live = document.getElementById("live");
let lastSig = null;
const rows = new Map(), ptCache = new Map();
const DAY = 86400000;
let sinceM = new Date(Date.now() - 7 * DAY).toISOString(), floorM = sinceM;

function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
function mdLite(s) {
  let h = esc(s);
  h = h.replace(/https?:\/\/[^\s*]+/g, u => { const m = u.match(/[.,)\]!?;:]+$/); const trail = m ? m[0] : ""; if (trail) u = u.slice(0, -trail.length);
    return '<a href="' + u + '" target="_blank" rel="noopener noreferrer">' + u + "</a>" + trail; });
  h = h.replace(/\*\*([^*\n][^*]*?)\*\*/g, "<strong>$1</strong>");
  return h;
}
function nearBottom() { return log.scrollHeight - log.scrollTop - log.clientHeight < 80; }
const AGENT_KEY = "wed_active_agent";
let activeAgent = "wednesday";
try { const a = localStorage.getItem(AGENT_KEY); if (a === "wednesday" || a === "tuesday" || a === "friday") activeAgent = a; } catch (e) {}
function agentOfProject(p) { return /datasec/i.test(String(p || "")) ? "tuesday" : /^friday$/i.test(String(p || "")) ? "friday" : "wednesday"; }
function agentOfMsg(m) { const a = m && m.agent; if (a === "wednesday" || a === "tuesday" || a === "friday" || a === "both") return a; return "both"; }
function inView(m) { const a = agentOfMsg(m); return a === "both" || a === activeAgent; }
function applyAgentView() {
  document.body.classList.toggle("view-tuesday", activeAgent === "tuesday");
  document.body.classList.toggle("view-friday", activeAgent === "friday");
  const w = document.getElementById("ag-wednesday"), t = document.getElementById("ag-tuesday"), f = document.getElementById("ag-friday");
  if (w) { w.classList.toggle("on", activeAgent === "wednesday"); w.setAttribute("aria-pressed", activeAgent === "wednesday"); }
  if (t) { t.classList.toggle("on", activeAgent === "tuesday"); t.setAttribute("aria-pressed", activeAgent === "tuesday"); }
  if (f) { f.classList.toggle("on", activeAgent === "friday"); f.setAttribute("aria-pressed", activeAgent === "friday"); }
  const box = document.getElementById("text");
  if (box) box.placeholder = activeAgent === "tuesday" ? "message Tuesday (Datasec)…" : activeAgent === "friday" ? "message Friday (laptop)…" : "message Wednesday…";
}
function setAgent(a) { if (a !== "wednesday" && a !== "tuesday" && a !== "friday") return; activeAgent = a; try { localStorage.setItem(AGENT_KEY, a); } catch (e) {} applyAgentView(); render(lastMsgs || []); }
document.getElementById("ag-wednesday").addEventListener("click", () => setAgent("wednesday"));
document.getElementById("ag-tuesday").addEventListener("click", () => setAgent("tuesday"));
document.getElementById("ag-friday").addEventListener("click", () => setAgent("friday"));
applyAgentView();
// ── weekly plan usage on the agent chips (Kam, 2026-09-09 12:32 on the local board; on the LIVE board 2026-09-22 08:57:36:
// "with the local version, I was able to see the weekly usage count on both Wednesday and Tuesday. Is this possible for
// the live version?"). Same meaning as the local page, one source difference: the figure is the seat's OWN reading,
// published by that seat with its certificate (seat/post_usage.py -> POST /api/seat/usage) and read here from
// GET /api/usage — the server attributes the row by the seat's token, so nothing on this page can be another seat's number.
// HONESTY (WED-73): three states, visibly different —
//   live   (reading < 15 min old)      -> "— 60%"           the seat is running and this is now
//   ageing (15..30 min)                -> "— 60% (22m)"     last known, WITH its age, dimmed
//   none   (absent, or >= 30 min old)  -> "— no reading"    dimmed; the tooltip says the last figure and how old it is
const USE_STALE_S = 900, USE_DEAD_S = 1800;
function ageLabel(sec) {
  if (sec == null) return "";
  if (sec < 3600) return Math.max(1, Math.round(sec / 60)) + "m";
  if (sec < 86400) return Math.round(sec / 3600) + "h";
  return Math.round(sec / 86400) + "d";
}
function usageState(d) {   // -> {text, cls, title}; pure, so scripts/09d_usage_page_checks.mjs can run it in Node
  if (!d || typeof d.pct !== "number") return { text: " — no reading", cls: "use stale", title: "no reading — this seat has not published its weekly usage to the live board" };
  const age = d.age_seconds;
  if (age == null || age >= USE_DEAD_S) return { text: " — no reading", cls: "use stale",
    title: "no reading — last published " + (ageLabel(age) || "unknown") + " ago (" + d.pct + "%); this seat may not be running" };
  const stale = age >= USE_STALE_S;
  return { text: " — " + d.pct + "%" + (stale ? " (" + ageLabel(age) + ")" : ""), cls: stale ? "use stale" : "use",
    title: "weekly plan usage, published by the " + (d.seat || "?") + " seat" + (d.resets_in ? " · renews in " + d.resets_in : "") + " · reading " + (ageLabel(age) || "0m") + " old" };
}
function renderUsage(data) {
  ["wednesday", "tuesday", "friday"].forEach(function (a) {
    const el = document.getElementById("use-" + a); if (!el) return;
    const s = usageState(data && data[a]); el.textContent = s.text; el.className = s.cls; el.title = s.title;
  });
}
async function pollUsage() {
  try { renderUsage(await WED.getJSON("/api/usage")); }
  catch (e) { /* leave the last render alone rather than blanking on a blip */ }
}
pollUsage();
setInterval(pollUsage, 60000);

const PF_KEY = "wed_chat_projects";
const pfEl = document.getElementById("projfilter");
let pfSel = {};
try { pfSel = JSON.parse(localStorage.getItem(PF_KEY) || "{}") || {}; } catch (e) { pfSel = {}; }
let lastMsgs = [];
function projOf(m) { return m.project || "WED"; }
function projOn(name) { if (name in pfSel) return !!pfSel[name]; return activeAgent !== "wednesday" ? true : name === "WED"; }   // tuesday + friday: every project on by default
function visible(m) { return inView(m) && (m.role === "kam" || projOn(projOf(m))); }
function seatShort(s) { return String(s || "").split(".")[0]; }
function renderFilter(msgs) {
  const names = new Set(["WED"]);
  for (const m of msgs) if (m.role !== "kam" && inView(m)) names.add(projOf(m));
  for (const n of [...names]) if (agentOfProject(n) !== activeAgent) names.delete(n);
  const sorted = [...names].sort((a, b) => a === "WED" ? -1 : b === "WED" ? 1 : a.localeCompare(b));
  pfEl.innerHTML = ""; pfEl.append("show replies from: ");
  for (const n of sorted) {
    const b = document.createElement("button"); b.type = "button";
    b.className = "pftog" + (projOn(n) ? " on" : ""); b.textContent = n;
    b.title = (projOn(n) ? "hide" : "show") + " Wednesday's " + n + " replies on this browser (not spoken while hidden)";
    b.addEventListener("click", () => { pfSel[n] = !projOn(n); try { localStorage.setItem(PF_KEY, JSON.stringify(pfSel)); } catch (e) {} render(lastMsgs); });
    pfEl.appendChild(b);
  }
  const ob = document.createElement("button"); ob.type = "button"; ob.className = "pftog"; ob.textContent = "load older — since " + floorM.slice(0, 10);
  ob.title = "load 7 more days of history"; ob.addEventListener("click", loadOlder); pfEl.appendChild(ob);
}
function render(msgs) {
  const stick = nearBottom() || lastSig === null;
  lastMsgs = msgs;
  renderFilter(msgs);
  const shown = msgs.filter(visible);
  msgsEl.innerHTML = "";
  if (!shown.length) { const p = document.createElement("p"); p.id = "empty"; p.textContent = msgs.length ? "no messages for the selected projects" : "no messages in this window"; msgsEl.appendChild(p); }
  for (const m of shown) {
    const role = m.role === "kam" ? "kam" : "wednesday";
    const div = document.createElement("div"); div.className = "msg " + role;
    const meta = document.createElement("div"); meta.className = "meta";
    const who = document.createElement("span"); who.className = "who";
    who.textContent = role === "kam" ? "Kam" : (m.seat === "tuesday" ? "Tuesday" : m.seat === "friday" ? "Friday" : "Wednesday");
    meta.append(who, "  " + (m.ts || "").slice(11, 16));
    if (role === "wednesday" && m.text) {
      const pb = document.createElement("button"); pb.className = "playbtn"; pb.textContent = "▶"; pb.title = "speak this message aloud (this device)";
      pb.addEventListener("click", () => WED.speak(m.text)); meta.appendChild(pb);
    }
    if (role === "wednesday" && (m.seat || m.project)) {
      const se = document.createElement("span"); se.className = "seat";
      se.textContent = [seatShort(m.seat), m.project].filter(Boolean).join(" · ");
      se.title = "written by seat " + (m.seat || "unknown") + " · project " + projOf(m); meta.appendChild(se);
    }
    if (m.backfill) { const bf = document.createElement("span"); bf.className = "seat"; bf.textContent = "backfill"; bf.title = "copied from the Studio's local log by the seat, original timestamp kept"; meta.appendChild(bf); }
    const body = document.createElement("div"); body.className = "body";
    if (m.locked) { body.classList.add("locked"); body.textContent = "🔒 encrypted — unlock the key to read"; }
    else if (m.error) { body.classList.add("bad"); body.textContent = "decrypt failed: " + m.error; }
    else if (role === "wednesday") body.innerHTML = mdLite(m.text || "");
    else body.textContent = m.text || "";
    div.append(meta, body);
    const ae = WEDFILES.attachmentsEl(m); if (ae) div.appendChild(ae);     // 2026-09-22: file chips (download from the drawer's rows)
    msgsEl.appendChild(div);
  }
  if (stick) log.scrollTop = log.scrollHeight;
}
const svBtn = document.getElementById("stopvoice");
svBtn.addEventListener("click", () => { svBtn.disabled = true; WED.stopSpeech(); setTimeout(() => { svBtn.disabled = false; }, 400); });
const AP_KEY = "wed_chat_autoplay";
const apBtn = document.getElementById("autoplay");
let autoplayOn = false; try { autoplayOn = localStorage.getItem(AP_KEY) === "1"; } catch (e) {}
apBtn.classList.toggle("on", autoplayOn);
apBtn.addEventListener("click", () => { autoplayOn = !autoplayOn; try { localStorage.setItem(AP_KEY, autoplayOn ? "1" : "0"); } catch (e) {}
  apBtn.classList.toggle("on", autoplayOn); if (autoplayOn) WED.speak("Autoplay on"); else WED.stopSpeech(); });
let knownKeys = null;
async function decryptAll() {
  for (const [k, r] of rows) {
    if (ptCache.has(k) && ptCache.get(k) !== null) continue;
    if (!WED.key.priv) { ptCache.set(k, null); continue; }
    try { ptCache.set(k, await WED.decryptRow(r)); } catch (e) { ptCache.set(k, undefined); r._err = String(e.message || e); }
  }
}
function msgsFromRows() {
  const out = [];
  for (const [k, r] of rows) { const pt = ptCache.get(k); out.push(WED.toMsg(r, pt === undefined ? undefined : pt, pt === undefined ? r._err : null)); }
  out.sort((a, b) => a.utc < b.utc ? -1 : a.utc > b.utc ? 1 : 0);
  return out;
}
async function loadOlder() {
  const newFloor = new Date(Date.parse(floorM) - 7 * DAY).toISOString();
  try {
    const d = await WED.getJSON("/api/messages?limit=1000" + WED.hiddenQ + "&since=" + encodeURIComponent(newFloor));
    for (const r of d.messages || []) { if (WED.isSynthetic(r) || WED.isHidden(r)) { WED.hidden.messages++; continue; } if (r.row_key < floorM) rows.set(r.row_key, r); }
    floorM = newFloor; if (knownKeys) for (const k of rows.keys()) knownKeys.add(k);
    await decryptAll(); lastSig = null; render(msgsFromRows());
  } catch (e) { live.textContent = "○ " + (e.message || e); }
}
async function poll(force) {
  try {
    const q = sinceM ? "&since=" + encodeURIComponent(sinceM) : "";
    const d = await WED.getJSON("/api/messages?limit=1000" + WED.hiddenQ + q);
    for (const r of d.messages || []) { if (r.row_key > sinceM) sinceM = r.row_key; if (WED.isSynthetic(r) || WED.isHidden(r)) { WED.hidden.messages++; continue; } rows.set(r.row_key, r); }   // synthetic hidden (Phase 3); hidden rows skipped unless ?hidden=1 (2026-09-22)
    live.textContent = "● live"; live.classList.add("on");
    await decryptAll();
    const msgs = msgsFromRows();
    if (knownKeys === null) knownKeys = new Set(rows.keys());
    else {
      let latestNew = null;
      for (const m of msgs) if (!knownKeys.has(m.row_key)) { knownKeys.add(m.row_key); if (m.role === "wednesday" && m.text && !m.backfill) latestNew = m; }
      if (autoplayOn && latestNew && visible(latestNew)) WED.speak(latestNew.text);
    }
    const sig = msgs.length + "|" + sinceM + "|" + (WED.key.priv ? "k" : "-") + "|" + activeAgent;
    if (!force && sig === lastSig) return;
    render(msgs); lastSig = sig;
  } catch (e) { live.textContent = "○ " + (String(e.message || e).startsWith("session") ? e.message : "reconnecting…"); live.classList.remove("on"); }
}
const sendBtn = document.getElementById("send"), textEl = document.getElementById("text");
async function doSend() {
  const t = textEl.value.trim(); const nf = WEDFILES.pendingCount(); if (!t && !nf) return;
  sendBtn.disabled = true;
  try {
    // 2026-09-22: queued files are encrypted + uploaded FIRST (ids), then the message row carries them as `attachments`
    const id = WED.newId(); const att = nf ? await WEDFILES.uploadPending(activeAgent, id) : [];
    await WED.postKamMessage(t || ("\uD83D\uDCCE " + att.length + " file" + (att.length === 1 ? "" : "s") + " attached"), activeAgent, false, { id, attachments: att });
    textEl.value = ""; textEl.style.height = "auto"; await poll(true); log.scrollTop = log.scrollHeight; }
  catch (e) { alert("not sent: " + (e.message || e)); }
  finally { sendBtn.disabled = false; textEl.focus(); }
}
sendBtn.addEventListener("click", doSend);
textEl.addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); doSend(); } });
function autogrow() { textEl.style.height = "auto"; textEl.style.height = Math.min(textEl.scrollHeight, window.innerHeight * 0.4) + "px"; }
textEl.addEventListener("input", autogrow);
textEl.addEventListener("paste", () => setTimeout(autogrow, 0));

/* KEY BAR (same control as the cockpit page) */
const kstate = document.getElementById("kstate"), knote = document.getElementById("knote");
const kunlock = document.getElementById("kunlock"), kchoose = document.getElementById("kchoose"), kforget = document.getElementById("kforget");
const kfilelbl = document.getElementById("kfilelbl"), kfilename = document.getElementById("kfilename");
const kimportlbl = document.getElementById("kimportlbl"), kimport = document.getElementById("kimport"), kimportfile = document.getElementById("kimportfile");
kfilename.value = WED.filename();
kfilename.addEventListener("change", () => { WED.setFilename(kfilename.value); kfilename.value = WED.filename(); });
async function paintKey(msg, cls) {
  const k = WED.key;
  const kname = WED.keyNameOfKid(k.kid); const klabel = kname ? " — " + kname + " key" : (k.kid ? " — kid " + k.kid : "");   // Phase 3: which device key
  if (k.priv) { kstate.textContent = "key: unlocked" + klabel + (k.source === "folder" ? " from folder “" + k.dirName + "”" + (k.fileName ? " (" + k.fileName + ")" : "") : " (imported copy in this browser)"); kstate.className = "kstate ok"; }
  else if (k.needsClick) { kstate.textContent = "key: folder “" + k.dirName + "” remembered — click Unlock"; kstate.className = "kstate warn"; }
  else { kstate.textContent = "key: not loaded — rows stay encrypted"; kstate.className = "kstate warn"; }
  if (msg) { kstate.textContent = msg; kstate.className = "kstate " + (cls || "warn"); }
  kunlock.hidden = !(k.needsClick && !k.priv);
  kchoose.hidden = !k.fsAvailable; kfilelbl.hidden = !k.fsAvailable; kimportlbl.hidden = false;
  kforget.hidden = !(k.priv || k.needsClick || await WED.rememberedFolderName());
  knote.textContent = k.fsAvailable
    ? (k.priv ? "read from disk on each visit; never stored by the page, never sent anywhere" : "Chrome/Edge: choose the folder once; the key is read from it on every visit and never leaves this machine")
    : "this browser has no folder access (Safari/iOS/Firefox): Import key… once (kam-ipad-private.pem on the iPad); it stays in this browser only";
}
async function afterKeyChange() { ptCache.clear(); await decryptAll(); lastSig = null; await WEDFILES.afterKeyChange(); render(msgsFromRows()); await paintKey(); }
kunlock.addEventListener("click", async () => { try { await WED.unlock(true); await afterKeyChange(); } catch (e) { await paintKey("unlock failed: " + (e.message || e), "bad"); } });
kchoose.addEventListener("click", async () => { try { await WED.chooseFolder(); await afterKeyChange(); } catch (e) { await paintKey("folder: " + (e.message || e), "bad"); } });
kimport.addEventListener("click", () => kimportfile.click());
kimportfile.addEventListener("change", async e => { const f = e.target.files[0]; if (!f) return; try { await WED.importFile(f); await afterKeyChange(); } catch (err) { await paintKey("import failed: " + (err.message || err), "bad"); } });
kforget.addEventListener("click", async () => { await WED.forget(); await afterKeyChange(); });

(async () => {
  try { const me = await WED.getJSON("/api/me"); document.getElementById("who").textContent = "signed in as " + (me.name || me.id) + (me.is_kam ? "" : " (read-only: not Kam's principal)"); } catch (e) {}
  try { await WED.publicKeys(); } catch (e) {}      // Phase 3: the ring (names the device key; the reply path wraps to it + the seat)
  try { await WED.unlock(false); } catch (e) {}
  await paintKey();
  WEDFILES.init({ zone: document.getElementById("log"), input: document.getElementById("attachfile"), attachBtn: document.getElementById("attach") });   // 2026-09-22 file drawer + drop zone
  await poll(true);
  setInterval(poll, 3000);
})();
</script></body></html>
