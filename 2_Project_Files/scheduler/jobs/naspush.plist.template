<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@SEAT@.naspush</string>
  <!-- The ONE-WAY NAS leg (Kam 2026-10-04: card wed-nassync-rearm-shape-1004 => a, then "go" on the nightly schedule).
       DevMASTER -> NAS, additive, never deletes, never writes DevMASTER. Wednesday's seat only (installer skips other seats). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@PROJECT_DIR@/2_Project_Files/scheduler/nas_push.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WED_AGENT</key><string>@SEAT@</string>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/@SEAT@_naspush.out</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/@SEAT@_naspush.err</string>
</dict>
</plist>
