<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE of record for the Ornith night job (Kam, 2026-09-14 18:15:36). install_night.command
     substitutes the four double-underscore placeholders (night_run path, agent, home, label) and writes the result to
     ~/Library/LaunchAgents/com.<agent>.ornith-night.plist. Same shape as the WED-16 scheduler jobs.
     Fires 23:30 local daily; night_run.sh's own gates decide whether anything runs. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@SEAT@.ornith-night</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@PROJECT_DIR@/2_Project_Files/local-model/night/night_run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WED_AGENT</key><string>@SEAT@</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/kam_code/Library/Logs/wednesday_ornith-night.out</string>
  <key>StandardErrorPath</key><string>/Users/kam_code/Library/Logs/wednesday_ornith-night.err</string>
</dict>
</plist>
