<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NIGHTLY STALE-TICKET SCREEN (Kam 2026-11-12 11:36 "implement this plan as a standard routine"; routine (b)). Wednesday seat ONLY
     (install_all_jobs.sh skips it elsewhere: Secuura content on Wednesday's Spark). Fires once at 01:15; nightly.sh itself enforces the
     01:00-05:00 window, refuses (exit 0, logged) while the tunnel is down or a Spark round/other client holds the box, and screens
     at most 60 tickets. PROPOSALS ONLY: no Linear write, no checkout write. Output: local-model/stale_screen/runs/<date>/ (gitignored). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@SEAT@.stalescreen</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@PROJECT_DIR@/2_Project_Files/local-model/stale_screen/nightly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>1</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict><key>WED_AGENT</key><string>@SEAT@</string></dict>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/@SEAT@_stalescreen.out</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/@SEAT@_stalescreen.err</string>
</dict>
</plist>
