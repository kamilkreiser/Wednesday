<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@SEAT@.nassync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@PROJECT_DIR@/2_Project_Files/scheduler/nas_sync.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>@NASHOUR@</integer>
    <key>Minute</key><integer>@NASMIN@</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/@SEAT@_nassync.out</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/@SEAT@_nassync.err</string>
</dict>
</plist>
