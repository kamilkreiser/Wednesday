<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@SEAT@.chatsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@PROJECT_DIR@/2_Project_Files/tools/chat_sync.sh</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <!-- out/err MUST live off the external volume: launchd cannot open them on
       /Volumes/DevMASTER and returns EX_CONFIG (78) without ever running the job.
       Measured 2026-09-09; the working nassync/wake/close plists all use ~/Library/Logs. -->
  <key>StandardOutPath</key><string>/Users/kam_code/Library/Logs/wednesday_chatsync.out</string>
  <key>StandardErrorPath</key><string>/Users/kam_code/Library/Logs/wednesday_chatsync.err</string>
</dict>
</plist>
