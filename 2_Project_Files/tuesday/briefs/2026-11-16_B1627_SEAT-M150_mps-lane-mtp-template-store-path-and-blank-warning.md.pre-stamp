    def test_templates_path_sits_beside_the_other_stores(self):
        st = app_settings(Compiled.template)
        self.assertEqual(st.get("MpsCalc__Templates__Path"), "/home/data/templates/")
        # Hand-derived: a store directory may not equal, contain or sit inside another store's, so each is its own folder under /home/data/.
        others = [st["MpsCalc__QuoteStore__Path"], st["MpsCalc__CatalogueOverlay__Path"]]
        self.assertEqual(len({st["MpsCalc__Templates__Path"], *others}), 3)

```
