- **B3, the new test file `tests/MpsCalc.Api.Tests/TemplateStartWarningTests.cs`** (the whole file, 84 lines; four rows; the row whose path is SET is the control for the filter of the three blank rows):
```
using Microsoft.Extensions.DependencyInjection;
using MpsCalc.Api.Quotes;
using MpsCalc.Api.Templates;
using MpsCalc.Api.Tests.Infrastructure;

namespace MpsCalc.Api.Tests;

/// <summary>
/// The start-up warning for a blank template store path: one Warning line when MpsCalc:Templates:Path is blank (in either mode),
/// none when it is set. Each test works in its own temporary root standing in for /home/data. All values SYNTHETIC.
/// </summary>
public sealed class TemplateStartWarningTests : IDisposable
{
    private const string BlankPathLine = "Warning: The template store is in memory: MpsCalc:Templates:Path is blank, so every template is lost at the next restart.";
    private readonly string _root;

    public TemplateStartWarningTests()
    {
        string tmp = Path.Combine(Path.GetTempPath(), $"mpscalc-tp-{Guid.NewGuid():N}");
        Directory.CreateDirectory(tmp);
        _root = QuoteFileStore.RealPath(tmp);
    }

    public void Dispose()
    {
        Directory.Delete(_root, recursive: true); // this test's own temporary directory, as the other store tests do
        GC.SuppressFinalize(this);
    }

    private string Data => Path.Combine(_root, "home", "data");

    private EntraApiHost Hosted(string? templatesPath)
    {
        var h = new EntraApiHost { QuoteStorePath = Path.Combine(Data, "quotes") };
        h.Settings["MpsCalc:QuoteStore:HostedRoot"] = Data + "/";
        if (templatesPath is not null)
        {
            h.Settings[TemplateStore.PathKey] = templatesPath;
        }
        return h;
    }

    /// <summary>The Warning lines the start logged that name the setting (the store's own refusals throw, so they never reach a log).</summary>
    private static string[] Mine(ApiHost host)
    {
        _ = host.Services.GetRequiredService<TemplateStore>(); // the host is built, and so has started, by now
        lock (host.Logged)
        {
            return [.. host.Logged.Where(m => m.StartsWith("Warning: ", StringComparison.Ordinal) && m.Contains(TemplateStore.PathKey, StringComparison.Ordinal))];
        }
    }

    [Fact]
    public void A_set_path_logs_no_warning_about_it_and_this_is_the_control_for_the_rows_below()
    {
        using var host = Hosted(Path.Combine(Data, "templates") + "/");
        // Hand-derived: the path is set, so the store opens on disk and the start has nothing to say about the setting.
        Assert.Empty(Mine(host));
        Assert.NotNull(host.Services.GetRequiredService<TemplateStore>().StoreDirectory);
    }

    [Fact]
    public void A_blank_path_logs_one_warning_at_start_hosted()
    {
        using var host = Hosted(templatesPath: null);
        // Hand-derived: no Templates setting anywhere (the appsettings files hold none), so one start logs one line.
        Assert.Equal([BlankPathLine], Mine(host));
        Assert.Null(host.Services.GetRequiredService<TemplateStore>().StoreDirectory);
    }

    [Fact]
    public void A_path_of_spaces_is_blank_and_logs_one_warning()
    {
        using var host = Hosted("   ");
        Assert.Equal([BlankPathLine], Mine(host));
    }

    [Fact]
    public void A_blank_path_logs_one_warning_at_start_local_dev()
    {
        using var host = new ApiHost();
        Assert.Equal([BlankPathLine], Mine(host));
    }
}
```
  The four test names are `A_set_path_logs_no_warning_about_it_and_this_is_the_control_for_the_rows_below`, `A_blank_path_logs_one_warning_at_start_hosted`, `A_path_of_spaces_is_blank_and_logs_one_warning` and `A_blank_path_logs_one_warning_at_start_local_dev`. If W1 changes at the stamp, the one constant `BlankPathLine` changes with it and nothing else.

