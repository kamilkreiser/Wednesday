    def test_mutation_a_pause_delay_that_is_not_a_number_or_exactly_the_modules_parameter_stays_unreadable(self):
        """B1003-1: the database's delay is a number, or EXACTLY AUTO_PAUSE_EXPRESSION (read through the module's default).
        Any other text, even another parameter, stays text: the rule reports 'not one literal number' and never reads it as the
        default 60. A reader loosened to any '[parameters(' text must fail this row."""
        for what, delay in (("another parameter", "[parameters('other')]"), ("an if() expression", "[if(true(), 60, -1)]"),
                            ("the parameter name in another case", "[parameters('AutoPauseDelay')]"), ("the text 60", "60")):
            t = copy.deepcopy(self.t)
            for db, _ in databases_with_template(t):
                props(db)["autoPauseDelay"] = delay
            with self.subTest(delay=what):
                v = rule_demo_database_stays_awake(t)
                self.assertEqual(len(v), 1)
                self.assertIn("not one literal number", v[0])
        t = copy.deepcopy(self.t)  # control: the exact expression is read through the default (60) and the shipped demo passes
        for db, _ in databases_with_template(t):
            props(db)["autoPauseDelay"] = AUTO_PAUSE_EXPRESSION
        self.assertEqual(rule_demo_database_stays_awake(t), [])
```
