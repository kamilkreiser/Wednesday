**`survive-term.js` (frozen; measured on a plain child, see STATE):**
```js
'use strict';
const realOnce = process.once.bind(process);
process.once = function (ev, fn) { return ev === 'SIGTERM' ? process : realOnce(ev, fn); };
process.on('SIGTERM', () => {});
```
**`stopms.js` (frozen; UNMEASURED as a whole, it boots the real server):** it requires the harness of the tree named by its first argument, boots a server with `preload` set to `survive-term.js` beside it and `bootTimeoutMs: 120000`, times `await h.stop()` and prints `STOPMS <ms>`; on any error it prints `STOPMS ERR <message>` and exits 1.
```js
'use strict';
const path = require('path');
const fs = require('fs');
const tree = process.argv[2];
const { bootServer } = require(path.join(tree, '__tests__/helpers/rd395-server-harness.js'));
(async () => {
    const made = [];
    const h = await bootServer({ tag: 'rd734-stop', made, bootTimeoutMs: 120000, preload: path.join(__dirname, 'survive-term.js') });
    const t0 = Date.now();
    await h.stop();
    console.log('STOPMS ' + (Date.now() - t0));
    for (const d of made) fs.rmSync(d, { recursive: true, force: true });
})().catch((e) => { console.log('STOPMS ERR ' + String(e.message).slice(0, 200)); process.exit(1); });
```
