+// RD-998: the store-tamper check above used to compare two clock readings with a strict less-than, the
+// shape that failed one hosted run of its sister check (RD-991). It now orders the token answer and the
+// tamper by the counter. No server is booted by these cells: each hands the check a result built by hand.
+describe('RD-998 - the store-tamper check orders its two events by a counter, not by a clock tie', () => {
+    const result = (fields) => ({ code: 'rd998-hand-built', restored: true, ...fields });
+    const REFUSAL = 'RD-452 harness [rd998-hand-built]: the store was not made bad inside the token exchange';
+
+    test('W1 - equal clock readings, the tamper ordered before the answer: the check passes', () => {
+        const r = result({ answeredAt: 5000, tamperedAt: 5000, answeredOrder: 2, tamperedOrder: 1 });
+        expect(() => expectTamperInsideTheWindow(r)).not.toThrow();
+    });
+
+    test('W2 - equal clock readings, the tamper ordered after the answer: the check throws the harness error', () => {
+        const r = result({ answeredAt: 5000, tamperedAt: 5000, answeredOrder: 1, tamperedOrder: 2 });
+        expect(() => expectTamperInsideTheWindow(r)).toThrow(REFUSAL);
