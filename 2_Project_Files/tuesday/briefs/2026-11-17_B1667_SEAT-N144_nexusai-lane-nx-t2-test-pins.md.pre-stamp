+        expect(() => expectTamperInsideTheWindow(r)).toThrow(REFUSAL);
+    });
+
+    test('W4 - a result with no answer stamp: the check throws the harness error', () => {
+        const r = result({ answeredAt: null, tamperedAt: 5000, answeredOrder: undefined, tamperedOrder: 1 });
+        expect(() => expectTamperInsideTheWindow(r)).toThrow(REFUSAL);
+    });
+});
