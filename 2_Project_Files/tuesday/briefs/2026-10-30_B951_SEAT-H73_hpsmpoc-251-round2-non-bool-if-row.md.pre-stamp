```
    def test_mutation_suffix_if_with_a_condition_that_is_no_bool_and_one_unscoped_branch_is_red(self):
        scoped = "uniqueString(resourceGroup().id, parameters('environmentName'))"
        take = f"take({scoped}, 6)"
        tail = "can take a branch with no uniqueString call scoped to resourceGroup().id and parameters('environmentName')"
        for cond in ("parameters('flag')",  # what a ternary on a bool parameter compiles to: kept as text, no bool
                     "concat('a','b')",  # a text
                     "createArray('a')"):  # an array
            for typed in (f"[if({cond}, {take}, 'zzzzzz')]",  # the scoped branch first
                          f"[if({cond}, 'zzzzzz', {take})]"):  # the scoped branch second
                with self.subTest(typed=typed):
                    t = self.mutate_main_variable("suffix", lambda _, typed=typed: typed)
                    self.assertEqual(t["variables"]["suffix"], typed)  # the mutation took
                    self.assertEqual(rule_module_call_bindings(t),
                                     [f"variables.suffix is {typed!r}, which, read in dev, uat, demo, {tail}"])  # a condition that is no bool takes both branches
```
