```python FILE: runlist1911.py
#!/usr/bin/env python3
# Drafter's run-list program for lane N-L: prints the top-level __tests__/*.test.js files whose text names a reader of the changed css/html frame.
import os, re, sys
root = sys.argv[1]
td = os.path.join(root, '__tests__')
pat = re.compile(r"index-styles\.css|dark-mode\.css|static/css|'css'|\"css\"|index\.html|renderPage\(|helpers/dom|helpers/css-colors|helpers/dark-corpus|css-colors")
hits = []
total = 0
for n in sorted(os.listdir(td)):
    p = os.path.join(td, n)
    if n.endswith('.test.js') and os.path.isfile(p):
        total += 1
        if pat.search(open(p, encoding='utf8', errors='replace').read()):
            hits.append(n)
print('frame: top-level __tests__/*.test.js; files', total, 'run-list', len(hits))
for h in hits: print(h)
```

