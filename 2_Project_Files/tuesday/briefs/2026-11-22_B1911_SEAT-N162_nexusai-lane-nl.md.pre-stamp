**The browser harness** (`browser1911.js`, plain node, `NODE_PATH` or the clone's `node_modules`; `playwright-core` `chromium.launch()` headless; a local file harness page with the REAL stylesheets of the tree under test and the markup of `static/index.html:203-213` and `static/js/index.js` (the `metric-label` div, the `consumable-bar` span); no network, no server, no port; run through the jest lock like every browser step). Run it at BASE (`old11`) and at the head (`new42`) and print both JSONs side by side:
```js FILE: browser1911.js
#!/usr/bin/env node
// browser1911.js <tree root> <out json>: real-engine read of the four texts of lane N-L in light and dark.
// A local harness with the REAL stylesheets of the tree and the markup copied from static/index.html and static/js/index.js.
// Not the live page: Bootstrap and the page scripts are absent (said so in every printout). Loopback/file only, no network.
'use strict';
const fs = require('fs');
const path = require('path');
const root = process.argv[2];
const out = process.argv[3];
const { chromium } = require('playwright-core');
const css = (n) => 'file://' + path.join(root, 'static', 'css', n);
const bar = (cls, w) => '<div class="consumable-bar" style="width:90px;margin:6px"><div class="consumable-fill ' + cls + ' tw-' + w + '"></div><span class="consumable-text">' + w + '%</span></div>';
const html = (dark) => '<!doctype html><html><head><meta charset="utf-8">' +
  '<link rel="stylesheet" href="' + css('index-styles.css') + '"><link rel="stylesheet" href="' + css('dark-mode.css') + '"></head>' +
  '<body class="' + (dark ? 'dark-mode' : '') + '">' +
  '<div class="metric-card"><div class="metric-label">Total Usage Cost</div><div class="metric-value">$1</div></div>' +
  '<div class="import-section"><h3>Print Jobs Data</h3><p class="file-description">CSV with columns: User_Name, Job_ID, etc.</p>' +
  '<div class="file-drop-zone"><div class="drop-text"><span>Drop print jobs CSV here or</span><label class="file-select-btn">Select File</label></div></div></div>' +
  [['black', 5], ['cyan', 50], ['magenta', 100], ['yellow', 25], ['yellow', 5], ['black', 100]].map(([c, w]) => bar(c, w)).join('') +
  '</body></html>';
(async () => {
  const b = await chromium.launch();
  const res = {};
  for (const mode of ['light', 'dark']) {
    const p = await b.newPage({ viewport: { width: 900, height: 700 } });
    fs.writeFileSync(path.join(path.dirname(out), 'harness_' + mode + '.html'), html(mode === 'dark'));
    await p.goto('file://' + path.join(path.dirname(out), 'harness_' + mode + '.html'));
    await p.waitForTimeout(500);
    res[mode] = await p.evaluate(() => {
      const lin = (c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
      const lum = (c) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
      const cr = (a, c) => { let x = lum(a), y = lum(c); if (x < y) [x, y] = [y, x]; return (x + 0.05) / (y + 0.05); };
      const rgb = (s) => (s.match(/[\d.]+/g) || []).slice(0, 4).map(Number);
      const ground = (el) => { // the first ancestor-or-self with an opaque background colour (alpha 1); gradients reported as such
        for (let e = el; e; e = e.parentElement) {
          const cs = getComputedStyle(e);
          if (cs.backgroundImage && cs.backgroundImage !== 'none') return { kind: 'gradient', css: cs.backgroundImage.slice(0, 80), el: e.className };
          const c = rgb(cs.backgroundColor);
          if (c.length === 3 || (c.length === 4 && c[3] === 1)) return { kind: 'solid', c: c.slice(0, 3), el: e.className || e.tagName };
        }
        return { kind: 'none' };
      };
      const row = (sel) => Array.from(document.querySelectorAll(sel)).map((el) => {
        const fg = rgb(getComputedStyle(el).color).slice(0, 3);
        const g = ground(el);
        const r = el.getBoundingClientRect();
        const pr = el.parentElement.getBoundingClientRect();
        return { sel, text: el.textContent.slice(0, 12), fg: fg.join(','), ground: g.kind === 'solid' ? g.c.join(',') + ' (' + g.el + ')' : g.kind + ' ' + (g.css || ''),
          ratio: g.kind === 'solid' ? Math.round(cr(fg, g.c) * 1000) / 1000 : null,
          h: Math.round(r.height * 10) / 10, w: Math.round(r.width * 10) / 10, insideParent: r.top >= pr.top - 0.01 && r.bottom <= pr.bottom + 0.01 && r.left >= pr.left - 0.01 && r.right <= pr.right + 0.01,
          textShadow: getComputedStyle(el).textShadow };
      });
      return { metric: row('.metric-card .metric-label'), file: row('.file-description'), drop: row('.drop-text'), dropSpan: row('.drop-text > span'), chip: row('.consumable-text'),
               track: Array.from(document.querySelectorAll('.consumable-bar')).slice(0, 1).map((e) => getComputedStyle(e).backgroundColor) };
    });
    await p.close();
  }
  await b.close();
  fs.writeFileSync(out, JSON.stringify(res, null, 1));
  console.log('wrote', out);
})().catch((e) => { console.error('FAIL', String(e).slice(0, 300)); process.exit(1); });
```
**What it proves and what it does not:** colour, ground and box of the four texts in light and dark in the real engine; NOT the live page (Bootstrap and the page scripts are absent), not hover or focus states, not other viewports. A ground the harness reports as `gradient` (the KPI card in dark: a gradient from `#1c1c1c` to `#262626`) has `ratio: null` and is read by hand from both stops (the cells D1 and D4 cover it as text). **Required at the head:** every `ratio` that is not null is at least 4.5 (light and dark); the chip's `insideParent` is true for all six bars (0 to 100 percent fill); `textShadow` of the chip reads `none`; the dark `.drop-text` colour reads `rgb(140, 140, 140)`. A reading that differs is a STOP naming the row, not an edit (HOLD 35).

