```
import re, sys
OWN = [r"\.tools/b1244", r"wt-b1244", r"pc-b1244", r"B1244", r"G328"]
SHARED = [r"change-report\.test\.ts", r"packages/renderers/src", r"change-report\.ts", r"b1241/composer-pcomp122", r"PCOMP-122", r"composer-heavy\.lock", r"\.tools/b1241", r"wt-b1241"]
VERB = re.compile(r"\b(write|writes|written|edit|edits|append|appends|add|adds|commit|merge|fold|comment|transition|move|create|post|POST|PUT|push|plant|plants|replace)\b", re.I)
for p in sys.argv[1:]:
    hits = []
    for n, line in enumerate(open(p, encoding="utf-8"), 1):
        own = [t for t in OWN if re.search(t, line)]
        sh = [t for t in SHARED if re.search(t, line)]
        if own or (sh and VERB.search(line)):
            hits.append((n, own, sh, line.strip()[:110]))
    print(p.split("/")[-1][:60], "hits", len(hits))
    for h in hits[:12]: print("   :%d own=%s shared=%s | %s" % h)
```
