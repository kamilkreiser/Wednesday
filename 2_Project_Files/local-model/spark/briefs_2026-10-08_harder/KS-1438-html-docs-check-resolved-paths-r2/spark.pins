# bash_patch2: ref = an existing suite in the RED suite's directory, shape reference only (never touched). The tier-1
# builder that bash_patch2 runs first refuses ref == test_file, so the declared RED suite cannot be its own ref.
# KS-1438 is Backlog (Kamil), round 0; the product is .mjs (bash_patch2 B5a: "not a .sh - bash -n not applicable").
tier=bash_patch2
ref=systemTest/__tests__/no_secret_prefix_echo.test.sh
