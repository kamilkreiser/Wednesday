+# 4. KS-1438: the checker reports through ANY spelling of its own path. The scratch dir is resolved
+# physically first, so the symlink cell and the space cell each exercise ONE spelling difference.
+printf '<html><body><div class="mermaid">graph TD\n A[Start --> B[End]</div></body></html>\n' >"$SCRATCH/broken.html"
+REAL_SCRATCH="$(cd -P "$SCRATCH" && pwd)"
+ln -s "$CHECK" "$REAL_SCRATCH/linked_check.mjs"
+mkdir -p "$REAL_SCRATCH/dir with space"
+cp "$CHECK" "$REAL_SCRATCH/dir with space/html_docs_check.mjs"
+# expect_reported <label> <checker path>: the broken page must exit 1 AND name the unbalanced bracket.
+expect_reported() {
+    local label="$1" checker="$2" out rc
+    out="$(node "$checker" "$SCRATCH/broken.html" 2>&1)"
+    rc=$?
+    if [[ $rc -eq 1 ]] && grep -q -- 'unbalanced \[\]' <<<"$out"; then
+        ok "KS-1438: $label reports the broken page"
+    else
+        bad "KS-1438: $label did NOT report the broken page (rc=$rc, got: ${out:-nothing})"
+    fi
+}
