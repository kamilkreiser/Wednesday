# hosted/ (2026-10-09, gitignore-at-creation). Never commit these:
# runs/  — every run dir holds input.json (Secuura source excerpts), request.json (the same, as sent) and out.md /
#          out.md.raw.json / out.md.checker/ (model-written Secuura patches). Client code; same rule as
#          local-model/runs/ and spark/cache/ in the root .gitignore.
# work/  — per-task --shared clones of the Secuura cache (~335 MB each when kept with --keep-clone).
# state/ — budget.json (running spend; no client code, but per-machine runtime state like spark/state/) and dry/
#          (dry-run request bodies = Secuura code again).
# done_<model>.md stays TRACKED, like spark/done.md: tags, verdicts, tokens, cost — no code.
runs/
work/
state/
__pycache__/
