 "files": {
  "Blockchain/Dev/services/api-gateway/src/__tests__/ks1215-the-connector-branch-never-carries-the-callers-bearer.test.ts": "/**\n * =============================================================================\n * KS-1215 — the connector branch never carries the caller's Bearer\n * =============================================================================\n * A request with a VALID `x-api-key` takes authenticateToken's connector branch:\n * req.user becomes the connector, and the key is exchanged at auth for a\n * short-lived connector JWT that is set as Authorization. When that exchange\n * failed (a refusal, a dropped connection, an unparseable body), the helper\n * returned null and Authorization was left as the CALLER sent it, so the\n * caller's own Bearer reached the upstream beside the connector principal:\n *   - a REVOKED session's JWT plus a valid key was forwarded past the\n *     session-revocation check (the N-1 of the KS-1207 gate);\n *   - a LIVE user's JWT travelled under the connector principal (a split\n *     principal).\n *\n * Now the branch drops the caller's Authorization first, before any await\n * (Wednesday's ruling O3, 2026-09-17 11:22:22Z). A successful exchange sets the\n * connector JWT as before; a failed one forwards no Bearer.\n *\n * Residual, by design: a revoked-JWT holder with a VALID key still acts as the\n * connector, which the key alone already grants. Not covered: /api/batch/*.\n *\n * Pre-gate fix round: POST /api/platform/organizations/register-connector built its\n * upstream Authorization from `rawAuthorization`, the copy index.ts takes before any\n * auth runs, so the caller's Bearer still reached /api/tenants, the key mint\n * /api/keys and /api/audit on the connector branch. It now forwards the header the\n * auth middleware left in place: the connector JWT for a connector, the admin's own\n * Bearer for a JWT-only admin.\n *\n * Real app (the ks1207 pattern): the app exported by index.ts, `../db` mocked,\n * every upstream pointed at one recording stub that also answers key validation\n * and the connector-token exchange. The session store is stubbed: session\n * `ks1215-revoked` is revoked, `ks1215-live` is live. One cell repeats N-1 under\n * NODE_ENV=production on /api/v1 (the ks871 production recipe).\n *\n * The STRUCTURAL cells call the middleware directly (the ks480 pattern). At\n * runtime the helper never rejects: it catches every failure and returns null,\n * so \"delete only when the exchange fails\" and \"delete first\" behave the same on\n * every runtime cell above. The structural cells make the helper reject and\n * check that the caller's Bearer was already gone, which only \"delete first,\n * before any await\" satisfies. No runtime path makes this helper reject today;\n * they guard a future change to it.\n * =============================================================================\n */\nimport { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';\nimport http from 'http';\nimport jwt from 'jsonwebtoken';\nimport type { AddressInfo } from 'net';\nimport type { Request, Response } from 'express';\n\nvi.mock('../db', async (orig) => {\n  const real = (await orig()) as Record<string, unknown>;\n  return {\n    ...real,\n    isDbAvailable: () => true,\n    // register-connector inserts the Organisation and reads back its id and slug.\n    query: async (sql: string) => (/INSERT INTO organizations/i.test(sql)\n      ? { rows: [{ id: 'd0000000-0000-4000-8000-000000001215', slug: 'ks1215-org' }], rowCount: 1 }\n      : { rows: [], rowCount: 0 }),\n  };\n});\n\nconst sessionChecks: string[] = [];\nvi.mock('@secuura/shared', async (orig) => {\n  const real = (await orig()) as Record<string, unknown>;\n  return {\n    ...real,\n    isSessionActive: async (sessionId: string) => {\n      sessionChecks.push(sessionId);\n      return sessionId === 'ks1215-revoked' ? false : sessionId === 'ks1215-live' ? true : null;\n    },\n  };\n});\n\nconst PRIV = process.env.__TEST_JWT_PRIVATE_PEM as string;\nconst TENANT = 'a0000000-0000-4000-8000-000000000001';\nconst OK_KEY = 'sk_ks1215_exchange_ok_00001';\nconst REFUSED_KEY = 'sk_ks1215_exchange_401_0001';\nconst DROPPED_KEY = 'sk_ks1215_exchange_drop_001';\nconst CONNECTOR_ID: Record<string, string> = { [OK_KEY]: 'ks1215-ok', [REFUSED_KEY]: 'ks1215-refused', [DROPPED_KEY]: 'ks1215-dropped' };\n\ntype Hit = { url: string; userId: string | null; bearer: string };\nconst hits: Hit[] = [];\nconst INFRA = (url: string) => url === '/api/keys/validate' || url === '/internal/connector-token' || url.startsWith('/.well-known/');\n\nconst RAN = new Set<string>();\n\nfunction readBody(req: http.IncomingMessage): Promise<string> {\n  return new Promise((r) => { const c: Buffer[] = []; req.on('data', (d) => c.push(d)); req.on('end', () => r(Buffer.concat(c).toString())); });\n}\nconst REGISTER_UPSTREAMS = ['/api/audit', '/api/keys', '/api/tenants'];\nasync function listen(server: http.Server): Promise<string> {\n  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', () => resolve()));\n  return `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n}\nasync function closeServer(server: http.Server | undefined): Promise<void> {\n  if (!server) return;\n  server.closeAllConnections();\n  await new Promise<void>((r) => server.close(() => r()));\n}\n\n/** What reached the upstream as Authorization: none, the connector JWT, or a user's JWT named by its session. */\nfunction bearerOf(header: string | undefined): string {\n  if (!header) return 'none';\n  const decoded = jwt.decode(header.replace(/^Bearer\\s+/i, '')) as Record<string, unknown> | null;\n  if (!decoded) return 'undecodable';\n  return decoded.type === 'connector' ? 'connector-jwt' : `user:${String(decoded.sessionId)}`;\n}\n\ntype Res = { status: number; code: string | null; forwarded: Hit[] };\nfunction send(base: string, path: string, headers: Record<string, string>): Promise<Res> {\n  return new Promise((resolve, reject) => {\n    const target = new URL(base);\n    const before = hits.length;\n    const req = http.request({ hostname: target.hostname, port: target.port, path, method: 'GET', agent: false, headers }, (res) => {\n      const c: Buffer[] = [];\n      res.on('data', (d) => c.push(d));\n      res.on('end', () => {\n        let code: string | null = null;\n        try { code = JSON.parse(Buffer.concat(c).toString())?.error?.code ?? null; } catch { /* non-JSON: code stays null */ }\n        // Give a forwarded request time to land before reading the recorder.\n        setTimeout(() => resolve({ status: res.statusCode ?? 0, code, forwarded: hits.slice(before) }), 50);\n      });\n    });\n    req.setTimeout(15000, () => req.destroy(new Error(`no response from ${path} within 15 s`)));\n    req.on('error', reject);\n    req.end();\n  });\n}\n\nfunction userJwt(sessionId: string): string {\n  return 'Bearer ' + jwt.sign(\n    { userId: 'u-ks1215', email: 'ks1215-user@secuura.io', role: 'user', verificationLevel: 'email', authMethod: 'email', tenantId: TENANT, sessionId },\n    PRIV,\n    { algorithm: 'RS256', expiresIn: '10m' },\n  );\n}\n\nfunction adminJwt(sessionId: string): string {\n  return 'Bearer ' + jwt.sign(\n    { userId: 'u-ks1215-admin', email: 'ks1215-admin@secuura.io', role: 'SYSTEM_ADMIN', verificationLevel: 'email', authMethod: 'email', tenantId: TENANT, sessionId },\n    PRIV,\n    { algorithm: 'RS256', expiresIn: '10m' },\n  );\n}\n\n/** POST a JSON body; waits long enough for register-connector's fire-and-forget audit call to land. */\nfunction post(base: string, path: string, headers: Record<string, string>, body: unknown): Promise<Res> {\n  return new Promise((resolve, reject) => {\n    const target = new URL(base);\n    const before = hits.length;\n    const payload = JSON.stringify(body);\n    const req = http.request({ hostname: target.hostname, port: target.port, path, method: 'POST', agent: false,\n      headers: { 'content-type': 'application/json', 'content-length': String(Buffer.byteLength(payload)), ...headers } }, (res) => {\n      const c: Buffer[] = [];\n      res.on('data', (d) => c.push(d));\n      res.on('end', () => {\n        let code: string | null = null;\n        try { code = JSON.parse(Buffer.concat(c).toString())?.error?.code ?? null; } catch { /* non-JSON */ }\n        setTimeout(() => resolve({ status: res.statusCode ?? 0, code, forwarded: hits.slice(before) }), 250);\n      });\n    });\n    req.setTimeout(15000, () => req.destroy(new Error(`no response from ${path} within 15 s`)));\n    req.on('error', reject);\n    req.end(payload);\n  });\n}\nlet externalRefSeq = 0;\nfunction registerBody(): Record<string, unknown> {\n  externalRefSeq += 1;\n  return { externalRef: `ks1215-ext-${externalRefSeq}`, organizationName: `KS1215 Org ${externalRefSeq}`, tenantSlug: 'ks1215-tenant' };\n}\n/** The Bearer each of register-connector's three upstream calls received, keyed by path. */\nfunction registerBearers(r: Res): Record<string, string> {\n  // Keys sorted, so the JSON comparison below does not depend on the order the calls arrive in.\n  return Object.fromEntries(r.forwarded.filter((h) => REGISTER_UPSTREAMS.includes(h.url)).map((h) => [h.url, h.bearer]).sort(([x], [y]) => x.localeCompare(y)));\n}\nconst allThree = (bearer: string) => ({ '/api/audit': bearer, '/api/keys': bearer, '/api/tenants': bearer });\n\n/** One upstream for every service: key validation, the connector-token exchange, and a recorder for everything else. */\nfunction createUpstream(): http.Server {\n  return http.createServer(async (req, res) => {\n    const body = await readBody(req);\n    const json = (status: number, payload: unknown) => { res.writeHead(status, { 'content-type': 'application/json' }); res.end(JSON.stringify(payload)); };\n    const url = req.url || '';\n    if (url === '/api/keys/validate') {\n      const key = JSON.parse(body || '{}').key as string;\n      return json(200, CONNECTOR_ID[key]\n        ? { data: { valid: true, connectorId: CONNECTOR_ID[key], scopes: ['documents:read', 'documents:write', 'organizations:register'], organizationId: 'org-ks1215', tenantId: TENANT, rateLimit: 1000, rateLimitWindow: 60 } }\n        : { data: { valid: false } });\n    }\n    if (url === '/internal/connector-token') {\n      const key = JSON.parse(body || '{}').apiKey as string;\n      if (key === DROPPED_KEY) { req.socket.destroy(); return; }\n      if (key !== OK_KEY) return json(401, { success: false });\n      const token = jwt.sign({ userId: 'connector:ks1215-ok', email: 'connector@secuura.io', role: 'connector', verificationLevel: 'api_key', type: 'connector' }, PRIV, { algorithm: 'RS256', expiresIn: 600 });\n      return json(200, { success: true, data: { token, expiresIn: 600 } });\n    }\n    if (url.startsWith('/.well-known/')) return json(404, {});\n    if (!INFRA(url)) hits.push({ url, userId: (req.headers['x-user-id'] as string | undefined) ?? null, bearer: bearerOf(req.headers.authorization as string | undefined) });\n    // register-connector's three upstream calls: the tenant lookup, the key mint and the audit write.\n    if (url === '/api/tenants') return json(200, { tenants: [{ id: TENANT, slug: 'ks1215-tenant' }] });\n    if (url === '/api/keys') return json(201, { success: true, data: { id: 'key-ks1215', key: 'sk_minted_ks1215', prefix: 'sk_mint' } });\n    if (url === '/api/audit') return json(201, { success: true });\n    return json(200, { success: true, data: { recorder: true } });\n  });\n}\n\nconst SERVICES = ['ANALYTICS', 'ANCHORING', 'AUTH', 'BILLING', 'GOVERNANCE', 'KYC', 'NFT', 'NOTIFICATION', 'ORIGINATE', 'PRISM',\n  'REFERRAL', 'SECURITY', 'STAKING', 'TIMESTAMPING', 'TRANSFER', 'VC_ISSUER', 'WALLET'];\n\nasync function bootApp(upstreamUrl: string): Promise<{ server: http.Server; url: string }> {\n  for (const name of SERVICES) vi.stubEnv(`${name}_SERVICE_URL`, upstreamUrl);\n  vi.stubEnv('TENANT_PROVISIONING_URL', upstreamUrl);\n  vi.stubEnv('GATEWAY_VOUCH_SECRET', '');\n  delete process.env.JWT_JWKS_URL;\n  vi.resetModules();\n  const app = (await import('../index')).default;\n  const server = http.createServer(app as http.RequestListener);\n  return { server, url: await listen(server) };\n}\n\nlet upstream: http.Server | undefined;\nlet upstreamUrl = '';\nbeforeAll(async () => {\n  upstream = createUpstream();\n  upstreamUrl = await listen(upstream);\n});\nafterAll(async () => {\n  await closeServer(upstream);\n  vi.unstubAllEnvs();\n});\n\n// An optional mount (authenticateToken(false)) and a required one (authenticateToken(true)).\nconst MOUNTS: Array<[string, string]> = [\n  ['optional /api/credentials', '/api/credentials/cred-ks1215'],\n  ['required /api/documents', '/api/documents/doc-ks1215'],\n];\n\ndescribe('KS-1215 real app, NODE_ENV=test — a failed connector-token exchange forwards no caller Bearer', () => {\n  let gateway: { server: http.Server; url: string } | undefined;\n  beforeAll(async () => {\n    vi.stubEnv('NODE_ENV', 'test');\n    gateway = await bootApp(upstreamUrl);\n  }, 60000);\n  afterAll(async () => { await closeServer(gateway?.server); });\n\n  for (const [mount, path] of MOUNTS) {\n    it(`🔴 ${mount} N-1: a valid key + a REVOKED session's JWT, exchange refused, reaches the upstream with no Bearer`, async () => {\n      RAN.add(`${mount} N-1`);\n      const r = await send(gateway!.url, path, { 'x-api-key': REFUSED_KEY, authorization: userJwt('ks1215-revoked') });\n      expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['connector:ks1215-refused'], ['none']]);\n    });\n\n    it(`🔴 ${mount} split principal: a valid key + a LIVE user's JWT, exchange refused, does not forward the user's Bearer`, async () => {\n      RAN.add(`${mount} split`);\n      const r = await send(gateway!.url, path, { 'x-api-key': REFUSED_KEY, authorization: userJwt('ks1215-live') });\n      expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['connector:ks1215-refused'], ['none']]);\n    });\n\n    it(`🔴 ${mount} unreachable: the exchange connection drops, and neither a live nor a revoked caller's Bearer is forwarded`, async () => {\n      RAN.add(`${mount} unreachable`);\n      const live = await send(gateway!.url, path, { 'x-api-key': DROPPED_KEY, authorization: userJwt('ks1215-live') });\n      const revoked = await send(gateway!.url, path, { 'x-api-key': DROPPED_KEY, authorization: userJwt('ks1215-revoked') });\n      expect([live.status, live.forwarded.map((h) => h.bearer), revoked.status, revoked.forwarded.map((h) => h.bearer)]).toEqual([200, ['none'], 200, ['none']]);\n    });\n\n    it(`control, ${mount}: exchange OK, a key alone forwards the connector JWT`, async () => {\n      RAN.add(`${mount} control key alone`);\n      const r = await send(gateway!.url, path, { 'x-api-key': OK_KEY });\n      expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['connector:ks1215-ok'], ['connector-jwt']]);\n    });\n\n    it(`control, ${mount}: exchange OK, a key beside a live JWT forwards the connector JWT, not the user's`, async () => {\n      RAN.add(`${mount} control key + live`);\n      const r = await send(gateway!.url, path, { 'x-api-key': OK_KEY, authorization: userJwt('ks1215-live') });\n      expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['connector:ks1215-ok'], ['connector-jwt']]);\n    });\n\n    it(`control, ${mount}: a live JWT alone is forwarded with the user's own Bearer after its session is checked`, async () => {\n      RAN.add(`${mount} control live alone`);\n      const before = sessionChecks.length;\n      const r = await send(gateway!.url, path, { authorization: userJwt('ks1215-live') });\n      expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['u-ks1215'], ['user:ks1215-live']]);\n      expect(sessionChecks.slice(before)).toContain('ks1215-live');\n    });\n  }\n  it('RED: a connector key is refused 403 on GET /api/platform/tenants/:id and nothing is forwarded', async () => {\n    RAN.add('platform GET /api/platform/tenants/:id refuses a connector');\n    const g284 = await send(gateway!.url, '/api/platform/tenants/ks1282-t1', { 'x-api-key': OK_KEY });\n    expect([g284.status, g284.code, g284.forwarded.map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a connector key is refused 403 on PATCH /api/platform/tenants/:id and nothing is forwarded', async () => {\n    RAN.add('platform PATCH /api/platform/tenants/:id refuses a connector');\n    const p301n = hits.length;\n    const p301 = await fetch(gateway!.url + '/api/platform/tenants/ks1282-t1', { method: 'PATCH', headers: { 'content-type': 'application/json', 'x-api-key': OK_KEY }, body: JSON.stringify({ name: 'KS1282 renamed' }) });\n    const p301code = ((await p301.json().catch(() => ({}))) as any)?.error?.code ?? null; await new Promise((r) => setTimeout(r, 50));\n    expect([p301.status, p301code, hits.slice(p301n).map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a connector key is refused 403 on PATCH /api/platform/tenants/:id/status and nothing is forwarded', async () => {\n    RAN.add('platform PATCH /api/platform/tenants/:id/status refuses a connector');\n    const s320n = hits.length;\n    const s320 = await fetch(gateway!.url + '/api/platform/tenants/ks1282-t1/status', { method: 'PATCH', headers: { 'content-type': 'application/json', 'x-api-key': OK_KEY }, body: JSON.stringify({ status: 'suspended' }) });\n    const s320code = ((await s320.json().catch(() => ({}))) as any)?.error?.code ?? null; await new Promise((r) => setTimeout(r, 50));\n    expect([s320.status, s320code, hits.slice(s320n).map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a connector key is refused 403 on DELETE /api/platform/tenants/:id and nothing is forwarded', async () => {\n    RAN.add('platform DELETE /api/platform/tenants/:id refuses a connector');\n    const d339n = hits.length;\n    const d339 = await fetch(gateway!.url + '/api/platform/tenants/ks1282-t1', { method: 'DELETE', headers: { 'x-api-key': OK_KEY } });\n    const d339code = ((await d339.json().catch(() => ({}))) as any)?.error?.code ?? null; await new Promise((r) => setTimeout(r, 50));\n    expect([d339.status, d339code, hits.slice(d339n).map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a connector key is refused 403 on GET /api/platform/audit-log and nothing is forwarded', async () => {\n    RAN.add('platform GET /api/platform/audit-log refuses a connector');\n    const a362 = await send(gateway!.url, '/api/platform/audit-log', { 'x-api-key': OK_KEY });\n    expect([a362.status, a362.code, a362.forwarded.map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a tenant ADMIN JWT is refused 403 on GET /api/platform/tenants and nothing is forwarded', async () => {\n    RAN.add('platform tenants GET refuses a tenant ADMIN');\n    const tok = 'Bearer ' + jwt.sign({ userId: 'u-ks1282-admin', email: 'ks1282-admin@secuura.io', role: 'ADMIN', verificationLevel: 'email', authMethod: 'email', tenantId: TENANT, sessionId: 'ks1215-live' }, PRIV, { algorithm: 'RS256', expiresIn: '10m' });\n    const r = await send(gateway!.url, '/api/platform/tenants', { authorization: tok });\n    expect([r.status, r.code, r.forwarded.map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED: a connector key is refused 403 on GET /api/platform/tenants and nothing is forwarded', async () => {\n    RAN.add('platform tenants GET refuses a connector');\n    const tg = await send(gateway!.url, '/api/platform/tenants', { 'x-api-key': OK_KEY });\n    expect([tg.status, tg.code, tg.forwarded.map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED KS-1238: POST /api/users/admin/create with a connector key alone is refused 401 by requireAdmin and nothing is forwarded', async () => {\n    RAN.add('admin create shadow');\n    const ac = await post(gateway!.url, '/api/users/admin/create', { 'x-api-key': OK_KEY }, { email: 'qa-ks1238@secuura.io', role: 'user' });\n    expect([ac.status, ac.code, ac.forwarded.map((h) => h.url)]).toEqual([401, 'UNAUTHORIZED', []]);\n  });\n  it('RED KS-1238: PATCH /api/users/admin/:id with a connector key alone is refused 401 by requireAdmin and nothing is forwarded', async () => {\n    RAN.add('admin patch shadow');\n    const ap0 = hits.length;\n    const ap = await fetch(gateway!.url + '/api/users/admin/u-ks1238', { method: 'PATCH', headers: { 'content-type': 'application/json', 'x-api-key': OK_KEY }, body: JSON.stringify({ role: 'user' }) });\n    const apCode = ((await ap.json().catch(() => ({}))) as any)?.error?.code ?? null; await new Promise((r) => setTimeout(r, 50));\n    expect([ap.status, apCode, hits.slice(ap0).map((h) => h.url)]).toEqual([401, 'UNAUTHORIZED', []]);\n  });\n  it('RED KS-1238 (i): a valid key + a REVOKED session JWT under a lower-case or upper-case bearer scheme, exchange refused, reaches the upstream with no Bearer', async () => {\n    RAN.add('KS-1238 (i) bearer scheme case');\n    const token = userJwt('ks1215-revoked').slice('Bearer '.length);\n    const lower = await send(gateway!.url, '/api/documents/doc-ks1215', { 'x-api-key': REFUSED_KEY, authorization: 'bearer ' + token });\n    const upper = await send(gateway!.url, '/api/documents/doc-ks1215', { 'x-api-key': REFUSED_KEY, authorization: 'BEARER ' + token });\n    expect(JSON.stringify([lower.status, lower.forwarded.map((h) => h.bearer), upper.status, upper.forwarded.map((h) => h.bearer)])).toBe(JSON.stringify([200, ['none'], 200, ['none']]));\n  });\n});\n\ndescribe('KS-1215 real app, NODE_ENV=production — /api/v1', () => {\n  let gateway: { server: http.Server; url: string } | undefined;\n  beforeAll(async () => {\n    // The ks871 production recipe: a stub CSRF secret and DB / Redis URLs on a closed loopback port (`../db` is mocked above).\n    vi.stubEnv('NODE_ENV', 'production');\n    vi.stubEnv('CSRF_SECRET', 'ks1215-stub-csrf-not-a-real-secret');\n    vi.stubEnv('DATABASE_URL', 'postgres://ks1215:ks1215@127.0.0.1:1/ks1215');\n    vi.stubEnv('REDIS_URL', 'redis://127.0.0.1:1');\n    vi.stubEnv('ENABLE_TEST_TOKENS', '');\n    vi.stubEnv('ENABLE_MOCK_ENDPOINTS', '');\n    gateway = await bootApp(upstreamUrl);\n  }, 60000);\n  afterAll(async () => { await closeServer(gateway?.server); });\n\n  it('🔴 production /api/v1/credentials N-1: a valid key + a REVOKED session\\'s JWT, exchange refused, reaches the upstream with no Bearer', async () => {\n    RAN.add('production N-1');\n    const unversioned = await send(gateway!.url, '/api/credentials/cred-ks1215', { authorization: userJwt('ks1215-live') });\n    expect([unversioned.status, unversioned.forwarded.length], 'production mode is live: the unversioned path redirects and forwards nothing').toEqual([307, 0]);\n    const r = await send(gateway!.url, '/api/v1/credentials/cred-ks1215', { 'x-api-key': REFUSED_KEY, authorization: userJwt('ks1215-revoked') });\n    expect([r.status, r.forwarded.map((h) => h.userId), r.forwarded.map((h) => h.bearer)]).toEqual([200, ['connector:ks1215-refused'], ['none']]);\n  });\n});\n\ndescribe('KS-1215 real app, NODE_ENV=test — register-connector forwards no caller Bearer upstream', () => {\n  let gateway: { server: http.Server; url: string } | undefined;\n  beforeAll(async () => {\n    vi.stubEnv('NODE_ENV', 'test');\n    gateway = await bootApp(upstreamUrl);\n  }, 60000);\n  afterAll(async () => { await closeServer(gateway?.server); });\n  const PATH = '/api/platform/organizations/register-connector';\n\n  it('🔴 register-connector: a valid key + a REVOKED session\\'s JWT sends no caller Bearer to /api/tenants, /api/keys or /api/audit, whether the exchange succeeds or is refused', async () => {\n    RAN.add('register revoked');\n    const ok = await post(gateway!.url, PATH, { 'x-api-key': OK_KEY, authorization: userJwt('ks1215-revoked') }, registerBody());\n    const refused = await post(gateway!.url, PATH, { 'x-api-key': REFUSED_KEY, authorization: userJwt('ks1215-revoked') }, registerBody());\n    // Compared as JSON so a red prints every forwarded Bearer (vitest truncates nested objects).\n    expect(JSON.stringify([ok.status, registerBearers(ok), refused.status, registerBearers(refused)]))\n      .toBe(JSON.stringify([201, allThree('connector-jwt'), 201, allThree('none')]));\n  });\n\n  it('🔴 register-connector: a valid key + a LIVE user\\'s JWT sends the connector JWT, not the user\\'s Bearer, to all three upstream calls', async () => {\n    RAN.add('register live');\n    const r = await post(gateway!.url, PATH, { 'x-api-key': OK_KEY, authorization: userJwt('ks1215-live') }, registerBody());\n    expect(JSON.stringify([r.status, registerBearers(r)])).toBe(JSON.stringify([201, allThree('connector-jwt')]));\n  });\n\n  it('RED register-connector: a valid key + a LIVE user\\'s JWT, exchange REFUSED, sends no caller Bearer to /api/tenants, /api/keys or /api/audit', async () => {\n    RAN.add('register live refused');\n    const liveRefused = await post(gateway!.url, PATH, { 'x-api-key': REFUSED_KEY, authorization: userJwt('ks1215-live') }, registerBody());\n    expect(JSON.stringify([liveRefused.status, registerBearers(liveRefused)])).toBe(JSON.stringify([201, allThree('none')]));\n  });\n  it('RED KS-1238 (iii): a connector key carrying organizations:register is refused 403 on POST /api/platform/tenants, and neither tenant-provisioning nor refresh-tenants is called', async () => {\n    RAN.add('KS-1238 (iii) tenants refuses a connector');\n    const r = await post(gateway!.url, '/api/platform/tenants', { 'x-api-key': OK_KEY }, { name: 'KS1238 Tenant', slug: 'ks1238-tenant' });\n    expect([r.status, r.code, r.forwarded.map((h) => h.url)]).toEqual([403, 'FORBIDDEN', []]);\n  });\n  it('RED KS-1238 (iii):