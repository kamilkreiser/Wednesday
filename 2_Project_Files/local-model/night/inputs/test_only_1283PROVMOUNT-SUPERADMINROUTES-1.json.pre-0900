ingify([201, allThree('user:ks1215-live')]));\n  });\n\n  it('control, register-connector: a key alone is unchanged, and all three upstream calls carry the connector JWT', async () => {\n    RAN.add('register key-only control');\n    const r = await post(gateway!.url, PATH, { 'x-api-key': OK_KEY }, registerBody());\n    expect(JSON.stringify([r.status, registerBearers(r)])).toBe(JSON.stringify([201, allThree('connector-jwt')]));\n  });\n});\n\ndescribe('KS-1215 STRUCTURAL — the caller Bearer is gone before the exchange is awaited', () => {\n  const CALLER = 'Bearer ks1215.caller.jwt';\n  const KEY = 'sk_ks1215_structural_key_01';\n\n  // structural: no runtime path makes this helper reject today; guards a future helper change.\n  async function callWithRejectingHelper(required: boolean) {\n    const auth = await import('../middleware/auth');\n    auth.apiKeyCache.set(KEY, {\n      result: { connectorId: 'ks1215-structural', scopes: ['documents:read'], organizationId: 'org-ks1215', tenantId: TENANT, tenantSlug: '', rateLimit: 1000, rateLimitWindow: 60 },\n      expiresAt: Date.now() + 60_000,\n    });\n    const planted = new Error('ks1215 structural: the connector-token helper rejected');\n    const cache = auth.connectorBearerCache;\n    const realGet = cache.get;\n    // getConnectorBearer reads this cache before its try block, so a throw here makes the helper itself reject.\n    Object.defineProperty(cache, 'get', {\n      configurable: true, writable: true,\n      value: function (this: typeof cache, k: string) { if (k === KEY) throw planted; return realGet.call(this, k); },\n    });\n    try {\n      const req = { headers: { 'x-api-key': KEY, authorization: CALLER }, get(name: string) { return (this as any).headers[name?.toLowerCase()]; } } as unknown as Request;\n      const res = { status() { return res; }, json() { return res; } } as unknown as Response;\n      const next = vi.fn();\n      let rejected: unknown = null;\n      try { await auth.authenticateToken(required)(req, res, next); } catch (err) { rejected = err; }\n      return { planted, rejected, authorization: req.headers.authorization };\n    } finally {\n      delete (cache as unknown as Record<string, unknown>).get;\n      auth.apiKeyCache.delete(KEY);\n    }\n  }\n\n  for (const required of [false, true]) {\n    it(`🔴 STRUCTURAL (no runtime path makes this helper reject today; guards a future helper change): authenticateToken(${required}), the caller's Bearer is already gone when the helper rejects`, async () => {\n      RAN.add(`structural required=${required}`);\n      const r = await callWithRejectingHelper(required);\n      expect(r.rejected, 'the planted rejection reached the middleware (else this cell proves nothing)').toBe(r.planted);\n      expect(r.authorization).toBeUndefined();\n    });\n  }\n});\n\ndescribe('KS-1215 COMPLETENESS', () => {\n  it('every graded cell above actually ran', () => {\n    const expected = [\n      ...MOUNTS.flatMap(([m]) => [`${m} N-1`, `${m} split`, `${m} unreachable`, `${m} control key alone`, `${m} control key + live`, `${m} control live alone`]),\n      'production N-1', 'structural required=false', 'structural required=true',\n      'platform POST /api/platform/tenant-key refuses a connector',\n      'platform DELETE /api/platform/tenant-key/:tenantId refuses a connector',\n      'platform GET /api/platform/tenant-key/:tenantId/status refuses a connector',\n      'platform GET /api/platform/templates/document-types refuses a connector',\n      'platform GET /api/platform/templates/workflows refuses a connector',\n      'platform POST /api/platform/templates/clone-to-tenant refuses a connector',\n      'register live refused',\n      'register revoked', 'register live', 'register admin control', 'register key-only control',\n      'platform GET /api/platform/tenants/:id refuses a connector',\n      'platform PATCH /api/platform/tenants/:id refuses a connector',\n      'platform PATCH /api/platform/tenants/:id/status refuses a connector',\n      'platform DELETE /api/platform/tenants/:id refuses a connector',\n      'platform GET /api/platform/audit-log refuses a connector',\n      'platform tenants GET refuses a tenant ADMIN',\n      'platform tenants GET refuses a connector',\n      'KS-1238 (i) bearer scheme case',\n      'KS-1238 (iii) tenants refuses a connector',\n      'admin create shadow', 'admin patch shadow',\n      'KS-1238 (iii) super-admin tenants',\n    ];\n    expect([...RAN].sort()).toEqual(expected.sort());\n  });\n});\n"
