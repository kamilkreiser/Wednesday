  "      outcomes.push([method + ' ' + path, r.status, code, hits.slice(n).map((h) => h.url)]);",
  "    }",
  "    expect(outcomes).toEqual(pairs.map(([method, path]) => [method + ' ' + path, 403, 'FORBIDDEN', []]));",
  "  });"
 ],
