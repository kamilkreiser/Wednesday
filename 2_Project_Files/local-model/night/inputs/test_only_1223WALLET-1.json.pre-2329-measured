  "Blockchain/Dev/services/api-gateway/src/__tests__/ks1041-vouch-header-strip.test.ts": "/**\n * =============================================================================\n * KS-1041 Step 2 — the vouch header must not survive the edge\n * =============================================================================\n * originate honours identity/tenant/role headers only on a request carrying a\n * valid `x-gateway-vouch`. That is worth something only if a client cannot\n * send the vouch itself: if it could, the vouch would be forgeable by exactly\n * the callers it exists to exclude, and the fix would be the same hole under a\n * new name.\n *\n * This suite pins the third red-proof arm. The other two live in\n * `services/originate/src/__tests__/ks1041-gateway-provenance.test.ts` (a\n * forged header on an unvouched request is refused; a genuine vouched request\n * still works).\n *\n * It imports the REAL pattern from utils/trustHeaders.ts — the same module\n * index.ts mounts — rather than re-declaring the regex. A test that copies the\n * pattern proves only that the copy behaves.\n * =============================================================================\n */\n\nimport { describe, it, expect } from 'vitest';\nimport {\n  TRUST_HEADER_PATTERN,\n  TRUST_HEADER_ALLOW_LIST,\n  isStrippedTrustHeader,\n  stripTrustHeaders,\n} from '../utils/trustHeaders';\n\ndescribe('KS-1041 Step 2 — x-gateway-vouch is stripped at the edge', () => {\n  it('strips a client-supplied x-gateway-vouch', () => {\n    // THE test. Without it the provenance middleware in originate is theatre.\n    expect(isStrippedTrustHeader('x-gateway-vouch')).toBe(true);\n  });\n\n  it.each(['X-Gateway-Vouch', 'X-GATEWAY-VOUCH', 'x-Gateway-vouch'])(\n    'strips it case-insensitively: %s',\n    (header) => {\n      // Node lower-cases incoming header names, but the pattern is applied to\n      // whatever Object.keys yields and must not depend on that.\n      expect(isStrippedTrustHeader(header)).toBe(true);\n    },\n  );\n\n  it('removes it from a header bag alongside the rest of the trust family', () => {\n    const headers: Record<string, unknown> = {\n      'x-gateway-vouch': 'stolen-or-guessed',\n      'x-user-role': 'connector',\n      'x-tenant-id': 'tenant-a',\n      'x-organization-id': 'org-a',\n      'x-emitter-internal': 'originate-create',\n      authorization: 'Bearer real-token',\n      'content-type': 'application/json',\n      'x-request-id': 'req-1',\n    };\n    stripTrustHeaders(headers);\n\n    expect(headers['x-gateway-vouch']).toBeUndefined();\n    expect(headers['x-user-role']).toBeUndefined();\n    expect(headers['x-tenant-id']).toBeUndefined();\n    expect(headers['x-organization-id']).toBeUndefined();\n    expect(headers['x-emitter-internal']).toBeUndefined();\n\n    // CONTROL — a blanket wipe would satisfy every assertion above while\n    // breaking the gateway. These must survive.\n    expect(headers.authorization).toBe('Bearer real-token');\n    expect(headers['content-type']).toBe('application/json');\n    expect(headers['x-request-id']).toBe('req-1');\n  });\n\n  it('keeps the x-tenant-override carve-out intact — the KS-4 regression', () => {\n    // The 2026-04-25 blanket strip matched this too and broke the admin\n    // portal's tenant selector silently for two weeks. Widening the pattern\n    // for the vouch must not re-break it.\n    expect(TRUST_HEADER_ALLOW_LIST.has('x-tenant-override')).toBe(true);\n    expect(isStrippedTrustHeader('x-tenant-override')).toBe(false);\n  });\n\n  it('CONTROL — the pattern does not match unrelated x- headers', () => {\n    // Proves the widening was targeted. `gateway-vouch` was added as a whole\n    // token deliberately: a bare `gateway` alternative would have swallowed\n    // every future x-gateway-* header.\n    for (const header of [\n      'x-gateway-timeout',\n      'x-gateway-version',\n      'x-request-id',\n      'x-forwarded-for',\n      'x-api-version',\n      'x-correlation-id',\n    ]) {\n      expect(isStrippedTrustHeader(header)).toBe(false);\n    }\n  });\n\n  it('CONTROL — the pattern still matches what it matched before this change', () => {\n    // A regression here would mean the widening broke the original strip,\n    // which is the thing standing between a client and a spoofed identity.\n    for (const header of [\n      'x-user-id',\n      'x-user-role',\n      'x-tenant-id',\n      'x-organization-id',\n      'x-org-id',\n      'x-role',\n      'x-roles',\n      'x-auth-user',\n      'x-policy-result',\n      'x-emitter-internal',\n    ]) {\n      expect(TRUST_HEADER_PATTERN.test(header)).toBe(true);\n    }\n  });\n});\n"
