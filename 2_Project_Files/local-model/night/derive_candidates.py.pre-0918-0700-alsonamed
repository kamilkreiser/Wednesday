}
AUTH = re.compile(r"\b(auth|mfa|oauth|login|session|jwt|password|csrf|rbac|permission|lockout|token)\b", re.I)
PATH = re.compile(r"(?:Blockchain/Dev/)?((?:services/[a-z0-9\-]+|packages/shared)/src/[\w./\-]+\.ts|systemTest/(?:performance|akto|playwright|fixtures)/[\w./\-]+\.ts)(?::(\d+))?")
# 2026-09-16 06:5x BASH TIER (Kam 18:19 "extend the checker"; tasks/bash_patch/ opened 00:4x): a description that names a
# shell script — Blockchain/Dev/scripts/*.sh, Start_Up/*.sh, systemTest/{scripts,schemathesis,...}/*.sh, a .githooks/ hook —
# is a bash_patch candidate; before this the predicate called them "names no product file" (KS-865/884/958/972/1089/1127 were
# all briefed by hand from the excluded list). Tests (__tests__/, *.test.sh) are never products.
SHPATH = re.compile(r"(?:Blockchain/Dev/)?((?:scripts|Start_Up|systemTest/[\w\-]+|\.githooks)/[\w./\-]+(?:\.sh)?)(?::(\d+))?")
FIX = re.compile(r"^##+\s*(fix[- ]shape|recommendation|fix:|acceptance|the fix|what needs doing)", re.I | re.M)

def q(query, variables=None):
    req = urllib.request.Request("https://api.linear.app/graphql", data=json.dumps({"query": query, "variables": variables or {}}).encode(),
                                 headers={"Authorization": KEY, "Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=60))

nodes, cursor = [], None
while True:
    r = q("""query($c:String){ issues(first:100, after:$c, filter:{ team:{key:{eq:"KS"}}, state:{type:{in:["backlog","unstarted"]}} }){
          pageInfo{hasNextPage endCursor} nodes{ identifier title priority updatedAt state{name} assignee{email} description attachments{nodes{url}} } } }""", {"c": cursor})
    d = r["data"]["issues"]; nodes += d["nodes"]
    if not d["pageInfo"]["hasNextPage"]: break
    cursor = d["pageInfo"]["endCursor"]

ready = sorted({re.match(r"READY_(KS-\d+)", os.path.basename(f)).group(1) for f in glob.glob(os.path.join(HERE, "READY_*")) if re.match(r"READY_(KS-\d+)", os.path.basename(f))})
done_pass = set()
try:
    for l in open(os.path.join(HERE, "done.md"), encoding="utf-8"):
        m = re.match(r"(KS-\d+) .*verdict RESULT: PASS", l)
        if m: done_pass.add(m.group(1))
except FileNotFoundError: pass

import subprocess, functools
SRC_CHECKOUT = os.environ.get("NIGHT_SOURCE_CHECKOUT", "/Volumes/DevMASTER/!CODING/Secuura/Blockchain/2_Project_Files")
BASENAME = re.compile(r"`?([A-Za-z][\w.\-]*\.ts)`?(?::\d+)?")
DOCFILE = re.compile(r"(?:Blockchain/Dev/)?((?:docs/[\w./\-]+\.md|CONTRIBUTING\.md|DEV-PROCESS\.md|VOCABULARY\.md|CLAUDE\.md|README\.md))")
ROUTE = re.compile(r"\b(?:GET|POST|PUT|PATCH|DELETE)\s+(/api/[\w/\-{}:.]+)")
def _git(*args):
    r = subprocess.run(["git", "-C", SRC_CHECKOUT, *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""
@functools.lru_cache(maxsize=1)
def tip_tree():
    tip = (_git("ls-remote", "origin", "refs/heads/develop").split() or [""])[0]
    if not tip or not _git("cat-file", "-t", tip).strip(): return "", []
    return tip, [l for l in _git("ls-tree", "-r", "--name-only", tip).split("\n") if l.startswith("Blockchain/Dev/")]
def _is_product(p):
    return p.endswith(".ts") and "__tests__" not in p and not p.endswith(".test.ts") and "/tests/" not in p and "/node_modules/" not in p
def resolve_files(desc):
    """Return (files, how) — files repo-relative under Blockchain/Dev/, READ verbs only on the source checkout."""
    tip, tree = tip_tree()
    if not tip: return [], ""
    # (a) docs: a docs/*.md or a named root doc → T4
    docs = []
    for m in DOCFILE.finditer(desc):
        cands = [t for t in tree if t.endswith("/" + m.group(1)) or t == "Blockchain/Dev/" + m.group(1)]
        for c in cands[:1]:
            rel = c[len("Blockchain/Dev/"):]
            if rel not in docs: docs.append(rel)
    if docs: return docs, "docs"
    # (b) a *.ts basename that resolves to exactly ONE product file at the tip
    found = []
    for m in BASENAME.finditer(desc):
        b = m.group(1)
        if b.endswith(".test.ts") or b.endswith(".d.ts") or b in ("index.ts",): continue
        cands = sorted({t for t in tree if t.endswith("/" + b) and _is_product(t)})
        if len(cands) == 1:
            rel = cands[0][len("Blockchain/Dev/"):]
            if rel not in found: found.append(rel)
    if found: return found, "basename"
    # (c) a route literal, grepped at the tip (read verb); keep files that carry it as a string literal
    for m in ROUTE.finditer(desc):
        route = m.group(1).rstrip(".,;:)")
        out = _git("grep", "-l", "--fixed-strings", "-e", f"'{route}'", tip, "--", "Blockchain/Dev/services", "Blockchain/Dev/packages")
        for line in out.split("\n"):
            p = line.split(":", 1)[-1].strip() if ":" in line else ""
            if p and _is_product(p) and "openapi" not in p:
                rel = p[len("Blockchain/Dev/"):]
                if rel not in found: found.append(rel)
        if found: return found, "route"
    return [], ""

tiers = {"T1 services (vitest, one file)": [], "T2 tooling (systemTest/*, one file)": [], "T2b bash (bash_patch — one script + a *.test.sh beside the reference)": [], "T3 jest services (originate, governance)": [], "T4 docs (doc_patch)": [], "T5 multi-file / later": []}
excluded, held, aside = [], [], []
for n in nodes:
    ident, title, desc = n["identifier"], n["title"], n["description"] or ""
    if ident in ready or ident in done_pass: held.append((ident, title[:80])); continue
    if ident in SET_ASIDE: aside.append((ident, SET_ASIDE[ident], n["updatedAt"][:10])); continue
    if any(x in (n["assignee"] or {}).get("email", "") for x in ("peter", "stuart")): excluded.append((ident, "on Peter/Stuart")); continue
    if any("/pull/" in (a["url"] or "") for a in n["attachments"]["nodes"]): excluded.append((ident, "has a PR attached")); continue
    if AUTH.search(title): excluded.append((ident, "auth-shaped title (LAST, Kam 16:40)")); continue
    files = []
    for m in PATH.finditer(desc):
        p = m.group(1)
        if "__tests__" in p or p.endswith(".test.ts") or "/tests/" in p: continue
        if p not in files: files.append(p)
    for m in SHPATH.finditer(desc):
        p = m.group(1)
        if not (p.endswith(".sh") or "/.githooks/" in p or p.startswith(".githooks/")): continue
        if "__tests__" in p or p.endswith(".test.sh") or "/tests/" in p: continue
        if p not in files: files.append(p)
    resolved_by = ""
    if not files:
        # 2026-09-15 22:5x RESOLVER (IMPROVEMENTS row 90): the bare predicate hid 152 tickets as "names no product file"
        # — KS-1097 (docs) and KS-794 (a route + a schema name) among them, both done by hand that night. A description
        # that names a *.ts BASENAME, a docs file, or a ROUTE is resolved to files at the tip with READ verbs only.
        files, resolved_by = resolve_files(desc)
    if not files: excluded.append((ident, "names no product file (after basename/docs/route resolution)")); continue
    if resolved_by == "docs": tiers["T4 docs (doc_patch)"].append((ident, n["priority"], "[resolved:docs, a HINT — the ticket MENTIONS the file] " + title[:80], files[:3])); continue
    if resolved_by: title = f"[resolved:{resolved_by}, a HINT — read the file] " + title  # prefix, so the 80-char cut keeps it
    if len(files) > 1: tiers["T5 multi-file / later"].append((ident, n["priority"], title[:80], files[:3])); continue
    f = files[0]
    if f.endswith(".sh") or ".githooks/" in f: tiers["T2b bash (bash_patch — one script + a *.test.sh beside the reference)"].append((ident, n["priority"], title[:80], [f]))
    elif f.startswith("systemTest/"): tiers["T2 tooling (systemTest/*, one file)"].append((ident, n["priority"], title[:80], [f]))
    elif f.startswith("services/originate/") or f.startswith("services/governance/"): tiers["T3 jest services (originate, governance)"].append((ident, n["priority"], title[:80], [f]))
    else: tiers["T1 services (vitest, one file)"].append((ident, n["priority"], title[:80], [f]))

now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
with open(OUT, "w", encoding="utf-8") as o:
    o.write(f"# Ornith candidates — derived {now} from {len(nodes)} KS Backlog/Todo tickets (read-only, unpaginated)\n\n")
    o.write("A CENSUS for the coordinator to brief from, easy → hard (Kam 2026-09-15 16:40 / 18:19). A ticket here is a candidate, not a task: read it, read the file at the tip, write `night/briefs/<id>.md`, then queue it. Auth-shaped titles are excluded (LAST); Peter/Stuart tickets and PR-attached tickets are excluded outright.\n\n")
    for t, rows in tiers.items():
        rows.sort(key=lambda r: (r[1] or 9, r[0]))
        o.write(f"## {t} — {len(rows)}\n")
        for r in rows: o.write(f"- {r[0]} (P{r[1]}) {r[2]} — `{'`, `'.join(r[3])}`\n")
        o.write("\n")
    o.write(f"## HELD (READY_* or done.md PASS) — {len(held)}\n" + "".join(f"- {i} {t}\n" for i, t in sorted(held)) + "\n")
    o.write(f"## SET ASIDE with a recorded reason — {len(aside)} (re-read only if the ticket's updatedAt moved)\n" + "".join(f"- {i} — {r} (updated {u})\n" for i, r, u in sorted(aside)) + "\n")
    o.write(f"## EXCLUDED by predicate — {len(excluded)}\n" + "".join(f"- {i} — {r}\n" for i, r in sorted(excluded)) + "\n")
print(f"wrote {OUT}: " + " · ".join(f"{t.split(' ')[0]} {len(r)}" for t, r in tiers.items()) + f" · held {len(held)} · set-aside {len(aside)} · excluded {len(excluded)} (total {len(nodes)})")
