+    expect(h.unhandled).toBe(0);
+    expect(LINES('warn', 'publishEvent ISSUER_CERT_EXPIRED failed')).toHaveLength(1);
+    expect(reasonOf(LINES('warn', 'publishEvent ISSUER_CERT_EXPIRED failed')[0])).toBe(SHAPES[3][2]);
+    expect((LINES('warn', 'publishEvent ISSUER_CERT_EXPIRED failed')[0]?.[2] as { certId?: string } | undefined)?.certId).toBe('cert-exp');
+  });
+});
