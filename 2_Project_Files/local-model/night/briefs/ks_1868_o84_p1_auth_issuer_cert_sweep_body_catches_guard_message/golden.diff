diff --git a/Blockchain/Dev/services/auth/src/__tests__/ks1868-issuer-cert-sweep-body-catches-unreadable-throw.test.ts b/Blockchain/Dev/services/auth/src/__tests__/ks1868-issuer-cert-sweep-body-catches-unreadable-throw.test.ts
