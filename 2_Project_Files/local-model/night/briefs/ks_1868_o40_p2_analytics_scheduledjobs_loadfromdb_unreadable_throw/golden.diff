diff --git a/Blockchain/Dev/services/analytics/src/__tests__/ks1868-scheduled-jobs-load-unreadable-throw.test.ts b/Blockchain/Dev/services/analytics/src/__tests__/ks1868-scheduled-jobs-load-unreadable-throw.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/analytics/src/__tests__/ks1868-scheduled-jobs-load-unreadable-throw.test.ts
@@ -0,0 +1,60 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+// KS-1868: loadScheduledJobsFromDb must still log its WARN when the thrown value
+// itself cannot be read (a revoked Proxy throws on `instanceof`; an Error whose
+// `message` getter throws, throws on `.message`).
+// The db stand-in is a plain function, not a vi.fn(): a spy inspects what it
+// rejects with and could itself fail on a revoked Proxy before the code under test saw it.
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  warn: vi.fn(),
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => true,
+  query: () => Promise.reject(h.toThrow),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: { info: vi.fn(), warn: h.warn, error: vi.fn(), debug: vi.fn() },
+}));
+
+import { loadScheduledJobsFromDb } from '../services/scheduledJobs';
+
+const WARNS = () => h.warn.mock.calls.filter((c) => String(c[0]).includes('loadScheduledJobsFromDb failed'));
+
+describe('KS-1868 loadScheduledJobsFromDb reads the thrown value safely', () => {
+  beforeEach(() => {
+    h.toThrow = undefined;
+    h.warn.mockReset();
+  });
+
+  it('control ks1868 C1 an ordinary Error still logs its message', async () => {
+    h.toThrow = new Error('db down');
+    await loadScheduledJobsFromDb();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'db down' });
+  });
+
+  it('RED ks1868 R1 a revoked Proxy thrown value logs a constant reason', async () => {
+    const { proxy, revoke } = Proxy.revocable({}, {});
+    revoke();
+    h.toThrow = proxy;
+    await loadScheduledJobsFromDb().catch(() => undefined);
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1868 R2 an Error whose message getter throws logs a constant reason', async () => {
+    h.toThrow = Object.create(Error.prototype, {
+      message: {
+        get() {
+          throw new Error('getter boom');
+        },
+      },
+    });
+    await loadScheduledJobsFromDb().catch(() => undefined);
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+});
