diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-organization-message-coercion-unreadable-throw.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-organization-message-coercion-unreadable-throw.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-organization-message-coercion-unreadable-throw.test.ts
@@ -0,0 +1,171 @@
+/**
+ * KS-1868 (QA gate 110, G110-F1): the three organization catches in routes/admin.ts (POST create, PUT update, DELETE delete) read the
+ * thrown value's `message` inside a guard (`reason = (err as Error).message`) but never coerce it. When the `message` getter SUCCEEDS and
+ * returns a hostile NON-string (a revoked Proxy, an object whose `toString` throws, a null-prototype object), the hostile value is passed
+ * on to the logger, and the real winston formatter throws while formatting it, so the request is never answered. The read is now wrapped in
+ * `String(...)` inside the same guard, so such a message falls to the constant `unreadable thrown value`.
+ *
+ * The handler under test is the LAST function of the route, taken from the route table and called directly with a fake request and
+ * response. The database stand-in is a plain function that rejects with the thrown value (a vi.fn() could inspect a revoked Proxy before
+ * the code under test does). The logger stand-in records what it is given; strings are compared, never a hostile value itself.
+ */
+import { describe, it, expect, beforeEach } from 'vitest';
+import type { Router } from 'express';
+import { createAdminRoutes, type AdminRouteDeps } from '../routes/admin';
+
+type Logged = { level: string; message: string; meta: { error?: unknown } | undefined };
+type ResOrg = { statusCode: number; body: unknown; status(c: number): ResOrg; json(b: unknown): ResOrg };
+
+const ks = {
+  thrown: undefined as { value: unknown } | undefined,
+  logs: [] as Logged[],
+  queries: [] as Array<{ text: string; params: unknown[] | undefined }>,
+};
+
+function mkRes(): ResOrg {
+  const r: ResOrg = {
+    statusCode: 200,
+    body: undefined,
+    status(c) {
+      r.statusCode = c;
+      return r;
+    },
+    json(b) {
+      r.body = b;
+      return r;
+    },
+  };
+  return r;
+}
+
+function buildRouter(): Router {
+  return createAdminRoutes({
+    authenticateToken: () => (_req: unknown, _res: unknown, next: () => void) => next(),
+    query: (text: string, params?: unknown[]) => {
+      ks.queries.push({ text, params });
+      if (ks.thrown) return Promise.reject(ks.thrown.value);
+      return Promise.resolve({ rows: [{ id: 'o-1' }], rowCount: 1 });
+    },
+    isDbAvailable: () => true,
+    redisService: {},
+    services: {},
+    log: (level: string, message: string, meta?: { error?: unknown }) => {
+      ks.logs.push({ level, message, meta });
+    },
+  } as unknown as AdminRouteDeps);
+}
+
+function handlerFor(rt: Router, method: string, path: string): (req: unknown, res: unknown) => Promise<void> {
+  const layers = (rt as unknown as { stack: Array<{ route?: { path: string; methods: Record<string, boolean>; stack: Array<{ handle: (req: unknown, res: unknown) => Promise<void> }> } }> }).stack;
+  const layer = layers.find((l) => l.route && l.route.path === path && l.route.methods[method]);
+  if (!layer || !layer.route) throw new Error('route not found: ' + method + ' ' + path);
+  const stack = layer.route.stack;
+  return stack[stack.length - 1].handle;
+}
+
+const OID = 'd5800000-0000-4000-8000-000000000002';
+
+/** Run a route handler. A handler that rejects (the defect) leaves the response untouched at 200. */
+async function invoke(method: string, path: string): Promise<ResOrg> {
+  const res = mkRes();
+  const req = {
+    params: { id: OID },
+    body: { name: 'Acme Org', type: 'Organization', status: 'active' },
+    query: {},
+    headers: {},
+    user: { userId: 'admin-72', role: 'SYSTEM_ADMIN', email: 'admin-72@test.io', verificationLevel: 'HIGH' },
+  };
+  await handlerFor(buildRouter(), method, path)(req, res).catch(() => undefined);
+  return res;
+}
+
+function revoked(): unknown {
+  const { proxy, revoke } = Proxy.revocable({}, {});
+  revoke();
+  return proxy;
+}
+
+// An Error whose `message` getter succeeds but returns the given value.
+function withMessage(value: () => unknown): unknown {
+  return Object.create(Error.prototype, {
+    message: {
+      get() {
+        return value();
+      },
+    },
+  });
+}
+
+const plain = (v: unknown): unknown => (typeof v === 'string' ? v : '<non-string>');
+
+type CaseOrg = { name: string; method: string; path: string; failed: string; answer: string };
+
+const CASES: CaseOrg[] = [
+  { name: 'POST create', method: 'post', path: '/api/users/admin/organizations', failed: '[Orgs] Create failed', answer: 'Failed to create organization' },
+  { name: 'PUT update', method: 'put', path: '/api/users/admin/organizations/:id', failed: '[Orgs] Update failed', answer: 'Failed to update organization' },
+  { name: 'DELETE delete', method: 'delete', path: '/api/users/admin/organizations/:id', failed: '[Orgs] Delete failed', answer: 'Failed to delete organization' },
+];
+
+const expected500 = (c: CaseOrg) => ({ success: false, error: { code: 'INTERNAL_ERROR', message: c.answer } });
+const loggedReason = (c: CaseOrg): unknown => {
+  const l = ks.logs.find((x) => x.level === 'error' && x.message === c.failed);
+  return l ? plain(l.meta?.error) : '<no log line>';
+};
+
+beforeEach(() => {
+  ks.thrown = undefined;
+  ks.logs.length = 0;
+  ks.queries.length = 0;
+});
+
+describe.each(CASES)('KS-1868 organization admin $name coerces a non-string message safely', (c) => {
+  it(`RED ks1868 R1 ${c.name}: a message that is a revoked Proxy is logged as a constant reason and the route still answers its constant 500`, async () => {
+    ks.thrown = { value: withMessage(revoked) };
+    const res = await invoke(c.method, c.path);
+    expect(res.statusCode).toBe(500);
+    expect(res.body).toEqual(expected500(c));
+    expect(loggedReason(c)).toBe('unreadable thrown value');
+  });
+
+  it(`RED ks1868 R2 ${c.name}: a message whose toString throws is logged as a constant reason and the route still answers its constant 500`, async () => {
+    ks.thrown = { value: withMessage(() => ({ toString() { throw new Error('toString boom'); } })) };
+    const res = await invoke(c.method, c.path);
+    expect(res.statusCode).toBe(500);
+    expect(res.body).toEqual(expected500(c));
+    expect(loggedReason(c)).toBe('unreadable thrown value');
+  });
+
+  it(`RED ks1868 R3 ${c.name}: a null-prototype message is logged as a constant reason and the route still answers its constant 500`, async () => {
+    ks.thrown = { value: withMessage(() => Object.create(null)) };
+    const res = await invoke(c.method, c.path);
+    expect(res.statusCode).toBe(500);
+    expect(res.body).toEqual(expected500(c));
+    expect(loggedReason(c)).toBe('unreadable thrown value');
+  });
+
+  it(`control ks1868 C1 ${c.name}: an ordinary Error logs its message and the answer is the constant 500 without it`, async () => {
+    ks.thrown = { value: new Error('db boom 10.0.0.7') };
+    const res = await invoke(c.method, c.path);
+    expect(res.statusCode).toBe(500);
+    expect(res.body).toEqual(expected500(c));
+    expect(JSON.stringify(res.body)).not.toContain('db boom');
+    expect(loggedReason(c)).toBe('db boom 10.0.0.7');
+  });
+});
+
+describe('KS-1868 organization admin routes: a successful call is unchanged', () => {
+  it('control ks1868 C2 DELETE delete: a successful delete answers 200 and logs no error', async () => {
+    const res = await invoke('delete', '/api/users/admin/organizations/:id');
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toEqual({ success: true });
+    expect(ks.queries.length).toBe(1);
+    expect(ks.logs.filter((l) => l.level === 'error')).toEqual([]);
+  });
+
+  it('control ks1868 C3 POST create: a successful create answers 201 and logs no error', async () => {
+    const res = await invoke('post', '/api/users/admin/organizations');
+    expect(res.statusCode).toBe(201);
+    expect(ks.queries.length).toBe(1);
+    expect(ks.logs.filter((l) => l.level === 'error')).toEqual([]);
+  });
+});
