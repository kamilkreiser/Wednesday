diff --git a/Blockchain/Dev/services/auth/src/__tests__/ks805-oauth-app-update-refuses-empty-redirect-uris.test.ts b/Blockchain/Dev/services/auth/src/__tests__/ks805-oauth-app-update-refuses-empty-redirect-uris.test.ts
