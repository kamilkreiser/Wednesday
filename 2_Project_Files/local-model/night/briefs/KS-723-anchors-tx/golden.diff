+// KS-723 (slice 3, the Platform-S hot path): GET /api/anchors/tx/{txHash} (index.ts) was routed but undeclared.
+// It answers { success: true, data: <one anchor> } - the formatAnchorResponse rows /document/{documentId} lists.
+sharedRegistry.registerPath({
+  method: 'get',
+  path: '/api/anchors/tx/{txHash}',
+  tags: ['Anchoring'],
+  summary: 'Get the anchor recorded for a transaction hash',
+  description:
+    'Returns the single anchor record whose transaction hash matches. Platform S polls this for ' +
+    'every in-flight anchor. Readable by any authenticated user, like the by-document lookup.',
+  security: [{ bearerAuth: [] }],
+  request: {
+    params: z.object({
+      txHash: z.string().openapi({ description: 'Cardano transaction hash', example: FX.anchor.txHash }),
+    }),
+  },
+  responses: {
+    400: commonErrorResponses[400],
+    200: {
+      description: 'The anchor recorded for the transaction hash',
+      content: {
+        'application/json': {
+          schema: z.object({
+            success: z.boolean(),
+            data: AnchorSchema,
+          }),
+        },
+      },
+    },
+    401: commonErrorResponses[401],
+    404: { ...commonErrorResponses[404], description: 'No anchor found for the given transaction hash' },
+    403: commonErrorResponses[403],
+    429: commonErrorResponses[429],
+    500: commonErrorResponses[500],
+    502: commonErrorResponses[502],
+    503: commonErrorResponses[503],
+  },
+});
+
