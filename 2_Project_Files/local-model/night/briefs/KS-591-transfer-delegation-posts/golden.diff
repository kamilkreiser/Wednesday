diff --git a/Blockchain/Dev/services/transfer/src/__tests__/ks591-transfer-delegation-posts-body-required.test.ts b/Blockchain/Dev/services/transfer/src/__tests__/ks591-transfer-delegation-posts-body-required.test.ts
