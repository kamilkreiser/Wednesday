diff --git a/Blockchain/Dev/frontend/issuer/src/__tests__/ks1391-issuer-declares-a-test-script.test.ts b/Blockchain/Dev/frontend/issuer/src/__tests__/ks1391-issuer-declares-a-test-script.test.ts
