diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-identity-seed-message-coercion-unreadable-throw.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-identity-seed-message-coercion-unreadable-throw.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1868-admin-identity-seed-message-coercion-unreadable-throw.test.ts
@@ -0,0 +1,148 @@
+/**
+ * KS-1868 (QA gate 110, G110-F1): the demo-seed catch in routes/admin.ts (`seedIdentityOrgsIfEmpty`, run at the start of
+ * GET /api/admin/identity/users) reads the thrown value's `message` inside a guard (`reason = (err as Error).message`) and then logs
+ * `'[Identity] Seed skipped: ' + reason`. When the `message` getter SUCCEEDS and returns a hostile NON-string (a revoked Proxy, an object
+ * whose `toString` throws, a null-prototype object, a Symbol), the `+` throws INSIDE the catch, outside the guard, and the whole request
+ * fails. The read is now wrapped in `String(...)` inside the same guard, so the seed is skipped and the request carries on, as it does for
+ * an ordinary Error.
+ *
+ * The handler under test is the LAST function of the route, taken from the route table and called directly with a fake request and
+ * response. The database stand-in is a plain function that rejects with the thrown value for the seed's COUNT query only (a vi.fn() could
+ * inspect a revoked Proxy before the code under test does).
+ */
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import type { Router } from 'express';
+import { createAdminRoutes, type AdminRouteDeps } from '../routes/admin';
+
+type Logged = { level: string; message: string; meta: unknown };
+type ResSeed = { statusCode: number; body: unknown; status(c: number): ResSeed; json(b: unknown): ResSeed };
+
+const ks = {
+  thrown: undefined as { value: unknown } | undefined,
+  logs: [] as Logged[],
+  queries: [] as string[],
+};
+
+function mkRes(): ResSeed {
+  const r: ResSeed = {
+    statusCode: 200,
+    body: undefined,
+    status(c) {
+      r.statusCode = c;
+      return r;
+    },
+    json(b) {
+      r.body = b;
+      return r;
+    },
+  };
+  return r;
+}
+
+function buildRouter(): Router {
+  return createAdminRoutes({
+    authenticateToken: () => (_req: unknown, _res: unknown, next: () => void) => next(),
+    query: (text: string) => {
+      ks.queries.push(text);
+      if (text.includes('COUNT(*)')) {
+        if (ks.thrown) return Promise.reject(ks.thrown.value);
+        return Promise.resolve({ rows: [{ cnt: '1' }], rowCount: 1 });
+      }
+      return Promise.resolve({ rows: [], rowCount: 0 });
+    },
+    isDbAvailable: () => true,
+    redisService: {},
+    services: {},
+    log: (level: string, message: string, meta?: unknown) => {
+      ks.logs.push({ level, message, meta });
+    },
+  } as unknown as AdminRouteDeps);
+}
+
+function handlerFor(rt: Router, method: string, path: string): (req: unknown, res: unknown) => Promise<void> {
+  const layers = (rt as unknown as { stack: Array<{ route?: { path: string; methods: Record<string, boolean>; stack: Array<{ handle: (req: unknown, res: unknown) => Promise<void> }> } }> }).stack;
+  const layer = layers.find((l) => l.route && l.route.path === path && l.route.methods[method]);
+  if (!layer || !layer.route) throw new Error('route not found: ' + method + ' ' + path);
+  const stack = layer.route.stack;
+  return stack[stack.length - 1].handle;
+}
+
+/** Run the route handler. A handler that rejects leaves the response untouched at 200 with no body. */
+async function invoke(): Promise<ResSeed> {
+  const res = mkRes();
+  const req = {
+    params: {},
+    body: {},
+    query: {},
+    headers: {},
+    user: { userId: 'admin-72', role: 'SYSTEM_ADMIN', email: 'admin-72@test.io', verificationLevel: 'HIGH' },
+  };
+  await handlerFor(buildRouter(), 'get', '/api/admin/identity/users')(req, res).catch(() => undefined);
+  return res;
+}
+
+function revoked(): unknown {
+  const { proxy, revoke } = Proxy.revocable({}, {});
+  revoke();
+  return proxy;
+}
+
+// An Error whose `message` getter succeeds but returns the given value.
+function withMessage(value: () => unknown): unknown {
+  return Object.create(Error.prototype, {
+    message: {
+      get() {
+        return value();
+      },
+    },
+  });
+}
+
+const seedLog = (): Logged | undefined => ks.logs.find((l) => l.level === 'warn' && l.message.startsWith('[Identity] Seed skipped'));
+const usersQueried = () => ks.queries.some((q) => q.includes('FROM users u'));
+
+const savedSeed = process.env.ENABLE_DEMO_SEED;
+
+beforeEach(() => {
+  ks.thrown = undefined;
+  ks.logs.length = 0;
+  ks.queries.length = 0;
+  process.env.ENABLE_DEMO_SEED = 'true';
+});
+
+afterEach(() => {
+  if (savedSeed === undefined) delete process.env.ENABLE_DEMO_SEED;
+  else process.env.ENABLE_DEMO_SEED = savedSeed;
+});
+
+describe('KS-1868 identity users seed catch coerces a non-string message safely', () => {
+  it('control ks1868 C1 seed: an ordinary Error is logged with its message and the request carries on to a 200', async () => {
+    ks.thrown = { value: new Error('db boom 10.0.0.7') };
+    const res = await invoke();
+    expect(seedLog()?.message).toBe('[Identity] Seed skipped: db boom 10.0.0.7');
+    expect(usersQueried()).toBe(true);
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toEqual({ success: true, users: [] });
+  });
+
+  it('control ks1868 C2 seed: with no seed failure nothing is logged as skipped and the request answers 200', async () => {
+    const res = await invoke();
+    expect(seedLog()).toBeUndefined();
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toEqual({ success: true, users: [] });
+  });
+
+  it.each([
+    ['R1', 'a message that is a revoked Proxy', () => withMessage(revoked), 'unreadable thrown value'],
+    ['R2', 'a message whose toString throws', () => withMessage(() => ({ toString() { throw new Error('toString boom'); } })), 'unreadable thrown value'],
+    ['R3', 'a null-prototype message', () => withMessage(() => Object.create(null)), 'unreadable thrown value'],
+    ['R4', 'a Symbol message', () => withMessage(() => Symbol('ks1868')), 'Symbol(ks1868)'],
+  ] as Array<[string, string, () => unknown, string]>)('RED ks1868 %s seed: %s is logged as its safe text and the request carries on to a 200', async (_id, _what, make, text) => {
+    ks.thrown = { value: make() };
+    const res = await invoke();
+    expect(seedLog()?.message).toBe('[Identity] Seed skipped: ' + text);
+    expect(usersQueried()).toBe(true);
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toEqual({ success: true, users: [] });
+  });
+});
