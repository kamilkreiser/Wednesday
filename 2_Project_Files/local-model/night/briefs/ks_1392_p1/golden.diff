diff --git a/Blockchain/Dev/packages/shared/src/__tests__/ks1392-ci-contracts-job-runs-in-the-contracts-directory.test.ts b/Blockchain/Dev/packages/shared/src/__tests__/ks1392-ci-contracts-job-runs-in-the-contracts-directory.test.ts
