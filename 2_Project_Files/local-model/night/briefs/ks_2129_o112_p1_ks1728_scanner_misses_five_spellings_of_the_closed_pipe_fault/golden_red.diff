   if ! printf '%s\n' $TABLES | grep -x "$e" >/dev/null; then  # KS-1728 b2: was `grep -q` after a printf pipe; this script has no pipefail so the class cannot move a verdict here, the form is pinned (see ks1728_product_scripts census)
