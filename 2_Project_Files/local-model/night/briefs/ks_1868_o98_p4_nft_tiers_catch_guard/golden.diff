diff --git a/Blockchain/Dev/services/nft-certificate/src/__tests__/ks1868-nft-tiers-catch-guard-catch-unreadable-throw.test.ts b/Blockchain/Dev/services/nft-certificate/src/__tests__/ks1868-nft-tiers-catch-guard-catch-unreadable-throw.test.ts
