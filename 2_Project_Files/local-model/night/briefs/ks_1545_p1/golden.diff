diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1545-platform-audit-log-logs-the-dropped-platform-half.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1545-platform-audit-log-logs-the-dropped-platform-half.test.ts
