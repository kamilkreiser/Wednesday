diff --git a/Blockchain/Dev/services/nft-certificate/src/__tests__/ks591-nft-mint-upload-fee-body-required.test.ts b/Blockchain/Dev/services/nft-certificate/src/__tests__/ks591-nft-mint-upload-fee-body-required.test.ts
