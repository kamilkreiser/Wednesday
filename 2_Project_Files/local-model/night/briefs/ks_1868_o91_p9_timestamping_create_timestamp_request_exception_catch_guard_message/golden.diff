diff --git a/Blockchain/Dev/services/timestamping/src/tsa/qualified-tsa.ts b/Blockchain/Dev/services/timestamping/src/tsa/qualified-tsa.ts
--- a/Blockchain/Dev/services/timestamping/src/tsa/qualified-tsa.ts
