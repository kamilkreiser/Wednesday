diff --git a/Blockchain/Dev/services/vc-issuer/src/__tests__/ks1904-credentialrepo-ensuretable-logs-only-a-string-message.test.ts b/Blockchain/Dev/services/vc-issuer/src/__tests__/ks1904-credentialrepo-ensuretable-logs-only-a-string-message.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/vc-issuer/src/__tests__/ks1904-credentialrepo-ensuretable-logs-only-a-string-message.test.ts
@@ -0,0 +1,72 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+// KS-1904: credentialRepo.ensureTable guards a message read that THROWS (KS-1868) but not one that RETURNS a non-string: an Error whose
+// `message` getter returns an object with a throwing toJSON was handed to the logger as { error: <object> }, and JSON.stringify of that
+// meta throws. It now logs the constant reason for any message that is not a string (a thrown value with no message still logs undefined).
+// Harness: the KS-1868 one (the db stand-in is a plain function that rejects with the value under test, here on the table check; the
+// logger is replaced); ensureTable is private, so it is reached through store().
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  warn: vi.fn(),
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => true,
+  query: (sql: string) => (/LIMIT 0/i.test(sql) ? Promise.reject(h.toThrow) : Promise.resolve({ rows: [] })),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: { info: vi.fn(), warn: h.warn, error: vi.fn(), debug: vi.fn() },
+}));
+
+import * as repo from '../repositories/credentialRepo';
+
+const WARNS = () => h.warn.mock.calls.filter((c) => String(c[0]).includes('Could not ensure'));
+const errorWithMessage = (value: unknown) =>
+  Object.create(Error.prototype, {
+    message: {
+      get() {
+        return value;
+      },
+    },
+  });
+const storeOne = () => repo.store({ id: 'ks1904-ensure-table' } as any).catch(() => undefined);
+
+describe('KS-1904 credentialRepo.ensureTable logs only a string message', () => {
+  beforeEach(() => {
+    h.toThrow = undefined;
+    h.warn.mockReset();
+  });
+
+  it('control ks1904 C1 an ordinary Error still logs its message', async () => {
+    h.toThrow = new Error('table check down');
+    await storeOne();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'table check down' });
+  });
+
+  it('control ks1904 C2 a thrown string has no message and still logs undefined', async () => {
+    h.toThrow = 'plain string';
+    await storeOne();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: undefined });
+  });
+
+  it('RED ks1904 R1 an Error whose message getter returns an object with a throwing toJSON logs a constant string reason', async () => {
+    h.toThrow = errorWithMessage({
+      toJSON() {
+        throw new Error('toJSON boom');
+      },
+    });
+    await storeOne();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1904 R2 an Error whose message getter returns a number logs a constant string reason', async () => {
+    h.toThrow = errorWithMessage(42);
+    await storeOne();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+});
