diff --git a/Blockchain/Dev/services/security/src/__tests__/ks1601-the-admin-scope-target-query-folds-the-role-under-collate-c.test.ts b/Blockchain/Dev/services/security/src/__tests__/ks1601-the-admin-scope-target-query-folds-the-role-under-collate-c.test.ts
