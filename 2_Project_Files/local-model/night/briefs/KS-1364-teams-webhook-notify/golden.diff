diff --git a/Blockchain/Dev/services/m365-integration/src/__tests__/ks1364-teams-webhook-config-notify-body-required.test.ts b/Blockchain/Dev/services/m365-integration/src/__tests__/ks1364-teams-webhook-config-notify-body-required.test.ts
