+/** The parts of a `spawnSync` result the child's verdict is read from - never its stdout or stderr. */
+interface ChildSpawn {
+    readonly status: number | null;
+    readonly signal: NodeJS.Signals | null;
+    readonly error?: Error;
+}
+
+/**
+ * Whether the child ended on its own: no spawn error, no signal, and an exit status of 0 or 1.
+ *
+ * @param {ChildSpawn} spawn - The spawn outcome.
+ * @returns {boolean} True only when vitest itself ended the run.
+ * @example
+ *   endedNormally({ status: 143, signal: null, error: new Error('ETIMEDOUT') }); // false
+ */
+function endedNormally(spawn: ChildSpawn): boolean {
+    return spawn.error === undefined && spawn.signal === null && (spawn.status === 0 || spawn.status === 1);
+}
+
+/**
+ * The child's verdict, from its spawn outcome and vitest's JSON report - NEVER from its human-readable
+ * output (KS-1313 / KS-1326: three rounds of summary-line parsing each misread a real shape). A child that
+ * did not end normally (a spawn error, a signal, or an exit status other than 0 or 1) is refused before the
+ * report is read, so a child killed by the spawn timeout cannot read as a pass.
+ *
+ * @param {ChildSpawn} spawn - The spawn outcome.
+ * @param {string | null} reportJson - The JSON reporter's file content, or null when no file was written.
+ * @returns {SuiteCounts} `{ passed, failed }` = the report's `numPassedTests` / `numFailedTests`.
+ * @example
+ *   countsFromSpawn({ status: 1, signal: null }, '{"numPassedTests":3,"numFailedTests":2}'); // { passed: 3, failed: 2 }
+ */
+function countsFromSpawn(spawn: ChildSpawn, reportJson: string | null): SuiteCounts {
+    if (!endedNormally(spawn)) {
+        throw new Error(
+            `the child vitest did not end normally (status ${String(spawn.status)}, signal ${String(spawn.signal)}, error ${String(spawn.error)})`,
+        );
+    }
+    if (reportJson === null) {
+        throw new Error('the child vitest wrote no JSON report');
+    }
+    let report: unknown;
+    try {
+        report = JSON.parse(reportJson);
+    } catch {
+        throw new Error(`the child vitest JSON report is not JSON: ${reportJson.slice(0, 200)}`);
+    }
+    const { numPassedTests, numFailedTests } = (report ?? {}) as Record<string, unknown>;
+    if (typeof numPassedTests !== 'number' || typeof numFailedTests !== 'number') {
+        throw new Error(
+            `the child vitest JSON report carries no numPassedTests / numFailedTests: ${reportJson.slice(0, 200)}`,
+        );
+    }
+    return { passed: numPassedTests, failed: numFailedTests };
+}
