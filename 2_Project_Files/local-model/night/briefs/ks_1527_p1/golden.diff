+#!/usr/bin/env bash
+# =============================================================================
+# TESTS for preflight_test_types_ratchet_leg.test.sh - KS-1527: its stub cells
+# must catch a mutated leg with no compiler.
+# =============================================================================
+# The PR #1513 gate built two mutants of scripts/preflight/test-types-ratchet.sh
+# that survived every stub cell (only the real-checker cells, which need a
+# workspace install, caught the second):
+#   X4      `check.cjs "$svc"` becomes `check.cjs "$svc" --update` (which would
+#           LOWER the baseline on every push): the stub logged only the service,
+#           so an extra argument was invisible.
+#   R1text  the rc-1 `why` text replaced by "something": no cell pinned it.
+# This suite aims the other suite at each mutant (its LEG_SH variable) and at no
+# workspace install (DEPS_PRESENT_ROOT at a directory that does not exist, so the
+# real-checker cells cannot be what fails), then asks whether the NAMED stub cell
+# is among the FAIL lines. Nothing in the repository is changed.
+#
+# Usage: bash Blockchain/Dev/scripts/__tests__/ks1527_ratchet_leg_stub_cells_catch_a_mutated_leg.test.sh
+# =============================================================================
+
+set -uo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SUITE="${RATCHET_LEG_SUITE_SH:-$HERE/preflight_test_types_ratchet_leg.test.sh}"
+LEG_REAL="${RATCHET_LEG_REAL_SH:-$HERE/../preflight/test-types-ratchet.sh}"
+PASS=0; FAIL=0
+
+[[ -f "$SUITE" ]] || { echo "FATAL: suite not found at $SUITE" >&2; exit 2; }
+[[ -f "$LEG_REAL" ]] || { echo "FATAL: leg not found at $LEG_REAL" >&2; exit 2; }
+
+tmp="$(mktemp -d "${TMPDIR:-/tmp}/secuura-ks1527.XXXXXX")"
+trap 'rm -rf "$tmp"' EXIT INT TERM
+
+check() {
+    local desc="$1" want="$2" got="$3"
+    if [[ "$got" == "$want" ]]; then PASS=$((PASS+1)); printf 'ok   %s\n' "$desc"
+    else FAIL=$((FAIL+1)); printf 'FAIL %s\n       want "%s", got "%s"\n' "$desc" "$want" "$got"; fi
+}
+
+# mutant <name> <sed expression> -> a mutated copy of the leg at $tmp/<name>/scripts/preflight/test-types-ratchet.sh
+mutant() {
+    mkdir -p "$tmp/$1/scripts/preflight"
+    sed "$2" "$LEG_REAL" > "$tmp/$1/scripts/preflight/test-types-ratchet.sh"
+}
+mutant real 's/^$//'
+mutant x4 's#check.cjs "$svc"#check.cjs "$svc" --update#'
+mutant r1 's#1) why="a NEW test-file type error[^"]*"#1) why="something"#'
+
+# run_with <name> -> the suite's output, with LEG_SH aimed at that leg copy and no install reachable
+run_with() {
+    LEG_SH="$tmp/$1/scripts/preflight/test-types-ratchet.sh" DEPS_PRESENT_ROOT="$tmp/no-install-here" \
+        bash "$SUITE" 2>&1 < /dev/null
+}
+# count_fail <output> <pattern> -> how many FAIL lines match the pattern
+count_fail() { printf '%s\n' "$1" | grep -c "^FAIL .*$2"; }
+
+# --- CELL 0 (CONTROL): the mutations really changed the leg ----------------------
+check "CONTROL both mutants differ from the real leg" "no no" \
+    "$(cmp -s "$tmp/x4/scripts/preflight/test-types-ratchet.sh" "$LEG_REAL" && echo yes || echo no) $(cmp -s "$tmp/r1/scripts/preflight/test-types-ratchet.sh" "$LEG_REAL" && echo yes || echo no)"
+
+out_real="$(run_with real)"
+out_x4="$(run_with x4)"
+out_r1="$(run_with r1)"
+
+# --- CELL 1 (RED at the tip): X4 turns the default-run stub cell red -------------
+check "X4 (an extra argument to the checker) fails the default-run stub cell" "1" \
+    "$(count_fail "$out_x4" 'the default run (no arguments) passes with all three checkers green')"
+
+# --- CELL 2 (RED at the tip): R1text turns the rc-1 wording cell red -------------
+check "R1text (the rc-1 wording replaced) fails the rc-1 wording stub cell" "1" \
+    "$(count_fail "$out_r1" 'the rc-1 wording names a NEW test-file type error')"
+
+# --- CELL 3 (CONTROL, tip AND after): the unmutated leg fails neither cell -------
+check "CONTROL the unmutated leg fails neither of those two stub cells" "0 0" \
+    "$(count_fail "$out_real" 'the default run (no arguments) passes with all three checkers green') $(count_fail "$out_real" 'the rc-1 wording names a NEW test-file type error')"
+
+echo ""
+echo "ks1527_ratchet_leg_stub_cells_catch_a_mutated_leg: ${PASS} passed, ${FAIL} failed"
+(( FAIL == 0 ))
