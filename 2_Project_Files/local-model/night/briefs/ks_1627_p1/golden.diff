+// =============================================================================
+// KS-1627 - the REAL services/redis module, in its in-memory fallback state, must make GET /api/connector/info answer 503
+// =============================================================================
+//
+// KS-1540 (#1582) made the info reader refuse with 503 SERVICE_UNAVAILABLE when Redis is unavailable, through
+// `redisService.isRedisAvailable?.() === false` in services/health.ts. The member is OPTIONAL on RedisServiceLike so that
+// older test doubles keep working, and the KS-1540 suite drives it with a double. If the real module's isRedisAvailable
+// were renamed and health.ts's call missed, the guard would be a silent no-op (undefined is not false) and the route
+// would go back to 200 with allowedDocumentTypes [] ("all types permitted"). Only a cell that passes the REAL module
+// catches that. This file does: no double, the real module, never initialised (no Redis was ever reached, so the module
+// is in its in-memory fallback state), over real HTTP behind the real authenticateToken(true).
+// =============================================================================
+
+import { describe, it, expect, beforeAll, afterAll } from 'vitest';
+import express from 'express';
+import type { Server } from 'http';
+import type { AddressInfo } from 'net';
+import { apiKeyCache, connectorBearerCache } from '../middleware/auth';
+import * as realRedis from '../services/redis';
+
+const CONNECTOR_ID = 'ks1627-c1';
+const KEY = 'sk_ks1627';
+const META = { connectorId: CONNECTOR_ID, scopes: ['documents:write'], organizationId: 'org-1', tenantId: 'ten-1', rateLimit: 100, rateLimitWindow: 60 };
+const UNREADABLE = 'Connector allow-list configuration is currently unreadable; refusing until it can be read';
+
+let server: Server;
+let base = '';
+
+beforeAll(async () => {
+  apiKeyCache.set(KEY, { result: META, expiresAt: Date.now() + 600000 });
+  connectorBearerCache.set(KEY, { token: 'connector.jwt.token', expiresAt: Date.now() + 600000 });
+  const { createHealthRoutes } = await import('../services/health');
+  const app = express();
+  app.use(createHealthRoutes({}, realRedis));
+  await new Promise<void>((resolve) => { server = app.listen(0, '127.0.0.1', () => resolve()); });
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+afterAll(async () => {
+  await new Promise((resolve) => server.close(resolve));
+});
+
+async function getInfo(): Promise<{ status: number; body: any }> {
+  const r = await fetch(`${base}/api/connector/info`, { headers: { 'x-api-key': KEY } });
+  return { status: r.status, body: await r.json() };
+}
+
+describe('KS-1627 - the real redis module in its fallback state makes GET /api/connector/info refuse', () => {
+  it('CONTROL KS-1627 C1: the real module exports isRedisAvailable as a function and reports false here (never initialised)', () => {
+    expect(typeof realRedis.isRedisAvailable).toBe('function');
+    expect(realRedis.isRedisAvailable()).toBe(false);
+  });
+
+  it('CONTROL KS-1627 C2: in this state the real settings read RESOLVES to null instead of throwing (the shape that used to answer 200 [])', async () => {
+    await expect(realRedis.getNotificationSettings('platform-settings')).resolves.toBeNull();
+  });
+
+  it('RED KS-1627 R1: an empty fallback store answers 503 SERVICE_UNAVAILABLE with the create path text, never 200 and never []', async () => {
+    const r = await getInfo();
+    expect([r.status, r.body?.error?.code, r.body?.error?.message, r.body?.allowedDocumentTypes]).toEqual([503, 'SERVICE_UNAVAILABLE', UNREADABLE, undefined]);
+  });
+
+  it('RED KS-1627 R2: a restrictive list written into the fallback memory store is still refused with 503, not echoed with 200', async () => {
+    await realRedis.setNotificationSettings('platform-settings', { integrations: [{ id: CONNECTOR_ID, config: { allowedDocumentTypes: ['SSD_DOCUMENT'] } }] });
+    const r = await getInfo();
+    expect([r.status, r.body?.error?.code, r.body?.error?.message, r.body?.allowedDocumentTypes]).toEqual([503, 'SERVICE_UNAVAILABLE', UNREADABLE, undefined]);
+  });
+});
