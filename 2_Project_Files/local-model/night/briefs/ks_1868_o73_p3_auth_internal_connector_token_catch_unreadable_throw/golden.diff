--- /dev/null
+++ b/Blockchain/Dev/services/auth/src/__tests__/ks1868-internal-connector-token-unreadable-throw.test.ts
@@ -0,0 +1,123 @@
+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import type { AddressInfo } from 'node:net';
+import type { Server } from 'node:http';
+import express from 'express';
+
+// KS-1868: POST /internal/connector-token calls the security service to validate the key; when that call REJECTS,
+// the route's catch must still log 'connector-token exchange failed' and answer the constant 502 BAD_GATEWAY even
+// if the rejection value cannot be read (a revoked Proxy throws on property reads; an Error whose `message` getter
+// throws, throws on `.message`). Today such a value makes the catch itself throw inside an async Express 4 handler:
+// no response is sent (the request hangs) and Node sees an UNHANDLED REJECTION. The cells count unhandled
+// rejections themselves and give the client a short timeout, so a hang shows as a failed assertion. The global
+// `fetch` the route calls is replaced by a plain function (not a vi.fn(): a spy inspects what it rejects with and
+// could itself fail on a revoked Proxy before the code under test saw it); the test client keeps the real one.
+const realFetch = globalThis.fetch;
+
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  logged: [] as unknown[][],
+  unhandled: 0,
+}));
+
+const capture = vi.hoisted(() => ({
+  debug: () => undefined,
+  info: () => undefined,
+  warn: () => undefined,
+  error: (...args: unknown[]) => {
+    h.logged.push(args);
+  },
+  log: () => undefined,
+}));
+vi.mock('../utils/logger', () => ({ logger: capture, createLogger: () => capture, validateEnv: () => undefined }));
+vi.mock('../services/jwt', () => ({
+  generateConnectorToken: () => ({ token: 'MINTED_1868_CONNECTOR', expiresIn: 300 }),
+}));
+
+const SAVED_LISTENERS = process.listeners('unhandledRejection');
+const onUnhandled = () => {
+  h.unhandled += 1;
+};
+
+let server: Server;
+let baseUrl = '';
+beforeAll(async () => {
+  process.removeAllListeners('unhandledRejection');
+  process.on('unhandledRejection', onUnhandled);
+  globalThis.fetch = ((_input: unknown) => Promise.reject(h.toThrow)) as unknown as typeof fetch;
+  const { internalRoutes } = await import('../routes/internal');
+  const app = express();
+  app.use(express.json());
+  app.use('/internal', internalRoutes);
+  server = app.listen(0, '127.0.0.1');
+  await new Promise<void>((resolve) => server.once('listening', () => resolve()));
+  baseUrl = 'http://127.0.0.1:' + String((server.address() as AddressInfo).port);
+});
+afterAll(async () => {
+  globalThis.fetch = realFetch;
+  server.closeAllConnections();
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+  process.removeListener('unhandledRejection', onUnhandled);
+  for (const l of SAVED_LISTENERS) process.on('unhandledRejection', l as (...a: any[]) => void);
+});
+beforeEach(() => {
+  h.toThrow = undefined;
+  h.logged.length = 0;
+  h.unhandled = 0;
+});
+
+const LINES = () => h.logged.filter((c) => c[0] === 'connector-token exchange failed');
+
+async function exchange(): Promise<{ status: number; code: string | undefined; minted: boolean } | null> {
+  try {
+    const res = await realFetch(baseUrl + '/internal/connector-token', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ apiKey: 'sk_ks1868_connector_key_000' }),
+      signal: AbortSignal.timeout(1500),
+    });
+    const text = await res.text();
+    let code: string | undefined;
+    try {
+      code = JSON.parse(text)?.error?.code;
+    } catch {
+      code = undefined;
+    }
+    return { status: res.status, code, minted: text.includes('MINTED_1868_CONNECTOR') };
+  } catch {
+    return null;
+  }
+}
+
+describe('KS-1868 the connector-token exchange catch reads the rejection value safely', () => {
+  it('control ks1868 C1 an ordinary Error still logs its message and the route answers 502 BAD_GATEWAY with no token', async () => {
+    h.toThrow = new Error('security down');
+    expect(await exchange()).toEqual({ status: 502, code: 'BAD_GATEWAY', minted: false });
+    expect(h.unhandled).toBe(0);
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ error: 'security down' });
+  });
+
+  it('RED ks1868 R1 a revoked Proxy rejection logs a constant reason and the route answers 502 BAD_GATEWAY with no token', async () => {
+    const { proxy, revoke } = Proxy.revocable({}, {});
+    revoke();
+    h.toThrow = proxy;
+    expect(await exchange()).toEqual({ status: 502, code: 'BAD_GATEWAY', minted: false });
+    expect(h.unhandled).toBe(0);
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1868 R2 an Error whose message getter throws logs a constant reason and the route answers 502 BAD_GATEWAY with no token', async () => {
+    h.toThrow = Object.create(Error.prototype, {
+      message: {
+        get() {
+          throw new Error('getter boom');
+        },
+      },
+    });
+    expect(await exchange()).toEqual({ status: 502, code: 'BAD_GATEWAY', minted: false });
+    expect(h.unhandled).toBe(0);
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+});
