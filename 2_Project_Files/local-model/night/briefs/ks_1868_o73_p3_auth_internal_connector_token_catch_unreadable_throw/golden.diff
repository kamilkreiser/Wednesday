diff --git a/Blockchain/Dev/services/auth/src/__tests__/ks1868-internal-connector-token-unreadable-throw.test.ts b/Blockchain/Dev/services/auth/src/__tests__/ks1868-internal-connector-token-unreadable-throw.test.ts
