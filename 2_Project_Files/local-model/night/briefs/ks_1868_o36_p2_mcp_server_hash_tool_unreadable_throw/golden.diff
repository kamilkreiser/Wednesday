diff --git a/Blockchain/Dev/services/mcp-server/src/__tests__/ks1868-hash-tool-unreadable-throw.test.ts b/Blockchain/Dev/services/mcp-server/src/__tests__/ks1868-hash-tool-unreadable-throw.test.ts
