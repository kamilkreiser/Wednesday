 fi
-
-TARGET_BASE="$TARGET" "$TSX_BIN" "$RUNNER" > "$OUT" 2>&1 || true
-
+
+TARGET_BASE="$TARGET" "$TSX_BIN" "$RUNNER" > "$OUT" 2> "$OUT.stderr" || true
+
 # stdout summary
