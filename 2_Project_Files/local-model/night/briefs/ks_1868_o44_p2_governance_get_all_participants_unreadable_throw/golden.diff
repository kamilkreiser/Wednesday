diff --git a/Blockchain/Dev/services/governance/src/__tests__/ks1868-get-all-participants-unreadable-throw.test.ts b/Blockchain/Dev/services/governance/src/__tests__/ks1868-get-all-participants-unreadable-throw.test.ts
