diff --git a/Blockchain/Dev/services/analytics/src/__tests__/ks1868-export-service-db-save-unreadable-throw.test.ts b/Blockchain/Dev/services/analytics/src/__tests__/ks1868-export-service-db-save-unreadable-throw.test.ts
