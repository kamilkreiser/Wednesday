--- /dev/null
+++ b/Blockchain/Dev/services/billing/src/__tests__/ks1868-billing-webhook-replay-unreadable-throw.test.ts
@@ -0,0 +1,141 @@
+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import express from 'express';
+import jwt from 'jsonwebtoken';
+import crypto from 'crypto';
+
+// KS-1868: the replay handler must still log its line and answer the constant 500 `Replay failed` when the thrown
+// value itself cannot be read (a revoked Proxy throws on `instanceof`; an Error whose `message` getter throws,
+// throws on `.message`). Harness: webhooks-replay-auth.test.ts (real router, real shared authenticate(), RS256 token).
+// The db stand-in rejects with a plain function, not a vi.fn(): a spy inspects what it rejects with and could
+// itself fail on a revoked Proxy before the code under test saw it. At the tip the request is never answered
+// (Express 4 does not see an async handler's rejection), so the cell gives the request a short deadline and counts
+// the unhandled rejection itself instead of letting the runner report it.
+const { privateKey: rsaPriv, publicKey: rsaPub } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
+const JWT_PRIVATE_PEM = rsaPriv.export({ type: 'pkcs8', format: 'pem' }).toString();
+
+process.env.NODE_ENV = 'development';
+process.env.JWT_PUBLIC_KEY = Buffer.from(rsaPub.export({ type: 'spki', format: 'pem' }).toString()).toString('base64');
+process.env.DATABASE_URL = 'postgres://test:test@localhost:5432/test';
+
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  logged: [] as unknown[][],
+  unhandled: 0,
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => true,
+  query: () => Promise.reject(h.toThrow),
+}));
+
+vi.mock('../services/stripeService', () => ({
+  getStripeService: () => ({
+    addCertificationCredits: async () => 0,
+    constructWebhookEvent: () => undefined,
+  }),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: {
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (...args: unknown[]) => {
+      h.logged.push(args);
+    },
+  },
+}));
+
+const { default: webhookRoutes } = await import('../routes/webhooks');
+const { errorHandler } = await import('@secuura/shared');
+
+const app = express();
+app.use('/webhooks', express.json(), webhookRoutes);
+app.use(errorHandler);
+
+const TIMEOUT_MS = 2500;
+const SAVED_LISTENERS = process.listeners('unhandledRejection');
+const onUnhandled = () => {
+  h.unhandled += 1;
+};
+
+let baseUrl = '';
+let server: ReturnType<typeof app.listen>;
+
+beforeAll(async () => {
+  process.removeAllListeners('unhandledRejection');
+  process.on('unhandledRejection', onUnhandled);
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => {
+      const addr = server.address();
+      const port = typeof addr === 'object' && addr ? addr.port : 0;
+      baseUrl = `http://127.0.0.1:${port}`;
+      resolve();
+    });
+  });
+});
+
+afterAll(() => {
+  server?.close();
+  process.removeListener('unhandledRejection', onUnhandled);
+  for (const l of SAVED_LISTENERS) process.on('unhandledRejection', l as (...a: any[]) => void);
+});
+
+beforeEach(() => {
+  h.toThrow = undefined;
+  h.logged.length = 0;
+  h.unhandled = 0;
+});
+
+const token = () => jwt.sign({ userId: 'u-1', email: 'x@secuura.io', role: 'SYSTEM_ADMIN' }, JWT_PRIVATE_PEM, { algorithm: 'RS256', expiresIn: '5m' });
+
+/** undefined when the request got no answer inside the deadline. */
+async function replay() {
+  const res = await fetch(`${baseUrl}/webhooks/replay`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
+    body: JSON.stringify({ eventId: 'evt_ks1868', reason: 'ks1868 replay check' }),
+    signal: AbortSignal.timeout(TIMEOUT_MS),
+  }).catch(() => undefined);
+  if (!res) return undefined;
+  const body: any = await res.json().catch(() => undefined);
+  return { status: res.status, body };
+}
+const LINES = () => h.logged.filter((c) => c[0] === 'Replay failed');
+
+describe('KS-1868 the webhook replay handler reads the thrown value safely', () => {
+  it('control ks1868 C1 an ordinary Error still logs its message and the route answers the constant 500', async () => {
+    h.toThrow = new Error('db down');
+    const res = await replay();
+    expect(res?.status).toBe(500);
+    expect(res?.body).toEqual({ success: false, error: { code: 'INTERNAL_ERROR', message: 'Replay failed' } });
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ eventId: 'evt_ks1868', error: 'db down' });
+  });
+
+  it('RED ks1868 R1 a revoked Proxy thrown value logs a constant reason and the route answers the constant 500', async () => {
+    const { proxy, revoke } = Proxy.revocable({}, {});
+    revoke();
+    h.toThrow = proxy;
+    const res = await replay();
+    expect(res?.status).toBe(500);
+    expect(res?.body).toEqual({ success: false, error: { code: 'INTERNAL_ERROR', message: 'Replay failed' } });
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ eventId: 'evt_ks1868', error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1868 R2 an Error whose message getter throws logs a constant reason and the route answers the constant 500', async () => {
+    h.toThrow = Object.create(Error.prototype, {
+      message: {
+        get() {
+          throw new Error('getter boom');
+        },
+      },
+    });
+    const res = await replay();
+    expect(res?.status).toBe(500);
+    expect(res?.body).toEqual({ success: false, error: { code: 'INTERNAL_ERROR', message: 'Replay failed' } });
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual({ eventId: 'evt_ks1868', error: 'unreadable thrown value' });
+  });
+});
