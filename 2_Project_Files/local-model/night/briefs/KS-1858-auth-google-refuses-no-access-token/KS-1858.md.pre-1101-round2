+let calls: string[];
+
+type Answer = { status: number; body: unknown };
+
+// A recording stub keyed by URL: the token endpoint answers `token`, the userinfo endpoint answers `user`, anything else 404.
+function stubFetch(token: Answer, user: Answer = { status: 401, body: { error: 'invalid_token' } }) {
+  calls = [];
+  vi.stubGlobal('fetch', vi.fn(async (url: string) => {
+    calls.push(String(url));
+    const a = String(url).includes('/token') ? token : String(url).includes('/userinfo') ? user : { status: 404, body: {} };
+    return new Response(JSON.stringify(a.body), { status: a.status, headers: { 'content-type': 'application/json' } });
+  }));
+}
+
+// The message exchangeCode rejects with, or 'RESOLVED' if it did not reject: a plain value, so a wrong answer fails by assertion.
+async function refusal(code: string): Promise<string> {
+  return new GoogleProvider(CONFIG).exchangeCode(code).then(() => 'RESOLVED', (e: Error) => e.message);
+}
