+// KS-591 (positive_data_acceptance register): the published contract for POST /api/stake/complete-unstake did not
+// mark the request body required, so a spec-driven caller (Schemathesis) sent no body at all and the handler
+// (routes/stake.ts) answered 400 'Address is required'. The body's one field, address, is required (KS-475), so an
+// absent body is always refused; the spec now says the body is required - the KS-1364 shape, and the shape its
+// siblings POST /api/stake and /api/stake/unstake already have. This file renders the document the generator
+// publishes, from the shared registry the staking module populates on import. No server, no database, no network.
+import { describe, it, expect } from 'vitest';
+import { generateOpenApiDocument } from '@secuura/shared';
+import '../staking.openapi';
+
+type AnyObj = Record<string, any>;
+
+const doc = generateOpenApiDocument({ title: 'staking (ks591 complete-unstake pin)', version: '0.0.0' }) as AnyObj;
+
+function operation(path: string, method: string): AnyObj | undefined {
+  return doc.paths?.[path]?.[method];
+}
+
+describe('KS-591: POST /api/stake/complete-unstake publishes a REQUIRED request body', () => {
+  it('RED KS-591 SU1: POST /api/stake/complete-unstake marks its request body required', () => {
+    expect(operation('/api/stake/complete-unstake', 'post')?.requestBody?.required).toBe(true);
+  });
+
+  it('control KS-591 SUC1: the body keeps its request schema and the operation keeps bearerAuth', () => {
+    const op = operation('/api/stake/complete-unstake', 'post');
+    expect(op?.requestBody?.content?.['application/json']?.schema?.$ref).toBe('#/components/schemas/CompleteUnstakeRequest');
+    expect(op?.security).toEqual([{ bearerAuth: [] }]);
+  });
+
+  it('control KS-591 SUC2: the request component still requires address, which is why an absent body is refused', () => {
+    const s: AnyObj = doc.components?.schemas ?? {};
+    expect(s.CompleteUnstakeRequest?.required).toEqual(['address']);
+  });
+
+  it('control KS-591 SUC3: the siblings POST /api/stake and POST /api/stake/unstake keep their required bodies', () => {
+    expect(operation('/api/stake', 'post')?.requestBody?.required).toBe(true);
+    expect(operation('/api/stake/unstake', 'post')?.requestBody?.required).toBe(true);
+  });
+});
