diff --git a/Blockchain/Dev/services/analytics/src/__tests__/ks1904-metrics-collector-load-logs-only-a-string-message.test.ts b/Blockchain/Dev/services/analytics/src/__tests__/ks1904-metrics-collector-load-logs-only-a-string-message.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/analytics/src/__tests__/ks1904-metrics-collector-load-logs-only-a-string-message.test.ts
@@ -0,0 +1,63 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+// KS-1904: MetricsCollector.loadFromDb guards a message read that THROWS (KS-1868) but not one that RETURNS a non-string: an Error whose
+// `message` getter returns an object with a throwing toJSON was handed to the logger as { error: <object> }, and JSON.stringify of that
+// meta throws. It now logs the constant reason for any message that is not a string. Harness: the KS-1868 one (the db stand-in is a plain
+// function that rejects with the value under test; the logger is replaced).
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  warn: vi.fn(),
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => true,
+  query: () => Promise.reject(h.toThrow),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: { info: vi.fn(), warn: h.warn, error: vi.fn(), debug: vi.fn() },
+}));
+
+import { MetricsCollector } from '../services/metricsCollector';
+
+const WARNS = () => h.warn.mock.calls.filter((c) => String(c[0]).includes('MetricsCollector.loadFromDb failed'));
+const errorWithMessage = (value: unknown) =>
+  Object.create(Error.prototype, {
+    message: {
+      get() {
+        return value;
+      },
+    },
+  });
+
+describe('KS-1904 MetricsCollector.loadFromDb logs only a string message', () => {
+  beforeEach(() => {
+    h.toThrow = undefined;
+    h.warn.mockReset();
+  });
+
+  it('control ks1904 C1 an ordinary Error still logs its message', async () => {
+    h.toThrow = new Error('db down');
+    await new MetricsCollector().loadFromDb();
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'db down' });
+  });
+
+  it('RED ks1904 R1 an Error whose message getter returns an object with a throwing toJSON logs a constant string reason', async () => {
+    h.toThrow = errorWithMessage({
+      toJSON() {
+        throw new Error('toJSON boom');
+      },
+    });
+    await new MetricsCollector().loadFromDb().catch(() => undefined);
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1904 R2 an Error whose message getter returns a number logs a constant string reason', async () => {
+    h.toThrow = errorWithMessage(42);
+    await new MetricsCollector().loadFromDb().catch(() => undefined);
+    expect(WARNS()).toHaveLength(1);
+    expect(WARNS()[0][1]).toEqual({ error: 'unreadable thrown value' });
+  });
+});
