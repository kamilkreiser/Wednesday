diff --git a/Blockchain/Dev/services/governance/src/__tests__/ks1722-proposals-list-refuses-an-unusable-filter.test.ts b/Blockchain/Dev/services/governance/src/__tests__/ks1722-proposals-list-refuses-an-unusable-filter.test.ts
