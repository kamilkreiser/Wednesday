diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1540-info-reader-refuses-when-redis-is-unavailable.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1540-info-reader-refuses-when-redis-is-unavailable.test.ts
