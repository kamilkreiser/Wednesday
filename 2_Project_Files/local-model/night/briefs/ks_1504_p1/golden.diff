diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1504-no-allowance-warning-escapes-the-auth-method.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1504-no-allowance-warning-escapes-the-auth-method.test.ts
