diff --git a/Blockchain/Dev/services/api-gateway/src/__tests__/ks1952-typed-create-is-refused-while-redis-is-unavailable.test.ts b/Blockchain/Dev/services/api-gateway/src/__tests__/ks1952-typed-create-is-refused-while-redis-is-unavailable.test.ts
