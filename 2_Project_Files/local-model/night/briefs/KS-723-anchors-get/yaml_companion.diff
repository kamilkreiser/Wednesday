+            application/json:
+              schema:
+                type: object
+                properties:
+                  documentId:
+                    type: string
+                  transactionId:
+                    type:
+                      - string
+                      - "null"
+                  transactionHash:
+                    type:
+                      - string
+                      - "null"
+                  simulated:
+                    type: boolean
+                  simulatedTxRef:
+                    type: string
+                  status:
+                    type: string
+                    enum:
+                      - pending
+                      - submitting
+                      - submitted
+                      - confirmed
+                      - failed
+                  blockNumber:
+                    type:
+                      - integer
+                      - "null"
+                  network:
+                    type: string
+                  anchoredAt:
+                    type:
+                      - string
+                      - "null"
+                  createdAt:
+                    type:
+                      - string
+                      - "null"
+                  contentHash:
+                    type: string
+                  verified:
+                    type: boolean
+                  identityCommitment:
+                    type:
+                      - string
+                      - "null"
+                  identity:
+                    type:
+                      - object
+                      - "null"
+                    additionalProperties: {}
+                  errorMessage:
+                    type:
+                      - string
+                      - "null"
+                  retryCount:
+                    type: integer
+                required:
+                  - documentId
+                  - transactionId
+                  - transactionHash
+                  - status
+                  - blockNumber
+                  - network
+                  - anchoredAt
+                  - createdAt
+                  - contentHash
+                  - verified
+                  - identityCommitment
+                  - identity
+                  - errorMessage
+                  - retryCount
+        "400":
