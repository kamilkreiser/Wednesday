diff --git a/Blockchain/Dev/services/originate/src/__tests__/ks1709-a-refused-certification-anchor-is-logged.test.ts b/Blockchain/Dev/services/originate/src/__tests__/ks1709-a-refused-certification-anchor-is-logged.test.ts
