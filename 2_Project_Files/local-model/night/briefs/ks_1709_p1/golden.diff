+++ b/Blockchain/Dev/services/originate/src/__tests__/ks1709-a-refused-certification-anchor-is-logged.test.ts
@@ -0,0 +1,160 @@
+/**
+ * KS-1709 - a non-ok answer from the anchoring service on POST /api/certifications/issue is logged, with its status and a bounded body.
+ *
+ * The route posts the certification's anchor to anchoring's POST /api/anchors and checked only `if (upstream.ok)`. A refusal (a 4xx
+ * or 5xx) is an answer, not an exception, so the `catch` never saw it: outside production the certification was kept with no anchor and
+ * no log line anywhere (measured on kintsugi, 2026-10-21: anchoring's bare 400 and nothing from originate). After this change one warn
+ * line names the certification id, the status and the first 200 characters of the body, as routes/anchors.ts already does.
+ * The response and the stored row are NOT changed here: what to do with the row is a separate decision on the ticket.
+ *
+ * Harness: the KS-1679 suite's (the real certificationsRouter over an in-memory store), plus a loopback anchoring stub whose answer
+ * each cell sets.
+ */
+process.env.DATABASE_URL = process.env.DATABASE_URL || 'postgresql://test:test@127.0.0.1:1/test';
+process.env.SIMULATE_ANCHORING = 'true';
+process.env.ANCHORING_SERVICE_URL = 'http://127.0.0.1:2';
+
+const store = new Map<string, any>();
+const saved: any[] = [];
+
+jest.mock('../repositories/documentRepo', () => ({
+  getDocument: jest.fn(async (id: string) => store.get(id) ?? null),
+  listDocuments: jest.fn(async () => ({ items: [...store.values()], total: store.size })),
+  saveDocument: jest.fn(async (record: any) => {
+    const copy = JSON.parse(JSON.stringify(record));
+    if (!Array.isArray(copy.signatures)) copy.signatures = [];
+    store.set(copy.id, copy);
+    saved.push(copy);
+    return { dbId: '99999999-9999-4999-8999-999999999999', inserted: true };
+  }),
+  updateDocument: jest.fn(async () => undefined),
+  generateContentHash: jest.fn(() => 'a'.repeat(64)),
+  assertNoCycle: jest.fn(async () => undefined),
+  getOrganizationExternalRef: jest.fn(async () => null),
+}));
+jest.mock('../repositories/certificationRepo', () => ({
+  initRepo: jest.fn(async () => undefined),
+  getCertification: jest.fn(),
+  saveCertification: jest.fn(async () => undefined),
+  listCertifications: jest.fn(),
+  saveShare: jest.fn(),
+  getSharesByCertification: jest.fn(),
+  getLineageEvents: jest.fn(),
+}));
+jest.mock('../db', () => ({ prisma: { $queryRaw: jest.fn(), $executeRaw: jest.fn(), $executeRawUnsafe: jest.fn() } }));
+jest.mock('../services/chargeEvents', () => ({ createChargeEvent: jest.fn(async () => ({ id: 'charge-1' })), getChargeEventsByCertification: jest.fn() }));
+jest.mock('../utils/notificationClient', () => ({ notifyDocumentCertified: jest.fn(async () => undefined), notifyDocumentRevoked: jest.fn(async () => undefined), notifyDocumentShared: jest.fn(async () => undefined) }));
+jest.mock('../repositories/shareRepo', () => ({ createShare: jest.fn() }));
+jest.mock('../repositories/lifecycleEventRepo', () => ({ createLifecycleEvent: jest.fn(), setLifecycleEventAnchor: jest.fn(), listLifecycleEvents: jest.fn() }));
+jest.mock('../events', () => ({ publishEvent: jest.fn(async () => undefined), EventTypes: { DOCUMENT_CREATED: 'document.created', DOCUMENT_OWNERSHIP_TRANSFERRED: 'document.ownership_transferred', DOCUMENT_VERSIONED: 'document.versioned', CERTIFICATION_ISSUED: 'certification.issued' } }));
+jest.mock('../services/threadTokenClient', () => ({ mintAndRegisterThreadToken: jest.fn(async () => ({})) }));
+jest.mock('../routes/verification', () => ({ registerInPlatformRegistry: jest.fn(async () => undefined) }));
+jest.mock('../services/anchorStateSync', () => ({ pollAnchorUntilConfirmed: jest.fn(async () => undefined), reconcileDocumentAnchorState: jest.fn(async (d: any) => d) }));
+jest.mock('../services/provenance', () => {
+  const actual = jest.requireActual('../services/provenance');
+  return { ...actual, recordActionProvenance: jest.fn(async () => undefined), getCreationProvenance: jest.fn(async () => null), wasCreatedByConnector: jest.fn(async () => true) };
+});
+jest.mock('@secuura/shared', () =>
+  require('./helpers/sharedModuleMock').makeSharedMock({
+    hasNulByte: jest.requireActual('@secuura/shared').hasNulByte,
+    runWithTenantId: jest.requireActual('@secuura/shared').runWithTenantId,
+    encryptField: jest.requireActual('@secuura/shared').encryptField,
+    decryptField: jest.requireActual('@secuura/shared').decryptField,
+    lookupHash: jest.requireActual('@secuura/shared').lookupHash,
+    verifyMessageSignature: jest.fn(() => true),
+  }),
+);
+jest.mock('../middleware/auth', () => ({
+  authenticate: () => (req: any, _res: unknown, next: () => void) => {
+    req.user = JSON.parse(String(req.headers['x-probe-user'] || '{}'));
+    next();
+  },
+}));
+jest.mock('../utils/logger', () => ({ logger: { info: jest.fn(), warn: jest.fn(), error: jest.fn(), debug: jest.fn() } }));
+
+import express from 'express';
+import { certificationsRouter } from '../routes/certifications';
+
+const TENANT = 'a0000000-0000-4000-8000-000000000001';
+const ISSUER = { userId: '11111111-2222-4333-8444-555555551709', role: 'ISSUER_ADMIN', verificationLevel: 'none', tenantId: TENANT };
+const SOURCE_ID = 'doc-src-1709';
+const UNREACHABLE = 'http://127.0.0.1:2';
+
+const app = express();
+app.use((req: any, _res, next) => { req.tenantId = TENANT; next(); });
+app.use('/api/certifications', express.json(), certificationsRouter);
+// One loopback stub plays auth (the issuer signature) and anchoring (POST /api/anchors answers whatever the cell set).
+let anchorReply: { status: number; body: string } = { status: 202, body: '{}' };
+const stubApp = express();
+stubApp.use(express.json());
+stubApp.post('/api/issuer-certs/sign', (req, res) => {
+  res.json({ success: true, signature: 'ab', signatureAlgorithm: 'RSASSA-PSS-SHA256', signedContentHash: req.body.contentHash, signedAt: new Date().toISOString(),
+    cert: { id: 'c1', fingerprintSha256: 'f'.repeat(64), subject: 'CN=probe', issuer: 'CN=probe', certPem: 'PEM', validFrom: '2026-01-01', validUntil: '2027-01-01', trustLevel: 'self-signed' } });
+});
+stubApp.post('/api/anchors', (_req, res) => { res.status(anchorReply.status).type('application/json').send(anchorReply.body); });
+let base = '';
+let stubBase = '';
+let server: ReturnType<typeof app.listen>;
+let stub: ReturnType<typeof stubApp.listen>;
+beforeAll(async () => {
+  await new Promise<void>((r) => { server = app.listen(0, '127.0.0.1', () => r()); });
+  await new Promise<void>((r) => { stub = stubApp.listen(0, '127.0.0.1', () => r()); });
+  const a = server.address(); base = 'http://127.0.0.1:' + String(typeof a === 'object' && a ? a.port : 0);
+  const s = stub.address(); stubBase = 'http://127.0.0.1:' + String(typeof s === 'object' && s ? s.port : 0);
+  process.env.AUTH_SERVICE_URL = stubBase;
+});
+afterAll(() => { server?.close(); stub?.close(); });
+
+const { logger } = jest.requireMock('../utils/logger') as { logger: { info: jest.Mock; warn: jest.Mock; error: jest.Mock } };
+const refused = () => logger.warn.mock.calls.filter((c) => /KS-1709/.test(String(c[0])));
+const unreachable = () => logger.warn.mock.calls.filter((c) => String(c[0]) === 'Anchoring service unreachable for certification');
+const queued = () => logger.info.mock.calls.filter((c) => String(c[0]) === 'Certification queued for anchoring');
+
+beforeEach(() => {
+  store.clear(); saved.length = 0;
+  store.set(SOURCE_ID, { id: SOURCE_ID, type: 'DOCUMENT', status: 'draft', owner: { id: ISSUER.userId }, data: { title: 'src' }, contentHash: 'sha256:' + 'a'.repeat(64), signatures: [], createdAt: '2026-10-01T00:00:00Z', updatedAt: '2026-10-01T00:00:00Z' });
+  logger.info.mockClear(); logger.warn.mockClear(); logger.error.mockClear();
+  process.env.ANCHORING_SERVICE_URL = stubBase;
+});
+afterEach(() => { process.env.ANCHORING_SERVICE_URL = UNREACHABLE; });
+
+async function issue() {
+  const res = await fetch(base + '/api/certifications/issue', { method: 'POST', headers: { 'content-type': 'application/json', 'x-probe-user': JSON.stringify(ISSUER) }, body: JSON.stringify({ type: 'DOCUMENT', parentDocumentId: SOURCE_ID, data: { title: 'c' } }) });
+  const out: any = await res.json().catch(() => ({}));
+  return { status: res.status, body: out };
+}
+
+describe('KS-1709 a non-ok answer from anchoring on POST /api/certifications/issue is logged', () => {
+  it('RED KS-1709 R1: a 400 with a reason logs one warn naming the certification, the status and the reason', async () => {
+    anchorReply = { status: 400, body: JSON.stringify({ success: false, error: { message: 'Invalid DID' } }) };
+    const r = await issue();
+    expect(r.status).toBe(201);
+    expect(refused().length).toBe(1);
+    const fields = refused()[0][1];
+    expect([fields.certId, fields.status]).toEqual([r.body.id, 400]);
+    expect(String(fields.body)).toContain('Invalid DID');
+  });
+  it('RED KS-1709 R2: a 503 with an empty body logs the status and an empty body, not nothing', async () => {
+    anchorReply = { status: 503, body: '' };
+    const r = await issue();
+    expect(r.status).toBe(201);
+    expect(refused().map((c) => [c[1].certId, c[1].status, c[1].body])).toEqual([[r.body.id, 503, '']]);
+  });
+  it('RED KS-1709 R3: a long body is cut to its first 200 characters', async () => {
+    anchorReply = { status: 422, body: 'x'.repeat(1000) };
+    const r = await issue();
+    expect(r.status).toBe(201);
+    expect(refused().map((c) => [c[1].status, String(c[1].body).length])).toEqual([[422, 200]]);
+  });
+  it('CONTROL KS-1709 C1: an accepted anchor logs no refusal, and the queued line carries the upstream id', async () => {
+    anchorReply = { status: 202, body: JSON.stringify({ success: true, data: { id: 'anchor-1709' } }) };
+    const r = await issue();
+    expect([r.status, refused().length]).toEqual([201, 0]);
+    expect(queued().map((c) => [c[1].certId, c[1].upstreamAnchorId])).toEqual([[r.body.id, 'anchor-1709']]);
+  });
+  it('CONTROL KS-1709 C2: an unreachable anchoring service keeps its own warn and logs no refusal', async () => {
+    process.env.ANCHORING_SERVICE_URL = UNREACHABLE;
+    const r = await issue();
+    expect([r.status, refused().length, unreachable().length]).toEqual([201, 0, 1]);
+  });
+});
