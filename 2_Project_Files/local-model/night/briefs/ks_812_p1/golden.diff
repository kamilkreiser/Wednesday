--- /dev/null
+++ b/Blockchain/Dev/scripts/__tests__/ks812_whatsapp_bot_default_api_target.test.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# TESTS for connectors/whatsapp-bot - the default SECUURA_API_URL must not be the dead Container Apps host (KS-812)
+# verify.ts falls back to a decommissioned secuura02-demo-api...azurecontainerapps.io host when SECUURA_API_URL is
+# unset, and index.ts prints the same host as "API target". The live demo is the VM ingress. The suite strips the types from the
+# real verify.ts with node's own stripTypeScriptTypes, runs verifyHash with SECUURA_API_URL unset and a stub fetch that
+# records the URL, then reads index.ts for the printed default. No network, no server, no express.
+# Usage: bash Blockchain/Dev/scripts/__tests__/ks812_whatsapp_bot_default_api_target.test.sh
+#        WA_SRC=/path/to/other/src bash ...   (to test a different copy of the connector's src)
+set -uo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+DEV="$(cd "$HERE/../.." && pwd)"
+SRC="${WA_SRC:-$DEV/connectors/whatsapp-bot/src}"
+[ -r "$SRC/verify.ts" ] || { echo "FATAL: verify.ts not readable at $SRC" >&2; exit 2; }
+[ -r "$SRC/index.ts" ] || { echo "FATAL: index.ts not readable at $SRC" >&2; exit 2; }
+WORK="$(mktemp -d "${TMPDIR:-/tmp}/ks812.XXXXXX")"
+trap 'rm -rf "$WORK"' EXIT
+VM_HOST="https://secuura02-demo.southeastasia.cloudapp.azure.com"
+pass=0
+fail=0
+ok()   { printf '  ok   %s\n' "$1"; pass=$((pass + 1)); }
+bad()  { printf '  FAIL %s\n     %s\n' "$1" "$2"; fail=$((fail + 1)); }
+
+# Prints the URL verifyHash requests. $1 = value for SECUURA_API_URL, or the word UNSET.
+# Node strips the TypeScript types itself (module.stripTypeScriptTypes, node 22.13+), so no typescript package is needed.
+requested_url() {
+  VERIFY_TS="$SRC/verify.ts" TMP_DIR="$WORK" ENVVAL="$1" node -e '
+    const fs = require("fs");
+    const m = require("module");
+    if (typeof m.stripTypeScriptTypes !== "function") { console.log("NO-STRIP-TYPES"); process.exit(0); }
+    const src = fs.readFileSync(process.env.VERIFY_TS, "utf8").replace(/^import .* from .\.\/messages.;\s*$/m, "");
+    const file = process.env.TMP_DIR + "/verify-" + Date.now() + ".mjs";
+    fs.writeFileSync(file, m.stripTypeScriptTypes(src));
+    if (process.env.ENVVAL === "UNSET") delete process.env.SECUURA_API_URL; else process.env.SECUURA_API_URL = process.env.ENVVAL;
+    let seen = "";
+    globalThis.fetch = async (u) => { seen = String(u); return { ok: false, status: 599 }; };
+    import(file).then((mod) => mod.verifyHash("sha256:00")).then(() => console.log(seen));
+  ' 2>/dev/null
+}
+
+URL_UNSET="$(requested_url UNSET)"
+URL_SET="$(requested_url "https://example.test")"
+
+case "$URL_UNSET" in
+  NO-STRIP-TYPES) echo "FATAL: this suite needs node 22.13+ (module.stripTypeScriptTypes)" >&2; exit 2 ;;
+  https://*) ok "preconditions hold - verifyHash with SECUURA_API_URL unset requested a URL: $URL_UNSET" ;;
+  *) bad "preconditions hold" "no URL was captured, got: $URL_UNSET" ;;
+esac
+if printf '%s' "$URL_UNSET" | grep -qF "$VM_HOST/api/verification/verify"; then
+  ok "verifyHash with SECUURA_API_URL unset targets the VM ingress"
+else
+  bad "verifyHash with SECUURA_API_URL unset targets the VM ingress" "requested: $URL_UNSET"
+fi
+if grep -rqF 'azurecontainerapps' "$SRC"; then
+  bad "no source file under src names the dead Container Apps host" "$(grep -rnF 'azurecontainerapps' "$SRC" | cut -c1-200 | tr '\n' ';')"
+else
+  ok "no source file under src names the dead Container Apps host"
+fi
+if grep -qF "API target: \${process.env.SECUURA_API_URL || '$VM_HOST'}" "$SRC/index.ts"; then
+  ok "index.ts prints the VM ingress as the default API target"
+else
+  bad "index.ts prints the VM ingress as the default API target" "$(grep -n 'API target' "$SRC/index.ts" | cut -c1-200)"
+fi
+if [ "$URL_SET" = "https://example.test/api/verification/verify" ]; then
+  ok "a set SECUURA_API_URL still wins over the default"
+else
+  bad "a set SECUURA_API_URL still wins over the default" "requested: $URL_SET"
+fi
+printf '\n  %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ] || exit 1
+exit 0
