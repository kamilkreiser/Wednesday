diff --git a/Blockchain/Dev/services/security/src/__tests__/ks1705-security-keys-post-and-admin-scopes-put-bodies-are-required.test.ts b/Blockchain/Dev/services/security/src/__tests__/ks1705-security-keys-post-and-admin-scopes-put-bodies-are-required.test.ts
