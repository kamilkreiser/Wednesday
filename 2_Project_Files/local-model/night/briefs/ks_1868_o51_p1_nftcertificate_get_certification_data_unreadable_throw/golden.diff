diff --git a/Blockchain/Dev/services/nft-certificate/src/__tests__/ks1868-nft-get-certification-data-unreadable-throw.test.ts b/Blockchain/Dev/services/nft-certificate/src/__tests__/ks1868-nft-get-certification-data-unreadable-throw.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/nft-certificate/src/__tests__/ks1868-nft-get-certification-data-unreadable-throw.test.ts
@@ -0,0 +1,103 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+
+// KS-1868: in production `getCertificationData` fetches the certification from the originate service; when that
+// fetch THROWS, its catch block must still log its line and return null, so `mintNFT` answers the honest
+// CERTIFICATION_NOT_FOUND, even if the thrown value cannot be read (a revoked Proxy throws on `instanceof`; an
+// Error whose `message` getter throws, throws on `.message`). Today the unreadable value makes the catch block
+// itself throw, nothing is logged, and `mintNFT` classifies the resulting TypeError as a generic MINT_FAILED.
+// The fetch stand-in is a plain function, not a vi.fn(): a spy inspects what it rejects with and could itself
+// fail on a revoked Proxy before the code under test saw it.
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  fetchOk: false,
+  warn: vi.fn(),
+  error: vi.fn(),
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => false,
+  query: vi.fn(),
+}));
+
+vi.mock('../cardano', () => ({
+  isCardanoNFTReady: () => false,
+  mintNFTOnChain: vi.fn(),
+  getPolicyId: () => null,
+  waitForNFTConfirmation: vi.fn(),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: { info: vi.fn(), warn: h.warn, error: h.error, debug: vi.fn() },
+}));
+
+import { nftMintingService } from '../services/minting.service';
+import { StorageTier, PrivacyLevel } from '../types';
+
+const LINE = 'Error fetching certification data from originate service';
+const LINES = () => h.error.mock.calls.filter((c) => String(c[0]).includes(LINE));
+
+const mint = () =>
+  nftMintingService.mintNFT({
+    certificationId: 'ks1868-cert-' + Math.random().toString(36).slice(2),
+    walletAddress: 'addr_test1ks1868',
+    chain: 'cardano',
+    storageTier: StorageTier.BASIC,
+    privacyLevel: PrivacyLevel.FULL_PRIVACY,
+  });
+
+describe('KS-1868 `getCertificationData` reads the thrown value safely', () => {
+  const savedEnv = process.env.NODE_ENV;
+  beforeEach(() => {
+    process.env.NODE_ENV = 'production';
+    h.toThrow = undefined;
+    h.fetchOk = false;
+    h.warn.mockReset();
+    h.error.mockReset();
+    vi.stubGlobal('fetch', () => (h.fetchOk ? Promise.resolve({ ok: false, status: 404 }) : Promise.reject(h.toThrow)));
+  });
+  afterEach(() => {
+    process.env.NODE_ENV = savedEnv;
+    vi.unstubAllGlobals();
+  });
+
+  it('control ks1868 C1 an ordinary Error still logs its message and mintNFT answers CERTIFICATION_NOT_FOUND', async () => {
+    h.toThrow = new Error('originate down');
+    const r = await mint();
+    expect(r.success).toBe(false);
+    expect(r.errorCode).toBe('CERTIFICATION_NOT_FOUND');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toMatchObject({ error: 'originate down' });
+  });
+
+  it('control ks1868 C2 a non-ok response answers CERTIFICATION_NOT_FOUND without the catch-block line', async () => {
+    h.fetchOk = true;
+    const r = await mint();
+    expect(r.success).toBe(false);
+    expect(r.errorCode).toBe('CERTIFICATION_NOT_FOUND');
+    expect(LINES()).toHaveLength(0);
+  });
+
+  it('RED ks1868 R1 a revoked Proxy thrown value logs a constant reason and mintNFT answers CERTIFICATION_NOT_FOUND', async () => {
+    const { proxy, revoke } = Proxy.revocable({}, {});
+    revoke();
+    h.toThrow = proxy;
+    const r = await mint();
+    expect(r.errorCode).toBe('CERTIFICATION_NOT_FOUND');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toMatchObject({ error: 'unreadable thrown value' });
+  });
+
+  it('RED ks1868 R2 an Error whose message getter throws logs a constant reason and mintNFT answers CERTIFICATION_NOT_FOUND', async () => {
+    h.toThrow = Object.create(Error.prototype, {
+      message: {
+        get() {
+          throw new Error('getter boom');
+        },
+      },
+    });
+    const r = await mint();
+    expect(r.errorCode).toBe('CERTIFICATION_NOT_FOUND');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toMatchObject({ error: 'unreadable thrown value' });
+  });
+});
