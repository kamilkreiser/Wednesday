diff --git a/Blockchain/Dev/services/billing/src/__tests__/ks1868-billing-webhook-stripe-claim-unreadable-throw.test.ts b/Blockchain/Dev/services/billing/src/__tests__/ks1868-billing-webhook-stripe-claim-unreadable-throw.test.ts
new file mode 100644
--- /dev/null
+++ b/Blockchain/Dev/services/billing/src/__tests__/ks1868-billing-webhook-stripe-claim-unreadable-throw.test.ts
@@ -0,0 +1,169 @@
+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import express from 'express';
+import crypto from 'crypto';
+
+// KS-1868: the Stripe webhook route must still log its line and answer the constant 503 (so Stripe redelivers) when the
+// value thrown out of the idempotency claim cannot be read (a revoked Proxy throws on `instanceof`; an Error whose
+// `message` getter throws, throws on `.message`). Harness: the ks1868 replay test (real router on a loopback listener).
+// The database is reported unavailable and `logger.warn`, which `claimEvent` calls before its own try, throws the
+// value from a plain function, not a vi.fn(): a spy inspects what it throws and could itself fail on a revoked Proxy
+// before the code under test saw it. At the tip the request is never answered (Express 4 does not see an async
+// handler's rejection), so the cell gives the request a short deadline and counts the unhandled rejection itself.
+const { publicKey: rsaPub } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
+
+process.env.NODE_ENV = 'development';
+process.env.JWT_PUBLIC_KEY = Buffer.from(rsaPub.export({ type: 'spki', format: 'pem' }).toString()).toString('base64');
+process.env.DATABASE_URL = 'postgres://test:test@localhost:5432/test';
+
+const h = vi.hoisted(() => ({
+  toThrow: undefined as unknown,
+  logged: [] as unknown[][],
+  queries: 0,
+  credits: 0,
+  unhandled: 0,
+}));
+
+vi.mock('../db', () => ({
+  isDbAvailable: () => false,
+  query: () => {
+    h.queries += 1;
+    return Promise.resolve({ rows: [], rowCount: 0 });
+  },
+}));
+
+vi.mock('../services/stripeService', () => ({
+  getStripeService: () => ({
+    addCertificationCredits: async () => {
+      h.credits += 1;
+      return 0;
+    },
+    constructWebhookEvent: () => ({ id: 'evt_ks1868_claim', type: 'customer.created', data: { object: { id: 'cus_1' } } }),
+  }),
+}));
+
+vi.mock('../utils/logger', () => ({
+  logger: {
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => {
+      if (h.toThrow !== undefined) throw h.toThrow;
+    },
+    error: (...args: unknown[]) => {
+      h.logged.push(args);
+    },
+  },
+}));
+
+const { default: webhookRoutes } = await import('../routes/webhooks');
+const { errorHandler } = await import('@secuura/shared');
+
+const app = express();
+app.use('/webhooks', express.json(), webhookRoutes);
+app.use(errorHandler);
+
+const TIMEOUT_MS = 2500;
+const SAVED_LISTENERS = process.listeners('unhandledRejection');
+const onUnhandled = () => {
+  h.unhandled += 1;
+};
+
+let baseUrl = '';
+let server: ReturnType<typeof app.listen>;
+
+beforeAll(async () => {
+  process.removeAllListeners('unhandledRejection');
+  process.on('unhandledRejection', onUnhandled);
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => {
+      const addr = server.address();
+      const port = typeof addr === 'object' && addr ? addr.port : 0;
+      baseUrl = `http://127.0.0.1:${port}`;
+      resolve();
+    });
+  });
+});
+
+afterAll(() => {
+  server?.close();
+  process.removeListener('unhandledRejection', onUnhandled);
+  for (const l of SAVED_LISTENERS) process.on('unhandledRejection', l as (...a: any[]) => void);
+});
+
+beforeEach(() => {
+  h.toThrow = undefined;
+  h.logged.length = 0;
+  h.queries = 0;
+  h.credits = 0;
+  h.unhandled = 0;
+});
+
+/** undefined when the request got no answer inside the deadline. */
+async function deliver() {
+  const res = await fetch(`${baseUrl}/webhooks/stripe`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', 'stripe-signature': 't=1,v1=stub' },
+    body: JSON.stringify({ id: 'evt_ks1868_claim', type: 'customer.created' }),
+    signal: AbortSignal.timeout(TIMEOUT_MS),
+  }).catch(() => undefined);
+  if (!res) return undefined;
+  const body: any = await res.json().catch(() => undefined);
+  return { status: res.status, body };
+}
+const LINES = () => h.logged.filter((c) => typeof c[0] === 'string' && c[0].startsWith('[Webhook] Refusing delivery'));
+const refusal = (error: string) => ({ eventId: 'evt_ks1868_claim', eventType: 'customer.created', error });
+
+describe('KS-1868 the Stripe webhook idempotency-claim catch reads the thrown value safely', () => {
+  it('control ks1868 C1 an ordinary Error from the claim still logs its message and the route answers the constant 503', async () => {
+    h.toThrow = new Error('warn sink down');
+    const res = await deliver();
+    expect(res?.status).toBe(503);
+    expect(res?.body?.success).toBe(false);
+    expect(res?.body?.error?.code).toBe('SERVICE_UNAVAILABLE');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual(refusal('warn sink down'));
+    expect(h.queries).toBe(0);
+    expect(h.credits).toBe(0);
+  });
+
+  it('control ks1868 C2 an unavailable database (nothing thrown by the logger) is refused with the claim error text', async () => {
+    const res = await deliver();
+    expect(res?.status).toBe(503);
+    expect(res?.body?.error?.code).toBe('SERVICE_UNAVAILABLE');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual(refusal('Idempotency claim unavailable: database unavailable'));
+    expect(h.queries).toBe(0);
+    expect(h.credits).toBe(0);
+  });
+
+  it('RED ks1868 R1 a revoked Proxy thrown value logs a constant reason and the route answers the constant 503', async () => {
+    const { proxy, revoke } = Proxy.revocable({}, {});
+    revoke();
+    h.toThrow = proxy;
+    const res = await deliver();
+    expect(res?.status).toBe(503);
+    expect(res?.body?.success).toBe(false);
+    expect(res?.body?.error?.code).toBe('SERVICE_UNAVAILABLE');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual(refusal('unreadable thrown value'));
+    expect(h.queries).toBe(0);
+    expect(h.credits).toBe(0);
+  });
+
+  it('RED ks1868 R2 an Error whose message getter throws logs a constant reason and the route answers the constant 503', async () => {
+    h.toThrow = Object.create(Error.prototype, {
+      message: {
+        get() {
+          throw new Error('getter boom');
+        },
+      },
+    });
+    const res = await deliver();
+    expect(res?.status).toBe(503);
+    expect(res?.body?.success).toBe(false);
+    expect(res?.body?.error?.code).toBe('SERVICE_UNAVAILABLE');
+    expect(LINES()).toHaveLength(1);
+    expect(LINES()[0][1]).toEqual(refusal('unreadable thrown value'));
+    expect(h.queries).toBe(0);
+    expect(h.credits).toBe(0);
+  });
+});
