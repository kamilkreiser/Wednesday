NIGHT_DIR = '/Volumes/DevMASTER/WEDNESDAY/2_Project_Files/local-model/night'

# ------------------------------------------------------------------ --title-from-brief (2026-09-22 11:2x)
# The title is DERIVED from the brief's own `File:` line, never typed: basename, `.test.sh`/`.test.ts`/`.test.js`/`.ts`/`.js`/`.sh`/`.md` stripped, upper-cased,
# `_`→`-`. The brief's `# ` heading must name the run's ticket (a wrong brief is refused, not silently titled from). A
# positional title given alongside must equal the derived one. The line each came from is printed.
def _title_from_brief(path):
    if not os.path.isfile(path): die(f"--title-from-brief: no such brief file: {path}")
    lines = open(path, errors='replace').read().splitlines()
    fl = next(((i, l) for i, l in enumerate(lines, 1) if re.match(r'^File:\s*\S', l)), None)
    if fl is None: die(f"--title-from-brief: the brief has no `File:` line: {path}")
    hl = next(((i, l) for i, l in enumerate(lines, 1) if l.startswith('# ')), None)
    if hl is None: die(f"--title-from-brief: the brief has no `# ` heading: {path}")
    if ticket not in hl[1]: die(f"--title-from-brief: the brief's `# ` heading (line {hl[0]}) does not name the run's ticket {ticket}: {hl[1][:120]!r}")
    m = re.search(r'`([^`]+)`', fl[1]) or re.match(r'^File:\s*(\S+)', fl[1])
    fpath = m.group(1).strip()
    base = os.path.basename(fpath)
    for suf in ('.test.sh', '.test.ts', '.test.js', '.ts', '.js', '.sh', '.md'):  # longest first; 2026-09-22 12:2x: TS/JS suites too (the FEED 10 code_patch briefs)
        if base.endswith(suf): base = base[:-len(suf)]; break
    t = base.upper().replace('_', '-')
    if not re.match(r'^[A-Z0-9][A-Z0-9.-]*$', t): die(f"--title-from-brief: derived title {t!r} is not caps/digits/dashes (from `File:` basename {base!r})")
    print(f"title-from-brief: {t} <- line {fl[0]} `{fl[1].strip()}` (basename {base!r}); heading line {hl[0]} names {ticket}: `{hl[1][:100]}`", file=sys.stderr)
    return t
if title_brief is not None:
    derived = _title_from_brief(title_brief)
    if title is not None and title != derived: die(f"--title-from-brief derived {derived!r} but the positional title is {title!r} — they must agree")
    title = derived

# ------------------------------------------------------------------ task type, from the run's own artefacts
# test_only inputs carry `test_file` (+ tampers); code_patch inputs carry `product_file` + `suggested_test_file` and
# no `test_file`. Anything else is refused — the READY's sentences would have no artefact to be built from.
# 2026-09-22 10:2x (Wednesday's bash_patch tooling drafter): a BASH_PATCH input has the SAME key shape as code_patch
# (product_file + suggested_test_file, no test_file — tasks/bash_patch/build_bash_input.sh), so the key predicate alone
# routed six PASS 7/7 bash runs into hold_code_patch(), which refused them for lacking a `mode: code_patch` line. The bash
# checker (tasks/bash_patch/checker.sh) prints NO `mode:` line at all — its first verdict line is `PASS B0 subject: clone
# at <tip>, …` and its checks are B0..B7. bash_patch is therefore detected from TWO artefacts of the run, which must agree:
# night_meta.json's queue_line `task=…/tasks/bash_patch/task.md` and checker.out's own shape (a `PASS B0`/`FAIL B0` line
# and no `mode:` line). The key predicate is never consulted for it.
def _detect_bash_patch():
    sig_task = None; sig_co = None
    meta_p = os.path.join(run, 'night_meta.json')
    if os.path.exists(meta_p):
        try: ql = json.load(open(meta_p)).get('queue_line', '') or ''
        except Exception: ql = ''
        mt = re.search(r'task=(\S+)', ql)
        if mt: sig_task = ('/tasks/bash_patch/' in mt.group(1))
    co_p = os.path.join(run, 'checker.out')
    if os.path.exists(co_p):
        co_t = open(co_p, errors='replace').read()
        sig_co = (re.search(r'^(PASS|FAIL) B0 ', co_t, re.M) is not None and re.search(r'^mode: ', co_t, re.M) is None)
    if sig_task is not None and sig_co is not None and sig_task != sig_co:
        die(f"task-type signals disagree: night_meta.json's task path says bash_patch={sig_task} but checker.out's shape (a B0 line and no `mode:` line) says bash_patch={sig_co}")
    return bool(sig_task if sig_task is not None else sig_co)
IS_BASH_PATCH = _detect_bash_patch()
# 2026-09-22 11:2x (Wednesday's doc_patch tooling drafter): a DOC_PATCH input (tasks/doc_patch/build_doc_input.py) carries
# product_file + defect_line and NO test file of any kind, so the key predicate below refused it as "neither". Like
# bash_patch it is detected from TWO artefacts that must agree: night_meta.json's `task=…/tasks/doc_patch/` and checker.out's
# shape (a `PASS D0`/`FAIL D0` line, no `mode:` line, no B0 line). A doc run whose input carries a test key is refused.
def _detect_doc_patch():
    sig_task = None; sig_co = None
    meta_p = os.path.join(run, 'night_meta.json')
    if os.path.exists(meta_p):
        try: ql = json.load(open(meta_p)).get('queue_line', '') or ''
        except Exception: ql = ''
        mt = re.search(r'task=(\S+)', ql)
        if mt: sig_task = ('/tasks/doc_patch/' in mt.group(1))
    co_p = os.path.join(run, 'checker.out')
    if os.path.exists(co_p):
        co_t = open(co_p, errors='replace').read()
        sig_co = (re.search(r'^(PASS|FAIL) D0 ', co_t, re.M) is not None and re.search(r'^mode: ', co_t, re.M) is None
                  and re.search(r'^(PASS|FAIL) B0 ', co_t, re.M) is None)
    if sig_task is not None and sig_co is not None and sig_task != sig_co:
        die(f"task-type signals disagree: night_meta.json's task path says doc_patch={sig_task} but checker.out's shape (a D0 line, no `mode:` line, no B0 line) says doc_patch={sig_co}")
    is_doc = bool(sig_task if sig_task is not None else sig_co)
    if is_doc and ('test_file' in inp or 'suggested_test_file' in inp): die(f"the run is doc_patch but input.json carries a test key: {sorted(k for k in inp if k in ('test_file', 'suggested_test_file'))}")
    if is_doc and ('product_file' not in inp or not isinstance(inp.get('defect_line'), dict)): die(f"the run is doc_patch but input.json lacks product_file / defect_line: keys {sorted(inp)}")
    return is_doc
IS_DOC_PATCH = (not IS_BASH_PATCH) and _detect_doc_patch()
IS_CODE_PATCH = (not IS_BASH_PATCH) and (not IS_DOC_PATCH) and ('test_file' not in inp and 'product_file' in inp and 'suggested_test_file' in inp)
if not IS_BASH_PATCH and not IS_DOC_PATCH and not IS_CODE_PATCH and 'test_file' not in inp:
    die(f"input.json is neither test_only (test_file) nor code_patch (product_file + suggested_test_file), and the run's artefacts name neither bash_patch nor doc_patch: keys {sorted(inp)}")

def _read(path, what):
    """Read an artefact the READY will quote; a missing one is a refusal, never a blank."""
    if not os.path.exists(path): die(f"{what} is missing: {path}")
    return open(path, errors='replace').read()

def _line(text, prefix, what):
    l = next((l.rstrip() for l in text.splitlines() if l.startswith(prefix)), '')
    if not l: die(f"checker.out has no line starting {prefix!r} — {what} cannot be asserted")
    return l

def _split_sections(lines):
    """[(hdr_minus, hdr_plus, [(hunk_header, [body lines])...])] from a unified diff's lines."""
    secs = []; i = 0
    while i < len(lines):
        if lines[i].startswith('--- ') and i + 1 < len(lines) and lines[i+1].startswith('+++ '):
            secs.append((lines[i], lines[i+1], [])); i += 2; continue
        if lines[i].startswith('@@'):
            if not secs: die(f"hunk header before any file header in patch: {lines[i]!r}")
            secs[-1][2].append((lines[i], [])); i += 1; continue
        if secs and secs[-1][2] and lines[i] != '':
            secs[-1][2][-1][1].append(lines[i])
        i += 1
    return secs

def _apply_to_tip(patch_file, files_at_tip, scratch_parent, opts=()):
    """git apply -p1 (strict unless `opts` — doc_patch passes the checker's own D2 options) of patch_file onto the tip's
    file content from input.json['files'], in a tempdir (no repository, no checkout: `git apply` outside a repo acts on
    plain files). Returns (rc, stderr, {path: sha256 of the file after}). The tempdir is removed afterwards."""
    import tempfile, hashlib, shutil
    td = tempfile.mkdtemp(prefix='hold_ready_apply_', dir=scratch_parent)
    try:
        for path, content in files_at_tip.items():
            fp = os.path.join(td, path); os.makedirs(os.path.dirname(fp), exist_ok=True)
            open(fp, 'w').write(content)
        r = subprocess.run(['git', 'apply', '-p1', *opts, patch_file], cwd=td, capture_output=True, text=True)
        digests = {p: hashlib.sha256(open(os.path.join(td, p), 'rb').read()).hexdigest() for p in files_at_tip}
        return r.returncode, r.stderr.strip(), digests
    finally:
        shutil.rmtree(td, ignore_errors=True)

def hold_code_patch():
    tip = inp['tip']; product_file = inp['product_file']; test_file = inp['suggested_test_file']
    runner = (inp.get('repo') or {}).get('test_runner', '').split(' ')[0] or inp.get('runner') or '?'
    co = _read(os.path.join(run, 'checker.out'), 'checker.out')
    if not re.search(r'^mode: code_patch', co, re.M): die("checker.out has no 'mode: code_patch' line — the input says code_patch but the checker did not run it as one")

    # 1. verdict — from checker.out
    m = re.search(r'^RESULT: (PASS|FAIL) \((\d+)/(\d+)\)', co, re.M)
    if not m or m.group(1) != 'PASS':
        fails = [l.strip() for l in co.splitlines() if l.startswith('FAIL ')]
        die(f"checker.out RESULT is not PASS: {m.group(0) if m else next((l for l in co.splitlines() if l.startswith('RESULT:')), 'absent')}; FAIL lines: {fails[:3]}")
    passed, total = m.group(2), m.group(3)
    a_lines = {k: _line(co, f'PASS {k} ', k) for k in ('A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7')}
    # A3c is absent from checker.out for a DELETION-ONLY product hunk (the checker prints an INFO A3i 'skipped — no expected + lines'
    # line and no A3c line at all — 2026-09-22 KS-629 LIVENESSRT). It is accepted ONLY under that exact shape, asserted below at step 3
    # against numstat (+0 on the product file); any other absence still refuses.
    a_lines['A3c'] = next((l.rstrip() for l in co.splitlines() if l.startswith('PASS A3c ')), '')
    a3i_skipped = next((l.rstrip() for l in co.splitlines() if l.startswith('INFO A3i skipped')), '')
    summary_line = _line(co, 'SUMMARY ', 'SUMMARY')
    a3i_line = next((l.rstrip() for l in co.splitlines() if l.startswith('A3i:')), '')

    # 2. the patch and its sections — every file the READY names must exist
    patch_path = os.path.join(chk, 'patch.diff'); patch_text = _read(patch_path, 'patch.diff')
    sections = json.loads(_read(os.path.join(chk, 'sections.json'), 'sections.json'))
    if not sections: die("sections.json is empty")
    hunk_audit = _read(os.path.join(chk, 'hunk_audit.out'), 'hunk_audit.out').strip().splitlines()
    hunk_audit_line = hunk_audit[0] if hunk_audit else die("hunk_audit.out is empty")
    sec_rows = []; strict_errors = []; any_recount = False
    for s in sections:
        k = s['n']; sf = s['file']
        _read(sf, f'section_{k}.diff')
        opts = _read(os.path.join(chk, f'section_{k}.opts'), f'section_{k}.opts').splitlines()
        applied_file = opts[0].strip() if opts else ''; apply_opts = opts[1].strip() if len(opts) > 1 else ''
        strict_out = _read(os.path.join(chk, f'apply_check_strict_{k}.out'), f'apply_check_strict_{k}.out').strip()
        if strict_out: strict_errors.append((k, s['path'], strict_out.splitlines()[0][:160]))
        if '--recount' in apply_opts or applied_file != sf: any_recount = True
        sec_rows.append((k, s['path'], sf, applied_file, apply_opts, s.get('hunks'), s.get('miscount'), strict_out))
    a2_line = a_lines['A2']
    strict_claimed = ('strict git apply --check' in a2_line and 'accommodation' not in a2_line)
    if (strict_errors or any_recount) and strict_claimed:
        die(f"apply_check_strict_*.out non-empty / opts carry an accommodation ({strict_errors}, recount={any_recount}) but the A2 line claims strict: {a2_line}")
    # `--directory=<subdir>` alone is a PATH MAPPING the checker records when the model's diff paths lack the repo
    # subdir (checker.sh:363-365) — it does not relax matching, and the checker's A2 still says strict. 2026-09-22
    # KS-1028: refused wrongly as a rewrite. Any OTHER opt under a strict A2 is still a contradiction.
    _non_dir = [(r[0], r[4]) for r in sec_rows if r[4] != '' and not all(t.startswith('--directory=') for t in r[4].split())]
    if strict_claimed and _non_dir: die(f"A2 claims strict but a section's opts are not empty (beyond --directory=): {_non_dir}")
    strict_ok = strict_claimed and not strict_errors and not any_recount
    cat_ok = (subprocess.run('cat ' + ' '.join("'" + r[2] + "'" for r in sec_rows) + " | cmp -s - '" + patch_path + "'", shell=True).returncode == 0)

    # 3. touched set — numstat.out (the checker's own) must equal the declared {product_file, suggested_test_file}
    numstat = _read(os.path.join(chk, 'numstat.out'), 'numstat.out').strip()
    ns_rows = [l.split('\t') for l in numstat.splitlines() if l.strip()]
    touched = sorted({r[2] for r in ns_rows if len(r) == 3})
    # The checker's A3 predicate (tasks/code_patch/checker.sh A3): touched == { product_file , exactly ONE test under
    # test_dir that is not the reference test }, nothing else. `suggested_test_file` is the builder's SUGGESTION (one slug
    # per ticket) — a split ticket's second part names its own test, and the checker accepts it; so must this tool.
    # (2026-09-22 04:4x: KS-1231 PART B refused on suggested_test_file while its checker said PASS A3.)
    test_dir = inp.get('test_dir') or ''; ref_test = inp.get('reference_test_file') or ''
    tests_touched = [f for f in touched if f != product_file and test_dir and f.startswith(test_dir + '/')]
    others = [f for f in touched if f != product_file and f not in tests_touched]
    if product_file not in touched or len(tests_touched) != 1 or others or tests_touched[0] == ref_test:
        die(f"touched {touched} is not {{ product_file , ONE test under {test_dir} }} (product present={product_file in touched}, tests={tests_touched}, other={others}, ref={ref_test})")
    if tests_touched[0] != test_file:
        print(f"NOTE: the touched test {tests_touched[0]} differs from the builder's suggested_test_file {test_file} — the checker's A3 accepts it; the READY names the TOUCHED file", file=sys.stderr)
        test_file = tests_touched[0]
    declared = sorted({product_file, test_file})
    adds = {r[2]: r[0] for r in ns_rows if len(r) == 3}; dels = {r[2]: r[1] for r in ns_rows if len(r) == 3}
    if not a_lines['A3c']:
        if a3i_skipped and str(adds.get(product_file)) == '0':
            a_lines['A3c'] = f"[no PASS A3c line in checker.out — DELETION-ONLY product hunk: numstat.out +0/-{dels.get(product_file, '?')} on {product_file}; checker.out INFO A3i verbatim: `{a3i_skipped}`]"
        else:
            die(f"checker.out has no line starting 'PASS A3c ' — A3c cannot be asserted (accepted only for a deletion-only product hunk: needs INFO A3i skipped + numstat +0 on {product_file}; got a3i_skipped={bool(a3i_skipped)}, adds={adds.get(product_file)!r})")

    # 4. product hunk '+' lines vs the brief's expected_plus (whitespace-stripped ordered equality; A3i covers bytes)
    exp = (inp.get('defect_line') or {}).get('expected_plus') or inp.get('expected_plus') or []
    if isinstance(exp, str): exp = exp.split('\n')
    prod_sec = next((s for s in sections if s['path'] == product_file or s['path'].endswith('/' + product_file) or product_file.endswith('/' + s['path'])), None)
    if prod_sec is None: die(f"no section in sections.json for the product file {product_file}")
    prod_lines = open(prod_sec['file'], errors='replace').read().split('\n')
