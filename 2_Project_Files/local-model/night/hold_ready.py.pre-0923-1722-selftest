if title_brief is None and len(args) != 4: die(f"expected 4 positional args (run-dir golden ROWID title), got {len(args)}: {args}", 1)
if title_brief is not None and len(args) not in (3, 4): die(f"with --title-from-brief expected 3 or 4 positional args (run-dir golden ROWID [title]), got {len(args)}: {args}", 1)
