def _bash_sections(text):
    """Per `--- `/`+++ ` section: hunk headers, change lines ('+'/'-', file headers excluded), context lines (' '),
    and EMPTY lines (the trailing-blank dialect git reads as context when the header count asks for it)."""
    lines = (text[:-1] if text.endswith('\n') else text).split('\n'); secs = []; i = 0
    while i < len(lines):
        l = lines[i]
        if l.startswith('--- ') and i + 1 < len(lines) and lines[i+1].startswith('+++ '):
            secs.append({'minus': l, 'plus': lines[i+1], 'hdrs': [], 'chg': [], 'ctx': [], 'blank': 0}); i += 2; continue
        if secs:
            s = secs[-1]
            if l.startswith('@@'): s['hdrs'].append(l)
            elif l[:1] in ('+', '-'): s['chg'].append(l)
            elif l[:1] == ' ': s['ctx'].append(l)
            elif l == '': s['blank'] += 1
        i += 1
    return secs

