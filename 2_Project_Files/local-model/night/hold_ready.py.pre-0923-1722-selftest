def _doc_section(lines, sub):
    """The checker's own section rule (tasks/doc_patch/checker.sh D4): `# ` runs to the next heading of any level,
    `### ` to the next of level <= 3, otherwise `## ` to the next `## `. Returns (start, end) or None."""
    if sub.startswith('# '):
        start = next((i for i, l in enumerate(lines) if l.startswith('# ') and not l.startswith('## ') and sub in l), None)
        if start is None: return None
        return start, next((i for i in range(start + 1, len(lines)) if lines[i].startswith('#')), len(lines))
    if sub.startswith('### '):
        start = next((i for i, l in enumerate(lines) if l.startswith('### ') and sub in l), None)
        if start is None: return None
        return start, next((i for i in range(start + 1, len(lines)) if re.match(r'^#{1,3} ', lines[i])), len(lines))
    start = next((i for i, l in enumerate(lines) if l.startswith('## ') and sub in l), None)
    if start is None: return None
    return start, next((i for i in range(start + 1, len(lines)) if lines[i].startswith('## ')), len(lines))

