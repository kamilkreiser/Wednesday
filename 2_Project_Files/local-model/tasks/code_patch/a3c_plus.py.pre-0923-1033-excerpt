#!/usr/bin/env python3
"""a3c_plus.py <input.json> <product section file> — every line the BRIEF adds must be added.

2026-09-15 22:0x (KS-976 B r1): the model changed both `must_change` sites (A3b 2/2) and DROPPED the insert-only
hunk that defined the helper those sites call — tsc failed three assertions later. A3b sees removals only; this
is its twin for ADDITIONS: `defect_line.expected_plus` (built from the '+' lines of the brief's edit blocks) must
each appear as a '+' line in the PRODUCT section, compared whitespace-stripped. Prints the missing lines, one per
line; exit 0 when none. Used by checker.sh as A3c; runnable standalone on a run's artefacts (that is the arm).

2026-09-15 22:5x (KS-999 r1, IMPROVEMENTS row 89): the model appended a trailing `// KS-999: …` comment to an
otherwise byte-identical product line and A3c called the addition ABSENT — a false FAIL on a correct hunk (the
KS-1074 B/C outputs carried the same trailing comments and were never measured by A3c, which only runs with a
must_change site). A '+' line now also matches when it equals the expected line AFTER a trailing `// …` comment
is removed. Exact match is tried first; the strip is applied to the '+' line only, never to the expectation, and
only at the LAST ` //` — a `//` inside a string earlier on the line is untouched because the exact match wins.
Arms: local-model/tests/a3c_arms.sh (real KS-999 output → PASS; a dropped hunk → FAIL; an altered token → FAIL)."""
import json
import re
import sys

_TRAIL = re.compile(r"\s+//[^\n]*$")


_UESC = re.compile(r"\\u([0-9a-fA-F]{4})")


def _unescape(line: str) -> str:
    # 2026-09-15 23:5x (KS-1133 A r2 retry): the model echoed the JSON input's `\u2192` / `\u2014` escapes into the
    # TS source instead of the characters. Inside a single-quoted TS string a `\uXXXX` escape yields the same
    # runtime character, so the '+' line is compared with the escapes DECODED; the expectation is never touched.
    return _UESC.sub(lambda m: chr(int(m.group(1), 16)), line)


def _norm(line: str) -> str:
    return _unescape(line).strip()


def _without_trailing_comment(line: str) -> str:
    return _TRAIL.sub("", _unescape(line)).strip()


d = json.load(open(sys.argv[1], encoding="utf-8"))
exp = d.get("defect_line", {}).get("expected_plus", [])
sec = open(sys.argv[2], encoding="utf-8", errors="replace").read().split("\n")
plus = [l[1:] for l in sec if l.startswith("+") and not l.startswith("+++")]
added = {_norm(l) for l in plus}
added_nocomment = {_without_trailing_comment(l) for l in plus}
missing = [e for e in exp if e.strip() and e.strip() not in added and e.strip() not in added_nocomment]
for m in missing:
    print(m)
if missing:
    sys.exit(1)

# A3d (2026-09-15 23:4x, KS-1133 A r1): the model copied the brief's fenced block and marked its CONTEXT lines
# (`summary:` / `description:`) as '+' beside the one real addition. `git apply --recount` APPLIED it, so the file
# carried a duplicated `description:` and tsc failed TS1005 three assertions later — a corrupt hunk that reads as a
# model failure. Rule: in a brief-driven task every product '+' line is in the brief's expected set; a '+' line that
# is NOT expected and whose stripped text equals a line of the TIP product file is a context line marked as an
# addition. Refused by name (exit 2) so RETRY-ONCE can feed the lines back. Short lines (< 8 chars: braces, blanks)
# are never flagged — a brace the brief did not spell out is a different, quieter defect.
# 2026-09-16 00:3x TEST-ONLY twin: in test-only mode the file the diff touches is the TEST file, so the checker
# passes ITS path as argv[3] and A3d compares against that file's tip (present in `files` when test_file= is
# pinned; a NEW test file has no tip lines, so A3d is inert for it — correct). No argv[3] = the product file.
_pf = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] else (d.get("product_file") or "")
_tip = set()
for _p, _txt in (d.get("files") or {}).items():
    if _p == _pf or _p.endswith(_pf) or _pf.endswith(_p):
        _tip = {l.strip() for l in _txt.split("\n") if len(l.strip()) >= 8}
_expected = {e.strip() for e in exp} | {_without_trailing_comment(e) for e in exp}
# 2026-09-16 06:5x (KS-1127 r1): a WHOLE-BLOCK REWRITE removes a run of lines and re-adds them with the edits inside —
# every re-added unchanged line is a tip line marked '+', but it is ALSO a '-' line of the same section, so nothing is
# duplicated in the applied file (the applied runner was byte-identical to the hand fix). A3d's target is DUPLICATION
# (KS-1133: a context line added beside its original). So a '+' tip line that the section also REMOVES is a rewrite,
# not a context-marked-as-addition, and is not flagged. A '+' tip line with no matching '-' still is.
_removed = {_norm(l[1:]) for l in sec if l.startswith("-") and not l.startswith("---")}
context_as_plus = [l for l in plus if len(_norm(l)) >= 8 and _norm(l) not in _expected
                   and _without_trailing_comment(l) not in _expected and _norm(l) in _tip
                   and _norm(l) not in _removed]
for c in context_as_plus:
    print("A3D " + c.strip())
sys.exit(2 if context_as_plus else 0)
