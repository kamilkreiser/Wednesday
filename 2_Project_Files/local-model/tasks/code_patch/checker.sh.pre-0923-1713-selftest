# BEGIN tsc_test_types (cut out verbatim by tests/checker_tsc_types_by_runner_arms.sh)
tsc_test_types() {
  # tsc_test_types <svc_dir> -> one line "<types>\t<why>"; <types> is empty when the runner could not be told
  python3 - "$1" <<'PYEOF'
import json, os, sys
d = sys.argv[1]; jest = []; vit = []
names = sorted(os.listdir(d)) if os.path.isdir(d) else []
jest += [f for f in names if f.startswith("jest.config.")]
vit += [f for f in names if f.startswith("vitest.config.")]
p = os.path.join(d, "package.json")
if os.path.isfile(p):
    try:
        j = json.load(open(p))
    except Exception:
        j = {}
    toks = str((j.get("scripts") or {}).get("test") or "").replace("&&", " ").split()
    if "jest" in toks: jest.append("scripts.test=jest")
    if "vitest" in toks: vit.append("scripts.test=vitest")
    deps = {**(j.get("dependencies") or {}), **(j.get("devDependencies") or {})}
    jest += [k for k in ("jest", "ts-jest") if k in deps]
    vit += [k for k in ("vitest",) if k in deps]
why = f"jest:{jest or '-'} vitest:{vit or '-'}".replace("'", "")
if jest and not vit: print("node,jest\t" + why)
elif vit and not jest: print("node,vitest/globals\t" + why)
else: print("\t" + why)
PYEOF
}
