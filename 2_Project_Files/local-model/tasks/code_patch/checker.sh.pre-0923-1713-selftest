      # the PASS A2 text above is kept byte-identical to the pre-0918 checker (recorded runs' PASS/FAIL lines stay comparable);
      # the guard's measurement and the context-ws refusal go on the section line below and in fuzzy_guard_<k>.out / ctxws_<k>.out
      echo "section $k $SEC_PATH: applies ONLY FUZZY (-C1): $(head -1 "$REP/apply_check_fuzzy_$k.out") — placement guard: $(tr '\n' ';' < "$REP/fuzzy_guard_$k.out") context-ws: $CTXWS_NOTE"
