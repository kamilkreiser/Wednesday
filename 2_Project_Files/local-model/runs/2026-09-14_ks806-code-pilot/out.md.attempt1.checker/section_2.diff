+async function verify(
+  extra: Record<string, unknown> = {},
+  path: '/verify' | '/authenticate' = '/verify',
+): Promise<{ status: number; body: string }> {
+  const res = await fetch(`${base}/api/auth/wallet${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      challengeId: CHALLENGE_ID,
+      walletAddress: WALLET_ADDR1,
+      signature: 'stub-signature',
+      key: 'stub-key',
+      ...extra,
+    }),
+  });
+  return { status: res.status, body: await res.text() };
+}
+
+describe('KS-806: synthetic email is injective (no collision for same prefix)', () => {
+  it('🔴 KS-806 — two addresses with same 8-char prefix produce different synthetic emails (fixes collision)', async () => {
+    const createdUsers: any[] = [];
+    vi.mocked(userRepo.createUser).mockImplementation((user) => {
+      createdUsers.push(user);
+      return user;
+    });
+
+    const res1 = await verify({ walletAddress: WALLET_ADDR1, challengeId: CHALLENGE_ID });
+    expect(res1.status).toBe(200);
+    const res2 = await verify({ walletAddress: WALLET_ADDR2, challengeId: CHALLENGE_ID });
+    expect(res2.status).toBe(200);
+
+    expect(createdUsers[0].email).not.toBe(createdUsers[1].email);
+  });
+
+  it('CONTROL — two addresses with different 8-char prefixes produce different synthetic emails', async () => {
+    const createdUsers: any[] = [];
+    vi.mocked(userRepo.createUser).mockImplementation((user) => {
+      createdUsers.push(user);
+      return user;
+    });
+
+    const res1 = await verify({ walletAddress: WALLET_ADDR3, challengeId: CHALLENGE_ID });
+    expect(res1.status).toBe(200);
+    const res2 = await verify({ walletAddress: WALLET_ADDR4, challengeId: CHALLENGE_ID });
+    expect(res2.status).toBe(200);
+
+    expect(createdUsers[0].email).not.toBe(createdUsers[1].email);
+  });
+});
