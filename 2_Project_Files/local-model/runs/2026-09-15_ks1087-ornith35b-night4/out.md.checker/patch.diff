+// =============================================================================
+// KS-1087 — approve must NOT delete the pending document when originate fails
+// =============================================================================
+//
+// The POST /api/workflow-instances/:id/approve handler forwards the pending
+// document to originate's `/api/documents`. Before the fix it did so fire-and-forget
+// and unconditionally deleted the pending document from Redis plus answered 200
+// "approved" regardless of originate's response. If originate returned 401 or was
+// unreachable the caller was told the document had been created while it never
+// existed anywhere. After the fix the forward is awaited and only on a 2xx does
+// the handler delete the pending doc and answer `approved`; otherwise it keeps the
+// pending doc and answers 502 with an ORIGINATE_FORWARD_FAILED error.
+//
+// Driven against the real router with a stub HTTP server as originate (same shape
+// as ks1071), because the handler uses node's http.request directly.
+// =============================================================================
+
+import { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';
+import express from 'express';
+import http from 'node:http';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { RequestHandler } from 'express';
+
+const DOC_ID = 'doc-ks1087';
+const INSTANCE_ID = 'wfi-ks1087';
+let gateway: Server;
+let gatewayPort: number;
+let originateStub: Server | null = null;
+let originateUrl: string;
+/** Status code the current cell wants the stub to return for POST /api/documents. */
+let stubStatus = 201;
+/** Body the stub returns alongside that status. */
+let stubBody: Record<string, unknown> = {};
+
+beforeAll(async () => {
+  // Stub originate: answers any path we don't care about with 404, but serves
+  // POST /api/documents with whatever status/body this cell configured.
+  originateStub = http.createServer((req, res) => {
+    if (req.method === 'POST' && req.url === '/api/documents') {
+      let body = '';
+      req.on('data', (c: Buffer) => { body += c.toString(); });
+      req.on('end', () => {
+        res.writeHead(stubStatus, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify(stubBody));
+      });
+      return;
+    }
+    res.writeHead(404);
+    res.end('{}');
+  });
+  originateStub.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => originateStub!.once('listening', () => r()));
+  const port = (originateStub!.address() as AddressInfo).port;
+  originateUrl = `http://127.0.0.1:${port}`;
+});
+
+afterEach(() => {
+  stubStatus = 201;
+  stubBody = {};
+});
+
+afterAll(async () => {
+  if (gateway) await new Promise<void>((r) => gateway.close(() => r()));
+  if (originateStub) await new Promise<void>((r) => originateStub.close(() => r()));
+});
+
+function buildApp(): express.Express {
+  const app = express();
+  const mockBodyParser: RequestHandler = express.json({ limit: '1mb' });
+  const deletePendingDocument = vi.fn().mockResolvedValue(undefined);
+  return { app, deletePendingDocument };
+}
+
+async function startGateway(app: express.Express): Promise<number> {
+  const server = app.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => server.once('listening', () => r()));
+  return (server.address() as AddressInfo).port;
+}
+
+async function approve(gatewayPort_: number): Promise<Response> {
+  return fetch(`http://127.0.0.1:${gatewayPort_}/api/workflow-instances/${INSTANCE_ID}/approve`, {
+    method: 'POST',
+    headers: { Authorization: 'Bearer t', 'Content-Type': 'application/json' },
+    body: JSON.stringify({ comments: 'ok' }),
+  });
+}
+
+/** Build the router with redisService wired so the handler enters the pending-doc branch. */
+function makeDeps(deletePendingDocument: ReturnType<typeof vi.fn>) {
+  return {
+    authenticateToken: () => (_req, _res, next) => next(),
+    mockBodyParser: express.json({ limit: '1mb' }) as RequestHandler,
+    query: vi.fn().mockResolvedValue({ rows: [] }) as never,
+    isDbAvailable: () => false,
+    log: () => undefined,
+    memWorkflowToDocumentMap: new Map<string, string>(),
+    memRejectedDocuments: new Map(),
+    dbSaveRejection: vi.fn().mockResolvedValue(undefined),
+    ADMIN_ROLES: ['ADMIN'],
+    enforceDocumentTypeRules: vi.fn().mockResolvedValue({ ok: true, docType: {} } as any),
+    createWorkflowInstanceIfRequired: vi.fn().mockResolvedValue({ gated: false }),
+    meetsVerificationLevel: () => true,
+    services: { originate: { url: originateUrl } } as Record<string, { name: string; url: string; healthPath: string; requiresAuth: boolean }> & { originate: { url: string } },
+    redisService: {
+      getWorkflowInstance: vi.fn().mockImplementation(async (id: string) => {
+        if (id === INSTANCE_ID) {
+          // Final step — lastIdx == steps.length - 1 — triggers the forward-to-originate path.
+          return {
+            status: 'pending_approval',
+            documentId: DOC_ID,
+            currentStepIndex: 0,
+            steps: [{ name: 'Approve', approverType: 'role', approverValue: 'admin', status: 'approved' }],
+          };
+        }
+        return null;
+      }),
+      getAllWorkflowInstances: vi.fn().mockResolvedValue([]),
+      setWorkflowInstance: vi.fn().mockResolvedValue(undefined),
+      getPendingDocument: vi.fn().mockImplementation(async (docId: string) => {
+        if (docId === DOC_ID) {
+          return { title: 'Degree', contentHash: 'h', createdBy: 'u1' };
+        }
+        return null;
+      }),
+      deletePendingDocument,
+      getWorkflowDocumentMapping: vi.fn().mockResolvedValue(null),
+      getNotificationSettings: vi.fn().mockResolvedValue({}),
+      getAllDocumentTypes: vi.fn().mockResolvedValue([]),
+      getRejectedDocument: vi.fn().mockResolvedValue(null),
+      setRejectedDocument: vi.fn().mockResolvedValue(undefined),
+    } as never,
+  };
+}
+
+describe('KS-1087 — approve keeps pending doc on originate failure', () => {
+  it('🔴 KS-1087 — originate 401: no 200 approved, and the pending document survives', async () => {
+    stubStatus = 401;
+    const { app, deletePendingDocument } = buildApp();
+    const { createVerificationRoutes } = await import('../routes/verification');
+    app.use(createVerificationRoutes(makeDeps(deletePendingDocument)));
+    gatewayPort = await startGateway(app);
+    gateway = undefined as unknown as Server; // keep reference for afterAll cleanup
+    const res = await approve(gatewayPort);
+    expect(res.status).not.toBe(200);
+    expect(res.status).toBe(502);
+    expect(deletePendingDocument).not.toHaveBeenCalled();
+  });
+
+  it('🔴 KS-1087 — originate unreachable: the pending document survives', async () => {
+    // Point at a closed port so http.request rejects with ECONNREFUSED.
+    const badUrl = `http://127.0.0.1:${(gateway?.address() as AddressInfo | null)?.port ?? 1}`;
+    const { app, deletePendingDocument } = buildApp();
+    const deps = makeDeps(deletePendingDocument);
+    deps.services.originate.url = badUrl;
+    const { createVerificationRoutes } = await import('../routes/verification');
+    app.use(createVerificationRoutes(deps));
+    gatewayPort = await startGateway(app);
+    const res = await approve(gatewayPort);
+    expect(res.status).not.toBe(200);
+    expect(res.status).toBe(502);
+    expect(deletePendingDocument).not.toHaveBeenCalled();
+  });
+
+  it('KS-1087 control — originate 201: approved and the pending document is deleted', async () => {
+    stubStatus = 201;
+    const { app, deletePendingDocument } = buildApp();
+    const { createVerificationRoutes } = await import('../routes/verification');
+    app.use(createVerificationRoutes(makeDeps(deletePendingDocument)));
+    gatewayPort = await startGateway(app);
+    const res = await approve(gatewayPort);
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.success).toBe(true);
+    expect(body.status).toBe('approved');
+    expect(deletePendingDocument).toHaveBeenCalledTimes(1);
+  });
+});
