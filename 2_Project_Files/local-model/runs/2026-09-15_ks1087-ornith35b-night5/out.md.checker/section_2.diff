--- /dev/null
+++ b/services/api-gateway/src/__tests__/ks1087-workflow-approve-deletes-the-pending-document.test.ts
@@ -0,0 +1,146 @@
+// =============================================================================
+// KS-1087 — workflow approve must NOT answer 200 "approved" without reading
+// originate's response. A refused forward (e.g. 401) or unreachable service
+// MUST keep the pending document and return an error.
+// =============================================================================
+
+import { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';
+import express from 'express';
+import http from 'node:http';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { RequestHandler } from 'express';
+
+const DOC_ID = 'doc-ks1087';
+const INSTANCE_ID = 'wfi-ks1087';
+let gateway: Server;
+let gatewayPort: number;
+let stubServer: Server | null = null;
+let stubPort: number | null = null;
+
+beforeAll(async () => {
+  const mockBodyParser: RequestHandler = express.json({ limit: '1mb' });
+
+  const app = express();
+  app.use(
+    createVerificationRoutes({
+      authenticateToken: () => (req, _res, next) => {
+        (req as any).user = { userId: 'u1', email: 'u@secuura.local', role: 'ADMIN', organizationId: 'org-1', verificationLevel: 'FULL' };
+        next();
+      },
+      mockBodyParser,
+      query: vi.fn(),
+      isDbAvailable: () => false,
+      redisService: {
+        getWorkflowInstance: async (id: string) => {
+          if (id === INSTANCE_ID) {
+            return {
+              id: INSTANCE_ID,
+              status: 'pending_approval',
+              currentStepIndex: 0,
+              steps: [{ name: 'Approve', approverType: 'role', approverValue: 'admin', status: 'pending' }],
+              documentId: DOC_ID,
+            };
+          }
+          return null;
+        },
+        getAllWorkflowInstances: async () => [],
+        setWorkflowInstance: async () => undefined,
+        getPendingDocument: async (id: string) => {
+          if (id === DOC_ID) {
+            return { title: 'Test Doc', contentHash: 'abc', createdBy: 'creator-id' };
+          }
+          return null;
+        },
+        deletePendingDocument: vi.fn().mockResolvedValue(undefined),
+        getRejectedDocument: async () => null,
+        setRejectedDocument: async () => undefined,
+        getNotificationSettings: async () => ({}),
+        getWorkflowDocumentMapping: async () => null,
+        getAllDocumentTypes: async () => [],
+      } as never,
+      services: { originate: { url: `http://127.0.0.1:${stubPort}` } } as never,
+      log: () => {},
+      memWorkflowToDocumentMap: new Map(),
+      memRejectedDocuments: new Map(),
+      dbSaveRejection: vi.fn(),
+      ADMIN_ROLES: ['ADMIN'],
+      enforceDocumentTypeRules: vi.fn(async () => ({ ok: true, docType: {} })),
+      createWorkflowInstanceIfRequired: vi.fn(async () => ({ gated: false })),
+      meetsVerificationLevel: () => true,
+    }),
+  );
+
+  gateway = app.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => gateway.once('listening', () => r()));
+  gatewayPort = (gateway.address() as AddressInfo).port;
+});
+
+afterAll(async () => {
+  await new Promise<void>((r) => gateway.close(() => r()));
+  if (stubServer) {
+    stubServer.close();
+    await new Promise<void>((r) => stubServer!.once('close', () => r()));
+  }
+});
+
+async function setupStub(statusCode: number): Promise<Server> {
+  const server = http.createServer((_req, res) => {
+    let body = '';
+    _req.on('data', (c: Buffer) => { body += c.toString(); });
+    _req.on('end', () => {
+      res.writeHead(statusCode, { 'Content-Type': 'application/json' });
+      res.end(JSON.stringify({ id: DOC_ID, status: statusCode === 201 ? 'created' : 'error' }));
+    });
+  });
+  server.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => server.once('listening', () => r()));
+  return server;
+}
+
+function closeStub(server: Server | null) {
+  if (!server) return;
+  server.close();
+}
+
+describe('KS-1087 — workflow approve keeps pending document on originate failure', () => {
+  it('🔴 KS-1087 — originate 401: no 200 approved, and the pending document survives', async () => {
+    // Arrange: stub answers 401 Unauthorized.
+    const server = await setupStub(401);
+    const port = (server.address() as AddressInfo).port;
+    stubPort = port;
+
+    try {
+      // Act: call the approve endpoint.
+      const response = await fetch(`http://127.0.0.1:${gatewayPort}/api/workflow-instances/${INSTANCE_ID}/approve`, {
+        method: 'POST',
+        headers: { Authorization: 'Bearer t', 'Content-Type': 'application/json' },
+      });
+
+      // Assert: should NOT be a successful approval.
+      expect(response.status).not.toBe(200);
+      
+      // Assert: deletePendingDocument was NOT called because forward failed.
+      expect(vi.mocked(require('../services/redis').default.deletePendingDocument)).not.toHaveBeenCalled();
+    } finally {
+      closeStub(stubServer);
+      stubServer = null;
+    }
+  });
+
+  it('🔴 KS-1087 — originate unreachable: the pending document survives', async () => {
+    // Arrange: point URL at a closed port to simulate network error.
+    stubPort = 9999; // Closed port.
+    
+    try {
+      // Act: call the approve endpoint.
+      const response = await fetch(`http://127.0.0.1:${gatewayPort}/api/workflow-instances/${INSTANCE_ID}/approve`, {
+        method: 'POST',
+        headers: { Authorization: 'Bearer t', 'Content-Type': 'application/json' },
+      });
+
+      // Assert: should NOT be a successful approval.
+      expect(response.status).not.toBe(200);
+      
+      // Assert: deletePendingDocument was NOT called because forward failed.
+      expect(vi.mocked(require('../services/redis').default.deletePendingDocument)).not.toHaveBeenCalled();
+    } finally {
+      closeStub(stubServer);
+      stubServer = null;
+    }
+  });
+
+  it('KS-1087 control — originate 201: approved and the pending document is deleted', async () => {
+    // Arrange: stub answers 201 Created (success case).
+    const server = await setupStub(201);
+    const port = (server.address() as AddressInfo).port;
+    stubPort = port;
+
+    try {
+      // Act: call the approve endpoint.
+      const response = await fetch(`http://127.0.0.1:${gatewayPort}/api/workflow-instances/${INSTANCE_ID}/approve`, {
+        method: 'POST',
+        headers: { Authorization: 'Bearer t', 'Content-Type': 'application/json' },
+      });
+
+      // Assert: should be a successful approval.
+      expect(response.status).toBe(200);
+      const body = await response.json();
+      expect(body.success).toBe(true);
+      expect(body.status).toBe('approved');
+      
+      // Assert: deletePendingDocument WAS called because forward succeeded.
+      expect(vi.mocked(require('../services/redis').default.deletePendingDocument)).toHaveBeenCalledTimes(1);
+    } finally {
+      closeStub(stubServer);
+      stubServer = null;
+    }
+  });
+});
