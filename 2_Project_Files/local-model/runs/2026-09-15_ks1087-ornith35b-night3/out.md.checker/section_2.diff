--- /dev/null
+++ b/services/api-gateway/src/__tests__/ks1087-workflow-approve-deletes-the-pending-document.test.ts
@@ -0,0 +1,146 @@
+// =============================================================================
+// KS-1087 — approve must NOT delete the pending document unless originate answers 2xx
+// =============================================================================
+
+import { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';
+import express from 'express';
+import http from 'node:http';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { RequestHandler } from 'express';
+
+const DOC_ID = 'doc-ks1087';
+const INSTANCE_ID = 'wfi-ks1087';
+let gateway: Server;
+let gatewayPort: number;
+let stubServer: Server | null = null;
+let stubStatus: number = 201;
+
+beforeAll(async () => {
+  // Stub originate that returns whatever `stubStatus` we set per cell.
+  stubServer = http.createServer((_req, res) => {
+    res.writeHead(stubStatus, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ id: DOC_ID }));
+  });
+  stubServer.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => stubServer!.once('listening', () => r()));
+  const port = (stubServer.address() as AddressInfo).port;
+
+  const mockBodyParser: RequestHandler = express.json({ limit: '1mb' });
+  const deleteFn = vi.fn(async () => undefined);
+
+  const app = express();
+  app.use(
+    (await import('../routes/verification')).createVerificationRoutes({
+      authenticateToken: () => (_req, _res, next) => next(),
+      mockBodyParser,
+      query: vi.fn(async () => ({ rows: [] })) as never,
+      isDbAvailable: () => false,
+      redisService: {
+        getWorkflowInstance: vi.fn(async () => ({
+          status: 'pending_approval',
+          currentStepIndex: 0,
+          steps: [{ name: 'Approve', approverType: 'role', approverValue: 'admin', status: 'pending' }],
+          documentId: DOC_ID,
+        })),
+        getAllWorkflowInstances: vi.fn(async () => []),
+        getPendingDocument: vi.fn(async () => ({
+          title: 'Test Doc',
+          documentType: 'DEGREE',
+          description: '',
+          contentHash: 'c'.repeat(64),
+          data: {},
+          createdBy: 'user-1',
+        })),
+        deletePendingDocument: deleteFn,
+        setWorkflowInstance: vi.fn(async () => undefined),
+      } as never,
+      services: { originate: { url: `http://127.0.0.1:${port}` }, anchoring: {} } as never,
+      log: () => undefined,
+      memWorkflowToDocumentMap: new Map(),
+      memRejectedDocuments: new Map(),
+      dbSaveRejection: vi.fn(async () => undefined),
+      ADMIN_ROLES: ['ADMIN'],
+      enforceDocumentTypeRules: vi.fn(async () => ({ ok: true, docType: {} })) as never,
+      createWorkflowInstanceIfRequired: vi.fn(async () => ({ gated: false })) as never,
+      meetsVerificationLevel: () => true,
+    }),
+  );
+
+  gateway = app.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => gateway.once('listening', () => r()));
+  gatewayPort = (gateway.address() as AddressInfo).port;
+});
+
+afterAll(async () => {
+  if (stubServer) stubServer.close();
+  await new Promise<void>((r) => gateway.close(() => r()));
+});
+
+async function approve(): Promise<Response> {
+  return fetch(`http://127.0.0.1:${gatewayPort}/api/workflow-instances/${INSTANCE_ID}/approve`, {
+    method: 'POST',
+    headers: { Authorization: 'Bearer t', 'Content-Type': 'application/json' },
+    body: '{}',
+  });
+}
+
+describe('KS-1087 — workflow-approve keeps the pending document on non-2xx originate responses', () => {
+  it('🔴 KS-1087 — originate 401: no 200 approved, and the pending document survives', async () => {
+    // Base behaviour (before fix): returns 200 "approved" AND deletes the pending doc even though originate refused with 401.
+    stubStatus = 401;
+    const res = await approve();
+    expect(res.status).not.toBe(200);
+    expect(deleteFn).not.toHaveBeenCalled();
+  });
+
+  it('🔴 KS-1087 — originate unreachable: the pending document survives', async () => {
+    // Base behaviour (before fix): returns 200 anyway because the forward is fire-and-forget.
+    // Point at a closed port so http.request rejects.
+    stubServer!.close();
+    stubServer = null;
+    try {
+      const res = await approve();
+      expect(res.status).not.toBe(200);
+      expect(deleteFn).not.toHaveBeenCalled();
+    } finally {
+      // Restore for other tests in this suite / teardown safety.
+      stubServer = http.createServer((_req, res) => {
+        res.writeHead(stubStatus || 201, { 'Content-Type': 'application/json' });
+        res.end('{}');
+      });
+      stubServer.listen(0, '127.0.0.1');
+      await new Promise<void>((r) => stubServer!.once('listening', () => r()));
+    }
+  });
+
+  it('KS-1087 control — originate 201: approved and the pending document is deleted', async () => {
+    // Control cell that must pass both before and after the fix to prove we reach the code path.
+    stubStatus = 201;
+    deleteFn.mockClear();
+    const res = await approve();
+    expect(res.status).toBe(200);
+    const j = await res.json() as any;
+    expect(j.success).toBe(true);
+    expect(j.status).toBe('approved');
+    expect(deleteFn).toHaveBeenCalledTimes(1);
+  });
+});
