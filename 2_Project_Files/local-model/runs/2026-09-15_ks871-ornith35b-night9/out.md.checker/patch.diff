+/**
+ * KS-871 — The audit log records `req.path` AFTER the response, so a REFUSED erasure is logged with the path trimmed to `/` instead of /api/gdpr/erasures
+ */
+import { describe, it, expect, vi } from 'vitest';
+import express from 'express';
+import type { AddressInfo } from 'node:net';
+import http from 'node:http';
+import { createAuditMiddleware } from '../middleware/audit';
+
+const FLAG = 'KS_871_ERASURE_REFUSED';
+
+let capturedRows: Array<{ sql: string; params: unknown[] }> = [];
+
+function buildApp() {
+  const app = express();
+  app.use(express.json());
+
+  const queryStub = async (_sql: string, params: unknown[]) => {
+    capturedRows.push({ sql: _sql, params });
+    return { rows: [] };
+  };
+
+  app.use(createAuditMiddleware({
+    query: queryStub,
+    isDbAvailable: () => true,
+    log: () => {},
+  }));
+
+  // Refused GDPR erasure gate — responds 403 without calling next().
+  if (process.env[FLAG] === 'true') {
+    app.delete('/api/gdpr/erasures/*', (_req, res) => {
+      res.status(403).json({ error: 'forbidden' });
+    });
+  }
+
+  // Ordinary POST route that answers normally.
+  app.post('/api/documents', (_req, res) => {
+    res.status(201).json({ id: 'doc-1' });
+  });
+
+  return app;
+}
+
+async function drive(method: 'DELETE' | 'POST', path: string): Promise<number> {
+  const server = buildApp().listen(0, '127.0.0.1');
+  await new Promise<void>((r) => server.once('listening', () => r()));
+  const port = (server.address() as AddressInfo).port;
+  const status = await new Promise<number>((resolve) => {
+    const req = http.request(
+      { host: '127.0.0.1', port, path, method },
+      (res) => { res.resume(); resolve(res.statusCode ?? 0); },
+    );
+    req.on('error', () => resolve(-1));
+    req.end();
+  });
+  await new Promise<void>((r) => server.close(() => r()));
+  return status;
+}
+
+describe('KS-871 — audit log captures original request path at entry', () => {
+  it('🔴 KS-871 — details.path is the original request path, not the trimmed remainder', async () => {
+    process.env[FLAG] = 'true';
+    capturedRows = [];
+    await drive('DELETE', '/api/gdpr/erasures/abc');
+    expect(capturedRows.length).toBeGreaterThan(0);
+    const lastRow = capturedRows[capturedRows.length - 1];
+    const params = lastRow.params as unknown[];
+    const detailsStr = params[9] as string;
+    const details = JSON.parse(detailsStr);
+    expect(details.path).toBe('/api/gdpr/erasures/abc');
+  });
+
+  it('🔴 KS-871 — action/resource are derived from the original path', async () => {
+    process.env[FLAG] = 'true';
+    capturedRows = [];
+    await drive('DELETE', '/api/gdpr/erasures/abc');
+    expect(capturedRows.length).toBeGreaterThan(0);
+    const lastRow = capturedRows[capturedRows.length - 1];
+    const params = lastRow.params as unknown[];
+    // params[3] = action, params[4] = resourceType
+    const action = params[3] as string;
+    const resourceType = params[4] as string;
+    expect(action).not.toBe('unknown.delete');
+    expect(resourceType).not.toBe('unknown');
+    expect(action).toContain('gdpr');
+    expect(resourceType).toContain('erasure');
+  });
+
+  it('KS-871 control — an ordinary POST /api/documents still audits its own path', async () => {
+    delete process.env[FLAG];
+    capturedRows = [];
+    await drive('POST', '/api/documents');
+    expect(capturedRows.length).toBeGreaterThan(0);
+    const lastRow = capturedRows[capturedRows.length - 1];
+    const params = lastRow.params as unknown[];
+    const detailsStr = params[9] as string;
+    const details = JSON.parse(detailsStr);
+    expect(details.path).toBe('/api/documents');
+  });
+});
