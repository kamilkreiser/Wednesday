--- /dev/null
+++ b/services/auth/src/__tests__/ks1018-security-correctness-three-verification-store-reads.test.ts
@@ -0,0 +1,94 @@
+/**
+ * KS-1018 — three verification-store reads swallow EVERY DB error with a bare `catch {}` and answer from an in-memory map.
+ *
+ * A DB outage (connection refused, pool exhausted, pg codes 08xxx/53xxx/57xxx) was therefore indistinguishable from "no such request" — the admin review route turned it into a 404 — and nothing was logged. The fix names the error, logs it, and rethrows as ServiceUnavailableError (503) only for infrastructure failures; any other error still falls through to the in-memory map.
+ *
+ * Cells:
+ *   🔴 GET /me/verification: a refused DB connection answers 503, not 200 from memory
+ *   🔴 POST /verification/:id/review as SYSTEM_ADMIN: a refused DB connection answers 503, not 404
+ *   CONTROL non-infrastructure DB error still falls through to the in-memory map
+ */
+
+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import type { AddressInfo } from 'node:net';
+import type { Server } from 'node:http';
+import express from 'express';
+
+const SEED_USER_ID = 'aaaaaaaa-2222-4222-8222-aaaaaaaaaaaa'; // declared AFTER hoisted blocks per KS-1050 rule
+
+const state = vi.hoisted(() => ({
+  caller: { userId: SEED_USER_ID, role: 'USER', tenantId: 'tenant-default' },
+  users: new Map<string, Record<string, unknown>>(),
+}));
+
+const dbQuery = vi.hoisted(() => vi.fn());
+
+vi.mock('../repositories/userRepo', () => ({
+  getUserById: vi.fn(async (id: string) => state.users.get(id) ?? null),
+  getUserByEmail: vi.fn(async () => null),
+  createInvitedStub: vi.fn(async () => ({ user: {}, alreadyExisted: false })),
+  listUsers: vi.fn(async () => []),
+  countUsers: vi.fn(async () => 0),
+  listOrganizations: vi.fn(async () => []),
+  getOrganizationTenant: vi.fn(async () => ({ tenantId: 'tenant-default' })),
+  emailExists: vi.fn(async () => false),
+  createUser: vi.fn(async (user: Record<string, unknown>) => user),
+  updateUser: vi.fn(async () => null),
+  updateUserPlatformScope: vi.fn(async (id: string, updates: Record<string, unknown>) => {
+    const existing = state.users.get(id);
+    if (!existing) return null;
+    const merged = { ...existing, ...updates };
+    state.users.set(id, merged);
+    return merged;
+  }),
+  updateUserOrThrow: vi.fn(async () => {}),
+}));
+
+vi.mock('../middleware/authenticate', () => {
+  const injectCaller =
+    () => (req: express.Request & { user?: unknown }, _res: express.Response, next: express.NextFunction) => {
+      (req as { user: unknown }).user = { ...state.caller };
+      next();
+    };
+  return { authenticate: injectCaller, authenticateAccessOrConnector: injectCaller };
+});
+
+vi.mock('../db', () => ({ isDbAvailable: () => true, query: dbQuery }));
+vi.mock('../services/session', () => ({ revokeAllUserSessions: vi.fn(async () => 0) }));
+vi.mock('../services/password', () => ({
+  hashPassword: vi.fn(async () => 'hashed'),
+  checkPasswordStrength: vi.fn(() => ({ ok: true })),
+  verifyPassword: vi.fn(async () => true),
+}));
+vi.mock('../utils/logger', () => ({ logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn(), debug: vi.fn() } }));
+
+import { userRoutes } from '../routes/users';
+import { errorHandler } from '../middleware/errorHandler';
+
+let server: Server;
+let baseUrl: string;
+
+beforeAll(async () => {
+  const app = express();
+  app.use(express.json());
+  app.use('/', userRoutes);
+  app.use(errorHandler);
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => {
+      const { port } = server.address() as AddressInfo;
+      baseUrl = `http://127.0.0.1:${port}`;
+      resolve();
+    });
+  });
+});
+
+afterAll(async () => {
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  state.users.clear();
+  state.users.set(SEED_USER_ID, {
+    id: SEED_USER_ID, email: 'a@example.com', role: 'USER', status: 'ACTIVE', verificationLevel: 'BASIC', tenantId: 'tenant-default'
+  });
+  state.caller = { userId: SEED_USER_ID, role: 'USER', tenantId: 'tenant-default' };
+  // Default to a non-infrastructure error so the control cell passes without extra setup
+  if (!dbQuery.mockRejectedValue) dbQuery.mockResolvedValue({ rows: [] });
+});
+
+const infraError = Object.assign(new Error('connect ECONNREFUSED 127.0.0.1:5432'), { code: 'ECONNREFUSED' });
+
+describe('KS-1018 — three verification-store reads swallow EVERY DB error with a bare catch and answer from memory', () => {
+  it('🔴 KS-1018 — GET /me/verification: a refused DB connection answers 503, not 200 from memory', async () => {
+    dbQuery.mockRejectedValue(infraError);
+    const res = await fetch(`${baseUrl}/me/verification`);
+    expect(res.status).toBe(503);
+    const body = await res.json();
+    expect(body.error.code).toBe('SERVICE_UNAVAILABLE');
+  });
+
+  it('🔴 KS-1018 — POST /verification/:id/review as SYSTEM_ADMIN: a refused DB connection answers 503, not 404', async () => {
+    state.caller.role = 'SYSTEM_ADMIN';
+    (state.users.get(SEED_USER_ID) as any).role = 'SYSTEM_ADMIN';
+    dbQuery.mockRejectedValue(infraError);
+    const res = await fetch(`${baseUrl}/verification/vr-test/review`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'approve' }),
+    });
+    expect(res.status).toBe(503);
+    const body = await res.json();
+    expect(body.error.code).toBe('SERVICE_UNAVAILABLE');
+  });
+
+  it('KS-1018 control — a non-infrastructure DB error still falls through to the in-memory map', async () => {
+    dbQuery.mockRejectedValue(Object.assign(new Error('relation does not exist'), { code: '42P01' }));
+    const res = await fetch(`${baseUrl}/me/verification`);
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.data.requests).toEqual([]);
+  });
+});
