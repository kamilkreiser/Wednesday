#!/bin/bash
# wake_watch.sh — Wednesday's fleet wake-up tripwire (built 2026-08-05 after
# Kam caught an in-pane plan-confirmation sitting unseen ~10 min; rewritten
# same night for macOS bash 3.2 — no associative arrays).
#
# Runs as a BACKGROUND TASK from Wednesday's own session: polls every 60s and
# EXITS (task-notification wakes Wednesday) when either:
#   (a) MAIL: a new message lands in wednesday-agent@ (timestamp > baseline), or
#   (b) PANE: an agent pane (not wednesday/fleet-monitor) sits idle at a
#       prompt with unchanged content for STABLE_N consecutive samples, or
#       (2026-09-16) waits on background subagents with unchanged content past
#       WAKE_WATCH_SUBAGENT_WAIT_MIN (default 60) — a wait is WORKING, not idle,
#       and a turn-ended pane whose only busy marker is a monitor/shell footer is
#       HOLDING, not frozen-busy (both were false wakes; see the leg below), or
#   (c) CTX: any Claude pane's statusline ctx% crosses a working-rhythm §2
#       threshold — 50% admission gate + checkpoint, 65% mechanical tails
#       only (added 2026-08-10, WED-84 rotation build; taps are questions
#       about task state, not wrap commands — sessions rotate at task
#       boundaries). INCLUDES wednesday's own pane — she is read
#       from outside like everyone else. Each threshold fires ONCE per pane
#       per session-generation: markers persist in cockpit/state/ (NOT this
#       run's temp dir) keyed by pane_id+pane_pid, so runner re-arms never
#       re-fire but a fresh session in the same pane starts clean.
# Pane state lives in files under a per-run temp dir (bash-3.2-safe).
# The background runner caps runs at 10 min, so this re-arms on that heartbeat.
#
# Usage: wake_watch.sh <baseline-iso-ts> [stable_n] [interval_s]
set -u
BASELINE="${1:?usage: wake_watch.sh <baseline-iso-ts> [stable_n] [interval_s]}"
STABLE_N="${2:-3}"
INTERVAL="${3:-60}"
ENVF="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/4_Credentials/.env"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
STATE_DIR="$(mktemp -d /tmp/wake_watch.XXXXXX)"
trap 'rm -rf "$STATE_DIR"' EXIT
# Test hook (rotation build 2026-08-10): point pane checks at another tmux
# session so fire-path tests never touch the live fleet. Production = fleet.
FLEET="${WAKE_WATCH_TMUX_SESSION:-fleet}:0"
# Persistent ctx-threshold markers (survive re-arm; per-generation, see (c))
CTX_STATE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/state"
mkdir -p "$CTX_STATE"
# markers older than 3 days belong to dead pane generations — prune quietly
find "$CTX_STATE" \( -name 'ctx_fired_*' -o -name 'idle_ack_*' -o -name 'wait_since_*' \) -mtime +3 -delete 2>/dev/null
# ── SEAT RESOLUTION (hoisted above the loop 2026-09-10, Kam's ruling
# "parameterise — make it agent-aware, Wednesday's behaviour byte-identical",
# card wed-wakewatch-hardcodes-wednesday-inbox-and-pane).
# The INBOX half was fixed 2026-09-09 but the resolution sat INSIDE the loop,
# BELOW the DEAD-coordinator check — so the one check that runs first could not
# see it and stayed hardcoded to the literal pane name "wednesday". On Tuesday's
# seat that meant: no DEAD detection for her at all (she has no pane by that
# name), and her OWN coordinator pane was not in the skip list, so the idle
# tripwire treated her as an agent and woke her about herself.
# Resolved ONCE here; every use below reads $SEAT. Wednesday's tree resolves to
# "wednesday", so every comparison is the same string it was before.
_root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
# WED_AGENT if set, else the TREE'S OWN NAME. The tree is the discriminator
# because the runner does NOT inherit WED_AGENT (measured 2026-09-09) and
# because the two trees are clones of one repo — the checkout path is the only
# thing that differs between them.
# 2026-09-13 (Tuesday's 19:1x finding): the rule now lives in the ONE shared
# resolver, seat_resolve.sh (also used by wednesday_rotate.sh + arm_wake_watch.sh),
# which sets SEAT + TREE_SEAT exactly as the case above did and adds
# coord_pane_id — the pane lookup that also accepts the legacy "wednesday" name.
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/seat_resolve.sh" || { echo "wake_watch: seat_resolve.sh missing beside this script" >&2; exit 2; }
seat_resolve "$_root"
_routing="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/inbox_routing.conf"
case "$SEAT" in
  tuesday)   SEAT_INBOX=$(awk -F'|' '$1=="Tuesday"{print $2}'   "$_routing" 2>/dev/null)
             KAM_TAG="[Kam -> Tuesday]"   ;;
  wednesday) SEAT_INBOX=$(awk -F'|' '$1=="Wednesday"{print $2}' "$_routing" 2>/dev/null)
             KAM_TAG="[Kam -> Wednesday]" ;;
  *)         SEAT_INBOX=""
             KAM_TAG="[Kam -> Wednesday]" ;;
esac
[ -n "$SEAT_INBOX" ] || SEAT_INBOX="wednesday-agent@agentmail.to"

end=$((SECONDS + 14400))
while [ $SECONDS -lt $end ]; do
  # (d) DEAD COORDINATOR (2026-09-02): the wednesday pane shows Claude Code's
  # hard stop "Context limit reached". Every other wake is pointless while this
  # holds — the seat cannot read a tap. Fires every cycle it is seen (the runner
  # respawns via wednesday_rotate.sh --dead; a respawn clears the pane).
  # Resolved through coord_pane_id: @cockpit_name == $SEAT, else the legacy
  # "wednesday" pane when this tree's seat IS $SEAT (the mini, 2026-09-13). An
  # absent coordinator pane is not fatal here — the check is simply skipped.
  wpane=$(coord_pane_id "$FLEET" 2>/dev/null || true)
  # 2026-09-14: the bare literal grep killed a healthy seat twice in 8 h (23:39, 06:53) —
  # the literal appears in ordinary tool output whenever a seat diagnoses the last kill.
  # The predicate now lives in dead_banner_check.sh (quote/tool-output/prose exclusions,
  # selftest inside it) and is shared with wednesday_rotate.sh --dead.
  if [ -n "$wpane" ] && TMUX_BIN="$TMUX_BIN" bash "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dead_banner_check.sh" "$wpane"; then
    echo "WAKE: pane '$SEAT' DEAD — Context limit reached; the coordinator cannot act — respawn required"; exit 0
  fi
  # (d2) EXITED COORDINATOR (2026-09-17, Tuesday on the mini): the session ENDED and the pane fell to the
  # cockpit's `exec bash`. No banner is shown, so (d) never fired and this loop typed WAKE lines into
  # bash for ~1.5 h. exited_seat_check.sh needs the cockpit's own exit marker AND no claude process under
  # the pane. The wording carries "DEAD" + "respawn required" so the runner routes it to
  # wednesday_rotate.sh --dead (which accepts the same predicate) and never taps the shell.
  if [ -n "$wpane" ] && TMUX_BIN="$TMUX_BIN" bash "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/exited_seat_check.sh" "$wpane"; then
    echo "WAKE: pane '$SEAT' DEAD — session EXITED (a shell in the seat pane, no Claude process); the coordinator cannot act — respawn required"; exit 0
  fi
  # (a) mail tripwire
  # SEAT-AWARE INBOX (Tuesday, 2026-09-09, on Kam's explicit instruction "fix things so
  # that next time I post it, you receive it"). Previously hardcoded to wednesday-agent@,
  # so on the Tuesday seat this polled the OTHER coordinator's mailbox: it woke Tuesday
  # about Wednesday's mail, gave no wake for Tuesday's own, and suppressed Tuesday's
  # outbound to Wednesday as "own". MEASURED COST: a message from Kam delivered straight
  # to tuesday-agent@ at 17:03:44 sat unread until he asked at 17:08.
  # Resolved from inbox_routing.conf by seat, exactly as send_brief.sh does.
  # DEFAULT IS wednesday, so behaviour on the Studio seat is byte-identical to before.
  # Seat resolution: WED_AGENT if set, else the TREE'S OWN NAME. The tree is used
  # because the runner does NOT inherit WED_AGENT (measured 2026-09-09: the live
  # watcher process carries no WED_AGENT), so keying on the variable alone would
  # silently keep polling the default inbox — the exact defect this fixes.
  # Unrecognised tree falls back to wednesday, so nothing changes for the Studio.
  # (seat, SEAT_INBOX and KAM_TAG are resolved ONCE above the loop — 2026-09-10)
  # The Kam-panel tag must name THIS seat as the ADDRESSEE, not merely be a Kam
  # message. Wednesday relays "[Kam -> Tuesday]" copies to Tuesday, so those sit in
  # HER sent folder with that prefix; a class-only match would wake her about her own
  # relay. Filter on class AND recipient (the 2026-08-13 shared-bus rule).
  # (KAM_TAG resolved above the loop — 2026-09-10)
  # Latest INBOUND message only — own outbound copies (from wednesday-agent@)
  # must never fire the tripwire (false wake 2026-08-05 21:4x).
  ts=$(set -a; . "$ENVF" 2>/dev/null; set +a; export SEAT_INBOX KAM_TAG; curl -s -m 10 \
    "https://api.agentmail.to/v0/inboxes/$SEAT_INBOX/messages?limit=10" \
    -H "Authorization: Bearer ${AGENTMAIL_API_KEY:-}" \
    | python3 -c "
import json,sys,os
_inb=os.environ.get('SEAT_INBOX','')
# A PANEL message from Kam is delivered INTO this seat's own inbox and therefore
# carries this seat's address in 'from' — so the own-outbound filter suppressed it.
# That is exactly why Kam's 17:03 message was delivered and never woke Tuesday.
# Kam's messages are never 'own outbound', whatever the From line says.
ms=[m for m in json.load(sys.stdin).get('messages',[])
    if str(m.get('subject','')).startswith(os.environ.get('KAM_TAG','')) or _inb not in str(m.get('from',''))]
print(ms[0].get('timestamp','')[:16] if ms else '')" 2>/dev/null)
  if [ -n "$ts" ] && [[ "$ts" > "$BASELINE" ]]; then
    echo "WAKE: new mail at $ts (baseline $BASELINE)"; exit 0
  fi
  # (a2) dashboard-chat tripwire — Kam's messages in chat_log.json are real
  # input with NO other watcher (added 2026-08-10 after his 08:45 message sat
  # unread 3h; ledger row same day). Newest role=="kam" ts, converted to UTC
  # minute-precision to match BASELINE's format.
  cts=$(python3 -c "
import json,datetime,sys
try:
    log=json.load(open('$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/0_Brain/dashboard/data/chat_log.json'))
    ks=[m for m in log if m.get('role')=='kam' and m.get('ts')]
    if not ks: print(''); sys.exit()
    t=datetime.datetime.fromisoformat(ks[-1]['ts']).astimezone(datetime.timezone.utc)
    print(t.strftime('%Y-%m-%dT%H:%M'))
except Exception: print('')" 2>/dev/null)
  # De-dup vs the push channel (Kam, 2026-08-17: "reading the prompt once is
  # enough"). chat_push.sh writes state/chat_pushed_through ONLY after a tap
  # that provably delivered (exit 0) — so skipping cts <= watermark can never
  # swallow an undelivered message; a failed/log-only push leaves the
  # watermark untouched and this backstop fires exactly as before.
  # NB: NOT $STATE_DIR (that is a per-invocation mktemp) — the watermark lives
  # in the PERSISTENT cockpit state dir, where chat_push.sh writes it. First
  # draft read $STATE_DIR and was a de-dup that could never suppress; caught
  # by exercising before arming.
  cpw=$(cat "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/state/chat_pushed_through" 2>/dev/null || echo "")
  if [ -n "$cts" ] && [[ "$cts" > "$BASELINE" ]]; then
    if [ -n "$cpw" ] && ! [[ "$cts" > "$cpw" ]]; then
      : # already push-delivered — stay quiet, baseline advances via runner on other fires
    else
      echo "WAKE: new dashboard-chat message from Kam at $cts UTC (baseline $BASELINE)"; exit 0
    fi
  fi
  # (b) pane idle-at-prompt tripwire
  "$TMUX_BIN" list-panes -t "$FLEET" -F '#{pane_id}|#{@cockpit_name}' 2>/dev/null | \
  while IFS='|' read -r pid name; do
    # Skip THIS seat's own coordinator pane (was the literal "wednesday", which
    # left Tuesday waking herself about her own prompt) and the monitor.
    case "$name" in "$SEAT"|fleet-monitor|'') continue;; esac
    # …and by PANE ID too (2026-09-13): on the mini the coordinator pane is still
    # named "wednesday" while SEAT is tuesday, so the name test above let the
    # idle tripwire wake Tuesday about her own prompt. $wpane is whatever
    # coord_pane_id resolved this cycle (empty = no coordinator pane found).
    [ -n "$wpane" ] && [ "$pid" = "$wpane" ] && continue
    key=$(printf '%s' "$pid" | tr -c 'A-Za-z0-9' '_')
    # 2026-09-15: the statusline (ctx:NN% | 7d:NN% renews:Nd Nh) drifts every few minutes with no
    # pane activity, so it is EXCLUDED from the hash — else an idle ack voids itself within minutes
    # (wake_ack.sh computes the same way; keep the two in step).
    tail=$("$TMUX_BIN" capture-pane -t "$pid" -p 2>/dev/null | grep -v '^$' | grep -v 'ctx:[0-9-]*%' | tail -20)
    h=$(printf '%s' "$tail" | shasum | cut -c1-12)
    hf="$STATE_DIR/h_$key"; cf="$STATE_DIR/c_$key"
    prev=$(cat "$hf" 2>/dev/null || echo none)
    cnt=$(cat "$cf" 2>/dev/null || echo 0)
    # A pane idle at its prompt but with a RUNNING background shell (Claude
    # status line shows "N shell(s)") is working (e.g. watching CI), not
    # waiting on Wednesday — its QUESTION mail / next turn is the real signal.
    # (Refined 2026-08-05 after two identical fires on a CI-watching agent.)
    # Ghost-text-aware prompt read (added 2026-08-10 consolidation: Vision
    # idled 90 min with 5 unseen mails because its prompt held a dim machine
    # SUGGESTION and the plain-capture test below saw a non-empty prompt).
    # Capture with -e, strip SGR-2 (dim) spans — the pane_prompt_check.sh
    # discriminator: dim = suggestion, nobody typed it — then strip all SGR
    # and NBSP. A prompt that is empty-after-ghost-removal IS idle. TYPED
    # unsent text (not dim) still deliberately reads as not-idle.
    pline=$("$TMUX_BIN" capture-pane -t "$pid" -p -e 2>/dev/null | grep -a '❯' | tail -1 | \
      LC_ALL=C perl -pe 's/\x1b\[2m.*?(?=\x1b|$)//g; s/\x1b\[[0-9;]*m//g; s/\xc2\xa0/ /g' 2>/dev/null)
    # Busy-detection covers EVERY kind of Claude background work, not just
    # shells (widened 2026-08-11: Vision was polling an ACS throttle window via
    # a MONITOR — statusline "· 1 monitor" — and the shell-only regex read a
    # working agent as idle. Same failure shape as the ghost-text blind spot:
    # the enforcement was scoped narrower than the rule it encodes). Plural
    # tolerant; add new indicators here the day they appear.
    # DELIBERATELY EXCLUDES "agent": the cockpit footer always renders a pane
    # count ("← 3 agents"). Matching it would make EVERY pane read busy forever
    # and silently disable this tripwire permanently — a watcher that can never
    # fire. Caught by my own test asserting the wrong expectation, 2026-08-11.
    # Widened 2026-08-12: a long IN-TURN tool call renders an empty prompt +
    # a working spinner ("· Testing… (28m 36s · ↓ 98.7k tokens)") — no
    # shell/monitor/task status, so the 08-11 regex read a 28-min local proof
    # as idle (false wake on Secuura). The spinner's own artifacts are the
    # signal: the token counter and the run-in-background/interrupt hints
    # render ONLY during active work — verified absent from the statusline
    # ("ctx:NN%…") and the footer ("← N agents"), so no always-busy hazard.
    ff="$STATE_DIR/f_$key"
    fcnt=$(cat "$ff" 2>/dev/null || echo 0)
    # IDLE-ACK read hoisted above the branches (2026-09-16) so the subagent-wait
    # bound below honours the same ack (see the IDLE-ACK block further down).
    ackf="$CTX_STATE/idle_ack_$key"
    ack=$(cat "$ackf" 2>/dev/null || echo none)
    # ── TURN-STATUS DISCRIMINATORS (2026-09-16, falsewake fix; arms:
    # fleet/tests/wake_watch_falsewake_arms.sh). Two measured false-wake classes:
    #  A. WAITING ON SUBAGENTS. The turn parks at an EMPTY prompt showing
    #     "✻ Waiting for 4 background agents to finish" and the text does not
    #     change while the subagents work — so the idle leg read it as idle
    #     (Tuesday, three false wakes on one pane), and with a "· N shells" footer
    #     the frozen leg read it as a fossil (HPSM-S42 %25, 2026-09-13 15:57).
    #     Tuesday's discriminator: empty prompt AND no spinner AND no waiting line
    #     = idle; any one present = working. A wait is WORKING — but not forever:
    #     unchanged past WAIT_MIN it fires its OWN wake (below).
    #  B. HOLDING BY DESIGN. Turn ended ("✻ Baked for 10s · done 9:59 pm · 1 monitor
    #     still running"), empty prompt, an inbox Monitor alive — the footer
    #     "· 1 monitor ·" matched the busy regex and the frozen leg fired on a pane
    #     that was simply waiting for a GO (four triages on 2026-09-16). Routed to
    #     the idle path, where the IDLE-ACK can silence a state already judged.
    # The LAST turn-status line in the tail is what the turn is doing NOW; an older
    # one above it is history (a wait that finished, then a reply and a done line,
    # is idle again). Keep WAIT_RE in step with monitor.sh.
    WAIT_RE='^[^[:alnum:]]*waiting[[:space:]]+(for|on)[[:space:]]+[0-9]+[[:space:]]+(background[[:space:]]+)?(sub-?)?agents?[[:space:]]+to[[:space:]]+finish'
    ENDED_RE='^[^[:alnum:]]*[A-Z][^[:space:]]*ed for [0-9]+(\.[0-9]+)?[hms]|· done [0-9]{1,2}:[0-9]{2}'
    SPIN_RE='…[[:space:]]*\([0-9]'
    # Markers that render ONLY while a turn is genuinely in flight — any one of
    # these keeps the pane on the frozen-busy leg exactly as before.
    STRONG_RE='↓ [0-9.]+k? tokens|to run in background|esc to interrupt|…[[:space:]]*\([0-9]'
    wl=$(printf '%s\n' "$tail" | LC_ALL=C grep -naiE "$WAIT_RE" | tail -1 | cut -d: -f1)
    dl=$(printf '%s\n' "$tail" | LC_ALL=C grep -naE "$ENDED_RE" | tail -1 | cut -d: -f1)
    sl=$(printf '%s\n' "$tail" | LC_ALL=C grep -naE "$SPIN_RE" | tail -1 | cut -d: -f1)
    wl=${wl:-0}; dl=${dl:-0}; sl=${sl:-0}
    empty_prompt=0
    printf '%s\n' "$pline" | grep -qE '^❯[[:space:]]*$' && empty_prompt=1
    waiting=0
    [ "$wl" -gt 0 ] && [ "$wl" -gt "$dl" ] && [ "$wl" -gt "$sl" ] && waiting=1
    holding=0
    # holding = a background-work FOOTER is the only busy marker (without one the pane
    # is plain idle and never reaches the frozen leg anyway), empty prompt, and the
    # last turn-status line is an ENDED line.
    if [ "$waiting" = 0 ] && [ "$empty_prompt" = 1 ] && [ "$dl" -gt 0 ] && [ "$dl" -gt "$sl" ] \
       && printf '%s' "$tail" | grep -qE 'shell still running|monitor still running|· [0-9]+ (shell|monitor|task)s?([^A-Za-z]|$)' \
       && ! printf '%s' "$tail" | LC_ALL=C grep -qE "$STRONG_RE"; then
      holding=1
    fi
    wsf="$CTX_STATE/wait_since_$key"
    if [ "$waiting" = 1 ]; then
      cnt=0; fcnt=0
      # SUBAGENT-WAIT BOUND. The clock lives in CTX_STATE as "<hash> <since> <lastfired>"
      # because STATE_DIR is erased at every re-arm (~2 min) and could never count
      # to an hour. Default 60 min: the longest LEGITIMATE silent wait measured in
      # this fleet is a lane queued on a shared docker.lock taken with
      # `lockf -t 3600` (HPSM-S42, 2026-09-13) — past 60 min unchanged even that
      # waiter has timed out and repainted, so the frozen wait is no longer
      # explained by work. Any subagent finishing changes "Waiting for N" and resets
      # the clock by itself. Rate limit: re-fires at most once per WAIT_MIN for the
      # same content, and never for a content hash acked with wake_ack.sh.
      WAIT_MIN="${WAKE_WATCH_SUBAGENT_WAIT_MIN:-60}"
      wn=$(printf '%s\n' "$tail" | sed -n "${wl}p" | LC_ALL=C grep -oE '[0-9]+' | head -1)
      now=$(date +%s)
      wrec=$(cat "$wsf" 2>/dev/null || true)
      read -r wh wsince wlast <<< "$wrec"
      case "${wsince:-}" in ''|*[!0-9]*) wh=none ;; esac
      case "${wlast:-}" in ''|*[!0-9]*) wlast=0 ;; esac
      if [ "${wh:-none}" != "$h" ]; then
        wsince=$now; wlast=0
        printf '%s %s %s' "$h" "$now" 0 > "$wsf"
      fi
      wage=$(( (now - wsince) / 60 ))
      if [ "$wage" -ge "$WAIT_MIN" ] && [ $((now - wlast)) -ge $((WAIT_MIN * 60)) ] && [ "$ack" != "$h" ]; then
        # Worded to contain "idle at prompt" ON PURPOSE: the live runner taps only
        # wake shapes its case statement knows, and a runner re-arm does not reload
        # that case list. It also has its own case line (arm_wake_watch.sh) from the
        # next runner start.
        echo "WAKE: pane '$name' ($pid) waiting on ${wn:-?} subagents with no change for ~$wage min — check the pane: a subagent or the lock it queues on may be hung (the turn is parked idle at prompt behind the wait; re-fires every ~$WAIT_MIN min while this exact content holds; wake_ack.sh $pid silences it)" > "$STATE_DIR/fired"
        # the lastfired stamp is committed only if THIS wake is the one delivered (see the emit below)
        printf '%s|%s %s %s|(%s)' "$wsf" "$h" "$wsince" "$now" "$pid" > "$STATE_DIR/wait_commit"
      fi
    elif [ "$holding" = 0 ] && printf '%s' "$tail" | grep -qE 'shell still running|· [0-9]+ (shell|monitor|task)s?([^A-Za-z]|$)|↓ [0-9.]+k? tokens|to run in background|esc to interrupt'; then
      cnt=0
      # FROZEN-BUSY discriminator (consolidation 2026-08-23; class evidence
      # 2026-08-21/22: turn-end stalls at 10+ instances, several wearing the
      # busy costume — "Brewed for 20m 0s" STATIC across 20+ min of checks,
      # "← 2 agents" stale, report mailed or in-pane, turn ENDED). A genuinely
      # working pane repaints its spinner timer/token counter every sample, so
      # its capture hash CHANGES; busy indicators over a FROZEN hash for
      # FROZEN_N consecutive samples = the render is a fossil and the turn has
      # likely ended. Fires with its own message so triage starts at the inbox
      # then the transcript (the 08-21 diagnostic order), never at the pane.
      FROZEN_N="${WAKE_WATCH_FROZEN_N:-6}"
      if [ "$prev" = "$h" ]; then fcnt=$((fcnt + 1)); else fcnt=0; fi
      if [ "$fcnt" -ge "$FROZEN_N" ]; then
        echo "WAKE: pane '$name' ($pid) shows BUSY indicators but content FROZEN ~$((FROZEN_N * INTERVAL / 60)) min — turn likely ENDED (mailed-report/turn-end stall class); check inbox FIRST, then transcript mtime, then detector at the pane" > "$STATE_DIR/fired"
      fi
    elif [ "$holding" = 1 ] || [ "$empty_prompt" = 1 ] || printf '%s' "$tail" | grep -qE 'Pick or adjust'; then
      if [ "$prev" = "$h" ]; then cnt=$((cnt + 1)); else cnt=1; fi
      fcnt=0
    else
      cnt=0
      fcnt=0
    fi
    printf '%s' "$h" > "$hf"; printf '%s' "$cnt" > "$cf"; printf '%s' "$fcnt" > "$ff"
    # not waiting now: retire any wait clock, so the next wait starts its own
    if [ "$waiting" = 0 ] && [ -f "$wsf" ] && [ "$(cat "$wsf" 2>/dev/null)" != "none 0 0" ]; then
      printf 'none 0 0' > "$wsf"
    fi
    # IDLE-ACK (2026-09-07): an idle pane that Wednesday has ALREADY adjudicated
    # must not re-fire forever. STATE_DIR is a fresh mktemp -d per invocation and
    # the runner re-arms every ~2 min, so cnt restarts from zero every cycle — a
    # pane parked at an empty prompt (dormant BY DESIGN, holding for Kam, with
    # Wednesday as its wake path) fires again every ~2 min, all night. Measured
    # 2026-09-07 22:35-22:39 on %162 in wake_watch_runner.log.
    # The ack is keyed to the pane's CONTENT HASH and lives in CTX_STATE, which
    # survives re-arm (an ack in STATE_DIR would be erased every cycle — a
    # suppression that cannot suppress). Any new output changes $h and lifts the
    # ack by itself, so this can never silence a pane that has something to say;
    # it silences only a repeat of a state already judged. Mail and ctx wakes are
    # separate legs and are untouched.
    # (ackf/ack are read above the branches since 2026-09-16)
    if [ "$cnt" -ge "$STABLE_N" ] && [ "$ack" != "$h" ]; then
      # DETECTOR VERDICT IN THE WAKE (2026-09-21, ledger w=3 -> enforcement): four
      # times today a Claude ghost suggestion wearing the fleet's own tap prefix sat
      # at a HOLDING seat's prompt and the idle wake carried no verdict, so the
      # coordinator read the pane before the detector had. The idle leg now runs
      # pane_prompt_check.sh on the pane itself and appends its one-line verdict
      # (SUGGESTION / TYPED, UNSENT / prompt empty / MODAL) to BOTH idle wordings.
      # Newlines are folded; a silent or failing detector reports NO VERDICT (rc N).
      det=$(bash "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/pane_prompt_check.sh" "$pid" 2>/dev/null); drc=$?
      det=$(printf '%s' "$det" | tr '\n\r' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [ -n "$det" ] || det="NO VERDICT (rc $drc)"
      if [ "$holding" = 1 ]; then
        echo "WAKE: pane '$name' ($pid) idle at prompt ~$((STABLE_N * INTERVAL / 60)) min — likely waiting on Wednesday (HOLDING: turn ended, only a background monitor/shell is live — check its inbox first; if it is holding by design, wake_ack.sh $pid silences this exact state) — detector: $det" > "$STATE_DIR/fired"
      else
        echo "WAKE: pane '$name' ($pid) idle at prompt ~$((STABLE_N * INTERVAL / 60)) min — likely waiting on Wednesday — detector: $det" > "$STATE_DIR/fired"
      fi
    fi
  done
  if [ -f "$STATE_DIR/fired" ]; then
    # Subagent-wait rate limit: stamp lastfired ONLY when that wake is the one
    # being delivered — a later pane in the same cycle overwrites "fired", and a
    # stamp for an undelivered wake would silence it for a whole WAIT_MIN.
    if [ -f "$STATE_DIR/wait_commit" ]; then
      wcm=$(cat "$STATE_DIR/wait_commit"); wcf=${wcm%%|*}; wcr=${wcm#*|}; wcv=${wcr%|*}; wcp=${wcr##*|}
      if grep -qF "$wcp" "$STATE_DIR/fired" && grep -qF 'subagents with no change' "$STATE_DIR/fired"; then
        printf '%s' "$wcv" > "$wcf"
      fi
    fi
    cat "$STATE_DIR/fired"; exit 0
  fi
  # (c) context-saturation tripwire (working-rhythm §2 — Kam's numbers,
  # adopted 2026-08-10): parse each pane's Claude statusline "ctx:NN%" from a
  # read-only capture; the LAST match in the visible pane is the statusline
  # (it renders below the transcript). "ctx:-" (no API call yet) simply
  # doesn't match — quiet. fleet-monitor has no statusline — skipped.
  # One wake per cycle: first pane over an unfired threshold wins; any other
  # crossing fires on the next 60s sample.
  "$TMUX_BIN" list-panes -t "$FLEET" -F '#{pane_id}|#{@cockpit_name}|#{pane_pid}' 2>/dev/null | \
  while IFS='|' read -r pid name ppid; do
    case "$name" in fleet-monitor|'') continue;; esac
    pct=$("$TMUX_BIN" capture-pane -t "$pid" -p 2>/dev/null | grep -oE 'ctx:[0-9]+%' | tail -1 | tr -dc '0-9')
    [ -n "$pct" ] || continue
    gen=$(printf '%s_%s' "$pid" "$ppid" | tr -c 'A-Za-z0-9' '_')
    if [ "$pct" -ge 90 ] 2>/dev/null; then
      # 90% = the CEILING of the band (Kam 2026-09-07 10:49, verbatim: "don't forget the
      # Wednesday window is between 80 and 90% context. Use this as your rotation window").
      # Past the ceiling nothing new is started at all: the first boundary IS the rotation.
      if [ ! -f "$CTX_STATE/ctx_fired_${gen}_90" ] && [ ! -f "$STATE_DIR/ctx_wake" ]; then
        touch "$CTX_STATE/ctx_fired_${gen}_90" "$CTX_STATE/ctx_fired_${gen}_80" "$CTX_STATE/ctx_fired_${gen}_70" "$CTX_STATE/ctx_fired_${gen}_65" "$CTX_STATE/ctx_fired_${gen}_50"
        echo "WAKE: pane '$name' ctx at ${pct}% — 90% CEILING (Kam 09-07 10:49, band 80-90): START NOTHING NEW. Finish the step you are on, answer any pending agent mail, write + push the handover block, then rotate at that boundary (wednesday: fleet/cockpit/wednesday_rotate.sh --self, detached; agents: cockpit.sh rotate)" > "$STATE_DIR/ctx_wake"
      fi
    elif [ "$pct" -ge 80 ] 2>/dev/null; then
      # 80% = the CEILING of the rotation band (Kam 2026-09-02 16:32: "70-80% is a
      # better number. 50% is too soon... conditional like before"). ROTATE NOW =
      # at the first boundary, start nothing. The wednesday pane rotates itself via
      # wednesday_rotate.sh --self after its handover block is pushed; agent panes
      # via cockpit.sh rotate. The only UNCONDITIONAL respawn is leg (d) DEAD.
      if [ ! -f "$CTX_STATE/ctx_fired_${gen}_80" ] && [ ! -f "$STATE_DIR/ctx_wake" ]; then
        touch "$CTX_STATE/ctx_fired_${gen}_80" "$CTX_STATE/ctx_fired_${gen}_70" "$CTX_STATE/ctx_fired_${gen}_65" "$CTX_STATE/ctx_fired_${gen}_50"
        echo "WAKE: pane '$name' ctx at ${pct}% — 80-90% BAND (Kam 09-07 10:49, superseding the 80-85 band): rotate at the NEXT SAFE BOUNDARY inside the band, 90% the ceiling: answer any pending agent mail, write + push the handover block, then rotate (wednesday: fleet/cockpit/wednesday_rotate.sh --self, detached; agents: cockpit.sh rotate)" > "$STATE_DIR/ctx_wake"
      fi
    elif [ "$pct" -ge 70 ] 2>/dev/null; then
      # 70% = the band is ENTERED (Kam 2026-08-21 grant, restored 2026-09-02 after the
      # 16:1x seat hardened this into an interrupt and rotated too soon): rotate at
      # the NEXT SAFE BOUNDARY — no agent QUESTION unanswered or imminent, no dangling
      # Kam thread, HEAD == origin, agents untouched. Conditional by design.
      if [ ! -f "$CTX_STATE/ctx_fired_${gen}_70" ] && [ ! -f "$STATE_DIR/ctx_wake" ]; then
        touch "$CTX_STATE/ctx_fired_${gen}_70" "$CTX_STATE/ctx_fired_${gen}_65" "$CTX_STATE/ctx_fired_${gen}_50"
        echo "WAKE: pane '$name' ctx at ${pct}% — 70% CHECKPOINT (Kam 09-07 10:49: the band is 80-90%): refresh the handover block, start nothing heavy, do NOT rotate yet — there is real room left. Answer any pending agent mail and keep the handover current; rotation happens inside 80-90, 90 the ceiling" > "$STATE_DIR/ctx_wake"
      fi
    elif [ "$pct" -ge 65 ] 2>/dev/null; then
      if [ ! -f "$CTX_STATE/ctx_fired_${gen}_65" ] && [ ! -f "$STATE_DIR/ctx_wake" ]; then
        touch "$CTX_STATE/ctx_fired_${gen}_65" "$CTX_STATE/ctx_fired_${gen}_50"
        echo "WAKE: pane '$name' ctx at ${pct}% — light checkpoint (band is 80-90, Kam 09-07): keep the handover block current and prefer bounded work, but there is real room left — do NOT wind down and do NOT rotate" > "$STATE_DIR/ctx_wake"
      fi
    elif [ "$pct" -ge 50 ] 2>/dev/null; then
      if [ ! -f "$CTX_STATE/ctx_fired_${gen}_50" ] && [ ! -f "$STATE_DIR/ctx_wake" ]; then
        touch "$CTX_STATE/ctx_fired_${gen}_50"
        echo "WAKE: pane '$name' ctx at ${pct}% — checkpoint: finish the current task, START nothing new that won't fit the budget (rhythm §2)" > "$STATE_DIR/ctx_wake"
      fi
    fi
  done
  if [ -f "$STATE_DIR/ctx_wake" ]; then cat "$STATE_DIR/ctx_wake"; exit 0; fi
  sleep "$INTERVAL"
done
echo "WAKE: 4h max runtime reached with no tripwire — re-arm from the session"
exit 0
