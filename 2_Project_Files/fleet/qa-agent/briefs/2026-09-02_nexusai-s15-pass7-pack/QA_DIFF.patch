index 0000000..5f91555
--- /dev/null
+++ b/__tests__/index-dark-surfaces.test.js
@@ -0,0 +1,227 @@
+/**
+ * @jest-environment jsdom
+ *
+ * R6-3 / P6-03 (RD-159) — the dashboard's dark surfaces.
+ *
+ * THE HEADLINE FINDING, in the tester's words from pass 6: `div.controls`
+ * computes `background-color: rgb(255,255,255)` under `body.dark-mode` and
+ * `div.ai-assistant-section` computes `rgb(248,249,250)`, so the body's
+ * #e8e8e8 lands on both and ALL EIGHT filter labels render at 1.23:1 — Date
+ * Range, User Filter, Anomaly Filter, Department, Data Source, Region, Action
+ * Type, Printer. That is the dashboard's primary control surface. `grep` found
+ * no `.controls` rule in dark-mode.css at 1f41edc either, so it is pre-existing
+ * and surfaced only because pass 6 was the first sweep of the whole page.
+ *
+ * Fixed on the SURFACE, not on the labels — the same decision the P2-04/P2-05
+ * comment in dark-mode.css records. Darkening `.form-label` instead would fix
+ * dark mode, break light mode (where #e8e8e8-on-white is the bug and the label
+ * colour is correct), and have to be repeated for every control added later.
+ *
+ * TARGETED BY SEMANTIC CLASS wherever one exists, deliberately. The extracted
+ * `s-xxxxxxxx` names are hashes of their own declaration text, so editing an
+ * inline style renames the class and silently unlinks any counterpart keyed to
+ * it (RD-165). Seven nodes on this page carry no semantic class at all and are
+ * keyed by hash out of necessity; they are probed below so a rename fails the
+ * build instead of shipping a silent regression.
+ *
+ * WHAT THIS FILE CANNOT CLAIM. Bootstrap is absent (RD-145), jsdom does not
+ * inherit `color`, discards `var()`, ignores `!important`, and resolves the
+ * cascade by source order rather than specificity (RD-163). A pass means "our
+ * own stylesheets no longer fail this node". The counts are a delta, never a
+ * product metric — the tester's real-engine table is the number pass 7 judges.
+ */
+
+const { renderPage, visibleTextNodes, measureContrast, parseColor, contrastRatio, rgb } = require('./helpers/dom');
+
+const PAGE = 'static/index.html';
+const AA = 4.5;
+
+/**
+ * Families R6-3 does not touch, each with the reason it is out.
+ *
+ * `.table-title` WAS here until RD-147 landed inside this round; it now has a
+ * positive assertion of its own below instead. The allowlist shrinking is the
+ * visible half of that fix.
+ */
+const OUT_OF_SCOPE = [
+    { re: /\bbtn-outline-(primary|secondary)\b/, why: 'Bootstrap-painted; jsdom never loaded Bootstrap (RD-145)' },
+    { re: /\btab-button\b|\bfile-select-btn\b|\brefresh-btn\b|\bmodal-btn\b|\bbtn-sm\b/, why: 'brand chrome / UA button face — RD-160, measured not changed' },
+    { re: /\bloading-(title|subtitle|status|content)\b|\bskip-setup-hint\b/, why: 'the load overlay, white-on-white in BOTH modes — RD-166, mode-independent and off-delta' },
+];
+const isOutOfScope = (cls, tag) =>
+    tag === 'option' ||
+    // the overlay's opt-out checkbox label carries no class of its own
+    (tag === 'label' && cls === '') ||
+    OUT_OF_SCOPE.some((f) => f.re.test(cls));
+
+const sweepCache = new Map();
+const sweep = (dark) => {
+    if (!sweepCache.has(dark)) {
+        renderPage(PAGE, { dark });
+        sweepCache.set(dark, visibleTextNodes()
+            .map((el) => ({ el, tag: el.tagName.toLowerCase(),
+                            cls: typeof el.className === 'string' ? el.className : '',
+                            ...measureContrast(el) }))
+            .filter((m) => m.ratio < AA));
+    }
+    return sweepCache.get(dark);
+};
+
+describe('R6-3 — the measured palette', () => {
+    const PAIRS = [
+        { fgName: 'filter label #e8e8e8',  fg: '#e8e8e8', bgName: 'controls #1e1e3f',  bg: '#1e1e3f', expected: 13.06 },
+        { fgName: 'body #e8e8e8',          fg: '#e8e8e8', bgName: 'raised #252550',    bg: '#252550', expected: 11.75 },
+        { fgName: 'muted #9090a0',         fg: '#9090a0', bgName: 'raised #252550',    bg: '#252550', expected: 4.58 },
+        { fgName: 'sort chevron #a8a8bc',  fg: '#a8a8bc', bgName: 'table head #252550', bg: '#252550', expected: 6.16 },
+        { fgName: 'risk title #ff9c9c',    fg: '#ff9c9c', bgName: 'page #1a1a2e',      bg: '#1a1a2e', expected: 8.52 },
+    ];
+
