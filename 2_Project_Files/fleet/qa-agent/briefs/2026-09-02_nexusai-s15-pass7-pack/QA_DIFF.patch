diff --git a/__tests__/jsdom-cascade-limit.test.js b/__tests__/jsdom-cascade-limit.test.js
new file mode 100644
index 0000000..7837c6d
--- /dev/null
+++ b/__tests__/jsdom-cascade-limit.test.js
@@ -0,0 +1,77 @@
+/**
+ * @jest-environment jsdom
+ *
+ * RD-163 — THIS HARNESS DOES NOT CASCADE LIKE A BROWSER.
+ *
+ * Found in s15 while R6-2 (RD-158) could not explain why
+ * `body.dark-mode .info-box` (specificity 0,2,0) was losing to
+ * `.s-3d740e084c` (0,1,0) in the rendered-page sweep.
+ *
+ * jsdom resolves competing declarations by SOURCE ORDER and ignores selector
+ * specificity. The probes below are constructed so the pair differs only in
+ * declaration order, which is the only way to show that ORDER — not
+ * specificity, and not the shorthand/longhand distinction — is what decides.
+ *
+ * Consequence, stated plainly: no contrast COUNT this harness produces is the
+ * product's. first-run-setup measured 267 dark failures with the sheets in the
+ * order the pages used to link them, and 30 with dark-mode.css linked last.
+ * Neither is a browser's number; the gap is the instrument. RD-158 moved the
+ * link so that the harness and a browser at least resolve the same WINNER.
+ * ENUMERATE here; DECIDE in the tester's real engine.
+ *
+ * WHY IT PROBES BY SWAPPING `document.head` rather than standing up its own
+ * jsdom: `require('jsdom')` fails under jest in this repo in BOTH environments —
+ * in the jsdom environment whatwg-url throws, and in the node environment jest
+ * cannot parse jsdom's ESM-only dependency chain. That is the same class of
+ * blocker as RD-134 (node-cron -> ESM-only uuid). Swapping the head in the
+ * environment jest already provides measures the same thing with no new
+ * dependency, and each case uses its own class names so nothing leaks between
+ * them.
+ *
+ * Note what this means for dom-harness.test.js's "the shipped dark-mode
+ * override beats the vendor rule, as it does in a browser": that test passes
+ * for the right reason only because it loads dark-mode.css second. It was never
+ * evidence about specificity, and this file exists so nobody reads it as such.
+ *
+ * If jsdom ever gains a real cascade, the three order-dependent assertions here
+ * FAIL — and that failure is the signal that this harness's numbers have become
+ * usable on their own.
+ */
+
+/** Compute background-color for `cls` under `css`, in a freshly-styled document. */
+function compute(css, cls) {
+    document.head.innerHTML = `<style>${css}</style>`;
+    document.body.className = 'dark-mode';
+    document.body.innerHTML = `<div class="${cls}" id="probe">t</div>`;
+    return getComputedStyle(document.getElementById('probe')).backgroundColor;
+}
+
+const MORE_SPECIFIC = 'body.dark-mode .ib{background-color:#16263f}';   // 0,2,0
+const LESS_LONGHAND = '.sx{background-color:#e7f3ff}';                   // 0,1,0
+const LESS_SHORTHAND = '.sx{background:#e7f3ff}';                        // 0,1,0
+
+describe('RD-163 — the cascade is resolved by source order, not specificity', () => {
+    test('CONTROL — each rule alone computes its own value, so the probe discriminates', () => {
+        expect(compute(MORE_SPECIFIC, 'ib')).toBe('rgb(22, 38, 63)');
+        expect(compute(LESS_LONGHAND, 'sx')).toBe('rgb(231, 243, 255)');
+    });
+
+    test('CONTROL — the head swap really does replace the previous rules', () => {
+        compute(LESS_LONGHAND, 'sx');
+        // .sx is no longer defined at all here, so the probe must fall back to
+        // the initial value rather than remember the previous test's sheet.
+        expect(compute(MORE_SPECIFIC, 'sx')).toBe('');
+    });
+
+    test('the LESS specific rule wins when declared last — a browser computes #16263f', () => {
+        expect(compute(`${MORE_SPECIFIC} ${LESS_LONGHAND}`, 'ib sx')).toBe('rgb(231, 243, 255)');
+    });
+
+    test('identical with the `background` shorthand, so it is not a shorthand-merge quirk', () => {
+        expect(compute(`${MORE_SPECIFIC} ${LESS_SHORTHAND}`, 'ib sx')).toBe('rgb(231, 243, 255)');
+    });
+
+    test('reverse the declaration order and the answer flips — order is the whole mechanism', () => {
+        expect(compute(`${LESS_SHORTHAND} ${MORE_SPECIFIC}`, 'ib sx')).toBe('rgb(22, 38, 63)');
+    });
+});
diff --git a/__tests__/quick-question-chips.test.js b/__tests__/quick-question-chips.test.js
new file mode 100644
index 0000000..9461697
--- /dev/null
+++ b/__tests__/quick-question-chips.test.js
@@ -0,0 +1,126 @@
+/**
+ * @jest-environment jsdom
+ *
+ * R6-3 / P6-03 (RD-159) — the quick-question chips.
+ *
+ * The tester measured four of these at 2.25 / 2.46 / 2.53 / 3.69:1 in dark mode
+ * in a real browser. The rendered-page sweep never saw them, and could not: the
+ * chips are created by `index.js`, so they are absent from the static markup
+ * the sweep walks. This file is what covers them instead.
+ *
+ * WHY THE FIX HAD TO BE A REFACTOR, not a colour change. The chips were styled
+ * by `button.style.cssText = ...`. An inline style has specificity 1,0,0,0, so
+ * NO stylesheet rule can override it without `!important` — and `!important` is
+ * exactly the trap R5-2 fell into: jsdom does not honour it, so the suite could
+ * not have told anyone whether the override landed. Adding a dark rule would
+ * have been inert in the browser and green here, which is the worst of both.
+ *
+ * So the six colour objects in the JS became six variant NUMBERS, and the values
+ * moved to `.example-prompt-c1..c6` in index-styles.css with dark counterparts
+ * in dark-mode.css. The cascade now does the theming, no `!important` is
+ * involved, and six JS-injected inline styles are gone — which is independently
+ * what scripts/refactor-inline-styles.js exists to achieve for CSP_STRICT.
+ *
+ * THIS MEASUREMENT IS THIS INSTRUMENT'S TO MAKE, unlike the .btn-hp case in
+ * R6-1. These buttons carry only `example-prompt` classes; no Bootstrap rule
+ * paints them, so jsdom's absence of Bootstrap does not distort the result. The
+ * chip is built and measured on the real stylesheets, in both modes.
+ *
+ * Light must not regress, and here that is a precise claim: the six light values
+ * moved from JS to CSS and must be byte-identical to what they were.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const { loadStylesheet, measureContrast, parseColor, contrastRatio, composite, rgb } = require('./helpers/dom');
+
+const AA = 4.5;
+const NON_TEXT = 3.0;
+const ROOT = path.join(__dirname, '..');
+const VARIANTS = [1, 2, 3, 4, 5, 6];
+
+/** The six light values as they stood in index.js before the refactor. */
+const LIGHT_BEFORE = {
+    1: { bg: 'rgba(52, 152, 219, 0.1)',  border: 'rgba(52, 152, 219, 0.3)',  text: 'rgb(41, 128, 185)' },
+    2: { bg: 'rgba(155, 89, 182, 0.1)',  border: 'rgba(155, 89, 182, 0.3)',  text: 'rgb(142, 68, 173)' },
+    3: { bg: 'rgba(230, 126, 34, 0.1)',  border: 'rgba(230, 126, 34, 0.3)',  text: 'rgb(230, 126, 34)' },
+    4: { bg: 'rgba(46, 204, 113, 0.1)',  border: 'rgba(46, 204, 113, 0.3)',  text: 'rgb(39, 174, 96)' },
+    5: { bg: 'rgba(52, 73, 94, 0.1)',    border: 'rgba(52, 73, 94, 0.3)',    text: 'rgb(52, 73, 94)' },
+    6: { bg: 'rgba(149, 165, 166, 0.1)', border: 'rgba(149, 165, 166, 0.3)', text: 'rgb(149, 165, 166)' },
+};
+
+/** Build one chip on the real stylesheets, inside the card it actually lives in. */
+function chip(variant, { dark }) {
+    document.head.innerHTML = '';
+    loadStylesheet('static/css/index-styles.css');
+    loadStylesheet('static/css/inline-styles-extracted.css');
+    loadStylesheet('static/css/dark-mode.css');       // linked last, as the pages do (RD-158)
+    document.body.className = dark ? 'dark-mode' : '';
+    document.body.innerHTML =
+        `<div class="ai-assistant-section">
+             <button class="example-prompt example-prompt-c${variant}">Show me unusual activity</button>
+         </div>`;
+    return document.querySelector('.example-prompt');
+}
+
+describe('RD-159 — the chips are no longer styled inline, which is what made them fixable', () => {
+    const js = fs.readFileSync(path.join(ROOT, 'static/js/index.js'), 'utf8');
+
+    test('no example-prompt button is given a cssText style any more', () => {
+        // The three call sites each used to write background/color/border inline.
+        const inlineChipStyles = js.match(/example-prompt[\s\S]{0,200}?style\.cssText/g) || [];
+        expect(inlineChipStyles).toEqual([]);
+    });
+
+    test('the chips get a variant CLASS instead, at all three call sites', () => {
+        expect((js.match(/example-prompt-c\$\{(?:color|item\.color)\}/g) || []).length).toBe(3);
+    });
+
+    test('POSITIVE CONTROL — the file still builds chips, so the zero above is not a delete', () => {
+        expect((js.match(/example-prompt/g) || []).length).toBeGreaterThanOrEqual(3);
+    });
+});
+
+describe('RD-159 — light mode keeps the exact values that moved out of the JS', () => {
+    test.each(VARIANTS)('variant %i is byte-identical to its pre-refactor value', (v) => {
+        const el = chip(v, { dark: false });
+        const cs = getComputedStyle(el);
+        expect({ bg: cs.backgroundColor, border: cs.borderColor, text: cs.color })
+            .toEqual({ bg: LIGHT_BEFORE[v].bg, border: LIGHT_BEFORE[v].border, text: LIGHT_BEFORE[v].text });
+    });
+});
+
+describe('RD-159 — dark mode: every chip clears AA on its own composited ground', () => {
+    test.each(VARIANTS)('variant %i clears 4.5:1 in dark mode', (v) => {
+        const el = chip(v, { dark: true });
+        const m = measureContrast(el);
+        // Reported as an object so a failure names the colours, not just a number.
+        expect({ variant: v, pass: m.ratio >= AA, ratio: +m.ratio.toFixed(2), fg: rgb(m.foreground), bg: rgb(m.background) })
+            .toEqual({ variant: v, pass: true, ratio: expect.any(Number), fg: expect.any(String), bg: expect.any(String) });
+    });
+
+    test('the chip borders clear the 3:1 non-text bar against the card', () => {
+        const card = parseColor('#252550');
+        const failing = VARIANTS.map((v) => {
+            const cs = getComputedStyle(chip(v, { dark: true }));
+            const border = composite(parseColor(cs.borderColor), card);
+            return { variant: v, ratio: +contrastRatio(border, card).toFixed(2) };
+        }).filter((m) => m.ratio < NON_TEXT);
+        expect(failing).toEqual([]);
+    });
+
+    test('NEGATIVE CONTROL — the values the tester measured would fail this', () => {
+        // #2980b9 on the dark card is what the inline style produced.
+        expect(contrastRatio(parseColor('#2980b9'), parseColor('#252550'))).toBeLessThan(AA);
+        expect(contrastRatio(parseColor('#8e44ad'), parseColor('#252550'))).toBeLessThan(AA);
+        expect(contrastRatio(parseColor('#34495e'), parseColor('#252550'))).toBeLessThan(AA);
+    });
+
+    test('CONTROL — dark and light actually differ, so the dark rules are being applied', () => {
+        for (const v of VARIANTS) {
+            const light = getComputedStyle(chip(v, { dark: false })).color;
+            const dark = getComputedStyle(chip(v, { dark: true })).color;
+            expect({ variant: v, differs: light !== dark }).toEqual({ variant: v, differs: true });
+        }
+    });
+});
