+/**
+ * @jest-environment node
+ *
+ * RD-158 / RD-163 — the two properties that make "dark-mode.css is linked LAST"
+ * a safe change rather than a hopeful one.
+ *
+ * WHY THE MOVE EXISTS. Every shipped page used to link `dark-mode.css` BEFORE
+ * `inline-styles-extracted.css`. In a browser that did not matter: every
+ * selector in dark-mode.css carries `.dark-mode`, so it out-specifies the
+ * plain single-class rules in the generated sheet and wins regardless of
+ * order. In the jsdom harness it mattered enormously, because jsdom resolves
+ * competing declarations by SOURCE ORDER and ignores specificity entirely
+ * (RD-163, pinned in dom-harness.test.js). The harness therefore measured a
+ * cascade no engine actually runs, and reported 267 dark failures on
+ * first-run-setup where a correctly-ordered sheet reports 30.
+ *
+ * So the move buys ONE thing: the harness now resolves the same winner a
+ * browser does. It is not expected to change a single rendered pixel, and the
+ * two tests below are what make that claim checkable instead of asserted.
+ *
+ *   1. dark-mode.css contains NOTHING that is not scoped to `.dark-mode`.
+ *      If it did, moving it last would let it win over light-mode rules it
+ *      previously lost to, and the move would stop being inert.
+ *   2. No sheet other than dark-mode.css defines a `.dark-mode` rule.
+ *      If one did, the move could flip an equal-specificity conflict.
+ *
+ * Both are asserted against the real files AND against deliberately sabotaged
+ * copies, because a green invariant that has never been shown to go red is not
+ * evidence — it is the shape RD-110 and RD-99 exist to stop. The sabotage is
+ * applied to strings in memory; no file on disk is touched.
+ *
+ * The generated sheet is stamped "Auto-generated ... Do not edit by hand", so
+ * the ORDER is the only lever available: a counterpart appended to that file
+ * would be deleted by the next `refactor-inline-styles.js` run.
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const ROOT = path.join(__dirname, '..');
+const read = (p) => fs.readFileSync(path.join(ROOT, p), 'utf8');
+
+const DARK_SHEET = 'static/css/dark-mode.css';
+const OTHER_SHEETS = [
+    'static/css/inline-styles-extracted.css',
+    'static/css/feedback-widget.css',
+    'static/css/first-run-setup-styles.css',
+    'static/css/index-styles.css',
+    'static/css/settings-styles.css',
+];
+const PAGES = ['static/first-run-setup.html', 'static/index.html', 'static/settings.html'];
+
+/**
+ * Every selector in a stylesheet, with comments stripped first.
+ *
+ * Stripping comments is not tidiness, it is the correctness of the
+ * measurement. A rough `grep -oE '^[^@{}/][^{]*\{'` over this file reports two
+ * rule heads with no `.dark-mode` — and both are PROSE inside the block
+ * comment that explains the R5-2 !important finding, where the continuation
+ * lines begin with a space rather than a slash: "`.text-primary-emphasis {
+ * color: var(...) !important }`" and "`.v { color: #664d03 !important }`".
+ * They are examples being described, not rules being shipped. A selector
+ * counter that reads comments measures the comment.
+ */
+function selectorsIn(cssText) {
+    const withoutComments = cssText.replace(/\/\*[\s\S]*?\*\//g, '');
+    const out = [];
+    for (const head of withoutComments.match(/[^{}]+(?=\{)/g) || []) {
+        for (const sel of head.split(',')) {
+            const s = sel.trim();
+            if (s && !s.startsWith('@')) out.push(s);
+        }
+    }
+    return out;
+}
+
+const isDarkScoped = (sel) => /(^|\s|\.)dark-mode\b/.test(sel);
+const unscopedIn = (css) => selectorsIn(css).filter((s) => !isDarkScoped(s));
+const darkScopedIn = (css) => selectorsIn(css).filter(isDarkScoped);
+
+/** The local stylesheet hrefs a page links, in document order. CDN hrefs excluded. */
+function localSheetOrder(html) {
+    return (html.match(/<link\b[^>]*>/gi) || [])
+        .filter((tag) => /rel\s*=\s*["']stylesheet["']/i.test(tag))
+        .map((tag) => (tag.match(/href\s*=\s*["']([^"']+)["']/i) || [])[1])
+        .filter(Boolean)
+        .filter((href) => !/^https?:/i.test(href));
+}
+
+describe('RD-158 — invariant 1: dark-mode.css is entirely scoped to .dark-mode', () => {
+    test('the shipped stylesheet has zero unscoped selectors', () => {
+        expect(unscopedIn(read(DARK_SHEET))).toEqual([]);
+    });
+
+    test('POSITIVE CONTROL — it is not scoped by being empty; it has real rules', () => {
+        expect(darkScopedIn(read(DARK_SHEET)).length).toBeGreaterThan(150);
+    });
+
+    test('NEGATIVE CONTROL — one unscoped rule appended makes it RED', () => {
+        const sabotaged = read(DARK_SHEET) + '\n.rogue-unscoped { color: red; }\n';
+        expect(unscopedIn(sabotaged)).toContain('.rogue-unscoped');
+    });
+
+    test('the comment-stripping is what makes the count right, and it can be shown', () => {
+        // The exact shape that fools a line-based grep: a rule written as prose
+        // inside a block comment. It must NOT be counted as a shipped selector.
+        const css = '/*\n * example: `.text-primary-emphasis { color: red !important }`\n */\nbody.dark-mode .a { color: #fff; }';
+        expect(unscopedIn(css)).toEqual([]);
+        expect(darkScopedIn(css)).toEqual(['body.dark-mode .a']);
+    });
+});
+
+describe('RD-158 — invariant 2: no other sheet defines a .dark-mode rule', () => {
+    test.each(OTHER_SHEETS)('%s defines no .dark-mode selector', (sheet) => {
+        expect(darkScopedIn(read(sheet))).toEqual([]);
+    });
+
+    test('POSITIVE CONTROL — those sheets are non-empty, so the zero is measured', () => {
+        for (const sheet of OTHER_SHEETS) {
+            expect(selectorsIn(read(sheet)).length).toBeGreaterThan(0);
+        }
+    });
+
+    test('NEGATIVE CONTROL — one .dark-mode rule appended to a later sheet makes it RED', () => {
+        const sabotaged = read(OTHER_SHEETS[0]) + '\nbody.dark-mode .rogue { color: red; }\n';
+        expect(darkScopedIn(sabotaged)).toContain('body.dark-mode .rogue');
+    });
+});
+
+describe('RD-158 — the link order itself, pinned on every page that carries dark mode', () => {
+    test.each(PAGES)('%s links dark-mode.css after every other local sheet', (page) => {
+        const order = localSheetOrder(read(page));
+        expect(order.length).toBeGreaterThan(1);
+        expect(order[order.length - 1]).toMatch(/dark-mode\.css$/);
+        // and exactly once, so a duplicate link cannot satisfy this by accident
+        expect(order.filter((h) => /dark-mode\.css$/.test(h))).toHaveLength(1);
+    });
+
+    test('NEGATIVE CONTROL — the old order fails this assertion', () => {
+        const old = `<link rel="stylesheet" href="/css/index-styles.css">
+                     <link href="/css/dark-mode.css" rel="stylesheet">
+                     <link rel="stylesheet" href="/css/inline-styles-extracted.css">`;
+        const order = localSheetOrder(old);
+        expect(order[order.length - 1]).not.toMatch(/dark-mode\.css$/);
+    });
+
+    test('NEGATIVE CONTROL — a page that links dark-mode.css twice fails it', () => {
+        const dupe = `<link href="/css/dark-mode.css" rel="stylesheet">
+                      <link rel="stylesheet" href="/css/inline-styles-extracted.css">
+                      <link href="/css/dark-mode.css" rel="stylesheet">`;
+        expect(localSheetOrder(dupe).filter((h) => /dark-mode\.css$/.test(h))).toHaveLength(2);
+    });
+});
