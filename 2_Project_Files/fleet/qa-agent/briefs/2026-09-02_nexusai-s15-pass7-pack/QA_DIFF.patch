diff --git a/__tests__/first-run-dark-surfaces.test.js b/__tests__/first-run-dark-surfaces.test.js
new file mode 100644
index 0000000..bd678a3
--- /dev/null
+++ b/__tests__/first-run-dark-surfaces.test.js
@@ -0,0 +1,169 @@
+/**
+ * @jest-environment jsdom
+ *
+ * R6-2 / P6-01 + P6-02 (RD-158) — the wizard's dark surfaces.
+ *
+ * THE MECHANISM, measured before anything was written. `first-run-setup.html`
+ * paints most of its panels from `inline-styles-extracted.css`: 51 of the
+ * `.s-xxxxxxxx` classes it uses declare a background or a text colour, and
+ * every one of them is a LIGHT-mode value. Nothing in dark-mode.css targeted
+ * them, so under `body.dark-mode` the page kept white / #f8f9fa / #e7f3ff /
+ * #fff3cd panels and dropped the body's #e8e8e8 onto them. The two largest
+ * clusters were bare `<strong>` at 1.09:1 and bare `<li>` at 1.23:1 — text
+ * with no class of its own, failing because of the ground beneath it.
+ *
+ * That sheet is stamped "Auto-generated by scripts/refactor-inline-styles.js.
+ * Do not edit by hand", so the counterparts live in dark-mode.css and the
+ * pages now link dark-mode.css LAST (RD-158, pinned in
+ * dark-mode-link-order.test.js). In a browser that changes no winner — every
+ * dark-mode selector already out-specified these — it changes which winner
+ * THIS harness sees, because jsdom cascades by source order (RD-163).
+ *
+ * WHAT THIS FILE CAN AND CANNOT CLAIM. Bootstrap is not loaded (CDN, RD-145),
+ * jsdom does not inherit `color`, discards `var()`, and does not honour
+ * `!important`. So a pass here means "our own stylesheets no longer fail this
+ * node". Whether the page reads correctly in the cascade is the tester's, and
+ * pass 7 is where it gets answered. The counts below are the instrument's, not
+ * the product's — 267 before and 30 after are two numbers from the same
+ * imperfect engine, useful as a delta and worthless as a product metric.
+ *
+ * MEASURED PALETTE. Every pair was computed before it was written; the matrix
+ * is asserted below. The tightest pair in the whole set is muted #9090a0 on the
+ * warning tint #332a12 at 4.51:1 — it passes AA by 0.01, and it is the first
+ * thing worth re-measuring in a real engine.
+ */
+
+const { renderPage, visibleTextNodes, measureContrast, parseColor, contrastRatio, rgb } = require('./helpers/dom');
+
+const PAGE = 'static/first-run-setup.html';
+const AA = 4.5;
+
+/** Light ground -> the dark counterpart it is given, reusing dark-mode.css's palette. */
+const GROUNDS = {
+    'rgb(30, 30, 63)':   { name: 'panel  (was white)',    probes: ['s-28fc19e0af', 's-618110d49d', 's-f28d221b5b', 's-2223116996'] },
+    'rgb(37, 37, 80)':   { name: 'raised (was #f8f9fa)',  probes: ['s-774f573f07', 's-951df17cfc', 's-a2c5bf3107', 's-e25ed4010e'] },
+    'rgb(22, 38, 63)':   { name: 'info   (was #e7f3ff)',  probes: ['s-70cc9673d8', 's-3d740e084c', 's-2a1b5837e4', 's-cee39a41dd'] },
+    'rgb(51, 42, 18)':   { name: 'warning (was #fff3cd)', probes: ['s-9f110629b5', 's-ea0f8633e3'] },
+};
+
+/** Families this round deliberately does NOT touch, each with the reason. */
+const OUT_OF_SCOPE = [
+    { re: /\bbtn-hp\b|\bbtn-success-hp\b|\bds-step-number\b|\bstep-title\b|\bstep-desc\b|\bstep-number\b/,
+      why: 'brand chrome on the #0096d6 ground — RD-160, Kam\'s decision, measured not changed' },
+    { re: /\bbtn-outline-(primary|secondary)\b|\bbtn-lg\b|\bbtn-sm\b/,
+      why: 'Bootstrap-painted; jsdom never loaded Bootstrap (RD-145), so this engine cannot judge it' },
+];
+const isOutOfScope = (cls, tag) => tag === 'option' || OUT_OF_SCOPE.some((f) => f.re.test(cls));
+
+/**
+ * Sweep once per mode and reuse it. A full walk of this page costs ~35s, and
+ * four independent walks put two minutes on the suite for four readings of the
+ * same page. The cache is keyed on the mode and never crosses one, so no
+ * assertion below can be answered by the other mode's render.
+ */
+const sweepCache = new Map();
+const sweep = (dark) => {
+    if (!sweepCache.has(dark)) {
+        renderPage(PAGE, { dark });
+        sweepCache.set(dark, visibleTextNodes()
+            .map((el) => ({ el, tag: el.tagName.toLowerCase(),
+                            cls: typeof el.className === 'string' ? el.className : '',
+                            ...measureContrast(el) }))
+            .filter((m) => m.ratio < AA));
+    }
+    return sweepCache.get(dark);
+};
+
+describe('R6-2 — the measured palette, asserted before it is trusted', () => {
+    // Object rows, not arrays, so the test NAME carries the measurement. A
+    // printf title on an array row consumes the args in order and had been
+    // printing "#e8e8e8 on #e8e8e8" — a title that reads as evidence while
+    // naming the wrong colour is worse than no title.
+    const PAIRS = [
+        { fgName: 'body text #e8e8e8', fg: '#e8e8e8', bgName: 'panel #1e1e3f',   bg: '#1e1e3f', expected: 13.06 },
+        { fgName: 'body text #e8e8e8', fg: '#e8e8e8', bgName: 'raised #252550',  bg: '#252550', expected: 11.75 },
+        { fgName: 'body text #e8e8e8', fg: '#e8e8e8', bgName: 'info #16263f',    bg: '#16263f', expected: 12.39 },
+        { fgName: 'body text #e8e8e8', fg: '#e8e8e8', bgName: 'warning #332a12', bg: '#332a12', expected: 11.58 },
+        { fgName: 'form-hint #b8c5d6', fg: '#b8c5d6', bgName: 'raised #252550',  bg: '#252550', expected: 8.22 },
+        { fgName: 'code #ff9ecd',      fg: '#ff9ecd', bgName: 'warning #332a12', bg: '#332a12', expected: 7.45 },
+        { fgName: 'link #79b8ff',      fg: '#79b8ff', bgName: 'panel #1e1e3f',   bg: '#1e1e3f', expected: 7.70 },
+        { fgName: 'muted #9090a0',     fg: '#9090a0', bgName: 'panel #1e1e3f',   bg: '#1e1e3f', expected: 5.09 },
+        { fgName: 'muted #9090a0',     fg: '#9090a0', bgName: 'warning #332a12', bg: '#332a12', expected: 4.51 },
+    ];
+
+    test.each(PAIRS)('$fgName on $bgName clears AA (measured $expected:1)', ({ fg, bg, expected }) => {
+        const ratio = contrastRatio(parseColor(fg), parseColor(bg));
+        expect(ratio).toBeCloseTo(expected, 1);
+        expect(ratio).toBeGreaterThanOrEqual(AA);
+    });
+
+    test('the tightest pair is muted #9090a0 on the warning tint, and it passes by 0.01', () => {
+        const ratios = PAIRS.map(({ fg, bg }) => contrastRatio(parseColor(fg), parseColor(bg)));
+        const tightest = PAIRS[ratios.indexOf(Math.min(...ratios))];
+        expect(`${tightest.fgName} on ${tightest.bgName}`).toBe('muted #9090a0 on warning #332a12');
+        expect(Math.min(...ratios)).toBeCloseTo(4.51, 2);
+    });
+
+    test('NEGATIVE CONTROL — the matrix can fail; the pre-fix pair is below AA', () => {
+        // #e8e8e8 on white is what the page actually rendered before this round.
+        expect(contrastRatio(parseColor('#e8e8e8'), parseColor('#ffffff'))).toBeLessThan(AA);
+    });
+});
+
+describe('R6-2 — the extracted grounds actually compute dark on the rendered page', () => {
+    test.each(Object.entries(GROUNDS))('%s is applied where the page uses it', (expectedRgb, { probes }) => {
+        renderPage(PAGE, { dark: true });
+        const seen = probes
+            .map((cls) => document.querySelector('.' + cls))
+            .filter(Boolean)
+            .map((el) => rgb(parseColor(getComputedStyle(el).backgroundColor)));
+        // Vacuity guard: if none of the probes is on the page, this assertion
+        // proves nothing and must fail rather than pass silently.
+        expect(seen.length).toBeGreaterThan(0);
+        for (const got of seen) expect(got).toBe(expectedRgb);
+    });
+
+    test('CONTROL — in LIGHT mode those same grounds are still the light values', () => {
+        renderPage(PAGE, { dark: false });
+        const el = document.querySelector('.s-28fc19e0af');
+        expect(el).not.toBeNull();
+        expect(rgb(parseColor(getComputedStyle(el).backgroundColor))).toBe('rgb(255, 255, 255)');
+    });
+});
+
+describe('R6-2 — the rendered dark sweep', () => {
+    test('every remaining dark failure is in a family this round deliberately left alone', () => {
+        const unexplained = sweep(true).filter((f) => !isOutOfScope(f.cls, f.tag));
+        // Named individually so a regression says WHICH node, not just a count.
+        expect(unexplained.map((f) => `${f.ratio.toFixed(2)} <${f.tag}> ${f.cls || '(no class)'}`)).toEqual([]);
+    });
+
+    test('the sweep is not passing by measuring nothing', () => {
+        renderPage(PAGE, { dark: true });
+        expect(visibleTextNodes().length).toBeGreaterThan(900);
+    });
+
+    test('NEGATIVE CONTROL — the allowlist does not swallow an in-scope failure', () => {
+        // A bare <li> on a white ground is exactly the P6-02 shape this round
+        // fixed: no class, so no out-of-scope rule can match it.
+        expect(isOutOfScope('', 'li')).toBe(false);
+        expect(isOutOfScope('form-hint', 'p')).toBe(false);
+        expect(isOutOfScope('s-924053337a', 'span')).toBe(false);
+    });
+
+    test('brand chrome IS still failing, and is recorded rather than silently passed', () => {
+        // RD-160 is Kam's card. This asserts the round did NOT quietly change it,
+        // so "0 unexplained failures" above cannot be read as "the page is clean".
+        const chrome = sweep(true).filter((f) => /\bbtn-hp\b|\bds-step-number\b/.test(f.cls));
+        expect(chrome.length).toBeGreaterThan(0);
+    });
+});
+
+describe('R6-2 — light mode must not regress', () => {
+    test('the light sweep is unchanged at its pre-existing 169 failures', () => {
+        // 169 is the number s14 measured before this round and Wednesday ruled
+        // OFF-DELTA. Pinned exactly: one more means this round leaked a colour
+        // into light mode, one fewer means it silently changed a light surface.
+        expect(sweep(false)).toHaveLength(169);
+    });
+});
diff --git a/__tests__/index-dark-surfaces.test.js b/__tests__/index-dark-surfaces.test.js
