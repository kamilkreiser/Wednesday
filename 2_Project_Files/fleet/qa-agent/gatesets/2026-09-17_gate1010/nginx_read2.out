## nginx-demo.conf 214-232
    # value deliberately rather than removing the cap.
    client_max_body_size 12m;

    # Slow-loris bound. The 408 JSON error page already existed below and was
    # unreachable until these were set.
    client_body_timeout   15s;
    client_header_timeout 15s;

    # Per-client concurrent connections. Empty key (no XFF) is skipped, so
    # local dev and the test suites are unaffected.
    limit_conn secuura_conn 50;

    # Aggregate ceiling for every location that does not set its own; /api/
    # redefines both zones below (a limit_req at a deeper level replaces the
    # inherited one rather than adding to it).
    limit_req zone=secuura_api burst=100 nodelay;

    # =========================================================================
    # KS-613 — security headers emitted BY THE GATEWAY
## nginx-demo.conf 405-420
    }

    # =========================================================================
    # API GATEWAY (highest priority path match)
    # =========================================================================
    location /api/ {
        # KS-613: both zones are declared here because a limit_req at this
        # level REPLACES the server-level one rather than adding to it — omit
        # secuura_api and /api/ would lose the aggregate ceiling entirely.
        # secuura_auth's key is empty for non-auth URIs, so it is a no-op
        # except on /api/auth/* and /api/v1/auth/*.
        limit_req zone=secuura_auth burst=10  nodelay;
        limit_req zone=secuura_api  burst=100 nodelay;
        proxy_pass http://api_gateway_pool$request_uri;
    }

## nginx-production.conf 340-352
        proxy_pass http://api_gateway_pool$request_uri;
    }

    # -------------------------------------------------------------------------
    # API GATEWAY
    # -------------------------------------------------------------------------

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://api_gateway_pool$request_uri;
    }

    location = /api/docs {
## issuer nginx.conf 118-140
        add_header Content-Type text/plain;
    }

    # API proxy - forward /api/* requests to the API gateway
    location /api/ {
        resolver 168.63.129.16 127.0.0.11 valid=30s;
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
    }

    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
        
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
