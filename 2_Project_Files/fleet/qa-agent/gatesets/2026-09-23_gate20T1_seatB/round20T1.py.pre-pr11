def go_string():
    return 'GO: merge ' + ', '.join('#' + n for n in sorted(PRS[p]['n'] for p in PUSH)) + ' batch'
def canon_path(row): return LM + '/runs/' + row[1] + '/out.md.checker/' + row[2]
def all_paths(): return [f['path'] for p in PUSH for f in PRS[p]['files']]
def distinct_paths(): return sorted(set(all_paths()))
def parse_ready(path):
    """(PR number, head 40-hex) from a captured READY: the number from `PR #N` in THE FIVE THINGS, the head = the first 40-hex after `Head at ORIGIN`."""
    t = open(path, encoding='utf-8').read(); body = t.split('## THE FIVE THINGS', 1)[-1]
    mn = re.search(r'PR[: *]*#(\d{4})\b', body); mh = re.search(r'Head at ORIGIN.*?\b([0-9a-f]{40})\b', body, re.S)
    return (mn.group(1) if mn else None, mh.group(1) if mh else None)
def read_newdev():
    """the predict run's launch-develop reading (newdev_tree.txt) as a dict, or {} if absent."""
    f = os.path.join(G, 'newdev_tree.txt')
    return dict(l.split(' ', 1) for l in open(f).read().strip().splitlines()) if os.path.exists(f) else {}
