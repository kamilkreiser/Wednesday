## originate webhooks.ts 425-560
   425	 * Deliver a payload to a webhook URL with HMAC-SHA256 signature.
   426	 */
   427	export async function deliverWebhook(
   428	  url: string,
   429	  secret: string,
   430	  payload: Record<string, unknown>,
   431	): Promise<{ status: number; success: boolean; duration: number; error?: string }> {
   432	  const body = JSON.stringify(payload);
   433	  const signature = createHmac('sha256', secret).update(body).digest('hex');
   434	  const start = Date.now();
   435	
   436	  // KS-487 B-2: re-validate at SEND time, not just at registration.
   437	  // Registration-time-only validation is defeated without any race — the
   438	  // attacker registers a public host, then repoints the DNS record. This is
   439	  // deliberately inside deliverWebhook rather than at its two call sites (the
   440	  // test-send at /test and the dispatch loop) so that neither can forget it,
   441	  // and so a third caller added later inherits it.
   442	  // KS-914: one call that validates AND connects to the address it validated.
   443	  // The previous shape — assertSafeOutboundUrl(url) then fetch(url) — resolved
   444	  // twice, and the second resolution is the one that decided where the packets
   445	  // went. It returns the guard's error rather than throwing, TAGGED with
   446	  // `reason: 'blocked' | 'request_failed'` — the branch below reads that tag,
   447	  // so the distinction is carried by the type and not by this sentence.
   448	  // `timeoutMs` is a total deadline on connect, transfer and drain, not a
   449	  // socket-idle timer.
   450	  const result = await safeOutboundRequest(
   451	    url,
   452	    {
   453	      method: 'POST',
   454	      headers: {
   455	        'Content-Type': 'application/json',
   456	        'x-secuura-signature': `sha256=${signature}`,
   457	        'x-secuura-event': (payload as any).type || 'unknown',
   458	        'x-secuura-delivery': (payload as any).id || uuidv4(),
   459	        'User-Agent': 'Secuura-Webhooks/1.0',
   460	      },
   461	      body,
   462	      timeoutMs: 10000,
   463	    },
   464	  );
   465	
   466	  if (!result.ok) {
   467	    // KS-914 A-4/A-5: the distinction is carried by `result.reason`, not by a
   468	    // comment. It reaches the operator on two surfaces — the persisted
   469	    // svc_webhook_deliveries.error and the /test response's delivery.error —
   470	    // so an operator can tell "we refused to send" from "their endpoint was
   471	    // down". The `blocked by SSRF guard:` prefix is the one this replaced; it
   472	    // is restored verbatim rather than reworded, because it is what anyone
   473	    // grepping delivery history is already looking for.
   474	    if (result.reason === 'blocked') {
   475	      logger.warn('webhook delivery blocked by SSRF guard', { url, reason: result.error });
   476	      return {
   477	        status: 0,
   478	        success: false,
   479	        duration: Date.now() - start,
   480	        error: `blocked by SSRF guard: ${result.error}`,
   481	      };
   482	    }
   483	    logger.warn('webhook delivery failed', { url, reason: result.error });
   484	    return {
   485	      status: 0,
   486	      success: false,
   487	      duration: Date.now() - start,
   488	      error: result.error,
   489	    };
   490	  }
   491	
   492	  return {
   493	    status: result.response.status,
   494	    success: result.response.ok,
   495	    duration: Date.now() - start,
   496	  };
   497	}
   498	
   499	/**
   500	 * Dispatch an event to all matching webhook subscriptions.
   501	 * Called by other services when events occur (cert issued, doc created, etc.)
   502	 */
   503	export async function dispatchEvent(
   504	  eventType: string,
   505	  payload: Record<string, unknown>,
   506	  db?: any,
   507	): Promise<number> {
   508	  try {
   509	    const client = db || prisma;
   510	    const webhooks = await client.$queryRaw`
   511	      SELECT id, url, secret_v2 FROM svc_webhooks
   512	      WHERE is_active = true AND ${eventType} = ANY(events)
   513	    `.catch(() => []);
   514	
   515	    if (!webhooks || webhooks.length === 0) return 0;
   516	
   517	    let delivered = 0;
   518	    for (const wh of webhooks as any[]) {
   519	      const event = {
   520	        id: `evt_${uuidv4()}`,
   521	        type: eventType,
   522	        timestamp: new Date().toISOString(),
   523	        data: payload,
   524	      };
   525	
   526	      // F-18 phase 2: decrypt secret_v2 at HMAC time.
   527	      const plainSecret = decryptWebhookSecret(wh.secret_v2, wh.id);
   528	      const result = await deliverWebhook(wh.url, plainSecret, event);
   529	
   530	      // Log delivery
   531	      try {
   532	        await client.$executeRaw`
   533	          INSERT INTO svc_webhook_deliveries (webhook_id, event_type, payload, response_status, success, error, duration_ms)
   534	          VALUES (${wh.id}::uuid, ${eventType}, ${JSON.stringify(event)}::jsonb, ${result.status}, ${result.success}, ${result.error || null}, ${result.duration})
   535	        `;
   536	      } catch { /* logging failure shouldn't break delivery */ }
   537	
   538	      if (result.success) delivered++;
   539	    }
   540	
   541	    logger.info('Webhook dispatch', { eventType, total: webhooks.length, delivered });
   542	    return delivered;
   543	  } catch (err: any) {
   544	    logger.warn('Webhook dispatch failed', { eventType, error: err.message });
   545	    return 0;
   546	  }
   547	}
   548	
   549	export default webhooksRouter;
