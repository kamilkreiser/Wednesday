import { defineConfig } from 'vitest/config';
import path from 'path';

export default defineConfig({
  resolve: {
    alias: {
      // The shared package exports map does not include ./utils/logger
      // but the auth logger re-exports from this path. Map it for tests.
      // The dist/ target always exists on an installed checkout: the repo
      // root's postinstall runs `npm run build --workspaces` (KS-381).
      '@secuura/shared/utils/logger': path.resolve(
        __dirname,
        '../../packages/shared/dist/utils/logger.js',
      ),
    },
  },
  test: {
    globals: true,
    environment: 'node',
    // KS-184: provision a baseline RS256 keypair before any suite imports
    // jwt.ts (which now requires one — no HS256 fallback).
    setupFiles: ['./vitest.setup.ts'],
  },
});
