    index 633e92de..a8af6492 100755
    --- a/Blockchain/Dev/scripts/run-migrations.sh
    +++ b/Blockchain/Dev/scripts/run-migrations.sh
    @@ -152,10 +152,17 @@ if [ "$failed_count" -gt 0 ]; then
