    index a7564f15..6fc1237f 100644
    --- a/Blockchain/Dev/scripts/check-no-latest-tags.sh
    +++ b/Blockchain/Dev/scripts/check-no-latest-tags.sh
    @@ -35,11 +35,24 @@ CHECK_FILES=(
       "deployment/azure/services.parameters.json"
       "deployment/azure/main.bicep"
       "deployment/azure/main.parameters.json"
    -  ".github/workflows/deploy-staging.yml"
     )
    +# KS-865: ".github/workflows/deploy-staging.yml" was the sixth entry and could never be read. This
    +# script cd's to Blockchain/Dev, so it looked for Blockchain/Dev/.github/workflows/deploy-staging.yml.
    +# That file DID exist (added in 4d908483f) and was deleted in b2c70381a on 2026-06-25; the repo-root
    +# copy was added in 1e3600359 and deleted in da98e25aa. At develop 6ab9d5021e96 `git ls-tree -r` finds
    +# NO file named deploy-staging.yml anywhere, so the entry was not mis-rooted — its target is gone.
    +# Below, `[ -f "$f" ] || continue` skipped it SILENTLY, so this gate advertised six files, read five,
    +# and printed OK. Same shape as KS-676. Removing it is the only loosening here; everything that can be
    +# read is now mandatory, and the count at the end makes an examined-nothing run impossible to misread.
     
    +EXAMINED=0
     for f in "${CHECK_FILES[@]}"; do
    -  [ -f "$f" ] || continue
    +  if [ ! -f "$f" ]; then
    +    echo "::error::$f is listed in CHECK_FILES but is not present (KS-865) — a listed input that is missing is an ERROR, not a skip"
    +    EXIT=1
    +    continue
    +  fi
    +  EXAMINED=$((EXAMINED + 1))
       # Match `image: …:latest` or `imageTag: latest` or `:latest"` in JSON.
       # Skip comment-only lines: `#` for yaml/sh, `//` for bicep.
       hits=$(grep -nE '(:latest\b|imageTag[^"]*"latest")' "$f" \
    @@ -52,6 +65,10 @@ for f in "${CHECK_FILES[@]}"; do
       fi
     done
     
    +# KS-865 (iii): the verdict names how many of the advertised inputs were actually examined, so a run
    +# that examined nothing cannot read as clean.
    +echo "check-no-latest-tags: examined $EXAMINED of ${#CHECK_FILES[@]} advertised file(s)."
    +
     if [ $EXIT -eq 0 ]; then
       echo "OK — no :latest tags found in production-bound configs."
     fi
