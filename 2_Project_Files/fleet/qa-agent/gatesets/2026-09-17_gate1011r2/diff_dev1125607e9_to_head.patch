+type QueryMock = Mock<(sql: string, params: unknown[]) => Promise<{ rows: unknown[] }>>;
+const makeQuery = (): QueryMock => vi.fn(async (_sql: string, _params: unknown[]) => ({ rows: [] as unknown[] }));
+
+function buildApp(user: object, query: QueryMock) {
+  const authenticateToken = ((_required?: boolean) =>
+    ((req, _res, next) => {
+      (req as unknown as { user: object }).user = { ...user };
+      next();
+    }) as RequestHandler) as (required?: boolean) => RequestHandler;
+
+  const app = express();
+  app.use(express.json());
+  app.use(createAuditMiddleware({ query, isDbAvailable: () => true, log: () => {} }));
+  app.use(
+    createProxyRoutes({
+      services: { originate: { url: `http://127.0.0.1:${upstreamPort}`, name: 'originate' } },
+      authenticateToken,
