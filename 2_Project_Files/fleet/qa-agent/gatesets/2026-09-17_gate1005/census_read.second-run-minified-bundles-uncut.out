6" width="2745" height="39" class="note"/><text x="1436" y="646" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="1436">Phase 3 - Create document. Auto-anchor fires.</tspan></text></g><g data-et="note" data-id="i26"><rect x="2337" y="1137" fill="#EDF2AE" stroke="#666" width="471" height="39" class="note"/><text x="2573" y="1142" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="2573">Phase 4 - Anchor on chain. Async, around 30s on preview.</tspan></text></g><g data-et="note" data-id="i32"><rect x="2387" y="1456" fill="#EDF2AE" stroke="#666" width="168" height="39" class="note"/><text x="2471" y="1461" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="2471">status confirmed</tspan></text></g><g data-et="note" data-id="i35"><rect x="63" y="1535" fill="#EDF2AE" stroke="#666" width="2745" height="39" class="note"/><text x="1436" y="1540" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="1436">Phase 5 - Poll for anchor outcome</tspan></text></g><g data-et="control-structure" data-id="i41"><line x1="77" y1="1584" x2="2373" y2="1584" class="loopLine"/><line x1="2373" y1="1584" x2="2373" y2="1821" class="loopLine"/><line x1="77" y1="1821" x2="2373" y2="1821" class="loopLine"/><line x1="77" y1="1584" x2="77" y2="1821" class="loopLine"/><polygon points="77,1584 127,1584 127,1597 118.6,1604 77,1604" class="labelBox"/><text x="102" y="1597" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="labelText" style="font-size: 16px; font-weight: 400;">loop</text><text x="1250" y="1602" text-anchor="middle" class="loopText" style="font-size: 16px; font-weight: 400;"><tspan x="1250">[every 5s with jitter cap 60s]</tspan></text></g><g data-et="note" data-id="i43"><rect x="-172.5" y="1876" fill="#EDF2AE" stroke="#666" width="521" height="39" class="note"/><text x="88" y="1881" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="88">txHash and blockNumber set. Document is provably anchored.</tspan></text></g><g data-et="note" data-id="i45"><rect x="2387" y="1970" fill="#EDF2AE" stroke="#666" width="371" height="39" class="note"/><text x="2573" y="1975" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="2573">Chain submit rejected or budget exhausted.</tspan></text></g><g data-et="note" data-id="i48"><rect x="113" y="2112" fill="#EDF2AE" stroke="#666" width="389" height="39" class="note"/><text x="308" y="2117" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="308">Backoff or alert ops. Chain may be congested.</tspan></text></g><g data-et="control-structure" data-id="i49"><line x1="-182.5" y1="1831" x2="2768" y2="1831" class="loopLine"/><line x1="2768" y1="1831" x2="2768" y2="2161" class="loopLine"/><line x1="-182.5" y1="2161" x2="2768" y2="2161" class="loopLine"/><line x1="-182.5" y1="1831" x2="-182.5" y2="2161" class="loopLine"/><line x1="-182.5" y1="1930" x2="2768" y2="1930" class="loopLine" style="stroke-dasharray: 3, 3;"/><line x1="-182.5" y1="2072" x2="2768" y2="2072" class="loopLine" style="stroke-dasharray: 3, 3;"/><polygon points="-182.5,1831 -132.5,1831 -132.5,1844 -140.9,1851 -182.5,1851" class="labelBox"/><text x="-157" y="1844" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="labelText" style="font-size: 16px; font-weight: 400;">alt</text><text x="1317.75" y="1849" text-anchor="middle" class="loopText" style="font-size: 16px; font-weight: 400;"><tspan x="1317.75">[status equals confirmed - happy path goes to Phase 6]</tspan></text><text x="1292.75" y="1948" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[status equals failed]</text><text x="1292.75" y="2090" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[status equals pending past budget]</text></g><g data-et="note" data-id="i52"><rect x="63" y="2201" fill="#EDF2AE" stroke="#666" width="3009.5" height="39" class="note"/><text x="1568" y="2206" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="1568">Phase 6 - Lifecycle actions. All shipped 2026-05-14.</tspan></text></g><g data-et="note" data-id="i60"><rect x="113" y="2647" fill="#EDF2AE" stroke="#666" width="567" height="40" class="note"/><text x="397" y="2652" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="397">KS-66 type enum now includes signed_document for the sign event.</tspan></text></g><g data-et="note" data-id="i72"><rect x="113" y="3251" fill="#EDF2AE" stroke="#666" width="582" height="39" class="note"/><text x="404" y="3256" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="404">KS-67 unified shares table. Email recipients resolved via KS-69 lookup.</tspan></text></g><g data-et="note" data-id="i85"><rect x="113" y="3902" fill="#EDF2AE" stroke="#666" width="459" height="39" class="note"/><text x="343" y="3907" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="343">KS-68. Chain anchoring of the event row is a follow-up.</tspan></text></g><g data-et="control-structure" data-id="i86"><line x1="77" y1="2250" x2="2313" y2="2250" class="loopLine"/><line x1="2313" y1="2250" x2="2313" y2="3951" class="loopLine"/><line x1="77" y1="3951" x2="2313" y2="3951" class="loopLine"/><line x1="77" y1="2250" x2="77" y2="3951" class="loopLine"/><line x1="77" y1="2702" x2="2313" y2="2702" class="loopLine" style="stroke-dasharray: 3, 3;"/><line x1="77" y1="2939" x2="2313" y2="2939" class="loopLine" style="stroke-dasharray: 3, 3;"/><line x1="77" y1="3305" x2="2313" y2="3305" class="loopLine" style="stroke-dasharray: 3, 3;"/><line x1="77" y1="3542" x2="2313" y2="3542" class="loopLine" style="stroke-dasharray: 3, 3;"/><polygon points="77,2250 127,2250 127,2263 118.6,2270 77,2270" class="labelBox"/><text x="102" y="2263" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="labelText" style="font-size: 16px; font-weight: 400;">alt</text><text x="1220" y="2268" text-anchor="middle" class="loopText" style="font-size: 16px; font-weight: 400;"><tspan x="1220">[Certify - issuer issues a verifiable cert. Shipped KS-66 + KS-70.]</tspan></text><text x="1195" y="2720" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[Sign - user adds PFX signature. Shipped via KS-66 enum.]</text><text x="1195" y="2957" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[Share - shipped via KS-67 documents/share + legacy certifications/share.]</text><text x="1195" y="3323" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[Revoke]</text><text x="1195" y="3560" text-anchor="middle" class="sectionTitle" style="font-size: 16px; font-weight: 400;">[Custody transfer - shipped KS-68. Rights-holder change without bytes changing.]</text></g><g data-et="note" data-id="i89"><rect x="2758" y="3991" fill="#EDF2AE" stroke="#666" width="314.5" height="39" class="note"/><text x="2915" y="3996" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="2915">Phase 7 - Public verification. No auth, cross-tenant. KS-70 lineage walk attached.</tspan></text></g><g data-et="note" data-id="i100"><rect x="3072.5" y="4582" fill="#EDF2AE" stroke="#666" width="611" height="39" class="note"/><text x="3378" y="4587" text-anchor="middle" dominant-baseline="middle" alignment-baseline="middle" class="noteText" dy="1em" style="font-size: 16px; font-weight: 400;"><tspan x="3378">KS-48 /api/documents/id/verify deprecated 2026-08-14. Use this endpoint.</tspan></text></g><g class="actor-man actor-top" name="Client" data-et="participant" data-type="actor" data-id="Client" style="stroke: rgb(212, 212, 212);"><line id="actor-man-torso0" x1="88" y1="25" x2="88" y2="45"/><line id="actor-man-arms0" x1="70" y1="33" x2="106" y2="33"/><line x1="70" y1="60" x2="88" y2="45"/><line x1="88" y1="45" x2="104" y2="60"/><circle cx="88" cy="10" r="15" width="176" height="65"/><text x="88" y="67.5" dominant-baseline="central" alignment-baseline="central" class="actor actor-man" style="text-anchor: middle; font-size: 16px; font-weight: 400;"><tspan x="88" dy="-8">Issuer or SSD</tspan></text><text x="88" y="67.5" dominant-baseline="central" alignment-baseline="central" class="actor actor-man" style="text-anchor: middle; font-size: 16px; font-weight: 400;"><tspan x="88" dy="8">Portal or Connector</tspan></text></g><g class="actor-man actor-top" name="Verifier" data-et="participant" data-type="actor" data-id="Verifier" style="stroke: rgb(212, 212, 212);"><line id="actor-man-torso6" x1="3047.5" y1="25" x2="3047.5" y2="45"/><line id="actor-man-arms6" x1="3029.5" y1="33" x2="3065.5" y2="33"/><line x1="3029.5" y1="60" x2="3047.5" y2="45"/><line x1="3047.5" y1="45" x2="3063.5" y2="60"/><circle cx="3047.5" cy="10" r="15" width="150" height="65"/><text x="3047.5" y="67.5" dominant-baseline="central" alignment-baseline="central" cla