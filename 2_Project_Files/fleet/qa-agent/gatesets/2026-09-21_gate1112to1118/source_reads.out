/** Chain form → logical strings. Booleans stay as "true"/"false" here; anchorReadback.ts types them by key. */
export function fromCardanoMetadatum(value: unknown): unknown {
  if (Array.isArray(value)) {
    if (value.length > 0 && value.every((el) => typeof el === 'string')) {
      return (value as string[]).join('');
    }
    return value.map(fromCardanoMetadatum);
  }
