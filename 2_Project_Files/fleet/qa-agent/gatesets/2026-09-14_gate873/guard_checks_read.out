--- tsconfig + vitest.config
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
import { defineConfig } from 'vitest/config';
import { resolve } from 'node:path';

export default defineConfig({
  resolve: {
    alias: {
      // KS-727 class guard: the guard imports service middleware from outside
      // this package, and those modules import `@secuura/shared` by name. Node
      // resolution sends that to `dist/`, so without this alias the suite would
      // measure the LAST BUILD rather than the working tree — a source fix
      // would leave the guard green until someone happened to rebuild, which is
      // the same inert-proof trap the #774 review recorded. It also keeps class
      // identity single: the guard's `instanceof` controls compare against the
      // same `AppError` the imported handlers see.
      //
      // Scope check: nothing inside `packages/shared/src` imports itself by
      // package name (all internal imports are relative), so this alias only
      // affects modules pulled in from outside the package.
      '@secuura/shared': resolve(__dirname, 'src/index.ts'),
    },
  },
  test: {
    include: ['src/__tests__/**/*.test.ts'],
    globals: true,
  },
});
