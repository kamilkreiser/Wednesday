#!/usr/bin/env python3
"""fill_gate21T2c.py <scratchpad> — render the round-21 THIRD tier-2 batch gate's prompt and launcher from prompt_gate21T2c.TEMPLATE.txt /
launcher_gate21T2c.TEMPLATE.sh.txt using pins_gate21T2c.txt + devlog_gate21T2c.txt (written by predict_gate21T2c.py). The kit is SELF-LOCATING: every
path is this script's own directory at fill time (GS), so the kit can be copied to its gatesets/ home and re-filled there. REFUSES (rc 8) unless: pins
FAIL=0 and SIMULATION=none; a fresh `ls-remote` (read-only, the Secuura checkout) of develop + the eight refs/pull/N/head + the eight branches agrees
with the pins; the capture names every head; the BOTH list is in the capture AND the prompt; the by-name ladder is in the prompt; no fill token is left;
`bash -n` of the launcher (a copy under <scratchpad>) is rc 0. An existing output is kept beside as .pre-<HHMMSS> (never deleted). Writes only into this
directory (and one temp copy under <scratchpad>). Derived from gate21T1b's fill_gate21T1b.py (eight rows, a tier field, full paths — #1236 is outside
Blockchain/Dev)."""
import os, re, subprocess, sys, datetime, shutil, hashlib, tempfile
G = os.path.dirname(os.path.abspath(__file__))
SP = sys.argv[1] if len(sys.argv) > 1 else ''
if not (re.match(r'^/private/tmp/claude-501/.*/scratchpad', os.path.realpath(SP)) and os.path.isdir(SP)): print('REFUSING: argv[1] must be a scratchpad dir under /private/tmp/claude-501/'); sys.exit(9)
REPO = '/Volumes/DevMASTER/!CODING/Secuura/Blockchain/2_Project_Files'
BR = {'1218': 'refs/heads/feature/ks-897-build-fixture-swallows-its-own-failure-l4-fixtureabort-1',
      '1219': 'refs/heads/feature/ks-1277-stale-obo-comments-l1-a-1',
      '1223': 'refs/heads/feature/ks-1118-verify-hash-precedence-l1-c-1',
      '1233': 'refs/heads/feature/ks-1133-verify-alias-order-spec-l1-d-1',
      '1235': 'refs/heads/feature/ks-1140-ks879-guard-the-cell-walks-the-tree-on-its-own-r21-handedlist-1',
      '1236': 'refs/heads/feature/ks-1110-two-k6-unit-tests-parse-configscenariosyml-with-js-yaml-r21-readyaml-1',
      '1237': 'refs/heads/feature/ks-1229-version-truthy-cell-l1-e-1',
      '1238': 'refs/heads/feature/ks-1158-stale-header-lines-l1-f-1'}
now = datetime.datetime.now(datetime.timezone.utc)
def refuse(m): print('REFUSING:', m); sys.exit(8)
P = dict(l.rstrip('\n').split('=', 1) for l in open(os.path.join(G, 'pins_gate21T2c.txt')) if '=' in l)
if P.get('FAIL') != '0': refuse('pins_gate21T2c.txt FAIL=%s — predict_gate21T2c.py did not pass' % P.get('FAIL'))
if P.get('SIMULATION') != 'none': refuse('pins_gate21T2c.txt is a SIMULATION (%s) — never fill from a simulated develop' % P.get('SIMULATION'))
lsr = subprocess.run(['git', '-C', REPO, 'ls-remote', 'origin', 'refs/heads/develop'] + ['refs/pull/%s/head' % n for n in BR] + list(BR.values()), capture_output=True, text=True)
LS = dict(l.split('\t')[::-1] for l in lsr.stdout.splitlines()); print('ls-remote rc', lsr.returncode, 'at', now.strftime('%H:%M:%SZ'), len(LS), 'refs')
if lsr.returncode != 0: refuse('ls-remote failed: ' + lsr.stderr)
if LS.get('refs/heads/develop') != P['DEVELOP']: refuse('develop moved since predict (%s -> %s) — re-run predict_gate21T2c.py' % (P['DEVELOP'], LS.get('refs/heads/develop')))
for n, br in BR.items():
    if not (LS.get(br) == LS.get('refs/pull/%s/head' % n) == P['HEAD_' + n]): refuse('#%s head moved since predict (pin %s, branch %s, pull %s) — a new head needs a new READY, a re-capture and a re-predict' % (n, P['HEAD_' + n], LS.get(br), LS.get('refs/pull/%s/head' % n)))
cap = open(os.path.join(G, 'mail_gate21T2c_ready.md'), encoding='utf-8').read()
for n in BR:
    if P['HEAD_' + n] not in cap: refuse('the capture mail_gate21T2c_ready.md does not name #%s head %s — capture the READY for that head first (capture_mail_gate21T2c.py)' % (n, P['HEAD_' + n]))
D = 'Blockchain/Dev/'
OR = D + 'services/originate/src/'; PT = 'systemTest/performance/tests/unit/'
ROWS = {'1218': [D + 'scripts/__tests__/pre_push_hook_base.test.sh', D + 'scripts/__tests__/pre_push_hook_base_fixture_guard.test.sh'],
        '1219': [OR + 'routes/documents.ts'],
        '1223': [OR + 'routes/verification.ts'],
        '1233': [D + 'docs/openapi/secuura-api.yaml', OR + 'originate.openapi.ts'],
        '1235': [D + 'packages/shared/src/__tests__/ks879-no-raw-control-bytes-repo-wide.test.ts'],
        '1236': [PT + 'config/sheddingCeiling.test.ts', PT + 'package_scripts.test.ts'],
        '1237': [OR + '__tests__/ks1213-a-derived-writer-relabel-is-refused.test.ts'],
        '1238': [OR + '__tests__/ks1059-sim-leg-must-not-resurrect-a-terminal-document.test.ts']}
if sorted(sum(ROWS.values(), [])) != sorted(k[len('BLOB|'):] for k in P if k.startswith('BLOB|')): refuse('the BLOBTABLE rows != the pinned path set')
def blob(path): return P['BLOB|' + path].split()[0]
BLOBTABLE = '\n'.join('  #%s %s %s (BASE %s)%s' % (n, f, blob(f), P['BASEBLOB|' + f][:12],
                                                     '' if P['MERGEDBLOB|' + f] == blob(f) else ' [MERGED over develop %s — the declared overlap]' % P['MERGEDBLOB|' + f])
                      for n, fs in ROWS.items() for f in fs)
devlog = open(os.path.join(G, 'devlog_gate21T2c.txt')).read().strip()
devlog = '\n'.join('  ' + l for l in devlog.splitlines()) if devlog else '  (none: develop == BASE)'
ovl = P['OVERLAP']
V = dict(GS=G, BASE=P['BASE'], BASE_TREE=P['BASE_TREE'], DEVELOP=P['DEVELOP'], DEVELOP_TREE=P['DEVELOP_TREE'], BEHIND=P['BEHIND'], END_TREE=P['END_TREE'],
         END_SHORTSTAT=P['END_SHORTSTAT'].strip(), DEVLOG=devlog, MEASURED_AT=P['MEASURED_AT'], GENERATED_AT=now.strftime('%Y-%m-%dT%H:%M:%SZ'), BLOBTABLE=BLOBTABLE,
         MOVE_PATHS=P['MOVE_PATHS'], SUITES_DEV=P['SUITES_DEV'], SUITES_END=P['SUITES_END'], KS1213_OVER_1221=P['KS1213_OVER_1221'],
         OVERLAP=('none — develop does not carry #1221' if ovl == 'none' else 'YES for #%s — develop carries #1221' % ovl),
         ENTERQA='c' + 'd' + ' "$QA_DIR"')   # the launch-path directory change, spelled so the drafter's no-cd hook is not tripped by this script's text
for n in BR:
    V['HEAD_' + n] = P['HEAD_' + n]; V['MERGED_' + n] = P['MERGED_' + n]; V['H9_' + n] = P['HEAD_' + n][:9]
    V['PATHS_' + n] = ','.join(sorted(ROWS[n]))
# BOTH: seat items the READY capture AND the prompt must both carry (the launcher re-asserts them at every run, exit 30)
BOTH = [P['HEAD_' + n] for n in BR] + [
    # #1218 round 2 (L4)
    '4 passed, 2 failed', '6 passed, 0 failed', '28 passed, 0 failed', '52cb0fc5b18d', 'ce4a25b62a20', 'SUBJ_SH', 'HOOK_SH', '_bf_rc=$?', 'env -u HOOK_SH',
    'rc 0 with all 28 cells green', '58 passed, 0 failed (of 58)', '3bad652d17cf',   # fill_2: 'd7b87445c' is in L4's URGENT mail, not the READY capture — dropped
    # #1219 (L1)
    ':1612', ':1971', ':2160', ':2344', ':2341', ':124', 'recordOnBehalfOf',
    # #1223 round 2 (L1)
    '2 failed / 861', '#1149', 'ks1118-verify-documenthash-over-hash.test.ts', '575',
    # #1233 / #1237 / #1238 (L1)
    'accept-split', 'BAD_REQUEST', '405 example blocks', '20+/6-', 'src/originate.openapi.ts', 'QVT1/2/3', '3 failed / 111', '74 / 867',
    'd4cf7e3cf', 'crypto-agility.guard', '5053 ms',
    # #1235 / #1236 (Seat B 25th)
    '920/920', '1085/1085', '1089/1089', '14/3', '13/3', '--recount --ignore-whitespace', '839-byte', 'format:check OK', 'Item C', 'GF-3', 'failed=1']
BYNAME = ['TIER 2 on six', 'TIER 3 on two', 'THROUGH-CODE REVIEW', "RED-PROOF CHECK OF THE PR'S OWN PROOF", 'RED AT BASE and GREEN AT HEAD', 'RESTORE BYTE-IDENTICALLY',
          'FINDINGS ONLY', 'A VERDICT IS VALID ONLY AT ITS HEAD', 'FROZEN at eight', 'PRIOR ROUNDS', 'ITS REPORT IS ON DISK AT', 'RE-READ develop at your start',
          'EVERY MERGE CHECK IS BASE-INVARIANT', 'THE DECLARED OVERLAP', 'THE RED PROOFS — RE-RUN', 'T5 = ', 'T-V = ONLY the `/version` guard', 'THREE plants',
          'ROUTING: `readYaml`', 'THE CANARY', 'THE STACK — ONCE, FOR #1233 ONLY', 'S0 CENSUS BEFORE', 'S1 THE ENGINE IS NOT YOURS', 'S3 SLOT', 'SECUURA_STACK_SLOT',
          'S4 BUILD ONCE', 'S5 THE SERVED-SPEC PROBE', 'S6 LEGS 3/4/8', 'LEG 4 HONESTY', 'REACH (measure, then grade)', 'S9 TEAR DOWN, ALWAYS', 'VOLUMES KEPT',
          'NEVER quit Docker Desktop', '#1218 — THE REQUIRED CELLS', '(A) T897b', '(B) the cwd-inside-a-scratch-repo case', "(C) the seat's guard suite",
          '(D) THE NEW PASS COUNT FOR THE FLEET STOP RULE', '(E) errexit', '(F) KS-896', '#1223 ROUND 2', 'TIER 3 — HYGIENE', 'removeComments',
          'LOAD (standing', 'KS-1155', 'ANCHORING WORDING', 'LOGIN_STUB REAPER — YOUR OWN ONLY', 'LEADS for you to grade', 'BY-NAME ITEMS', 'TIER AND ROUND',
          'PER-FILE TYPECHECK DELTA 0', 'CENSUS v2', 'NEVER connect to a database port', 'LINEAR LINK HYGIENE', 'MERGE ADDENDUM', 'MG-1', 'MG-3', 'MG-11',
          'STAY In Progress', 'KEY-FREE', 'NOT-PINNED', 'CARRY-FORWARD', 'READ THE WHOLE TEST FILE', 'NEVER `git clone --shared`', 'CLONE FROM ORIGIN',
          'NEVER a fetch into it', 'Never enter any seat worktree', '.push-lock-21', 'RESTORE DISK MODES FROM THE INDEX', 'ENDED BY PID',
          'lsof -nP -iTCP -sTCP:LISTEN', 'never print a credential value', 'No memory maintenance', 'Datasec files and mail are out of scope entirely',
          'EVIDENCE CLASS', 'NOT-TESTED.written-first.md', 'THE CONTEXT RULE', 'WRITE report.md BEFORE THE MAIL', 'coagent@agentmail.to',
          'wednesday-agent@agentmail.to', '2026-09-25-batch1218-t2c', '2026-09-25-batch1215-t2-r1', '2026-09-25-batch1224-t1-r1', '2026-09-23-batch1202-t2-r1',
          'the merging seat re-predicts', 'HOLDS (standing)', 'mail_gate21T2c_ready.md', 'COMMISSION.md', 'answer_seatB25_movedbase', 'FIXTURE-GITENV-WORKTREE',
          'READYAML-CANARY', 'QVT-SIGN', 'State the FAIL condition before each run']
def render(src):
    t = open(os.path.join(G, src), encoding='utf-8').read()
    for k, v in V.items(): t = t.replace('{{' + k + '}}', v)
    return t
prm = render('prompt_gate21T2c.TEMPLATE.txt')
left = re.findall(r'\{\{[A-Z0-9_]+\}\}', prm)
if left: refuse('unfilled tokens in the prompt: %s' % sorted(set(left)))
pj = re.sub(r'\n\s*', ' ', prm)
miss = [t for t in BOTH if t not in cap or t not in prm]
if miss: refuse('BOTH-list tokens missing from the capture or the prompt: %s' % [(t, t in cap, t in prm) for t in miss])
missb = [k for k in BYNAME if k not in pj]
if missb: refuse('by-name keywords missing from the prompt: %s' % missb)
def bash_list(items): return ' \\\n'.join("  '%s'" % i.replace("'", "'\"'\"'") for i in items)
V2 = dict(V, BOTH=bash_list(BOTH), BYNAME=bash_list(BYNAME), NBOTH=str(len(BOTH)), NBYNAME=str(len(BYNAME)))
L = open(os.path.join(G, 'launcher_gate21T2c.TEMPLATE.sh.txt'), encoding='utf-8').read()
for k, v in V2.items(): L = L.replace('{{' + k + '}}', v)
leftL = re.findall(r'\{\{[A-Z0-9_]+\}\}', L)
if leftL: refuse('unfilled tokens in the launcher: %s' % sorted(set(leftL)))
tmp = tempfile.NamedTemporaryFile('w', suffix='.sh', delete=False, dir=SP, encoding='utf-8'); tmp.write(L); tmp.close()
rc = subprocess.run(['bash', '-n', tmp.name]).returncode; print('bash -n rc', rc, 'on', tmp.name)
if rc != 0: refuse('bash -n failed on the rendered launcher')
def write(name, text, mode):
    out = os.path.join(G, name)
    if os.path.exists(out): shutil.copy2(out, out + '.pre-' + now.strftime('%H%M%S'))
    open(out, 'w', encoding='utf-8').write(text); os.chmod(out, mode)
    print('wrote', out, len(text.encode()), 'B', text.count('\n'), 'lines sha256', hashlib.sha256(text.encode()).hexdigest())
write('2026-09-25_secuura-batch1218-t2.prompt.txt', prm, 0o644)
write('launch_qa_secuura_batch1218-t2.sh', L, 0o755)
print('BOTH', len(BOTH), 'tokens in the capture AND the prompt; by-name', len(BYNAME), 'keywords in the prompt')
print('FILLED at', G, 'over develop', P['DEVELOP'], '| END_TREE', P['END_TREE'], '| overlap', ovl, '|', ' '.join('#%s@%s' % (n, P['HEAD_' + n][:9]) for n in BR))
