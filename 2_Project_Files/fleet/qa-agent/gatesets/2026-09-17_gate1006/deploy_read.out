--- E. rejectControlBytes body (does it answer or next(err)?)
608: export function rejectControlBytes() {
609:   return (req: Request, res: Response, next: NextFunction) => {
610:     if (req.body !== undefined && req.body !== null) {
611:       const hit = findControlBytePath(req.body);
612:       if (hit) {
613:         const message = `Must not contain ${describeControlByte(hit.char)}`;
614:         res.status(400).json({
615:           success: false,
616:           error: {
617:             code: 'VALIDATION_ERROR',
618:             message,
619:             details: [{ path: hit.path, message }],
620:           },
621:         });
622:         return;
623:       }
624:     }
625:     next();
626:   };
627: }
628: 
629: /**
630:  * KS-800: mount the body parsers AND the control-byte guard in the one order
631:  * that works, so no service has to remember it.
632:  *
633:  * The order is load-bearing and the failure is silent. `rejectControlBytes()`
634:  * inspects `req.body`; mounted between `express.json()` and
635:  * `express.urlencoded()` it walks `{}` on every form request and passes
636:  * everything. Five services shipped exactly that, and the same NUL byte was
637:  * 400 as JSON and 200 as a form — on `/api/oauth/authorize` it reached the
638:  * authorization-code minter (KS-781 P3-3).
639:  *
640:  * The doc comment on the guard used to say "mount immediately after
641:  * `express.json()`", which TOLD people to get it wrong. A per-service
642:  * convention is the class of guard that eventually fails; this is the fix that
643:  * removes the convention.
644:  *
645:  * @param app - the express application
646:  * @param opts.limit - body size limit passed to both parsers (default '1mb')
647:  * @param opts.urlencoded - mount `express.urlencoded` too (default true)
648:  *
649:  * @example
650:  * const app = express();
651:  * mountBodyParsers(app);   // json + urlencoded + guard, correctly ordered
652:  */
