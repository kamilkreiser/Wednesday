     1	export async function getTransaction(txHash: string) {
     2	  if (!blockfrost) return null;
     3	  try {
     4	    return await blockfrost.txs(txHash);
     5	  } catch (err: any) {
     6	    // 404 = the chain answered: tx not on chain yet. Reachability is recorded
     7	    // by the client proxy; this only decides what the CALLER gets back.
     8	    if (err?.status_code === 404) return null;
     9	    throw err;
    10	  }
    11	}
