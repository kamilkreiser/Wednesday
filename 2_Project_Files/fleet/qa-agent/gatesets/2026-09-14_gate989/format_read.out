-- fixtures/tsconfig.json:
{
    // KS-993: nothing type-checked this directory.
    //
    // `systemTest/fixtures/` holds the provisioning step every suite runs
    // (`pre-suite.ts`, `manifest.ts`, `provision-actors.ts`). It is executed via
    // `tsx`, which TRANSPILES WITHOUT TYPE-CHECKING — so until this file existed a
    // type error here did not fail a build, it failed at runtime inside whichever
    // suite happened to run it.
    //
    // Deliberately the NARROWEST config that covers the directory: it type-checks
    // and emits nothing. The per-package tsconfigs cannot reach here — each sets
    // `rootDir: "."` at its own package root, and their `@fixtures/*` aliases point
    // at their OWN fixtures subdirectory, not this shared one.
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "types": ["node"],
        // KS-993: this directory has no node_modules of its own; the type packages
        // live in the sibling suites that consume it. Pointed here rather than
        // dropping `types` — removing it would silence node builtins instead of
        // resolving them, which is loosening the config to make it pass.
        "typeRoots": ["../performance/node_modules/@types"],

        // These modules import each other with explicit `.ts` extensions
        // (`./manifest.ts`), which is how `tsx` runs them. Type-check them the
        // same way rather than rewriting the imports to suit the checker.
        "allowImportingTsExtensions": true,
        "noEmit": true,

        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "generated"]
}
