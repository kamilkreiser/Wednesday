 */
export default {
    printWidth: 120,
    tabWidth: 4,
    useTabs: false,
    semi: true,
    singleQuote: true,
    quoteProps: 'consistent',
    trailingComma: 'all',
    bracketSpacing: true,
    arrowParens: 'always',
    proseWrap: 'always',
    embeddedLanguageFormatting: 'auto',
    overrides: [
        {
            files: ['*.ts', '*.tsx'],
            options: {
                proseWrap: 'preserve',
            },
        },
        {
            files: ['**/*.md', '*.md'],
            options: {
                proseWrap: 'always',
            },
        },
        {
            files: '*.json',
            options: {
                trailingComma: 'none', // JSON doesn't support trailing commas
            },
        },
        {
            files: ['*.yml', '*.yaml'],
            options: {},
        },
        {
            files: '*.txt',
            options: {
                parser: 'markdown',
            },
        },
    ],
};
