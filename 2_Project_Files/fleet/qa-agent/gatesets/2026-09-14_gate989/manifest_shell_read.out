-- vitest.unit.config.ts:
/**
 * Vitest configuration for the FAST, OFFLINE unit / characterization layer.
 *
 * Mirrors the sibling `systemTest/akto` pattern: a minimal config (no reporters,
 * no globalSetup, no live services) so the characterization net runs in well
 * under a second and can be re-run after every restructure step.
 *
 * It picks up ONLY `tests/unit/**` and never touches the network or a real k6
 * runtime. The `k6/execution` module is aliased to a local stub so helper
 * modules that import it (e.g. `helpers/data.ts`) load under Node — k6/http is
 * imported as `import type` in the helpers, so it is erased at runtime and needs
 * no alias.
 *
 * Invoked by `npm run test:unit`.
 */

import { fileURLToPath } from 'node:url';

import { defineConfig } from 'vitest/config';

// 10 s is generous for pure, in-memory unit tests; the only heavier test spawns
// the ci-gate CLI once per scenario fixture (tsx cold start ~1-2 s).
const UNIT_TEST_TIMEOUT_MS = 15_000;

export default defineConfig({
    test: {
        globals: true,
        environment: 'node',
        include: ['tests/unit/**/*.test.ts'],
        testTimeout: UNIT_TEST_TIMEOUT_MS,
        alias: {
            'k6/execution': fileURLToPath(new URL('./tests/unit/k6mocks/execution.ts', import.meta.url)),
            'k6': fileURLToPath(new URL('./tests/unit/k6mocks/k6.ts', import.meta.url)),
        },
    },
});
