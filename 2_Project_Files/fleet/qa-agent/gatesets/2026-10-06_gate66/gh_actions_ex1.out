RUN Dependabot standalone locks        prev completed/skipped        head -/-
RUN PR Security Gates (KS-168)         prev completed/failure        head -/-
RUN PR — Lockfiles (path-skip twin)    prev completed/success        head -/-
RUN Security Scanning                  prev completed/failure        head -/-
RUN pr                                 prev completed/failure        head -/-
RUN pr-premerge-ack                    prev completed/success        head -/-
PR-WORKFLOW `pr` prev ('completed', 'failure') head None
