ks501 test at head: lines 50-72
/**
 * KS-501 — a non-string documentType must be rejected, never crash the gateway.
 *
 * `enforceDocumentTypeRules` read `(body.documentType || body.type || '') as
 * string` — a compile-time cast, not a runtime coercion — so a truthy
 * non-string (123, [...], {...}) passed the falsy guard and reached
 * `typeRef.toUpperCase()` inside `resolveDocumentType`, throwing a TypeError
 * that escaped as an unhandled rejection and crashed the WHOLE gateway
 * process (restart → a measured 66-operation 502 cascade in the
 * full-2026-07-24 sweep). These tests pin the fix: a 400 VALIDATION_ERROR
 * result, and a total (null-returning) resolver.
 */

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { resolveDocumentType, enforceDocumentTypeRules } from '../services/enforcement';

vi.mock('../services/redis', () => ({
  getAllDocumentTypes: vi.fn(),
  getWorkflow: vi.fn(),
  setWorkflowInstance: vi.fn(),
    expect((result as { status?: number }).status).toBe(400);
  });

  it('still passes through an absent/empty documentType', async () => {
    const result = await enforceDocumentTypeRules({}, undefined);
    expect(result.ok).toBe(true);
  });

  it('resolveDocumentType is total: a non-string returns null rather than throwing', async () => {
    await expect(resolveDocumentType(123 as unknown as string)).resolves.toBeNull();
    await expect(resolveDocumentType({} as unknown as string)).resolves.toBeNull();
    // Redis is never consulted for a value that cannot be a type ref.
    expect(redisService.getAllDocumentTypes).not.toHaveBeenCalled();
  });
  it('RED KS-1203: a body carrying no resolvable documentType admits with an EMPTY docType and never consults the catalogue', async () => {
    const untypedShapes = [{}, { documentType: '' }, { type: '' }, { DocumentType: 'SSD_DOCUMENT' }, { document_type: 'SSD_DOCUMENT' }, { Type: 'SSD_DOCUMENT' }, { data: { title: 'no type here' } }];
    for (const body of untypedShapes) {
      const result = await enforceDocumentTypeRules(body, undefined);
      expect([result.ok, (result as { docType?: unknown }).docType]).toEqual([true, {}]);
    }
    expect(redisService.getAllDocumentTypes).not.toHaveBeenCalled();
  });
});
