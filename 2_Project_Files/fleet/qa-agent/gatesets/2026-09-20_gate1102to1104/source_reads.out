  describe('enforceDocumentTypeRules', () => {
    it('returns ok:true with empty docType when no typeRef is provided', async () => {
      const result = await enforceDocumentTypeRules({}, makeUser());
      expect(result).toEqual({ ok: true, docType: {} });
