{
  "name": "@secuura/referral-service",
  "version": "0.1.0",
  "description": "Secuura Referral Service - Referral codes, milestones, and growth rewards",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "secuura",
    "referral",
    "growth",
    "rewards"
  ],
  "author": "Kamil Kreiser",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "nanoid": "^3.3.17",
    "uuid": "^14.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "eslint": "^10.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@types/pg": "^8.16.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "body-parser": "1.20.8",
    "postcss": "8.5.23"
  }
