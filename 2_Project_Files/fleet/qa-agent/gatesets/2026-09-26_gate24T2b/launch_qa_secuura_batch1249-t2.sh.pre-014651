has 'A WRONG READING ON ANY REAL SHAPE = NO GO for that PR (blocking)' && has 'the PR'"'"'s own commit / cell text NAMES it as a shape the check catches' && has 'THROUGH THE REAL CODE PATH — never a lifted regex, never a Python port' && has 'do not soften the rule yourself' || { echo "REFUSING: THE READER RULE" >&2; exit 40; }
has '#1250 TRAP-SWALLOWS-TERM (MANDATORY' && has 'exits 0 OR prints a green `shell suites:` verdict OR runs a further suite = NO GO for #1250 (blocking)' && has 'SIGTERM sent to the RUNNER'"'"'s own pid (by pid, never by name)' || { echo "REFUSING: the #1250 TRAP-SWALLOWS-TERM rule" >&2; exit 41; }
has 'DO NOT GRADE #1248.' && has '#1249 is graded over develop + #1248' && has 'its MERGE ADDENDUM line is the HOLD form ("HOLD: #1248 not GO")' || { echo "REFUSING: #1248 not graded / #1249 over develop + #1248" >&2; exit 42; }
has 'never by name, never pid 1' && has 'report the count before / after' || { echo "REFUSING: the LOGIN_STUB REAPER rule" >&2; exit 43; }
has 'DECLARED SCOPE (grade as disclosed scope, never as a defect of the PR)' && has 'grade it NOT MEASURED, never as a defect of #1254' || { echo "REFUSING: the declared scope" >&2; exit 44; }
has 'They are NOT RUN in this gate: NO Docker, NO database.' && has 'For #1252 you owe instead the LEG-8-PORT' && has '#1252 is NO GO until they run' || { echo "REFUSING: legs 3/4/8 NOT run / #1252 LEG-8-PORT" >&2; exit 45; }
has "WEDNESDAY'S signed GO naming the head" && has '`GO: merge #1249, #1250, #1251, #1252, #1253, #1254, #1255 batch`' && has '#1249 ONLY AFTER #1248 is on develop' || { echo "REFUSING: merge authority / the GO string / the #1248-first order" >&2; exit 26; }
has '## MERGE ADDENDUM' && has 'PER PR FILE (1 over 1 path) for #1249, #1251, #1253 and #1255, (2 over 2 paths) for #1250, (3 over 3 paths) for #1252 and #1254' && has 'KEY-FREE' && has 'subject <= 92 chars' && has 'FLEET STOP after this merge' || { echo "REFUSING: the MERGE ADDENDUM rules" >&2; exit 25; }
grep -qF -- '[QA -> Wednesday] TIER-2 GATE batch #1249 #1250 #1251 #1252 #1253 #1254 #1255 (Seats L6 L5 B28, round 24)' "$PROMPT_FILE" && has 'FROM coagent@agentmail.to' || { echo "REFUSING: the verdict subject / sender" >&2; exit 23; }
grep -qF -- "$BASE_SHA" "$PROMPT_FILE" && grep -qF -- "$DEVELOP_SHA" "$PROMPT_FILE" && grep -qF -- "$END_TREE" "$PROMPT_FILE" && grep -qF -- "$END_TREE_NOSTACK" "$PROMPT_FILE" || { echo "REFUSING: BASE / the launch develop / the END trees not in full" >&2; exit 31; }
NOTE="origin develop $CUR_DEV == the pinned launch develop ($DEV_BEHIND ahead of BASE $BASE_SHA); heads at branch AND pull/<n>/head:$HEADS_NOTE; #1248 stack base ${_s48:0:9}; END_TREE $END_TREE"
_ANY_OVR="$(env | grep -c '^QAB24B_')"
if [ "${1:-}" = "--check" ]; then
  echo "all guards pass:"
  echo "  $NOTE"
  echo "  compare (GitHub API), develop...head per PR (merge_base, ahead, behind, the PR's own paths by name):"; printf '%s\n' "$COMPARE" | sed 's/^/    /' | cut -c1-240
  echo "  capture, prompt, QA project and repo present; kit at its filled home; seven rows; thinking directive; capture + commission named; no unfilled token"
  echo "  capture and prompt BOTH carry every head in full, every ticket and 61 seat items; the prompt carries 96 by-name keywords and the base-invariant+pairwise+declared-overlap / no-docker / red-proof / fleet-STOP / load+anchoring / holds / READER RULE / TRAP-SWALLOWS-TERM / #1248-not-graded / reaper / scope / legs-3/4/8 rules, the GO string, the addendum rules, the verdict subject, BASE / develop / both END trees in full"
  [ "$_ANY_OVR" != 0 ] && echo "  (a QAB24B_* TEST OVERRIDE is set)"
  echo "  a launch (not --check) will refuse unless stdin is a TTY (exit 21)"
  exit 0
fi
[ -t 0 ] || { echo "REFUSING: stdin is not a TTY — run this launcher in a cockpit pane, never inside a Bash tool" >&2; exit 21; }
[ "$_ANY_OVR" = 0 ] || { echo "REFUSING: a launch with test overrides set" >&2; exit 16; }
echo "$NOTE" >&2
cd "$QA_DIR" || { echo "cannot enter $QA_DIR" >&2; exit 16; }
exec claude --dangerously-skip-permissions "$(cat "$PROMPT_FILE")"
