has 'REVOKE AND VALIDATE (#1322 REVOKE-VALIDATE-UNCHANGED;' && has 'no unhandled rejection, no process exit' && has 'must answer 503/500 BEFORE `revokePriorConnectorKeys` runs' || { echo "REFUSING: the revoke / validate / rotate rule" >&2; exit 50; }
