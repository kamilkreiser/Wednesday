=== jwt.ts :185-250 at H986 ===
 * Generate access token
 */
export function generateAccessToken(user: User, sessionId: string, oauth?: OAuthMintOptions): string {
  // KS-151: attach role-derived scopes so downstream `isAllowedByRoleOrScope`
  // checks accept callers (e.g. OWNER → `documents:write`) without the role
  // allow-list having to grow. Empty for roles that already pass via the
  // role path.
  const scopes = getDefaultScopesForRole(user.role);
  const payload: Omit<OAuthTokenClaims, 'iat' | 'exp'> = {
    userId: user.id,
    email: user.email,
    role: user.role,
    organizationId: user.organizationId,
    verificationLevel: user.verificationLevel,
    sessionId,
    type: 'access',
    tenantId: user.tenantId,
    tenantSlug: user.tenantSlug,
    // KS-835: an OAuth mint carries the GRANTED scopes (even when empty) and the
    // 'oauth' label; a login mint keeps the role default and no label.
    ...(oauth ? { scopes: [...oauth.scopes], authMethod: 'oauth' as const } : scopes.length > 0 ? { scopes } : {}),
    ...(oauth ? { client_id: oauth.clientId } : {}), // KS-823
  };

  return signToken(payload, parseDuration(JWT_EXPIRES_IN));
}

/**
 * Generate refresh token. Includes a per-token jti so rotation can denylist
 * the predecessor (audit A-05 — without this, a stolen refresh token keeps
 * working for its full 7-day lifetime even after the user has rotated).
 */
export function generateRefreshToken(user: User, sessionId: string, oauth?: OAuthMintOptions): string {
  const scopes = getDefaultScopesForRole(user.role);
  const payload: Omit<OAuthTokenClaims, 'iat' | 'exp'> = {
    userId: user.id,
    email: user.email,
    role: user.role,
    organizationId: user.organizationId,
    verificationLevel: user.verificationLevel,
    sessionId,
    type: 'refresh',
    tenantId: user.tenantId,
    tenantSlug: user.tenantSlug,
    ...(oauth ? { scopes: [...oauth.scopes], authMethod: 'oauth' as const } : scopes.length > 0 ? { scopes } : {}), // KS-835
    ...(oauth ? { client_id: oauth.clientId } : {}), // KS-823: the refresh grant checks this against the presenting client
    jti: crypto.randomUUID(),
  };

  return signToken(payload, parseDuration(JWT_REFRESH_EXPIRES_IN));
}

/**
 * Generate token pair (access + refresh)
 */
export function generateTokenPair(user: User, sessionId: string, oauth?: OAuthMintOptions): {
  accessToken: string;
  refreshToken: string;
  expiresIn: number;
} {
  return {
    accessToken: generateAccessToken(user, sessionId, oauth),
    refreshToken: generateRefreshToken(user, sessionId, oauth),
    expiresIn: parseDuration(JWT_EXPIRES_IN),
  };
}
=== jwt.ts :375-390 verifyRefreshToken ===
/**
 * Verify refresh token specifically
 */
export function verifyRefreshToken(token: string): OAuthTokenClaims {
  const payload = verifyToken(token) as OAuthTokenClaims;
  if (payload.type !== 'refresh') {
    throw new InvalidTokenError();
  }
  return payload;
}

