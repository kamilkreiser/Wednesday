== confidenceForAnchorStatus :220-275
   220	 * Before this the decision lived twice. Tier 2 (the blob synthesised from the
   221	 * anchor store, below) mapped `confirmed`→on-chain, `failed`→off-chain-only and
   222	 * EVERYTHING ELSE→pending-onchain — an OPEN default. Tier 1 (the persisted
   223	 * document blob, in the verify handler) admitted only `confirmed`/null into
   224	 * `persistedAnchored` and then let anything without its own
   225	 * `confidence: 'pending-onchain'` fall to off-chain-only — a CLOSED default.
   226	 * Measured at develop 721b333a6: a `pending`/`submitted` anchor answered
   227	 * `pending-onchain` via tier 2 and `off-chain-only` via tier 1 (F8), and an
   228	 * out-of-union value such as `expired` answered `pending-onchain` via tier 2
   229	 * (F10) — "still coming", to the third-party verifier, with nothing red.
   230	 * `anchor_store.status` is `TEXT NOT NULL DEFAULT 'pending'` with no CHECK
   231	 * (migrations 001:714, 003:26), so a new terminal value lands there silently.
   232	 *
   233	 * The default is CLOSED: only anchoring's own union
   234	 * ('pending' | 'submitted' | 'confirmed' | 'failed', anchoring/src/index.ts:112)
   235	 * is mapped; anything else — including originate's own `anchor_failed`
   236	 * vocabulary — is off-chain-only.
   237	 *
   238	 * `null`/absent is NOT this function's decision. The tier-1 `persistedAnchored`
   239	 * carve-out (the seeded demo documents, KS-1057) and the statusless
   240	 * `confidence: 'pending-onchain'` fallback (originate routes/documents.ts:1367-1372,
   241	 * routes/certifications.ts:463-469 and :1184-1191) stay where they are.
   242	 *
   243	 * `on-chain` here means "the status alone would allow the claim". The tier-1
   244	 * predicate still requires the hash, the height and `simulated !== true`
   245	 * before it is made (KS-1057; KS-1069 and KS-1070 own those conjuncts).
   246	 */
   247	export function confidenceForAnchorStatus(
   248	  status: unknown,
   249	): 'on-chain' | 'pending-onchain' | 'off-chain-only' {
   250	  switch (status) {
   251	    case 'confirmed':
   252	      return 'on-chain';
   253	    case 'submitted':
   254	    case 'pending':
   255	      return 'pending-onchain';
   256	    case 'failed':
   257	      return 'off-chain-only';
   258	    default:
   259	      // KS-1071 F10: closed. Tier 2's prior behaviour here was 'pending-onchain'.
   260	      return 'off-chain-only';
   261	  }
   262	}
