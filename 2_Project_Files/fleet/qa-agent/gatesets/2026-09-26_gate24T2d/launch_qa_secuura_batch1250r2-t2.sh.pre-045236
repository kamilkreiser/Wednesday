has "WEDNESDAY'S signed GO naming the head" && has '`GO: merge #1250, #1253, #1262, #1263 batch`' && has 'by a MERGE SEAT Wednesday names, never by an author' && has "#1263's author Seat L7 is LIVE and squashes its own PR on the GO" || { echo "REFUSING: merge authority / the GO string / a merge seat" >&2; exit 26; }
has '## MERGE ADDENDUM' && has 'PER PR FILE (2 over 2 paths) for #1250, (1 over 1 path) for #1253, #1262 and #1263' && has 'KEY-FREE' && has 'subject <= 92 chars' && has 'FLEET STOP after this merge' && has 'CAP NO GO (round 2 of 2)' || { echo "REFUSING: the MERGE ADDENDUM rules" >&2; exit 25; }
grep -qF -- '[QA -> Wednesday] TIER-2 GATE batch #1250r2 #1253r2 #1262 #1263 (Seats L5 B28 L7, round 24 cap)' "$PROMPT_FILE" && has 'FROM coagent@agentmail.to' || { echo "REFUSING: the verdict subject / sender" >&2; exit 23; }
grep -qF -- "$BASE_SHA" "$PROMPT_FILE" && grep -qF -- "$DEVELOP_SHA" "$PROMPT_FILE" && grep -qF -- "$END_TREE" "$PROMPT_FILE" && grep -qF -- "$RED62" "$PROMPT_FILE" || { echo "REFUSING: BASE / the launch develop / the END_TREE / the red base not in full" >&2; exit 31; }
NOTE="origin develop $CUR_DEV == the pinned launch develop ($DEV_BEHIND ahead of BASE $BASE_SHA); heads at branch AND pull/<n>/head:$HEADS_NOTE; END_TREE $END_TREE"
_ANY_OVR="$(env | grep -c '^QAB24D_')"
if [ "${1:-}" = "--check" ]; then
  echo "all guards pass:"
  echo "  $NOTE"
  echo "  compare (GitHub API), develop...head per PR (merge_base, ahead, behind, the PR's own paths by name):"; printf '%s\n' "$COMPARE" | sed 's/^/    /' | cut -c1-240
  echo "  capture, prompt, QA project and repo present; kit at its filled home; four rows; thinking directive; capture + commission named; no unfilled token"
  echo "  capture and prompt BOTH carry every head in full, every ticket and 36 seat items; the prompt carries 117 by-name keywords and the base-invariant+pairwise / docker-for-#1262-only / red-proof / fleet-STOP / load+anchoring / holds / READER RULE / RULING (a)+SIGTERM / #1262 DB / reaper / scope / legs-3/4/8 / CAP / TIER-3 rules, the GO string, the addendum rules, the verdict subject, BASE / develop / END_TREE / the red base in full"
  [ "$_ANY_OVR" != 0 ] && echo "  (a QAB24D_* TEST OVERRIDE is set)"
  echo "  a launch (not --check) will refuse unless stdin is a TTY (exit 21)"
  exit 0
fi
[ -t 0 ] || { echo "REFUSING: stdin is not a TTY — run this launcher in a cockpit pane, never inside a Bash tool" >&2; exit 21; }
[ "$_ANY_OVR" = 0 ] || { echo "REFUSING: a launch with test overrides set" >&2; exit 16; }
echo "$NOTE" >&2
cd "$QA_DIR" || { echo "cannot enter $QA_DIR" >&2; exit 16; }
exec claude --dangerously-skip-permissions "$(cat "$PROMPT_FILE")"
