#
# Usage: launch_qa_secuura_batch1038_1041.sh [--check]
# Exit: 0 launched (or guards passed under --check) · 2..29 a guard refused
"""
PRLIST = '\n'.join('  "%d|%s|refs/heads/%s|%s"' % (n, t, br, (h if n != 1041 else '${QAB4_HEAD_1041:-' + h + '}')) for n, t, br, h, *_ in PRS)
