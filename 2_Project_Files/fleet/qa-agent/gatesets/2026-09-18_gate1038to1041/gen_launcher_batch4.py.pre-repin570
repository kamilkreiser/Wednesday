allfiles = []
for n, t, br, h, run, nf, tdev, t922 in PRS:
    files = sorted(git('diff', '--name-only', DEV, h).stdout.splitlines()); allfiles += files
    par = rp(h + '^1'); npar = len(git('rev-list', '--parents', '-n', '1', h).stdout.split()) - 1
    ok = par == DEV and npar == 1 and len(files) == nf and rp(h + '^{tree}') == tdev and all(f in LANDED and LANDED[f][1] == n for f in files)
    print('#%d %s head %s parent %s (=develop %s) parents %d files %d tree %s  %s' % (n, t, h[:9], par[:9], par == DEV, npar, len(files), rp(h + '^{tree}')[:9], 'OK' if ok else 'BAD'))
    if not ok: bad.append(('PR shape', n))
if len(allfiles) != len(set(allfiles)): bad.append(('four PRs not pairwise file-disjoint',))
print('pairwise disjoint: %d files, %d distinct' % (len(allfiles), len(set(allfiles))))
if bad: print('REFUSING: pins disagree with the repo; nothing written', bad); sys.exit(1)

# scratch repo: canonical-patch identity + merges (never the Secuura repo)
X = tempfile.mkdtemp(prefix='genbatch4-')
subprocess.run(['git', 'init', '--bare', '-q', X], check=True)
open(os.path.join(X, 'objects', 'info', 'alternates'), 'w').write(REPO + '/.git/objects\n')
for n, t, br, h, *_ in PRS: git('update-ref', 'refs/heads/p%d' % n, h, repo=X)
git('update-ref', 'refs/heads/d', DEV, repo=X); git('update-ref', 'refs/heads/h922', H922, repo=X)
for n, t, br, h, run, nf, tdev, t922 in PRS:
    ck = RUNS + run + '/out.md.checker/'
    secs = sorted(f for f in glob.glob(ck + 'section_*.diff') if os.path.basename(f).count('.') == 1)
    env = dict(os.environ, GIT_INDEX_FILE=X + '/idx_%d' % n); git('read-tree', DEV, repo=X, env=env)
    for sf in secs:
        of = sf[:-5] + '.opts' if os.path.exists(sf[:-5] + '.opts') else sf + '.opts'
        opts = [w for l in open(of).read().splitlines() for w in l.split() if w.startswith('--')] if os.path.exists(of) else []
        r = git('apply', '--cached', *opts, sf, repo=X, env=env)
        if r.returncode: bad.append(('canonical apply', n, os.path.basename(sf), r.stderr.strip()[:120]))
    got = git('write-tree', repo=X, env=env).stdout.strip()
    print('#%d canonical patch (%d sections) applied onto develop -> tree %s == head tree %s' % (n, len(secs), got[:9], got == tdev))
    if got != tdev: bad.append(('canonical patch != PR', n, got, tdev))
def mtree(a, b):
    r = git('merge-tree', '--write-tree', '--name-only', a, b, repo=X); o = r.stdout.strip().split('\n'); return r.returncode, o[0], len(o) - 1
def commit(tree, *parents):
    e = dict(os.environ, GIT_AUTHOR_NAME='drafter', GIT_AUTHOR_EMAIL='d@x', GIT_COMMITTER_NAME='drafter', GIT_COMMITTER_EMAIL='d@x',
             GIT_AUTHOR_DATE='2026-09-18T00:00:00Z', GIT_COMMITTER_DATE='2026-09-18T00:00:00Z')
    args = ['commit-tree', tree] + [x for p in parents for x in ('-p', p)] + ['-m', 'scratch']
    return git(*args, repo=X, env=e).stdout.strip()
rc, t, c = mtree('d', 'h922')
if (rc, t, c) != (0, T922, 0): bad.append(('#922 over develop', rc, t, c))
SQ = commit(T922, DEV); git('update-ref', 'refs/heads/dev922', SQ, repo=X)
for n, tk, br, h, run, nf, tdev, t922 in PRS:
    for base, want in (('d', tdev), ('dev922', t922)):
        rc, t, c = mtree(base, 'p%d' % n)
        print('#%d x %-6s rc %d tree %s conflicts %d %s' % (n, base, rc, t[:9], c, 'OK' if (rc, t, c) == (0, want, 0) else 'BAD'))
        if (rc, t, c) != (0, want, 0): bad.append(('merge', n, base))
for base, want in (('d', COMBINED_DEV), ('dev922', COMBINED_922)):
    cur = rp_x = git('rev-parse', base, repo=X).stdout.strip()
    for n, *_ in PRS:
        rc, t, c = mtree(cur, 'p%d' % n)
        if rc or c: bad.append(('combined', base, n))
        cur = commit(t, cur, git('rev-parse', 'p%d' % n, repo=X).stdout.strip())
    ct = git('rev-parse', cur + '^{tree}', repo=X).stdout.strip()
    print('all four over %-6s -> tree %s %s' % (base, ct[:9], 'OK' if ct == want else 'BAD'))
    if ct != want: bad.append(('combined tree', base, ct))
print('scratch (left in place):', X)
if bad: print('REFUSING:', bad); sys.exit(1)

def cut(start, end_incl):
    assert s.count(start) == 1, ('cut start', start[:70], s.count(start))
    i = s.index(start); j = s.index(end_incl, i) + len(end_incl); return s[i:j]
