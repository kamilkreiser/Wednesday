HEADER_NEW = """# launch_qa_secuura_batch1038_1041.sh — cross-project QA agent, ONE BATCHED ROUND 1 gate at the TIER 1 floor over FOUR file-disjoint Secuura/Blockchain PRs
#   #1038 KS-1233 @ 2122b4af7  redis.ts: platform-settings written with SET, no TTL (the connector allow-list failed open)   — TIER 1 (auth-door policy)
