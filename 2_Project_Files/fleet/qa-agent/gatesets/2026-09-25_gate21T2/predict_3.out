  #1218 diff:
    diff --git a/Blockchain/Dev/scripts/__tests__/pre_push_hook_base.test.sh b/Blockchain/Dev/scripts/__tests__/pre_push_hook_base.test.sh
    index e33da9a4..982d41fd 100644
    --- a/Blockchain/Dev/scripts/__tests__/pre_push_hook_base.test.sh
    +++ b/Blockchain/Dev/scripts/__tests__/pre_push_hook_base.test.sh
    @@ -120,7 +120,22 @@ GATE_STUB
         cp "$HOOK" .githooks/pre-push
         chmod +x .githooks/pre-push
         git config core.hooksPath .githooks
    -  ) >/dev/null 2>&1
    +  ) >"$WORK/build.log" 2>&1 || {
    +    # KS-897: this redirect is deliberate — the fixture build is noisy (git init,
    +    # commit, push) — but it used to swallow FAILURE as well as noise, so a fixture
    +    # that did not build was indistinguishable from one that did, and every case
    +    # below then asserted against a repository that may not exist.
    +    #
    +    # A suite that cannot build its fixture ABORTS. exit 2 is this file's existing
    +    # convention for "cannot run at all" — the same code the missing-hook guard at
    +    # the top uses — so a caller can tell it apart from a test failure (1).
    +    #
    +    # The log is ECHOED, not merely named: $WORK is removed by the EXIT trap, so a
    +    # path in the message would point at a file the reader cannot open.
    +    echo "FIXTURE BUILD FAILED for $root (mode=$mode) — build log follows:" >&2
    +    sed 's/^/    /' "$WORK/build.log" >&2
    +    exit 2
    +  }
     }
     
     # ---------------------------------------------------------------------------
    @@ -137,16 +152,23 @@ build_fixture "$WORK/c0" with-develop
       # shape is not only "no local develop" — it is also "the branch under test has
       # no upstream", and that half was invisible in this line.
       git checkout -q -b feature/x --no-track origin/develop
    +  # KS-896: `upstream=NONE` alone is satisfied when feature/x DOES NOT EXIST AT ALL
    +  # — if this checkout fails, the branch is never created, `rev-parse @{upstream}`
    +  # fails, `up` is empty and becomes NONE. An absent branch and a branch with no
    +  # upstream were indistinguishable, so this cell certified a shape it had not
    +  # observed. Assert the branch EXISTS first, and report that fact in the message
    +  # beside local= and remote=, which the cell already reports.
    +  git rev-parse --verify --quiet refs/heads/feature/x >/dev/null 2>&1 && fx=YES || fx=NO
       up="$(git rev-parse --abbrev-ref 'feature/x@{upstream}' 2>/dev/null)"
       [ -n "$up" ] || up=NONE
    -  printf '%s|%s|%s|%s\n' "$branches" "$local_dev" "$remote_dev" "$up"
    +  printf '%s|%s|%s|%s|%s\n' "$branches" "$local_dev" "$remote_dev" "$up" "$fx"
     ) > "$WORK/c0.out" 2>/dev/null
    -IFS='|' read -r c0_branches c0_local c0_remote c0_up < "$WORK/c0.out"
    -if [ "$c0_local" = NO ] && [ "$c0_remote" = YES ] && [ "$c0_up" = NONE ]; then
    -  ok "CONTROL — the fixture is a real fresh clone: local branches [${c0_branches% }], develop local=NO remote=YES, upstream=NONE"
    +IFS='|' read -r c0_branches c0_local c0_remote c0_up c0_fx < "$WORK/c0.out"
    +if [ "$c0_fx" = YES ] && [ "$c0_local" = NO ] && [ "$c0_remote" = YES ] && [ "$c0_up" = NONE ]; then
    +  ok "CONTROL — the fixture is a real fresh clone: local branches [${c0_branches% }], develop local=NO remote=YES, feature/x exists=YES with upstream=NONE"
     else
       bad "CONTROL — the fixture is a real fresh clone" \
    -      "expected local develop NO + origin/develop YES + upstream NONE; got local=$c0_local remote=$c0_remote upstream=$c0_up"
    +      "expected feature/x to EXIST with no upstream, plus local develop NO + origin/develop YES; got feature/x exists=$c0_fx local=$c0_local remote=$c0_remote upstream=$c0_up"
     fi
     
