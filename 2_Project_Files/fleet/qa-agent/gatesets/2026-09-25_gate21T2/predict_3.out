  #1220 diff of anchorReadback.ts:
    diff --git a/Blockchain/Dev/services/anchoring/src/anchorReadback.ts b/Blockchain/Dev/services/anchoring/src/anchorReadback.ts
    index f49ffb6a..cfac4f9a 100644
    --- a/Blockchain/Dev/services/anchoring/src/anchorReadback.ts
    +++ b/Blockchain/Dev/services/anchoring/src/anchorReadback.ts
    @@ -65,6 +65,37 @@ export interface VerifyResponseContext {
      * for the chain source (json_metadata after fromCardanoMetadatum) or the DB row's metadata_payload for the db source;
      * `row` is the anchor_store row when the answer came from the DB.
      */
    +/**
    + * KS-1129 (the anchoring site) — `anchor_store.block_number` is a `BIGINT`, and node-postgres
    + * returns int8 as a **string** by default. There is no int8 `setTypeParser` anywhere in
    + * `Blockchain/Dev` (non-test, non-lock: 0 hits), so the raw row value left this body as a string
    + * while the SAME column is converted with `Number()` in `index.ts` — the control that says the
    + * authors already know the shape.
    + *
    + * Three readers sat on that one string. This function fixes ONE of them:
    + *   1. HERE — the `GET /api/anchors/verify/:hash` body.
    + *   2. originate's KS-584 heal path (`services/originate/src/routes/verification.ts`), which
    + *      persists this reply's `blockNumber` into the document blob unshaped.
    + *   3. the api-gateway's live chain-scan readers, which have no shape rule at all.
    + * Sites 2 and 3 are NOT this seat's files and remain open on KS-1129.
    + *
    + * Null-safe, and deliberately so:
    + *   - absent (`undefined`/`null`) stays `null` — never `0`, never `NaN`;
    + *   - the empty string stays `null` rather than becoming `Number('') === 0`, which would invent
    + *     a block height of zero for a row that has none;
    + *   - a value that does not convert stays `null`. `JSON.stringify` already serialises `NaN` to
    + *     `null`, so this states the wire behaviour rather than changing it — and it lets a unit
    + *     cell assert the shape without inspecting serialised output.
    + *
    + * The `||` in the caller is left exactly as it was: changing it to `??` would be a separate
    + * behaviour change (it would start accepting a `0` height), and this ticket is about the TYPE.
    + */
    +export function toBlockNumber(value: unknown): number | null {
    +  if (value === undefined || value === null || value === '') return null;
    +  const n = Number(value);
    +  return Number.isFinite(n) ? n : null;
    +}
    +
     export function buildVerifyResponse(
       source: 'db' | 'chain',
       onChain: any,
    @@ -100,7 +131,7 @@ export function buildVerifyResponse(
         txHash,
         ...(simulated ? { simulated: true, simulatedTxRef: rawTxHash } : {}),
         cardanoScanUrl: txHash ? `${explorerBase}/${txHash}` : null,
    -    blockNumber: onChain?.blockNumber || row?.block_number || null,
    +    blockNumber: toBlockNumber(onChain?.blockNumber || row?.block_number),
         confirmedAt: onChain?.confirmedAt || row?.confirmed_at || null,
         anchoredAt: row?.created_at || null,
         metadata: {
