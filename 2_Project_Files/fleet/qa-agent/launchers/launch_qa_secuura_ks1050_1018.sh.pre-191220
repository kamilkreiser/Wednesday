  [ -n "${QA1018_USERS_FILE:-}" ] && echo "  (develop auth routes/users.ts read from the QA1018_USERS_FILE fixture, not the contents API)"
  echo "  a launch (not --check) will refuse unless stdin is a TTY (exit 21)"
