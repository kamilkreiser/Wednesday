for T in 'VSP75-G12-O1' 'G12-O7' 'N2.11'; do grep -qF -- "$T" "$G12_REPORT" || { echo "REFUSING: gate 12's report does not carry '$T'" >&2; exit 31; }; done
[ -s "$G13_REPORT" ] || { echo "REFUSING: gate 13's report is absent: $G13_REPORT" >&2; exit 31; }
