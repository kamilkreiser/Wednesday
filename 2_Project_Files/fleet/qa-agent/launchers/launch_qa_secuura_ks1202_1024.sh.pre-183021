DEVELOP_SHA='81ee4b729e86a645fc9098aafa1aaf39035a9950'   # develop at draft close = #1021s squash on 581c9db0d, NOT an ancestor of the head (git ls-remote 18:24:04, branches API 18:24:23 AEST)
