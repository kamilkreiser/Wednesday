{
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "sh /Volumes/DevMASTER/WEDNESDAY/2_Project_Files/tools/statusline_publish.sh '[Wednesday]' wednesday"
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/precompact_block.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/session_start_compact.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/pretooluse_no_cd.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/pretooluse_seat_scoped_chat.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/pretooluse_grep_case.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/2_Project_Files/fleet/hooks/pretooluse_no_rm.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Edit(//Volumes/DevMASTER/!CODING/**)",
      "Write(//Volumes/DevMASTER/!CODING/**)",
      "Edit(//Volumes/DevMASTER/Notes (MASTER)/**)",
      "Write(//Volumes/DevMASTER/Notes (MASTER)/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
