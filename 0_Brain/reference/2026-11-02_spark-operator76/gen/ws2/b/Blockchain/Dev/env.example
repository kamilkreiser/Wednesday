# =============================================================================
# SECUURA LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local:  cp env.example .env.local
# This template has working defaults for local development
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
POSTGRES_USER=secuura
# KS-731: intentionally BLANK. scripts/bootstrap-env.sh generates a per-clone
# value here, and it only generates into an EMPTY value — shipping a literal
# would make the generator a no-op and leave every clone, worktree and slot
# sharing one password again, which is the whole defect. If you copy this file
# by hand instead of running bootstrap, compose falls back to its own literal
# (KS-762) and the stack still starts.
POSTGRES_PASSWORD=
POSTGRES_DB=secuura
DATABASE_URL=postgresql://secuura:@localhost:6432/secuura   # bootstrap-env.sh rebuilds this with the generated password (KS-731)

# The password for the least-privilege application role (`secuura_app`) that
# every service's DATABASE_URL is built from, and that the init script
# docker/init/01-create-app-role.sh provisions on a fresh volume.
#
# KS-762 — SET THIS. It was never documented here, which is how it came to be
# relied on as a committed literal instead: `docker-compose.yml` carries a
# `${APP_DB_PASSWORD:-<literal>}` fallback at 51 sites (plus one in
# scripts/rls/verify-fail-closed.sh — 52 in total), so a clone with no value set
# silently runs on a password that is in git history. Measured 2026-09-03: that
# literal is a WORKING credential on a local stack, not a placeholder — `psql`
# as secuura_app with it returns AUTH OK, and a deliberately wrong password
# returns FATAL, so the probe discriminates.
#
# The fallbacks have NOT been removed. Turning them into `${APP_DB_PASSWORD:?}`
# is the obvious fix and is deliberately HELD: docker-compose.yml:121-132
# carries a KS-165 instruction not to, because a required variable stops every
# existing local stack and a fresh clone until its .env gains this line. Both
# positions are right and the trade is a decision with a team cost, so it sits
# with Kam rather than being taken quietly. Until it is ruled, setting this
# value is what takes YOUR stack off the committed one.
#
# ⚠ ON AN EXISTING STACK, SETTING A NEW VALUE HERE BREAKS AUTH. The secuura_app
# role password is baked into the Postgres volume by 01-create-app-role.sh at
# FIRST INIT and is not re-read afterwards, so changing this line alone leaves
# the services presenting a password the database does not have. To move off the
# committed value on a stack you already have: either recreate the volume, or
# ALTER the role password to match. On a fresh clone, just set it.
#
# ⚠ Removing the default would not un-commit the literal — it is in history from
# 1305bbda9. ROTATION is the half that actually retires it, scheduled
# 2026-09-05 09:00 (KS-762). After that rotation this value changes and a fresh
# volume is required for it to take effect on an existing stack.
#
# Verify where your stack stands at any time:
#     Blockchain/Dev/scripts/check-app-db-password-default.sh
APP_DB_USER=secuura_app
APP_DB_PASSWORD=change-me-before-first-run

# -----------------------------------------------------------------------------
# REDIS (REQUIRED - password required for production)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# KS-731: intentionally BLANK. scripts/bootstrap-env.sh generates a per-clone
# value here, and it only generates into an EMPTY value — shipping a literal
# would make the generator a no-op and leave every clone, worktree and slot
# sharing one password again, which is the whole defect. If you copy this file
# by hand instead of running bootstrap, compose falls back to its own literal
# (KS-762) and the stack still starts.
REDIS_PASSWORD=
# External port (set to empty to disable external access in production)
REDIS_EXTERNAL_PORT=6379

# -----------------------------------------------------------------------------
# CARDANO NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Options: devnet, preview, preprod, mainnet
CARDANO_NETWORK=preview

# Local devnet URL (used when CARDANO_NETWORK=devnet)
CARDANO_NODE_URL=http://localhost:8090

# Blockfrost API (required for preview/preprod/mainnet)
# Get a free project ID at: https://blockfrost.io
BLOCKFROST_PROJECT_ID=preview_your_project_id_here

# Koios API (alternative to Blockfrost)
# KOIOS_API_KEY=

# Smart Contract Addresses (populated after deployment)
# CONTRACT_PLATFORM_GOVERNANCE=
# CONTRACT_DEPLOYMENT=
# CONTRACT_DOCUMENT=
# CONTRACT_MULTI_SIG=
# CONTRACT_PROVENANCE=

# Wallet Configuration (for anchoring service)
# ANCHORING_WALLET_ADDRESS=addr_test1...
# ANCHORING_WALLET_SKEY_PATH=/path/to/payment.skey

# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION (REQUIRED) — RS256-only (KS-184/302; HS256 removed)
# Keys are generated by scripts/bootstrap-env.sh into .env. auth signs with the
# private key; every verifier validates with the public key. Never commit real keys.
# -----------------------------------------------------------------------------
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
# RS256 keypair (base64-encoded PEM). auth alone holds the private key (sole signer)
# + key id; every service holds the public key to verify. Verifiers fail closed
# without the public key. bootstrap-env.sh fills these in.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
JWT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# CSRF PROTECTION
# In production, generate a strong secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
CSRF_SECRET=dev_csrf_secret_change_in_production
CSRF_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# MICROSOFT ENTRA ID (Optional - leave blank for local development)
# Get credentials from Azure Portal > App Registrations
# -----------------------------------------------------------------------------
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AUTH0 (Optional - leave blank for local development)
# Get credentials from Auth0 Dashboard > Applications
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SHAREPOINT (Optional - for M365 integration)
# -----------------------------------------------------------------------------
SHAREPOINT_SITE_URL=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Nothing is set here on purpose, for the same reason as the API GATEWAY block below: a port
# written in this file is a slot-1 literal, and bootstrap-env.sh copies this template into
# every clone's .env.
#
# It mattered more here than for a dead key. An explicit CORS_ORIGINS in .env WINS over the
# compose default, so a clone that copied the line below handed api-gateway an allow-list
# holding the three Vite dev-server origins and NO GATEWAY ORIGIN AT ALL -- on any slot, and
# missing :6103 as well. docker-compose.yml:503 already carries the better list: :6100-:6103
# plus ${GATEWAY_PORT:-6882} and ${WEBSITE_PORT:-6881}, which scripts/stack_env.sh exports
# per slot, so an untouched .env is right on every slot.
#
# KS-1355: this line used to read
#   CORS_ORIGINS=http://localhost:6100,http://localhost:6101,http://localhost:6102
# Set it only to ADD an origin the compose default cannot know about (a tunnel, a LAN
# address, a deployed hostname) -- and remember that setting it REPLACES the default, so
# include this slot's gateway and website origins yourself.
# KS-1381 owns the remaining slot-1 literals in the other templates.

# -----------------------------------------------------------------------------
# GRAFANA (Monitoring)
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=secuura_grafana

# -----------------------------------------------------------------------------
# KYC PROVIDERS (Optional)
# -----------------------------------------------------------------------------
KYC_PROVIDER=mock
# Values: mock | microsoft (Entra Verified ID).
# Onfido / Jumio / Sumsub retired 2026-04-29 — see CONNECTORS.md.
# Microsoft Entra Verified ID setup uses ENTRA_TENANT_ID / ENTRA_CLIENT_ID /
# ENTRA_CLIENT_SECRET / ENTRA_CREDENTIAL_MANIFEST_URL (declared elsewhere).

# -----------------------------------------------------------------------------
# ANALYTICS
# -----------------------------------------------------------------------------
METRICS_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# TEST TOKENS (Local development / E2E testing only)
# Enables Bearer test_token_* for automated tests. MUST be false in production.
# -----------------------------------------------------------------------------
# AUDIT B-4: default false. Setting true bypasses authentication via Bearer test_token_*.
# Only enable in local dev — api-gateway refuses to start with this true in production/staging/demo.
ENABLE_TEST_TOKENS=false

# -----------------------------------------------------------------------------
# MOCK ENDPOINTS (API Gateway)
# Enable mock admin/verification/wallet endpoints in the gateway.
# Useful for local dev without all services running. MUST be false in production.
# -----------------------------------------------------------------------------
# AUDIT D-11: default false. Mock endpoints (wallet auth, admin) bypass real auth.
# Only enable in local dev — api-gateway refuses to start with this true in production/staging/demo.
ENABLE_MOCK_ENDPOINTS=false

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
# KS-1374: 10000/min on LOCAL stacks, so the Schemathesis and Akto harnesses are not
# paced by the platform's own limiter. This template only seeds a NEW .env — an existing
# .env is left untouched by scripts/bootstrap-env.sh, so raising an existing local stack
# is a one-line hand edit.
# The demo and Azure values are set ELSEWHERE and are NOT changed by this line:
# docker-compose.yml keeps a ${RATE_LIMIT_MAX_REQUESTS:-2000} fallback (what the demo VM
# inherits when its own .env is silent), and deployment/azure/services.bicep sets 2000 for
# dev and 100 for every other Azure environment.
# Harnesses read this same variable rather than a second copy of the figure:
# systemTest/schemathesis/scripts/runner/config.py and systemTest/akto's aktoRateLimit.ts.
RATE_LIMIT_MAX_REQUESTS=10000

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# ERROR TRACKING (Optional — Sentry)
# When set, errors are forwarded to Sentry in addition to structured JSON logs.
# Leave blank to use structured JSON logging only (Grafana/Loki compatible).
# Requires @sentry/node to be installed in the service's node_modules.
# -----------------------------------------------------------------------------
SENTRY_DSN=

