# ---------------------------------------------------------------------------
# Cardano platform wallet (KS-535, 2026-07-30) — READ THIS BEFORE SETTING IT
# ---------------------------------------------------------------------------
# LEAVE THIS EMPTY on a local/dev stack unless you have your OWN funded preview
# wallet. Never copy the demo VM's mnemonic into a local .env.
#
# Why: a Cardano transaction consumes specific UTxOs. Two environments sharing
# one wallet select the same UTxOs and race — the loser's transaction references
# an already-spent input and fails with
#   ConwayMempoolFailure "All inputs are spent. Transaction has probably
#   already been included"
# That is exactly what happened: local and demo ran the same mnemonic and
# accumulated 295 (local) and 2 (demo) failures of that kind. The anchoring
# service's withWalletLock only serialises submissions WITHIN one process; it
# cannot coordinate across separate deployments, and nothing else does.
#
# Empty => isCardanoReady() is false => anchoring uses dev mock mode. That is
# safe and honest since KS-520/KS-522: a simulated or mock anchor is never
# presented as on-chain proof (txHash null, simulated:true, no explorer link).
#
# If you need real-chain fidelity locally, generate your own preview wallet and
# fund it: https://docs.cardano.org/cardano-testnets/tools/faucet
PLATFORM_WALLET_MNEMONIC=

# Force the simulated-anchor path regardless of wallet/Blockfrost config.
# Honest since KS-520 (fails closed rather than fabricating) and KS-522
# (simulated anchors are labelled at verify time). Leave unset for dev mock mode.
SIMULATE_ANCHORING=

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# DEMO MODE (Development/Staging Only)
# Set to 'true' to enable demo login button in frontend
# NEVER enable in production
# -----------------------------------------------------------------------------
VITE_ENABLE_DEMO=true

# -----------------------------------------------------------------------------
# API GATEWAY
# -----------------------------------------------------------------------------
# The gateway's host port is GATEWAY_PORT, which scripts/stack_env.sh derives per slot.
# Nothing is set here on purpose: a port written in this file would be a slot-1 literal.
# KS-1417: this block used to set API_GATEWAY_PORT (6882), which nothing reads; it was copied into every clone's .env.

# External port for Postgres (set to empty to disable in production)
POSTGRES_EXTERNAL_PORT=6432

# -----------------------------------------------------------------------------
# LOCAL LLM - OLLAMA
# -----------------------------------------------------------------------------
# Run Ollama natively on macOS (recommended for Apple Silicon GPU acceleration):
#   ./scripts/start-ollama.sh
#
# Or via Docker (Linux/CI):
#   docker-compose --profile local-llm up -d ollama
#
# Model used: qwen3.5-122b-q4km
# Ollama API is OpenAI-compatible at http://localhost:11434
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5-122b-q4km
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Path to your Ollama models directory (only needed for start-ollama.sh / Docker mount)
OLLAMA_MODELS_PATH=/Users/kam_code/!CODING/Local Dev and AI/ollama/models
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# -----------------------------------------------------------------------------
# API docs exposure (F-04 opt-in guard; BACKLOG #555 decision 2026-07-19)
# -----------------------------------------------------------------------------
# Compose defaults this to FALSE because the same docker-compose.yml runs the
# internet-facing demo VM. Set true here for local dev so /api/docs (Swagger
# UI + raw spec) is reachable on the gateway. Leave unset/false on any
# deployed environment.
ENABLE_PUBLIC_API_DOCS=true

# -----------------------------------------------------------------------------
# DEMO SERVICE — inbound auth + non-prod gate (KS-641)
# -----------------------------------------------------------------------------
# demo-service mints REAL platform tokens without asking the caller for a
# credential: POST /demo-api/persona/switch authenticates server-side as one of
# four seeded personas — including admin@secuura.io, role Platform Admin — and
# proxies the httpOnly refresh cookie back. POST /demo-api/reset runs a
# pg_restore plus a Redis FLUSHALL.
#
# It therefore refuses to start unless BOTH are set, and refuses to start in
# production regardless of what they say:
#   DEMO_SERVICE_ENABLED  must be exactly "true" — a deliberate opt-in.
#   DEMO_SERVICE_KEY      shared key, >= 16 chars. Every /demo-api route except
#                         /health requires it as the X-Demo-Key header.
#
# The key is meant to be held by the GATEWAY and injected server-side, not by a
# browser — the only caller is the demo overlay, which has no credential of its
# own, and a secret baked into a public demo bundle is not a secret. Nothing
# routes /demo-api/ today (the location block was removed under F-09), so if you
# restore that block you must also add:
#     proxy_set_header X-Demo-Key <the value below>;
# Change this value on any deployed environment.
DEMO_SERVICE_ENABLED=true
DEMO_SERVICE_KEY=local-dev-demo-key-change-me

# -----------------------------------------------------------------------------
# GATEWAY_VOUCH_SECRET — KS-1041 Step 2 (gateway provenance)
# -----------------------------------------------------------------------------
# Shared secret proving to `originate` that a request arrived through
# `api-gateway`. originate honours identity/tenant/role headers only on a
# request carrying a matching `x-gateway-vouch`; on anything else it DROPS
# those headers. It does not refuse the request — two services call originate
# directly by design (m365-integration's Outlook verify-hash, nft-certificate's
# minting fetch) and neither sends a trust header, so stripping closes the hole
# without breaking them.
#
# WHERE IT MAY LIVE, and this part is load-bearing:
#   - set it HERE, in `.env`, which docker compose interpolates into the
#     `environment:` blocks of api-gateway and originate ONLY.
#   - do NOT put it in `.env.local`. Four services declare
#     `env_file: .env.local` (api-gateway, auth, m365-integration, kyc), so a
#     value placed there reaches all four — measured, not assumed. That hands
#     the secret to two services with no business holding it, and a lock is
#     worth what its key's storage is worth.
#
# UNSET FAILS CLOSED (Kam's ruling, 2026-10-13: "Fail closed, deployed only after
# the secret is set"). This REPLACES the previous "fail-OPEN by design" wording,
# which described the behaviour before KS-1032. An unconfigured box honours NO
# gateway-set identity header. It is not silent — originate logs a WARNING at boot
# naming the consequence, and the gateway simply omits the header.
#
# ⚠ SET THIS BEFORE DEPLOYING, and verify by TENANT, not by status code. On an unset
# or MISMATCHED secret, Platform-S metering answers 200 reading the DEFAULT tenant's
# usage — not 401 — because the gateway also attaches a connector Bearer that
# authenticate() accepts (pull request 1546 gate, cells GA1/GA2/GC5). 401 occurs only
# when the token exchange failed; MULTI_TENANCY_ENABLED=true with NODE_ENV=production
# gives 400 on every request. Assert data.tenantId == Platform S's key tenant.
# Generate one with:
#     openssl rand -hex 32
# Locally, scripts/bootstrap-env.sh does that for you when this line is blank
# (KS-955); deployed environments are provisioned separately (KS-1083). Keep it
# BLANK here — bootstrap_env_gateway_vouch.test.sh refuses a template value.
GATEWAY_VOUCH_SECRET=

# -----------------------------------------------------------------------------
# EMITTER_SIGNING_SECRET — KS-1717 (the signed originate -> anchoring hop)
# -----------------------------------------------------------------------------
# HMAC key originate signs its own hops to anchoring with. `x-emitter-internal`
# tells anchoring to skip the flat-anchor `anchor` provenance row, because the
# operation already wrote its own. anchoring honours it ONLY when the signature
# (method, path, marker, a timestamp within 60 s, the caller's Authorization
# header, and the raw body bytes) verifies under this key. Without that check,
# a caller reaching anchoring directly on the compose network with a connector
# JWT could set the header and suppress its own provenance row.
#
# WHAT IT DOES NOT DO: anyone holding the key can sign, and there is no nonce
# store. A byte-identical replay under the SAME bearer verifies for just under
# 61 s after signing when the two clocks agree, and for up to about 121 s if the
# signer's clock runs up to 60 s fast. A replay with a different body, method,
# path, marker, timestamp or bearer is refused.
#
# WHERE IT MAY LIVE: here, in `.env`, which compose interpolates into the
# `environment:` blocks of originate and anchoring ONLY. NOT in `.env.local`
# (four services load that file). The SAME value on both services, and at least
# 32 characters — anything shorter is treated as unset.
#
# UNSET FAILS CLOSED. anchoring honours no marker and logs a WARNING at boot, so
# originate's own hops each write a SECOND action_provenance row (an `anchor` row
# beside the operation's own) until the secret is set on BOTH services. Set it on
# both before deploying the images that check it.
# Generate one with:
#     openssl rand -hex 32
EMITTER_SIGNING_SECRET=

# KS-1081: five keys that docker-compose.yml reads but this template did not declare. Each is
# declared here at compose's own default (empty), so a .env bootstrapped from this file behaves
# exactly as before. Set real values in your own .env, never here.
# Bootstrap SYSTEM_ADMIN password (KS-966): empty means the account is not seeded.
ADMIN_USER_PASSWORD=
# Demo-seed gate, with the flag below it: read by the seeder in originate.
ENABLE_DEMO_SEED=
ALLOW_DEFAULT_SEED_PASSWORDS=
# RFC-3161 timestamp authority; an EMPTY TSA_URL means the code default.
TSA_URL=
TSA_AUTH_KEY=
