ENTRA_VERIFIED_ID_AUTHORITY=did:ion:your-verifier-did
ENTRA_CREDENTIAL_MANIFEST_URL=https://verifiedid.did.msidentity.com/v1.0/manifests/SecuuraKYCCredential
