diff --git a/Blockchain/Dev/services/originate/src/__tests__/ks1868-originate-documents-get-by-id-catch-unreadable-throw.test.ts b/Blockchain/Dev/services/originate/src/__tests__/ks1868-originate-documents-get-by-id-catch-unreadable-throw.test.ts
