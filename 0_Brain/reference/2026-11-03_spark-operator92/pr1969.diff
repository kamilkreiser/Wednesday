+    expect(await run(s.call, revokedProxy())).toEqual({ threw: false, value: s.fallback });
+    expect(LOG(s.log)).toHaveLength(1);
+    expect(reasonOf(LOG(s.log)[0])).toBe('unreadable thrown value');
