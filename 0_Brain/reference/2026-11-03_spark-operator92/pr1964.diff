+    await route(SIGN_REQUEST, withMessage(Object.create(null)), CONSTANT);
+  });
+
+  it('RED ks1868 R3 POST /:id/sign/request: an Error whose message is a Symbol logs the Symbol text and the route answers 500', async () => {
+    await route(SIGN_REQUEST, withMessage(Symbol('ks1868')), 'Symbol(ks1868)');
+  });
+
+  it('RED ks1868 R4 GET /:id/lifecycle-events: a revoked Proxy thrown value logs the constant reason and the route answers 500', async () => {
+    await route(LIFECYCLE, revokedProxy(), CONSTANT);
+  });
+
+  it('RED ks1868 R5 GET /:id/lifecycle-events: an Error whose message is a null-prototype object logs the constant reason and the route answers 500', async () => {
+    await route(LIFECYCLE, withMessage(Object.create(null)), CONSTANT);
+  });
+
+  it('RED ks1868 R6 GET /:id/lifecycle-events: an Error whose message is a Symbol logs the Symbol text and the route answers 500', async () => {
+    await route(LIFECYCLE, withMessage(Symbol('ks1868')), 'Symbol(ks1868)');
+  });
+
+  it('RED ks1868 R7 GET /:id/sig-json: a revoked Proxy thrown value logs the constant reason and the route answers 500', async () => {
+    await route(SIG_JSON, revokedProxy(), CONSTANT);
+  });
+
+  it('RED ks1868 R8 GET /:id/sig-json: an Error whose message is a null-prototype object logs the constant reason and the route answers 500', async () => {
+    await route(SIG_JSON, withMessage(Object.create(null)), CONSTANT);
+  });
+
+  it('RED ks1868 R9 GET /:id/sig-json: an Error whose message is a Symbol logs the Symbol text and the route answers 500', async () => {
+    await route(SIG_JSON, withMessage(Symbol('ks1868')), 'Symbol(ks1868)');
+  });
+});
