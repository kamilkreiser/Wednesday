+const DOC = 'doc-ks1868-lookup-target';
+let baseUrl = '';
+let server: ReturnType<typeof app.listen>;
+
+beforeAll(async () => {
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => resolve());
+  });
+  const address = server.address();
+  baseUrl = `http://127.0.0.1:${typeof address === 'object' && address ? address.port : 0}`;
+});
+
+afterAll(() => server?.close());
+
+beforeEach(() => {
+  mockState.toThrow = undefined;
+  mockState.errored.length = 0;
+  mockState.reads = 0;
+  mockState.writes = 0;
+});
+
+const revokedProxy = (): unknown => {
+  const { proxy, revoke } = Proxy.revocable({}, {});
+  revoke();
+  return proxy;
+};
+/** An Error whose `message` getter succeeds and returns the (non-string) value m. */
+const withMessage = (m: unknown): unknown => Object.create(Error.prototype, { message: { get() { return m; } } });
+/** The logged `error` field of the logger call that carries this first argument, as a string; the type name when it is not one. */
+const reasonOf = (first: string): string => {
+  const calls = mockState.errored.filter((c) => c[0] === first);
+  if (calls.length !== 1) return '<' + calls.length + ' calls>';
+  const v = (calls[0][1] as { error?: unknown } | undefined)?.error;
+  return typeof v === 'string' ? v : '<' + typeof v + '>';
+};
+
+let unhandled = 0;
+const onUnhandled = () => {
+  unhandled += 1;
+};
+beforeAll(() => {
+  process.on('unhandledRejection', onUnhandled);
+});
+afterAll(() => {
+  process.removeListener('unhandledRejection', onUnhandled);
+});
+beforeEach(() => {
+  unhandled = 0;
+});
+
+async function call(method: string, path: string, body?: unknown): Promise<{ status: number; code: string | undefined } | null> {
+  try {
+    const res = await fetch(`${baseUrl}${path}`, {
+      method,
+      headers: { 'content-type': 'application/json' },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(1500),
+    });
+    const payload = (await res.json()) as { error?: { code?: string } };
+    return { status: res.status, code: payload.error?.code };
+  } catch {
+    return null;
+  }
+}
+
+const SIGN_REQUEST: [string, string, string, unknown] = ['POST', `/api/documents/${DOC}/sign/request`, 'Failed to create signing request', { walletAddress: 'addr_test1ks1868' }];
+const LIFECYCLE: [string, string, string, unknown] = ['GET', `/api/documents/${DOC}/lifecycle-events`, 'Failed to list lifecycle events', undefined];
+const SIG_JSON: [string, string, string, unknown] = ['GET', `/api/documents/${DOC}/sig-json`, 'Failed to get sig-json', undefined];
+
+async function route(r: [string, string, string, unknown], thrown: unknown, reason: string): Promise<void> {
+  mockState.toThrow = thrown;
+  expect(await call(r[0], r[1], r[3])).toEqual({ status: 500, code: 'INTERNAL_ERROR' });
+  expect(unhandled).toBe(0);
+  expect(mockState.errored).toHaveLength(1);
+  expect(reasonOf(r[2])).toBe(reason);
+  expect(mockState.reads).toBe(1);
+  expect(mockState.writes).toBe(0);
+}
+const CONSTANT = 'unreadable thrown value';
+
+describe('KS-1868 the originate document lookup routes log text for a hostile thrown value', () => {
+  it('control ks1868 C1 POST /:id/sign/request: an ordinary Error is logged with its own message and the route answers 500', async () => {
+    await route(SIGN_REQUEST, new Error('Connection terminated unexpectedly'), 'Connection terminated unexpectedly');
+  });
+
+  it('control ks1868 C2 GET /:id/lifecycle-events: an ordinary Error is logged with its own message and the route answers 500', async () => {
+    await route(LIFECYCLE, new Error('Connection terminated unexpectedly'), 'Connection terminated unexpectedly');
+  });
+
+  it('control ks1868 C3 GET /:id/sig-json: an ordinary Error is logged with its own message and the route answers 500', async () => {
+    await route(SIG_JSON, new Error('Connection terminated unexpectedly'), 'Connection terminated unexpectedly');
+  });
+
+  it('control ks1868 C4 POST /:id/sign/request: a thrown plain string is logged as its own text and the route answers 500', async () => {
