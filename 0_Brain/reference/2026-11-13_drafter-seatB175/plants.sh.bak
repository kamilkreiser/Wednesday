export GIT_OPTIONAL_LOCKS=0
D=/Volumes/DevMASTER/WEDNESDAY/0_Brain/reference/2026-11-13_drafter-seatB175
C=$D/clone_work/clone
DEV=$(git -C $C rev-parse origin/develop)
export GIT_AUTHOR_NAME=drafter GIT_AUTHOR_EMAIL=d@example.invalid GIT_COMMITTER_NAME=drafter GIT_COMMITTER_EMAIL=d@example.invalid
plant() {
  p="$1"; ln="$2"
  export GIT_INDEX_FILE=$D/clone_work/idx_pl_$(date +%s%N)
  git -C $C read-tree $DEV
  git -C $C show "$DEV:$p" > $D/scratch_blob.txt
  python3 -I - "$D/scratch_blob.txt" "$ln" <<'PY'
import sys
f,ln=sys.argv[1],int(sys.argv[2])
L=open(f,encoding='utf-8').read().split('\n')
L[ln-1]=L[ln-1]+' PLANTED'
open(f,'w',encoding='utf-8').write('\n'.join(L))
PY
  b=$(git -C $C hash-object -w $D/scratch_blob.txt)
  git -C $C update-index --cacheinfo 100644,$b,"$p"
  t=$(git -C $C write-tree)
  c=$(git -C $C commit-tree $t -p $DEV -m "scratch plant $p:$ln")
  unset GIT_INDEX_FILE
  echo $c
}
mt() { a=$(git -C $C merge-tree --write-tree $1 $2 2>/dev/null); ra=$?; b=$(git -C $C merge-tree --write-tree $2 $1 2>/dev/null); rb=$?; echo "rc $ra/$rb"; }
h() { git -C $C rev-parse refs/remotes/pr/$1; }
ROWS="2095 2090 2098 2089 2079 2220 2221 2222 2223 2224"
CERT="Blockchain/Dev/services/originate/src/routes/certifications.ts"
P_CERT=$(plant "$CERT" 1270)
P_CERT0=$(plant "$CERT" 5)
P_ENF=$(plant "Blockchain/Dev/services/api-gateway/src/services/enforcement.ts" 55)
P_AUTH=$(plant "Blockchain/Dev/services/auth/src/routes/auth.ts" 67)
P_MFA=$(plant "Blockchain/Dev/services/auth/src/routes/mfa.ts" 130)
echo "develop=$DEV"
echo "POSITIVE: certifications.ts line 1270 (inside R118 hunk 1267-1279) plant vs r118an: $(mt $P_CERT $(h r118an))"
echo "NEGATIVE: certifications.ts line 5 plant vs r118an: $(mt $P_CERT0 $(h r118an))"
echo "PLANT enforcement.ts line 55 vs 2224: $(mt $P_ENF $(h 2224))"
echo "PLANT auth.ts line 67 vs 2223: $(mt $P_AUTH $(h 2223))"
echo "PLANT mfa.ts line 130 vs 2098: $(mt $P_MFA $(h 2098))"
echo "CONTROL enf plant vs 2223: $(mt $P_ENF $(h 2223))"
echo "CONTROL auth plant vs 2224: $(mt $P_AUTH $(h 2224))"
echo "CONTROL mfa plant vs 2223: $(mt $P_MFA $(h 2223))"
for n in $ROWS 2225 2099 2160; do echo " cert-plant(1270) vs $n: $(mt $P_CERT $(h $n))"; done
for n in $ROWS 2225 2099 2160; do echo " r118an vs $n: $(mt $(h r118an) $(h $n))"; done
echo "r118an vs develop: $(mt $(h r118an) $DEV)"
echo "OLD r118 (5ca0ef71) vs develop: $(mt $(h r118) $DEV)"
