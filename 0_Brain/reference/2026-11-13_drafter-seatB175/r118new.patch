@@ -1264,6 +1264,19 @@ certificationsRouter.post(
         });
       }
 
+      // KS-1699: bind the verify on the record, the way `GET /:id` does (KS-1695). Before this, any
+      // authenticated same-tenant caller who was not a party got 200 with `status`, `checks`,
+      // `issuer {id, did}` and the raw `blockchain` object, and a `verification` charge row was written
+      // for them. This precedes the charge write below, so a refused caller is never billed. The refusal
+      // is the SAME status and body as this route's own unknown-id answer above (not the GET shape), so
+      // "not yours" cannot be told from "no such certification".
+      if (!callerMayReadCertification(req, certification)) {
+        return res.status(404).json({
+          verified: false,
+          error: 'Certification not found',
+        });
+      }
+
       // Check status
       const isValid = certification.status === 'issued';
       const isExpired = certification.expiresAt && new Date(certification.expiresAt) < new Date();
diff --git a/Projects Documents/fragments/cheat/KS-1699-certification-verify-needs-the-reader-check.html b/Projects Documents/fragments/cheat/KS-1699-certification-verify-needs-the-reader-check.html
