            verified: isValid && !isExpired && hashValid,
            certificationId: certification.id,
            status: certification.status,
            checks: {
              exists: true,
              notRevoked: !isRevoked,
              notExpired: !isExpired,
              hashValid,
              blockchainAnchored: !!certification.blockchain,
