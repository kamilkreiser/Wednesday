=== analytics
     1	/**
     2	 * =============================================================================
     3	 * DATABASE CLIENT — analytics Service
     4	 * =============================================================================
     5	 * Lightweight PostgreSQL connection using the `pg` library.
     6	 * Falls back gracefully if the database is unavailable, allowing the service
     7	 * to function in degraded mode with in-memory storage.
     8	 * =============================================================================
     9	 */
    10	
    11	import { Pool, PoolClient, QueryResult, QueryResultRow } from 'pg';
    12	
    13	let pool: Pool | null = null;
    14	let dbAvailable = false;
    15	
    16	function dbLog(level: 'info' | 'warn' | 'error', message: string, meta?: object) {
    17	  const ts = new Date().toISOString();
    18	  console.log(JSON.stringify({ timestamp: ts, level, service: 'analytics-db', message, ...meta }));
    19	}
    20	
    21	export function getPool(): Pool {
    22	  if (!pool) {
    23	    const databaseUrl = process.env.DATABASE_URL;
    24	    if (!databaseUrl) {
    25	      dbLog('warn', 'DATABASE_URL not set — running with in-memory storage only');
    26	      throw new Error('DATABASE_URL not configured');
    27	    }
    28	    pool = new Pool({
    29	      connectionString: databaseUrl,
    30	      max: 10,
    31	      idleTimeoutMillis: 30000,
    32	      connectionTimeoutMillis: 5000,
    33	    });
    34	
    35	    pool.on('error', (err: Error) => {
    36	      dbLog('error', 'DB pool unexpected error', { error: err.message });
    37	    });
    38	  }
    39	  return pool;
    40	}
    41	
    42	export async function query<T extends QueryResultRow = QueryResultRow>(
    43	  text: string,
    44	  params?: unknown[],
    45	): Promise<QueryResult<T>> {
    46	  return getPool().query<T>(text, params);
    47	}
    48	
    49	export async function getClient(): Promise<PoolClient> {
    50	  return getPool().connect();
    51	}
    52	
    53	export async function transaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
    54	  const client = await getClient();
    55	  try {
    56	    await client.query('BEGIN');
    57	    const result = await fn(client);
    58	    await client.query('COMMIT');
    59	    return result;
    60	  } catch (err) {
    61	    await client.query('ROLLBACK');
    62	    throw err;
    63	  } finally {
    64	    client.release();
    65	  }
    66	}
    67	
    68	// =============================================================================
    69	// AVAILABILITY PROBE + BACKGROUND RETRY (KS-377)
    70	// =============================================================================
    71	// A failed probe at boot must never latch the service into degraded mode for
    72	// its lifetime: losing the compose/ACA start race against Postgres used to
    73	// leave a healthy-looking service serving its in-memory fallback until a
    74	// manual restart. Every DB-gated code path re-reads isDbAvailable() per call,
    75	// so flipping the flag when a background re-probe succeeds restores steady
    76	// state — and the one-shot boot work registered via initDb's onReady hook
    77	// (in-memory store hydration) is re-run too, so recovery is complete
    78	// rather than just the flag flip (KS-382).
    79	
    80	const DB_RETRY_INITIAL_MS = 1_000;
    81	const DB_RETRY_MAX_MS = 30_000;
    82	let retryDelayMs = DB_RETRY_INITIAL_MS;
    83	let retryAttempts = 0;
    84	let retryTimer: ReturnType<typeof setTimeout> | null = null;
    85	
    86	/** One-shot boot work (store hydration) re-run on recovery (KS-382). */
    87	type DbReadyHook = () => void | Promise<void>;
    88	let onDbReady: DbReadyHook | null = null;
    89	
    90	async function runDbReadyHook(): Promise<void> {
    91	  if (!onDbReady) return;
    92	  try {
    93	    await onDbReady();
    94	  } catch (err: any) {
    95	    // Boot work failing must not un-flag an otherwise reachable DB.
    96	    dbLog('error', 'DB ready boot work failed', { error: err?.message });
    97	  }
    98	}
    99	
   100	async function probeDb(): Promise<{ ok: boolean; error?: string }> {
   101	  try {
   102	    const result = await query<{ ok: number }>('SELECT 1 AS ok');
   103	    dbAvailable = result.rows[0]?.ok === 1;
   104	    return { ok: dbAvailable };
   105	  } catch (err: any) {
   106	    dbAvailable = false;
   107	    return { ok: false, error: err?.message };
   108	  }
   109	}
   110	
   111	function scheduleRetry(): void {
   112	  if (retryTimer || dbAvailable) return;
   113	  retryTimer = setTimeout(async () => {
   114	    retryTimer = null;
   115	    retryAttempts += 1;
   116	    const probe = await probeDb();
   117	    if (probe.ok) {
   118	      dbLog('info', 'Database connection established (recovered after retry)', {
   119	        attempts: retryAttempts,
   120	      });
   121	      retryAttempts = 0;
   122	      retryDelayMs = DB_RETRY_INITIAL_MS;
   123	      // Recovery is more than the flag flip: run the boot work that was
   124	      // skipped while the DB was down (store hydration) (KS-382).
   125	      await runDbReadyHook();
=== api-gateway
     1	/**
     2	 * =============================================================================
     3	 * DATABASE CLIENT — api-gateway Service
     4	 * =============================================================================
     5	 * Lightweight PostgreSQL connection using the `pg` library.
     6	 * Falls back gracefully if the database is unavailable, allowing the service
     7	 * to function in degraded mode with in-memory storage.
     8	 * =============================================================================
     9	 */
    10	
    11	import { Pool, PoolClient, QueryResult, QueryResultRow } from 'pg';
    12	import { applyTenantGuc, queryWithTenantGuc } from '@secuura/shared';
    13	
    14	let pool: Pool | null = null;
    15	let dbAvailable = false;
    16	
    17	function dbLog(level: 'info' | 'warn' | 'error', message: string, meta?: object) {
    18	  const ts = new Date().toISOString();
    19	  console.log(JSON.stringify({ timestamp: ts, level, service: 'api-gateway-db', message, ...meta }));
    20	}
    21	
    22	export function getPool(): Pool {
    23	  if (!pool) {
    24	    const databaseUrl = process.env.DATABASE_URL;
    25	    if (!databaseUrl) {
    26	      dbLog('warn', 'DATABASE_URL not set — running with in-memory storage only');
    27	      throw new Error('DATABASE_URL not configured');
    28	    }
    29	    pool = new Pool({
    30	      connectionString: databaseUrl,
    31	      max: 10,
    32	      idleTimeoutMillis: 30000,
    33	      connectionTimeoutMillis: 5000,
    34	    });
    35	
    36	    pool.on('error', (err: Error) => {
    37	      dbLog('error', 'DB pool unexpected error', { error: err.message });
    38	    });
    39	  }
    40	  return pool;
    41	}
    42	
    43	export async function query<T extends QueryResultRow = QueryResultRow>(
    44	  text: string,
    45	  params?: unknown[],
    46	): Promise<QueryResult<T>> {
    47	  // KS-458: bundles the RLS tenant GUC (seeded by authenticateToken /
    48	  // runWithPlatformScope) into the same transaction as the statement.
    49	  return queryWithTenantGuc<T>(getPool(), text, params);
    50	}
    51	
    52	export async function getClient(): Promise<PoolClient> {
    53	  return getPool().connect();
    54	}
    55	
    56	export async function transaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
    57	  const client = await getClient();
    58	  try {
    59	    await client.query('BEGIN');
    60	    // KS-458: the tenant GUC must live inside this transaction.
    61	    await applyTenantGuc(client);
    62	    const result = await fn(client);
    63	    await client.query('COMMIT');
    64	    return result;
    65	  } catch (err) {
    66	    await client.query('ROLLBACK');
    67	    throw err;
    68	  } finally {
    69	    client.release();
    70	  }
    71	}
    72	
    73	// =============================================================================
    74	// AVAILABILITY PROBE + BACKGROUND RETRY (KS-377)
    75	// =============================================================================
    76	// A failed probe at boot must never latch the service into degraded mode for
    77	// its lifetime: losing the compose/ACA start race against Postgres used to
    78	// leave a healthy-looking service serving its in-memory fallback until a
    79	// manual restart. Every DB-gated code path re-reads isDbAvailable() per call,
    80	// so flipping the flag when a background re-probe succeeds restores steady
    81	// state — and the one-shot boot work registered via initDb's onReady hook
    82	// (cache warm / startup migrations) is re-run too, so recovery is complete
    83	// rather than just the flag flip (KS-382).
    84	
    85	const DB_RETRY_INITIAL_MS = 1_000;
    86	const DB_RETRY_MAX_MS = 30_000;
    87	let retryDelayMs = DB_RETRY_INITIAL_MS;
    88	let retryAttempts = 0;
    89	let retryTimer: ReturnType<typeof setTimeout> | null = null;
    90	
    91	/** One-shot boot work (cache warm, startup DDL) re-run on recovery (KS-382). */
    92	type DbReadyHook = () => void | Promise<void>;
    93	let onDbReady: DbReadyHook | null = null;
    94	
    95	async function runDbReadyHook(): Promise<void> {
    96	  if (!onDbReady) return;
    97	  try {
    98	    await onDbReady();
    99	  } catch (err: any) {
   100	    // Boot work failing must not un-flag an otherwise reachable DB.
   101	    dbLog('error', 'DB ready boot work failed', { error: err?.message });
   102	  }
   103	}
   104	
   105	async function probeDb(): Promise<{ ok: boolean; error?: string }> {
   106	  try {
   107	    const result = await query<{ ok: number }>('SELECT 1 AS ok');
   108	    dbAvailable = result.rows[0]?.ok === 1;
   109	    return { ok: dbAvailable };
   110	  } catch (err: any) {
   111	    dbAvailable = false;
   112	    return { ok: false, error: err?.message };
   113	  }
   114	}
   115	
   116	function scheduleRetry(): void {
   117	  if (retryTimer || dbAvailable) return;
   118	  retryTimer = setTimeout(async () => {
   119	    retryTimer = null;
   120	    retryAttempts += 1;
   121	    const probe = await probeDb();
   122	    if (probe.ok) {
   123	      dbLog('info', 'Database connection established (recovered after retry)', {
   124	        attempts: retryAttempts,
   125	      });
=== anchoring
     1	/**
     2	 * =============================================================================
     3	 * DATABASE CLIENT — Anchoring Service
     4	 * =============================================================================
     5	 * Lightweight PostgreSQL connection using the `pg` library.
     6	 * Falls back gracefully if the database is unavailable, allowing the service
     7	 * to function in degraded mode with in-memory storage.
     8	 * =============================================================================
     9	 */
    10	
    11	import { Pool, PoolClient, QueryResult, QueryResultRow } from 'pg';
    12	
    13	let pool: Pool | null = null;
    14	let dbAvailable = false;
    15	
    16	function dbLog(level: 'info' | 'warn' | 'error', message: string, meta?: object) {
    17	  const ts = new Date().toISOString();
    18	  console.log(JSON.stringify({ timestamp: ts, level, service: 'anchoring-db', message, ...meta }));
    19	}
    20	
    21	export function getPool(): Pool {
    22	  if (!pool) {
    23	    const databaseUrl = process.env.DATABASE_URL;
    24	    if (!databaseUrl) {
    25	      dbLog('warn', 'DATABASE_URL not set — running with in-memory storage only');
    26	      throw new Error('DATABASE_URL not configured');
    27	    }
    28	    pool = new Pool({
    29	      connectionString: databaseUrl,
    30	      max: 10,
    31	      idleTimeoutMillis: 30000,
    32	      connectionTimeoutMillis: 5000,
    33	    });
    34	
    35	    pool.on('error', (err: Error) => {
    36	      dbLog('error', 'DB pool unexpected error', { error: err.message });
    37	    });
    38	  }
    39	  return pool;
    40	}
    41	
    42	export async function query<T extends QueryResultRow = QueryResultRow>(
    43	  text: string,
    44	  params?: unknown[],
    45	): Promise<QueryResult<T>> {
    46	  return getPool().query<T>(text, params);
    47	}
    48	
    49	export async function getClient(): Promise<PoolClient> {
    50	  return getPool().connect();
    51	}
    52	
    53	export async function transaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
    54	  const client = await getClient();
    55	  try {
    56	    await client.query('BEGIN');
    57	    const result = await fn(client);
    58	    await client.query('COMMIT');
    59	    return result;
    60	  } catch (err) {
    61	    await client.query('ROLLBACK');
    62	    throw err;
    63	  } finally {
    64	    client.release();
    65	  }
    66	}
    67	
    68	// =============================================================================
    69	// AVAILABILITY PROBE + BACKGROUND RETRY (KS-377)
    70	// =============================================================================
    71	// A failed probe at boot must never latch the service into degraded mode for
    72	// its lifetime: losing the compose/ACA start race against Postgres used to
    73	// leave a healthy-looking service whose writes 202'd but never persisted.
    74	// Every DB-gated code path re-reads isDbAvailable() per call, so flipping the
    75	// flag when a background re-probe succeeds is all recovery takes (schema DDL
    76	// is ensured lazily by callers / owned by the migration path).
    77	
    78	const DB_RETRY_INITIAL_MS = 1_000;
    79	const DB_RETRY_MAX_MS = 30_000;
    80	let retryDelayMs = DB_RETRY_INITIAL_MS;
    81	let retryAttempts = 0;
    82	let retryTimer: ReturnType<typeof setTimeout> | null = null;
    83	
    84	async function probeDb(): Promise<{ ok: boolean; error?: string }> {
    85	  try {
    86	    const result = await query<{ ok: number }>('SELECT 1 AS ok');
    87	    dbAvailable = result.rows[0]?.ok === 1;
    88	    return { ok: dbAvailable };
    89	  } catch (err: any) {
    90	    dbAvailable = false;
    91	    return { ok: false, error: err?.message };
    92	  }
    93	}
    94	
    95	function scheduleRetry(): void {
    96	  if (retryTimer || dbAvailable) return;
    97	  retryTimer = setTimeout(async () => {
    98	    retryTimer = null;
    99	    retryAttempts += 1;
   100	    const probe = await probeDb();
   101	    if (probe.ok) {
   102	      dbLog('info', 'Database connection established (recovered after retry)', {
   103	        attempts: retryAttempts,
   104	      });
   105	      retryAttempts = 0;
   106	      retryDelayMs = DB_RETRY_INITIAL_MS;
   107	    } else {
   108	      retryDelayMs = Math.min(retryDelayMs * 2, DB_RETRY_MAX_MS);
   109	      dbLog('warn', 'Database still unavailable — will retry', {
   110	        error: probe.error,
   111	        attempt: retryAttempts,
   112	        nextRetryMs: retryDelayMs,
   113	      });
   114	      scheduleRetry();
   115	    }
   116	  }, retryDelayMs);
   117	  // A pending probe must never hold the process open (shutdown, tests).
   118	  retryTimer.unref?.();
   119	}
   120	
   121	/**
   122	 * Test the database connection and set the availability flag.
   123	 * On failure, keeps re-probing in the background with capped backoff (KS-377)
   124	 * instead of latching degraded mode until a manual restart.
   125	 */
