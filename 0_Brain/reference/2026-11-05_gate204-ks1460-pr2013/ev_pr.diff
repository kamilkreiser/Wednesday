+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import type { AddressInfo } from 'node:net';
+import type { Server } from 'node:http';
+import express from 'express';
+
+// KS-1460 row 1 (Wednesday's ruling of 2026-11-05: "make the 'rehashed' info line truthful in the same PR, log only,
+// no behaviour change, one cell"). POST /api/auth/login's UPGRADE-ON-VERIFY step rehashes a bcrypt hash to Argon2id
+// with `userRepo.updateUser`, which answers `null` when its UPDATE matched no row. The route discarded that answer
+// and logged "UPGRADE-ON-VERIFY: rehashed bcrypt -> argon2id" whether or not the write landed, so the log recorded a
+// rehash that may not have happened. It now logs the info line only when the write landed, and a warn naming the
+// write that did not land otherwise. The step stays non-fatal: the login answers 200 with tokens either way.
+// Harness: the ks1868 rehash test's (real router and error handler; repository, password, session, jwt, lockout,
+// mail and event bus mocked), with the logger's info AND warn captured.
+
+const h = vi.hoisted(() => ({
+  rehashLands: true,
+  info: [] as unknown[][],
+  warn: [] as unknown[][],
+}));
+
+const capture = vi.hoisted(() => ({
+  debug: () => undefined,
+  info: (...args: unknown[]) => { h.info.push(args); },
+  warn: (...args: unknown[]) => { h.warn.push(args); },
+  error: () => undefined,
+  log: () => undefined,
+}));
+vi.mock('../utils/logger', () => ({ logger: capture, createLogger: () => capture, validateEnv: () => undefined }));
+vi.mock('@secuura/shared/utils/logger', () => ({ logger: capture, createLogger: () => capture }));
+
+const LOGIN_EMAIL = 'ks1460-login@secuura.local';
+const ACTIVE_USER = {
+  id: 'user-1460-login', email: LOGIN_EMAIL, status: 'ACTIVE', role: 'OWNER',
+  verificationLevel: 'BASIC', mfaEnabled: false, mfaSecret: null, mfaBackupCodes: null,
+  passwordHash: '$2b$10$bcryptstub', tenantId: 'ten-1', organizationId: 'org-1',
+};
+
+vi.mock('../db', () => ({ query: vi.fn(async () => ({ rows: [], rowCount: 0 })) }));
+
+vi.mock('../repositories/userRepo', () => ({
+  getPlatformAdmin: vi.fn(async () => null),
+  getUserByEmail: vi.fn(async (email: string) =>
+    email.toLowerCase().trim() === LOGIN_EMAIL ? { ...ACTIVE_USER } : null),
+  getUserById: vi.fn(async () => null),
+  getUserByIdPreAuth: vi.fn(async () => ({ ...ACTIVE_USER })),
+  getUserBySocialId: vi.fn(async () => null),
+  createUser: vi.fn(async () => null),
+  // the real contract: null when the UPDATE matched no row (repositories/userRepo.ts)
+  updateUser: (_id: string, patch: Record<string, unknown>) =>
+    Promise.resolve(patch && 'passwordHash' in patch && !h.rehashLands ? null : { ...ACTIVE_USER, ...patch }),
+  updateUserOrThrow: vi.fn(async () => ({ ...ACTIVE_USER })),
+  updateUserPlatformScope: vi.fn(async () => null),
+  updatePlatformAdminPassword: vi.fn(async () => undefined),
+  reencryptMfaSecretIfLegacy: vi.fn(async () => undefined),
+  reencryptPlatformAdminMfaSecretIfLegacy: vi.fn(async () => undefined),
+}));
+
+vi.mock('../services/password', () => ({
+  verifyPassword: vi.fn(async () => true),
+  hashPassword: vi.fn(async () => '$argon2id$stub'),
+  checkPasswordStrength: vi.fn(() => ({ ok: true })),
+  generateResetToken: vi.fn(() => 'tok'),
+  shouldRehashAfterVerify: vi.fn(() => true),
+}));
+
+vi.mock('../services/session', () => ({
+  createSession: vi.fn(async () => ({ id: 'sess-1460-login' })),
+  revokeSession: vi.fn(async () => undefined),
+  revokeAllUserSessions: vi.fn(async () => 0),
+  getSession: vi.fn(async () => null),
+  rotateSessionRefreshToken: vi.fn(async () => undefined),
+  getRedisClient: vi.fn(() => null),
+  validateSession: vi.fn(async () => true),
+  updateSessionActivity: vi.fn(async () => undefined),
+  isRedisAvailable: vi.fn(() => true),
+}));
+
+vi.mock('../services/jwt', () => ({
+  generateTokenPair: vi.fn(() => ({ accessToken: 'MINTED_1460_LOGIN', refreshToken: 'MINTED_1460_LOGIN_R', expiresIn: 900 })),
+  verifyRefreshToken: vi.fn(() => ({})),
+  decodeToken: vi.fn(() => ({ jti: 'jti-1460', exp: Math.floor(Date.now() / 1000) + 3600 })),
+}));
+
+vi.mock('../services/refreshDenylist', () => ({
+  isRefreshJtiDenylisted: vi.fn(async () => false),
+  denylistRefreshJti: vi.fn(async () => undefined),
+}));
+vi.mock('../services/accountLockout', () => ({
+  isLockedOut: vi.fn(async () => false), recordFailure: vi.fn(async () => 1),
+  recordSuccess: vi.fn(async () => undefined), clearFailures: vi.fn(async () => undefined),
+}));
+vi.mock('../services/email', () => ({
+  sendVerificationEmail: vi.fn(async () => undefined),
+  sendPasswordResetEmail: vi.fn(async () => undefined),
+}));
+
+const passThrough = (...args: unknown[]) => {
+  if (args.length >= 3 && typeof args[2] === 'function') return (args[2] as () => void)();
+  return (_r: unknown, _s: unknown, n: () => void) => n();
+};
+vi.mock('../middleware/authenticate', () => ({
+  authenticate: passThrough, authenticateToken: passThrough,
+  authenticateAccessOrConnector: passThrough, optionalAuthenticate: passThrough,
+  requireRole: passThrough,
+}));
+vi.mock('../middleware/tenantGuc', () => ({ seedTenantGuc: (_r: unknown, _s: unknown, n: () => void) => n() }));
+vi.mock('../events', () => ({
+  publishEvent: () => Promise.resolve(undefined),
+  EventTypes: { USER_LOGIN: 'user.login' },
+}));
+
+let server: Server;
+let baseUrl = '';
+beforeAll(async () => {
+  const { authRoutes } = await import('../routes/auth');
+  const { errorHandler } = await import('../middleware/errorHandler');
+  const app = express();
+  app.use(express.json());
+  app.use('/api/auth', authRoutes);
+  app.use(errorHandler);
+  server = app.listen(0, '127.0.0.1');
+  await new Promise<void>((resolve) => server.once('listening', () => resolve()));
+  baseUrl = 'http://127.0.0.1:' + String((server.address() as AddressInfo).port);
+});
+afterAll(async () => {
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+beforeEach(() => {
+  h.rehashLands = true;
+  h.info = [];
+  h.warn = [];
+});
+
+const REHASHED = 'UPGRADE-ON-VERIFY: rehashed bcrypt -> argon2id';
+const NOT_LANDED = 'UPGRADE-ON-VERIFY: the rehash write did not take effect (non-fatal); the old hash stays';
+const infoLines = (msg: string) => h.info.filter((c) => c[0] === msg);
+const warnLines = (msg: string) => h.warn.filter((c) => c[0] === msg);
+
+async function login(): Promise<{ status: number; minted: boolean }> {
+  const res = await fetch(baseUrl + '/api/auth/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ email: LOGIN_EMAIL, password: 'pw-correct-horse' }),
+    signal: AbortSignal.timeout(5000),
+  });
+  const text = await res.text();
+  return { status: res.status, minted: text.includes('MINTED_1460_LOGIN') };
+}
+
+describe('KS-1460 row 1 — the UPGRADE-ON-VERIFY log line says whether the rehash landed', () => {
+  it('RED — a rehash write that does not land logs the warn, never "rehashed", and the login still answers 200 with tokens', async () => {
+    h.rehashLands = false;
+    expect(await login()).toEqual({ status: 200, minted: true });
+    expect(infoLines(REHASHED), 'the log must not record a rehash that did not land').toHaveLength(0);
+    expect(warnLines(NOT_LANDED)).toEqual([[NOT_LANDED, { userId: ACTIVE_USER.id }]]);
+  });
+
+  it('CONTROL — a rehash write that lands logs "rehashed" once and no warn; the login answers 200 with tokens', async () => {
+    expect(await login()).toEqual({ status: 200, minted: true });
+    expect(infoLines(REHASHED)).toEqual([[REHASHED, { userId: ACTIVE_USER.id }]]);
+    expect(warnLines(NOT_LANDED)).toHaveLength(0);
+  });
+});
diff --git a/Blockchain/Dev/services/auth/src/__tests__/ks1460-social-level-raise-confirms-the-write.test.ts b/Blockchain/Dev/services/auth/src/__tests__/ks1460-social-level-raise-confirms-the-write.test.ts
