@@ -0,0 +1,229 @@
+// =============================================================================
+// KS-1460 rows 4 and 6 — the `verificationLevel: 'SOCIAL'` raise is confirmed
+// =============================================================================
+//
+// Two routes raise a BASIC account to SOCIAL after a social sign-in:
+//   - GET  /api/auth/social/:provider/callback  (row 4): it then set
+//     `user.verificationLevel = 'SOCIAL'` in memory and minted a token pair;
+//   - POST /api/auth/social/link               (row 6): it then answered
+//     `success: true, linked: true`.
+// Both called `userRepo.updateUser`, which answers `null` when its UPDATE matched
+// no row (repositories/userRepo.ts), and both discarded that answer. So a token
+// claiming SOCIAL, or a success answer, went out over a write that did not land.
+// Both now call `updateUserOrThrow`: a write that did not land is a 503
+// (ServiceUnavailableError) before any session, token or success answer.
+//
+// The repository double below models the REAL contract: `updateUser` answers
+// null for a write that did not land, and `updateUserOrThrow` is `updateUser`
+// plus a ServiceUnavailableError on null, as the real one is. That is what lets
+// the same cells red on the unfixed routes (which read `updateUser` and ignore
+// the null) and pass on the fixed ones.
+//
+// Not covered here, by Wednesday's ruling of 2026-11-05: the social-id link
+// writes (rows 3 and 5) belong to KS-1672 (updateUser drops social-id fields,
+// so there is no failure for updateUserOrThrow to catch).
+// The harness is ks795's (the callback through a real OAuth `state` store on an
+// in-memory Redis double).
+// =============================================================================
+
+import { describe, it, expect, beforeAll, afterAll, beforeEach, vi } from 'vitest';
+import express from 'express';
+import { randomUUID } from 'node:crypto';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+
+const state = vi.hoisted(() => ({
+  /** the account the callback resolves by its social id, and the link route reads back */
+  level: 'BASIC' as string,
+  /** when true, the SOCIAL write does not land: updateUser answers null for it */
+  levelWriteLands: true,
+  levelWrites: [] as Array<{ id: string; updates: Record<string, unknown> }>,
+  sessions: 0,
+}));
+
+const silentLogger = vi.hoisted(() => ({ debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn(), log: vi.fn() }));
+vi.mock('../utils/logger', () => ({ logger: silentLogger, createLogger: () => silentLogger, validateEnv: vi.fn() }));
+vi.mock('@secuura/shared/utils/logger', () => ({ logger: silentLogger, createLogger: () => silentLogger }));
+
+vi.mock('../providers/social', async (importOriginal) => {
+  const real = await importOriginal<Record<string, unknown>>();
+  const NAMES = ['google', 'linkedin', 'facebook', 'apple', 'github', 'microsoft_personal'];
+  class StubFactory {
+    get(name: string) {
+      if (!NAMES.includes(name)) return undefined;
+      return {
+        name,
+        getAuthUrl: () => 'https://provider.test/auth',
+        exchangeCode: async () => ({
+          providerId: `${name}-provider-id-1460`, provider: name, email: 'u1460@secuura.local',
+          emailVerified: true, displayName: 'U', firstName: 'U', lastName: 'Ser', rawProfile: {},
+        }),
+      };
+    }
+    getEnabled() { return NAMES; }
+    has(n: string) { return NAMES.includes(n); }
+    isValidProvider(n: string) { return NAMES.includes(n); }
+  }
+  return { ...real, SocialProviderFactory: StubFactory };
+});
+
+const account = () => ({
+  id: 'user-1460', email: 'u1460@secuura.local', status: 'ACTIVE', role: 'OWNER',
+  mfaEnabled: false, mfaSecret: null, verificationLevel: state.level, tenantId: 'ten-1', organizationId: 'org-1',
+});
+
+vi.mock('../repositories/userRepo', async () => {
+  const { ServiceUnavailableError } = await import('../middleware/errorHandler');
+  const updateUser = async (id: string, updates: Record<string, unknown>) => {
+    if ('verificationLevel' in updates) {
+      state.levelWrites.push({ id, updates });
+      return state.levelWriteLands ? { ...account(), ...updates } : null;
+    }
+    return { ...account() }; // any other write (the social-id link is KS-1672's and is not the subject)
+  };
+  return {
+    getUserBySocialId: vi.fn(async () => ({ ...account() })),
+    getUserByEmail: vi.fn(async () => null),
+    getUserById: vi.fn(async () => ({ ...account() })),
+    updateUser: vi.fn(updateUser),
+    // the real contract (repositories/userRepo.ts updateUserOrThrow): updateUser, then a 503 on null
+    updateUserOrThrow: vi.fn(async (id: string, updates: Record<string, unknown>, operation: string) => {
+      const updated = await updateUser(id, updates);
+      if (!updated) throw new ServiceUnavailableError(`${operation} could not be confirmed. Please retry — if you already succeeded, you may not need to.`);
+      return updated;
+    }),
+    createUser: vi.fn(async () => null),
+    getPlatformAdmin: vi.fn(async () => null),
+    reencryptMfaSecretIfLegacy: vi.fn(async () => undefined),
+  };
+});
+
+const redisStore = new Map<string, string>();
+vi.mock('../services/session', () => ({
+  createSession: vi.fn(async () => { state.sessions += 1; return { id: 'sess-1460' }; }),
+  getRedisClient: vi.fn(() => ({
+    setex: async (k: string, _ttl: number, v: string) => { redisStore.set(k, v); return 'OK'; },
+    get: async () => null,
+    incr: async () => 1,
+    expire: async () => 1,
+    set: async () => 'OK',
+    del: async () => 1,
+    getdel: async (k: string) => { const v = redisStore.get(k) ?? null; redisStore.delete(k); return v; },
+  })),
+  validateSession: vi.fn(async () => true),
+  updateSessionActivity: vi.fn(async () => undefined),
+}));
+vi.mock('../services/jwt', () => ({
+  generateTokenPair: vi.fn(() => ({ accessToken: 'MINTED_1460_ACCESS', refreshToken: 'MINTED_1460_REFRESH', expiresIn: 900 })),
+  verifyAccessToken: vi.fn(() => ({})),
+}));
+// POST /social/link reads req.user; every other factory the route tree registers passes through.
+const withUser = () => (req: Record<string, unknown>, _s: unknown, n: () => void) => {
+  (req as { user?: unknown }).user = { userId: 'user-1460', organizationId: 'org-1', tenantId: 'ten-1' };
+  n();
+};
+const passthrough = () => (_r: unknown, _s: unknown, n: () => void) => n();
+vi.mock('../middleware/authenticate', () => ({
+  authenticate: withUser,
+  authenticateAccessOrConnector: passthrough,
+  requireRole: passthrough,
+  requireVerificationLevel: passthrough,
+  requireOwnership: passthrough,
+  requireSameOrganization: passthrough,
+}));
+vi.mock('../db', () => ({ query: vi.fn(async () => ({ rows: [] })) }));
+vi.mock('../events', () => ({ publishEvent: vi.fn(async () => undefined), EventTypes: {} }));
+
+let server: Server;
+let base: string;
+
+beforeAll(async () => {
+  const { authRoutes } = await import('../routes/auth');
+  const { errorHandler } = await import('../middleware/errorHandler');
+  const app = express();
+  app.use(express.json());
+  app.use('/api/auth', authRoutes);
+  app.use(errorHandler);
+  server = app.listen(0, '127.0.0.1');
+  await new Promise<void>((r) => server.once('listening', () => r()));
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+afterAll(async () => { await new Promise<void>((r) => server.close(() => r())); });
+
+beforeEach(() => {
+  state.level = 'BASIC';
+  state.levelWriteLands = true;
+  state.levelWrites = [];
+  state.sessions = 0;
+});
+
+async function callback(): Promise<{ status: number; body: string }> {
+  const { storeOAuthState } = await import('../services/oauthState');
+  const oauthState = `test-state-${randomUUID()}`;
+  await storeOAuthState(oauthState, 'google');
+  const res = await fetch(`${base}/api/auth/social/google/callback?code=stub-code&state=${encodeURIComponent(oauthState)}`, { redirect: 'manual' });
+  return { status: res.status, body: await res.text() };
+}
+async function link(): Promise<{ status: number; body: string }> {
+  const res = await fetch(`${base}/api/auth/social/link`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ provider: 'google', code: 'stub-code' }),
+  });
+  return { status: res.status, body: await res.text() };
+}
+const show = (r: { status: number; body: string }) => `status ${r.status}, body: ${r.body.slice(0, 200)}`;
+
+describe('KS-1460 row 4 — the social callback confirms the SOCIAL raise before it mints', () => {
+  it('RED — a SOCIAL write that does not land answers 503, mints no token and creates no session', async () => {
+    state.levelWriteLands = false;
+    const r = await callback();
+    expect(r.status, show(r)).toBe(503);
+    expect(r.body).toContain('SERVICE_UNAVAILABLE');
+    expect(r.body).not.toContain('MINTED_1460');
+    expect(state.sessions).toBe(0);
+    expect(state.levelWrites).toEqual([{ id: 'user-1460', updates: { verificationLevel: 'SOCIAL' } }]);
+  });
+
+  it('CONTROL — a SOCIAL write that lands still mints (the success path is unchanged)', async () => {
+    const r = await callback();
+    expect(r.status, show(r)).toBe(200);
+    expect(r.body).toContain('MINTED_1460_ACCESS');
+    expect(state.sessions).toBe(1);
+    expect(state.levelWrites).toHaveLength(1);
+  });
+
+  it('CONTROL — an account already SOCIAL issues no level write and mints', async () => {
+    state.level = 'SOCIAL';
+    state.levelWriteLands = false; // would 503 if the route wrote; it must not write at all
+    const r = await callback();
+    expect(r.status, show(r)).toBe(200);
+    expect(r.body).toContain('MINTED_1460_ACCESS');
+    expect(state.levelWrites).toEqual([]);
+  });
+});
+
+describe('KS-1460 row 6 — POST /social/link confirms the SOCIAL raise before it answers success', () => {
+  it('RED — a SOCIAL write that does not land answers 503, not success', async () => {
+    state.levelWriteLands = false;
+    const r = await link();
+    expect(r.status, show(r)).toBe(503);
+    expect(r.body).toContain('SERVICE_UNAVAILABLE');
+    expect(r.body).not.toContain('"success":true');
+    expect(state.levelWrites).toEqual([{ id: 'user-1460', updates: { verificationLevel: 'SOCIAL' } }]);
+  });
+
+  it('CONTROL — a SOCIAL write that lands answers success, linked (the success path is unchanged)', async () => {
+    const r = await link();
+    expect(r.status, show(r)).toBe(200);
+    expect(r.body).toContain('"linked":true');
+    expect(state.levelWrites).toHaveLength(1);
+  });
+
+  it('CONTROL — an account already SOCIAL issues no level write and answers success', async () => {
+    state.level = 'SOCIAL';
+    state.levelWriteLands = false;
+    const r = await link();
+    expect(r.status, show(r)).toBe(200);
+    expect(state.levelWrites).toEqual([]);
+  });
+});
