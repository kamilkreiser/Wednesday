/**
 * =============================================================================
 * PASSWORD-LOGIN GATE (KS-781)
 * =============================================================================
 * The gates `/api/auth/login` applies between "a password arrived" and "a
 * credential is issued": account lockout, account status, password
 * verification, and the second factor.
 *
 * WHY THIS EXISTS
 * ---------------
 * `POST /api/oauth/authorize` was a SECOND, password-only login. It called
 * `getUserByEmail` → `verifyPassword` → `createAuthorizationCode` and consulted
 * neither `mfaEnabled`, nor account lockout, nor `user.status`. A password alone
 * yielded an authorization code for an account whose front door refuses
 * password-only login — confirmed at runtime, not inferred: the same account and
 * password returned `403 MFA_REQUIRED` from `/api/auth/login` and `302 …?code=…`
 * from `/api/oauth/authorize`.
 *
 * KS-737 closed "a second factor that can be declined" on the login route. This
 * route declined it by not being the route that asks.
 *
 * WHY A HELPER RATHER THAN A THIRD COPY
 * -------------------------------------
 * KS-781 covers three token-issuing doors — this one, the social-callback
 * account-linking branch, and `POST /api/auth/wallet/verify`. The ticket was
 * deliberately kept as ONE ticket because they share a single remedy: three
 * separate inline fixes would be three things that must agree and nothing
 * comparing them, which is precisely the class that produced KS-737.
 *
 * WHAT THIS DID NOT DO, UNTIL IT HAD TO (KS-796 QA2-F6 — corrected)
 * -----------------------------------------------------------------
 * This header used to say it deliberately does NOT refactor `/api/auth/login` to
 * call it, on the reasoning that login carries logic this gate has no business
 * owning (platform-admin lookup, upgrade-on-verify rehashing, tenant resolution)
 * and that a drift TEST was guard enough.
 *
 * **`/api/auth/login` calls it now**, and the reason the old reasoning failed is
 * worth keeping: the drift test compared the two routes' verdicts but its corpus
 * had no PENDING or INVITED row, so login kept its own status DENY-list and
 * minted a full token pair for both while the shared allow-list refused them at
 * every other door (KS-796 F-1, BLOCKER). A test guards only the rows it has.
 *
 * The logic that genuinely is login's own stayed in the route: the platform-admin
 * branch never enters this gate, and upgrade-on-verify and tenant resolution run
 * after it returns. So the concern was right about WHICH code belongs where and
 * wrong that a test could substitute for a shared call site.
 *
 * The refusal is uniform by design (pen-test F-11): locked out, suspended,
 * deactivated, SSO-only, unknown email and wrong password all return the same
 * `invalid_credentials`. Differentiating them leaks account existence and
 * account state to an unauthenticated caller.
 * =============================================================================
 */

// S130-F6 / registry.ts:245 — `z` MUST come from '@secuura/shared', not 'zod'.
// `extendZodWithOpenApi` is applied to the shared package's zod prototype; a
// direct 'zod' import gets an UNEXTENDED one, so every schema built here lacks
// `.openapi()`. The CJS spec generator happens to unify the two resolutions and
// hid it; a vitest run does not, which is why `auth.openapi.ts` could not be
// imported by any test and its module-scope canary could never fire.
import { z } from '@secuura/shared';
import * as userRepo from '../repositories/userRepo';
import { verifyTotpCode, verifyBackupCode } from './totp';
import { logger } from '../utils/logger';
import type { User } from '../types';
import { ServiceUnavailableError } from '../middleware/errorHandler';
import { STATUSES_MAY_RECEIVE_CREDENTIAL } from '../types';

// KS-1804 (note 1): this declaration moved here, below the last import. It sat between two imports
// (after errorHandler, before ../types). Only its position changed: the value is the same string literal.
/** KS-1188 F3: the 503 text when a backup-code burn could not be confirmed. True whether or not the burn landed. */
const BACKUP_CODE_UNCONFIRMED_MESSAGE =
  'Sign-in could not be confirmed. If you signed in with a backup code, your backup code may already have been spent: ' +
  'try again with another backup code or an authenticator app code.';

const maskEmail = (email: string): string => {
  const [local, domain] = String(email).split('@');
  if (!domain) return '***';
  return `${local.slice(0, 2)}***@${domain}`;
};

/**
 * KS-781 F-1: the accepted shapes for a second factor — 6 digits (TOTP) or 8
 * alphanumeric (backup code; base32 is a subset, and verifyBackupCode
 * upper-cases so lowercase is accepted). Both branches are ASCII-only, which
 * preserves the KS-518 property that the spec's code-POINT count and this
 * runtime code-UNIT check agree.
 *
 * MOVED HERE from routes/auth.ts (re-exported there, so its existing importers
 * and the KS-622 lockstep test are unaffected). It lives in the shared
 * credential layer because BOTH login routes need it and doors 2 and 3 will
 * too — and because importing it route-to-route pulled the whole auth route
 * module, and everything it imports, into oauth.ts's dependency graph.
 */
export const MFA_CODE_PATTERN = /^(?:[0-9]{6}|[A-Za-z0-9]{8})$/;

/**
 * KS-781 P3-4: the accepted INBOUND SHAPES for `mfaCode` — one definition, so
 * the password doors cannot disagree about what a second factor may look like.
 *
 * WHY THIS EXISTS AS A SYMBOL rather than two matching literals. The previous
 * round gave `/api/oauth/authorize` a union accepting `""` (an HTML form
 * submits an untouched input as the empty string) and left `/api/auth/login`
 * on the bare regex. Measured on the re-gate: the same body was `400` at login
 * and `302 + code` at authorize — 2 disagreements in a 12-row corpus. The
 * route's own new comment claimed *"the same accepted shapes as
 * /api/auth/login"*, which was false as written.
 *
 * Worse, the drift guard built in that round could not see it: its corpus
 * builds every body with `...(mfaCode ? { mfaCode } : {})`, so a falsy code was
 * OMITTED rather than sent, and `""` was unexpressible. A class was identified,
 * a guard was built for it, and the next change landed in the guard's declared
 * gap. Both were fixed together — the guard now sends `""` explicitly.
 *
 * `""` means ABSENT, not "any code goes": a genuinely malformed code (`"abc"`,
 * `"12345"`) is still a 400 on both doors, and an account with MFA still gets
 * `403 MFA_REQUIRED`. The widening is exactly the empty string.
 */
export const MFA_CODE_ACCEPTED = z.union([z.string().regex(MFA_CODE_PATTERN), z.literal('')]);

/**
 * The runtime form of {@link MFA_CODE_ACCEPTED}: optional, with `""` normalised
 * to `undefined` so every consumer downstream sees one representation of
 * "no second factor supplied". Used by BOTH password doors.
 *
 * The published spec uses `MFA_CODE_ACCEPTED.optional()` directly (no
 * transform — a transform describes runtime coercion, not the wire contract),
 * so the two stay in step through the shared union rather than by copy.
 */
export const mfaCodeRuntimeSchema = MFA_CODE_ACCEPTED.optional().transform((v) => (v ? v : undefined));

/**
 * KS-796 — THE ONE DEFINITION OF "this account may not be issued a credential
 * because of its status".
 *
 * Called from two places for two different reasons, which is why the rule is a
 * function and not a second `if`:
 *
 *   - `enforcePasswordLoginGates` refuses EARLY, before verifying the password,
 *     so a suspended account costs an attacker no crypto work and the refusal
 *     timing does not distinguish it from an unknown email;
 *   - `assertAccountMayReceiveCredential` refuses at the shared gate, which is
 *     the only check doors 2 and 3 have.
 *
 * Measured before this existed: removing the status branch from the shared
 * helper reddened door 3's suite and left door 1's **completely green**, because
 * door 1 carried its own copy of the same condition. Two copies of a refusal
 * rule, in the file written to stop exactly that, is the KS-737 class in
 * miniature. With this predicate the same tamper reddens both.
 */
export function accountStatusForbidsCredential(user: Pick<User, 'status'>): boolean {
  // KS-796 Q1: an ALLOW-list, not a deny-list. The deny-list named SUSPENDED and
  // DEACTIVATED and therefore let PENDING, INVITED — and anything the mapper did
  // not recognise — mint a full token pair. Inverted, a status nobody thought
  // about is refused by default, which is the only safe direction for a
  // credential gate.
  return !(STATUSES_MAY_RECEIVE_CREDENTIAL as readonly string[]).includes(user.status);
}

/**
 * KS-796 / KS-795 — THE SPLIT.
 *
 * The gates that apply to an ALREADY-RESOLVED account, with no password step:
 * lockout, account status, and the second factor. `enforcePasswordLoginGates`
 * calls it after verifying the password, so there is ONE gate rather than a
 * password copy and a credential copy that must agree.
 *
 * WHY IT EXISTS SEPARATELY FROM THE PASSWORD GATE
 * ----------------------------------------------
 * KS-781 covers three token-issuing doors. Door 1 authenticates with a
 * password. Door 2 authenticates with an external identity assertion. Door 3
 * authenticates with a CIP-8 wallet signature. Only the credential differs —
 * everything the platform then asks about the ACCOUNT is identical, and it was
 * asked on exactly one of the three.
 *
 * IDENTIFIER NORMALISATION LIVES IN HERE, NOT IN THE CALLERS
 * ---------------------------------------------------------
 * KS-781 F-1: `accountLockout` keyed on `.toLowerCase()` with no trim while
 * `getUserByEmail` trimmed, so a padded address resolved the victim's row
 * against a lockout counter nothing had incremented — one space defeated the
 * lockout, measured at 30 of 30 attempts. That was closed in two callers, which
 * is a convention; doors 2 and 3 are new callers. It is normalised here so a
 * caller cannot reintroduce it. (KS-781 N-6 also put a `.trim()` in the key
 * derivation itself, so this is now belt AND braces, deliberately.)
 *
 * A WALLET ACCOUNT'S IDENTIFIER
 * -----------------------------
 * Wallet users carry a synthetic @wallet.local email (`routes/wallet.ts`, `getOrCreateWalletUser`): `w-<40 hex of
 * sha256(address)>` for accounts created since KS-806, `<addr-prefix>...` for older ones, which keep the email they
 * already store. It is stable per account, so
 * it keys the lockout counter consistently; it is not a deliverable address and
 * nothing here treats it as one.
 */
export type CredentialIssueGateResult =
  | { ok: true }
  /** Uniform refusal — never say WHICH reason applied. */
  | { ok: false; reason: 'refused' }
  /** The account has a second factor and no usable code arrived. */
  | { ok: false; reason: 'mfa_required' };

export interface CredentialIssueGateInput {
  /** 6 digits = TOTP, 8 alphanumeric = backup code. Absent is the MFA_REQUIRED case. */
  mfaCode?: string;
  sourceIp: string;
  /** Names the calling route in logs so a refusal can be traced to its door. */
  route: string;
  /**
   * Skip the lockout check. ONLY for a caller that has already performed it —
   * i.e. the password path, which checks lockout BEFORE the user lookup so a
   * locked-out account costs an attacker the same as an unknown one. Every
   * other caller leaves this false and gets the check.
   */
  lockoutAlreadyChecked?: boolean;
}

/**
 * May this account be issued a credential right now, whatever proved the
 * caller's identity? Returns ok only when every gate passes.
 */
export async function assertAccountMayReceiveCredential(
  user: User,
  input: CredentialIssueGateInput,
): Promise<CredentialIssueGateResult> {
  const { mfaCode, sourceIp, route, lockoutAlreadyChecked } = input;

  // Normalised HERE — see the header. The identifier is the account's own, not
  // one the caller supplied, so a caller cannot key the counter differently
  // from the account it resolved.
  const email = String(user.email ?? '').toLowerCase().trim();

  const { isLockedOut, recordFailure, recordSuccess } = await import('./accountLockout');
  const { getRedisClient } = await import('./session');
  const lockoutRedis = getRedisClient();

  if (!lockoutAlreadyChecked && (await isLockedOut(lockoutRedis, email, sourceIp))) {
    logger.warn(`${route}: blocked by account lockout`, { email: maskEmail(email), ip: sourceIp });
    return { ok: false, reason: 'refused' };
  }

  if (accountStatusForbidsCredential(user)) {
    logger.warn(`${route}: blocked by account status`, { userId: user.id, status: user.status });
    await recordFailure(lockoutRedis, email, sourceIp);
    return { ok: false, reason: 'refused' };
  }

  if (user.mfaEnabled) {
    if (!mfaCode) return { ok: false, reason: 'mfa_required' };

    if (!user.mfaSecret) {
      // MFA on with no secret is a configuration fault, not a credential the
      // caller can supply. Refuse rather than fall through — falling through
      // issues a credential without the factor, which is the whole defect.
      logger.error(`${route}: MFA enabled but no secret found`, { userId: user.id });
      return { ok: false, reason: 'refused' };
    }

    if (!verifyTotpCode(user.mfaSecret, mfaCode)) {
      const backupResult = user.mfaBackupCodes
        ? await verifyBackupCode(mfaCode, user.mfaBackupCodes)
        : { valid: false, index: -1 };

      if (backupResult.valid && backupResult.index >= 0 && user.mfaBackupCodes) {
        // Single-use: burn it before it can buy a second credential.
        //
        // KS-1052: the burn is CHECKED. It was discarded, and on a write that
        // did not land the code stayed valid while this function went on to
        // recordSuccess() and returned ok:true — a single-use credential
        // surviving the login it just bought. consumeBackupCode refuses instead
        // (KS-1848: it was updateUserOrThrow), so the code cannot be spent without being spent.
        //
        // The 503 is not a credential oracle: it is reachable only AFTER a
        // backup code has already verified, so it tells an attacker nothing
        // they did not supply. An invalid code still takes the uniform
        // refusal path below.
        //
        // KS-1848 (gate 30 F1): the burn removes the STORED HASH this request matched, in one conditional statement
        // (userRepo.consumeBackupCode). It used to splice the code out of this request's snapshot and write the whole
        // array back by id, so two sign-ins holding the same snapshot both succeeded with one code, and two with
        // different codes left one spent code stored and valid again.
        const usedHash = user.mfaBackupCodes[backupResult.index];
        let burn: userRepo.BackupCodeConsumption;
        // KS-1188 F3: a 503 around the burn does not mean "nothing happened". The burn can have LANDED while the
        // read-back inside consumeBackupCode failed (KS-1848: it was updateUserOrThrow; measured by the #1013 gate: codes 2 -> 1), so "please retry" sent
        // the user back with a SPENT code: 401 and a lockout increment. A fault before the burn gives 503 then 200 on
        // retry, so the response alone cannot tell the two apart. Wording only (ruled option A, 2026-10-12): same 503,
        // same code, text that is true in both cases. It is conditional ("if you signed in with a backup code") so it
        // does not confirm the code was valid. Any other failure passes through untouched.
        try {
          // KS-1848: was `updateUserOrThrow(user.id, { mfaBackupCodes: <snapshot minus the code> }, 'Backup-code sign-in')`.
          burn = await userRepo.consumeBackupCode(user.id, usedHash);
        } catch (err) {
          // `statusCode`, not `instanceof`: this reads the same for an AppError from any package. (KS-1467: AppError's constructor used to end with
          // Object.setPrototypeOf(this, AppError.prototype), which reset every subclass instance, so `instanceof ServiceUnavailableError` was always false here.)
          if ((err as { statusCode?: unknown } | null)?.statusCode === 503) throw new ServiceUnavailableError(BACKUP_CODE_UNCONFIRMED_MESSAGE);
          throw err;
        }
        if (!burn.consumed) {
          // KS-1848: the stored set no longer holds this code: another request spent it, or replaced the set (a backup-code
          // regenerate), between our read and our write. Answer exactly what a replay of a spent code answers (it fails
          // verifyBackupCode and lands in the branch below): the uniform refusal, counted
          // once by the lockout. Status, body and lockout count are identical to that replay; the TIME is not
          // (KS-1848, gate 38 F1: this comment used to say "so a lost race is no oracle", which overclaims for time):
          // verifyBackupCode returns at the first matching hash, so a lost race skips the comparisons a wrong or spent
          // code pays for and answers about 30 ms sooner (medians 45.4 ms against 77.8 / 76.6 ms, set size 2, 15 samples).
          // KS-1848 does not change that timing; exploiting it needs the password, a valid code and a millisecond-wide
          // race. Ruled by Wednesday 2026-10-30. Previously this request overwrote the row and was issued a second
          // credential for the same code.
          logger.warn(`${route}: backup code already spent by a concurrent sign-in`, { userId: user.id });
          await recordFailure(lockoutRedis, email, sourceIp);
          return { ok: false, reason: 'refused' };
        }
        // KS-1848: the snapshot is trimmed only once the burn is confirmed. It used to be spliced BEFORE the write, so a
        // 503 left this request's copy without a code the database might still hold.
        user.mfaBackupCodes.splice(backupResult.index, 1);
        logger.info(`${route}: MFA verified via backup code`, { userId: user.id });
      } else {
        logger.warn(`${route}: MFA verification failed`, { userId: user.id });
        // KS-622: reached only when BOTH checks failed, so a legitimate backup
        // code never increments the lockout counter.
        await recordFailure(lockoutRedis, email, sourceIp);
        return { ok: false, reason: 'refused' };
      }
    }

    // KS-158: self-heal a legacy-plaintext secret after a successful verify.
    await userRepo.reencryptMfaSecretIfLegacy(user.id);
  }

  await recordSuccess(lockoutRedis, email, sourceIp);
  return { ok: true };
}

export type PasswordLoginGateResult =
  | { ok: true; user: User }
  /** Uniform refusal — never say WHICH of the refusal reasons applied. */
  | { ok: false; reason: 'invalid_credentials' }
  /** The account has a second factor and no code (or no usable code) arrived. */
  | { ok: false; reason: 'mfa_required' };

export interface PasswordLoginGateInput {
  email: string;
  password: string;
  /** 6 digits = TOTP, 8 alphanumeric = backup code. Absent is the MFA_REQUIRED case. */
  mfaCode?: string;
  sourceIp: string;
  /** Names the calling route in logs so a lockout can be traced to its door. */
  route: string;
}

/**
 * Apply login's pre-credential gates. Returns the user only when every gate
 * passes; the caller renders its own error shape from `reason`.
 */
export async function enforcePasswordLoginGates(
  input: PasswordLoginGateInput,
): Promise<PasswordLoginGateResult> {
  const { password, mfaCode, sourceIp, route } = input;

  // KS-781 F-1 — NORMALISE THE IDENTIFIER ONCE, HERE, AND USE ONLY THIS VALUE.
  //
  // This is the whole finding, and it belongs in the shared layer rather than in
  // each caller. The two consumers of an email disagreed about normalisation:
  //
  //   accountLockout keys on `email.toLowerCase()`      — NO trim
  //   userRepo.getUserByEmail  does `.toLowerCase().trim()` — trims
  //
  // `/api/auth/login` is safe only by accident of ordering: `loginSchema`'s
  // `z.string().trim().email()` trims BEFORE either sees the value. Authorize
  // read `req.body.email` raw, so `" victim@example.com"` produced a lockout key
  // nothing had ever incremented while still resolving the victim's row — the
  // lockout was defeated by one space. Measured by the QA pass: 30 of 30
  // attempts across six whitespace variants reached a locked-out account, and
  // that account was minted an authorization code.
  //
  // Normalising in the gate rather than only in a route schema is deliberate:
  // doors 2 and 3 (KS-795 / KS-796) will call the split helper, and a fix that
  // lived in one route's schema would let them reintroduce exactly this bug.
  const email = input.email.toLowerCase().trim();

  // recordSuccess is NOT taken here: clearing the counter is the shared gate's
  // job, and it must happen only once every gate has passed.
  const { isLockedOut, recordFailure } = await import('./accountLockout');
  const { getRedisClient } = await import('./session');
  const lockoutRedis = getRedisClient();

  // Gate 1 — account lockout, checked BEFORE the lookup so a locked-out account
  // costs an attacker the same as an unknown one.
  if (await isLockedOut(lockoutRedis, email, sourceIp)) {
    logger.warn(`${route}: blocked by account lockout`, { email: maskEmail(email), ip: sourceIp });
    return { ok: false, reason: 'invalid_credentials' };
  }

  const user = await userRepo.getUserByEmail(email);
  if (!user) {
    await recordFailure(lockoutRedis, email, sourceIp);
    return { ok: false, reason: 'invalid_credentials' };
  }

  // Gate 2 — account status, refused EARLY so a suspended account costs no
  // password verify. Uniform refusal (F-11): do not differentiate SUSPENDED /
  // DEACTIVATED from a wrong password at an unauthenticated door. The RULE is
  // shared with the credential gate (KS-796); only the timing differs.
  if (accountStatusForbidsCredential(user)) {
    await recordFailure(lockoutRedis, email, sourceIp);
    return { ok: false, reason: 'invalid_credentials' };
  }

  // SSO-only account — same uniform error.
  if (!user.passwordHash) {
    await recordFailure(lockoutRedis, email, sourceIp);
    return { ok: false, reason: 'invalid_credentials' };
  }

  // Gate 3 — password.
  const { verifyPassword } = await import('./password');
  if (!(await verifyPassword(password, user.passwordHash))) {
    await recordFailure(lockoutRedis, email, sourceIp);
    return { ok: false, reason: 'invalid_credentials' };
  }

  // Gate 4 — everything that is about the ACCOUNT rather than the password:
  // the second factor, and (for a caller that has not already done it) lockout
  // and status. Delegated so doors 2 and 3 apply the identical rules — a second
  // copy here is exactly the drift KS-737 and KS-781 both came from.
  //
  // `lockoutAlreadyChecked` because this path checks lockout BEFORE the user
  // lookup, so a locked-out account costs an attacker the same as an unknown
  // one. Status is re-checked inside; that is idempotent and cheap.
  const accountGate = await assertAccountMayReceiveCredential(user, {
    mfaCode,
    sourceIp,
    route,
    lockoutAlreadyChecked: true,
  });
  if (!accountGate.ok) {
    return accountGate.reason === 'mfa_required'
      ? { ok: false, reason: 'mfa_required' }
      : { ok: false, reason: 'invalid_credentials' };
  }

  return { ok: true, user };
}
