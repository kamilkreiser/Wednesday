--- a/Blockchain/Dev/tests/e2e/tests/auth-exhaustive.spec.ts
+++ b/Blockchain/Dev/tests/e2e/tests/auth-exhaustive.spec.ts
@@ -748,6 +748,10 @@
     // Must not expose SQL errors
     expect(body.toLowerCase()).not.toContain('sql');
     expect(body.toLowerCase()).not.toContain('syntax error');
-    expect(body.toLowerCase()).not.toContain('drop table');
+    // KS-1039: 'drop table' is the INPUT, and a register that stores and returns a display name returns it verbatim, so asserting it is absent from
