 # KS-1560 M-2 (PR #1528 gate note, mutant B): this used to be `grep -qF 'bin/jq' "$f"`, a substring anywhere in the file, so
 # deleting the real `ln -sf "$JQ_BIN" "$root/bin/jq"` line and leaving the words `bin/jq` in a comment, a string or an
 # existence test kept the census green. A line that starts with `ln` cannot be a comment, an echo or a `[ -x ... ]` test.
-links_jq() { grep -qE '^[[:space:]]*ln[[:space:]]+-[A-Za-z]*s[A-Za-z]*[[:space:]].*bin/jq["'"'"']?[[:space:]]*($|[;&|#])' "$1"; }
+# KS-2141 (F-2078-1, F-2078-2): the predicate reads the link STATEMENT. Backslash continuations are joined, a comment is dropped,
+# then `ln` must stand as a command (line start, after ; & | ( ! then do else, or after `command`), carry a symlink flag, and
+# name bin/jq as its LAST word before the end of the statement (end of line, ; & | ), or a redirection such as 2>/dev/null).
+links_jq() {
+    awk '{ if (sub(/\\$/, "")) { buf = buf $0 " "; next } print buf $0; buf = "" } END { if (buf != "") print buf }' "$1" \
+        | sed -E -e 's/^[[:space:]]*#.*$//' -e 's/[[:space:]]+#.*$//' \
+        | grep -qE '(^|[;&|(!]|[[:space:]](then|do|else))[[:space:]]*(command[[:space:]]+)?ln[[:space:]]+(-[A-Za-z]*s[A-Za-z]*|--symbolic)[[:space:]][^;&|#]*bin/jq["'"'"']?[[:space:]]*($|[;&|)]|[0-9]*>)'
+}
 
