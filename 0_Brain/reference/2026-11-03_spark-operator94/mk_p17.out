     return subjectOrg !== null && subjectOrg === callerOrg ? user.id : null;
   } catch (err) {
-    if (err instanceof OnBehalfOfError) throw err;
+    let isOnBehalfOfError: boolean;
+    let reason: string | null | undefined;
