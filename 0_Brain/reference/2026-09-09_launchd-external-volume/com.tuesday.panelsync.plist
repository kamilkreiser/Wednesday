<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tuesday.panelsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/KK_T9_External_HDD/TUESDAY/2_Project_Files/tools/panel_sync.sh</string>
    <string>once</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <!-- Log paths MUST be on the boot volume. A plist with out/err under /Volumes
       is refused wholesale by launchd with EX_CONFIG 78: it never runs the
       program and reports nothing. Found by the Studio seat 2026-09-09. -->
  <key>StandardOutPath</key><string>/Users/kamil/Library/Logs/com.tuesday.panelsync.out</string>
  <key>StandardErrorPath</key><string>/Users/kamil/Library/Logs/com.tuesday.panelsync.err</string>
</dict>
</plist>
