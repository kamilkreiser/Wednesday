+/// The member's own figures, read before a seal with no folder listing (AUDIT-NEXT-A items 2
+/// and 3).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Figures {
+    /// The member's segment (`SessionAudit::segment`).
+    pub segment: u64,
+    /// Its own last number (`own().seq()`).
+    pub own_seq: u64,
+    /// The number of its last own checkpoint (`own().checkpoints()`'s last `head.author_seq`; 0
+    /// when it holds none).
+    pub own_checkpoint: u64,
+}
+
+/// The owner's seal, step by step, with no host (AUDIT-NEXT-A item 2): `owner_seal` gives it the
+/// host's steps as closures over `cx`, a test gives it a model.
+///
+/// * `figures` reads the member's figures; `None` = the host has no member (`Closed`).
+/// * (a, R2-N1) a host with no member is opened again ONCE (`reopen`) before its figures are
+///   read; only if that read also fails is the answer [`segment_unknown`] (no `seal` call).
+/// * [`drive_seal`] then makes the command's ONE `seal` (`seal_once`); `limits` receives the
+///   answer's limits report, at once.
+/// * After the answer: a re-open when the action asks for one; the text is chosen AFTER its result
+///   is known (b, R2-N2: a done seal whose re-open failed says so); row 4 reads the segment of the
+///   host opened again against the one read before.
+/// * (item 3, R2-N3) a `NothingToSeal` answer (by its variant, bare or inside `LimitsChanged`)
+///   says which cause the figures read before the call show; the old text when they show neither.
+///
+/// Returns the action, the number of `seal` calls, and whether the answer was an `Err`.
+pub fn owner_seal_steps<C>(
+    cx: &mut C,
+    figures: impl Fn(&C) -> Option<Figures>,
+    mut reopen: impl FnMut(&mut C) -> bool,
+    mut seal_once: impl FnMut(&mut C) -> (Result<SealReport, HostError>, bool),
+    mut limits: impl FnMut(&mut C, &LimitsReport),
+) -> (Action, u32, bool) {
+    fn nothing_to_seal<T>(answer: &Result<T, HostError>) -> bool {
+        match answer {
+            Err(HostError::Audit(AuditError::NothingToSeal)) => true,
+            Err(HostError::LimitsChanged { answer, .. }) => nothing_to_seal(answer.as_ref()),
+            _ => false,
+        }
+    }
+    let mut fig = figures(cx);
+    // RED CONTROL `member_less_never_reopened` (AN-2b): the broken variant never opens a member-less
+    // host again here (the seal then answers `segment_unknown`, 0 calls).
+    if fig.is_none() && !cfg!(coagent_red = "member_less_never_reopened") {
+        reopen(cx);
+        fig = figures(cx);
+    }
+    // the same figure serves row 7 (in `act_on_seal`) and row 4 (below)
+    let read = fig.map(|f| f.segment);
+    let before = segment_before_for_seal(read);
+    let mut nothing = false;
+    let (mut a, calls, was_err) = drive_seal(read, || {
+        let (answer, closed_after) = seal_once(cx);
+        nothing = nothing_to_seal(&answer);
+        (answer, closed_after)
+    });
+    if let Some(l) = &a.limits {
+        limits(cx, l);
+    }
+    if a.reopen {
+        let reopened = reopen(cx);
+        if !reopened {
+            if !a.done {
+                a.text = T_NOT_SEALED_NOT_REOPENED;
+            } else if !cfg!(coagent_red = "row11_text_before_reopen") {
+                // RED CONTROL `row11_text_before_reopen` (AN-2): the broken variant keeps row 11's
+                // "opened again" when the re-open failed.
+                a.text = T_SEALED_NOT_REOPENED;
+            }
+        }
+        if a.read_segment && reopened {
+            // row 4: whether the seal landed is read from the segment of the host opened again,
+            // against the same figure read before the call
+            match (figures(cx).map(|f| f.segment), before) {
+                (Some(s), Some(b)) if s != b => {
+                    a.done = true;
+                    a.text = T_SEALED_REOPEN;
+                }
+                // not moved; or (not reachable: a host just opened has its member, and `seal` is
+                // called only with a known segment) unknown: never "sealed"
+                _ => a.text = T_NOT_SEALED_REOPEN,
+            }
+        }
+    }
+    if nothing && !a.done {
+        a.text = match fig {
+            // RED CONTROL `nothing_text_guessed` (AN-3): the broken variant says "nothing new"
+            // whatever the figures say.
+            _ if cfg!(coagent_red = "nothing_text_guessed") => T_NOTHING_NEW,
+            Some(f) if f.own_seq > f.own_checkpoint => T_NOTHING_UNWRITTEN,
+            Some(f) if f.own_seq == f.own_checkpoint => T_NOTHING_NEW,
+            _ => T_NOTHING,
+        };
+    }
+    (a, calls, was_err)
+}
