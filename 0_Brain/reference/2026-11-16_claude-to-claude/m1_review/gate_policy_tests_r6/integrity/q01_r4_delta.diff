+
+// RULING (Friday, 2026-11-18, addendum 7): new helper. `decide` takes the time as a parameter and reads no clock, so
+// an injected clock cannot measure it; the wall clock is noisy on a busy machine (the round-5 gate saw 52.07 ms once
+// in 22 runs under load). Each case is therefore run FIVE times and the SMALLEST time is reported and asserted. A
+// real regression is extra work done on every run, so it makes all five runs slow and still fails the bound.
+fn smallest_of_five(mut f: impl FnMut()) -> std::time::Duration {
+    (0..5)
+        .map(|_| {
+            let t = std::time::Instant::now();
+            f();
+            t.elapsed()
+        })
+        .min()
+        .unwrap()
+}
