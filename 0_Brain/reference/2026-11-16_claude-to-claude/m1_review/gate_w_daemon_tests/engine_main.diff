+/// The process's stop signals (W-5), made ONCE before the engine's loop and never re-made inside
+/// it. `recv` yields the log line of the signal that came. Unix: SIGTERM and SIGINT, as before.
+/// Windows: Ctrl-C through tokio's safe `tokio::signal::ctrl_c` (READ in the vendored
+/// `tokio-1.54.1/src/signal/ctrl_c.rs:59`). RAN ON THE OWNER'S PC at `07a9d13` (Friday's WO-5): one Ctrl-C
+/// stopped it cleanly, one ended it with no stop line (cause not known; `docs/DAEMON.md` 6a). Since then it
+/// is armed in `run` right after the lock, before "started" (WRITTEN AND TYPE-CHECKED; NEVER RUN on the PC
+/// yet). Its one future is kept here
+/// across loop turns, because it "will complete on the first received ctrl-c after the initial
+/// call to either `Future::poll` or `.await`" (the same file's doc comment). A closed console
+/// window, a logoff, Ctrl-Break or a kill from the task manager is NOT handled: the process ends without
+/// `shutdown`, which is the crash path of the recovery rules (`docs/DAEMON.md` rows 45 and 46).
+struct StopSignals {
+    #[cfg(unix)]
+    term: tokio::signal::unix::Signal,
+    #[cfg(unix)]
+    int: tokio::signal::unix::Signal,
+    #[cfg(not(unix))]
+    ctrl_c:
+        Option<std::pin::Pin<Box<dyn std::future::Future<Output = std::io::Result<()>> + Send>>>,
+}
+
+impl StopSignals {
+    fn new() -> Result<StopSignals, String> {
+        #[cfg(unix)]
+        {
+            use tokio::signal::unix::{signal, SignalKind};
+            Ok(StopSignals {
+                term: signal(SignalKind::terminate()).map_err(|_| "cannot watch SIGTERM")?,
+                int: signal(SignalKind::interrupt()).map_err(|_| "cannot watch SIGINT")?,
+            })
+        }
+        #[cfg(not(unix))]
+        {
+            // `ctrl_c()` registers tokio's console handler only when it is first polled (READ
+            // `tokio-1.54.1/src/signal/ctrl_c.rs:59-62`: the body `os_impl::ctrl_c()?.recv().await`
+            // runs on the first poll; `windows/sys.rs` `new` calls `SetConsoleCtrlHandler`). Until
+            // then a Ctrl-C ends the process the default way, with no stop path. So it is polled
+            // ONCE here, with a waker that does nothing: that registers the handler and this
+            // future's receiver now; the loop's own poll later gives it the real waker. If it is
+            // already complete (a Ctrl-C at that very moment, or an error), the result is kept.
+            let mut f: std::pin::Pin<
+                Box<dyn std::future::Future<Output = std::io::Result<()>> + Send>,
+            > = Box::pin(tokio::signal::ctrl_c());
+            let mut cx = std::task::Context::from_waker(std::task::Waker::noop());
+            if let std::task::Poll::Ready(r) = std::future::Future::poll(f.as_mut(), &mut cx) {
+                f = Box::pin(std::future::ready(r));
+            }
+            Ok(StopSignals { ctrl_c: Some(f) })
+        }
+    }
+
+    /// The next stop signal's log line. Cancel-safe: a turn of the loop that ends on another event
+    /// loses no signal (the Unix streams and the one Ctrl-C future live in `self`).
+    async fn recv(&mut self) -> &'static str {
+        #[cfg(unix)]
+        {
+            tokio::select! {
+                _ = self.term.recv() => "SIGTERM received; stopping",
+                _ = self.int.recv() => "SIGINT received; stopping",
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let Some(f) = self.ctrl_c.as_mut() else {
+                return std::future::pending().await;
+            };
+            let r = f.await;
+            self.ctrl_c = None;
+            match r {
+                Ok(()) => "Ctrl-C received; stopping",
+                Err(e) => {
+                    log!(
+                        "cannot watch Ctrl-C ({:?}): this daemon now stops only when idle or when it is ended",
+                        e.kind()
+                    );
+                    std::future::pending().await
+                }
+            }
+        }
+    }
