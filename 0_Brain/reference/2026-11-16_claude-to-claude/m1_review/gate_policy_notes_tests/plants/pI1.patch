+/// POLICY-NOTES item 1 (m-1; the owner's card `general-c2c-allow-terminal-vs-exclusions-1125`, its default a): a
+/// terminal command runs unasked in the owner origin only while NOTHING is excluded, the owner's exclusion list AND the
+/// grant's exclude list (applied even while the grant is inactive, as in `assess`) both empty. No command's reach can be
+/// bounded from its text (a script, `cd`, `xargs`, `tar`, an interpreter), so whether it reads an excluded file cannot
+/// be recognised soundly; while anything is excluded it continues to [8] and asks, as `decide`. Removing this item
+/// is this one function (and its call in [7d]).
+fn nothing_is_excluded(state: &State) -> bool {
+    #[cfg(not(feature = "red_owner_terminal_ignores_exclusions"))]
+    return state.exclusions.pats.is_empty()
+        && !state
+            .grant
+            .as_ref()
+            .is_some_and(|gs| !gs.grant.exclude.pats.is_empty());
+    #[cfg(feature = "red_owner_terminal_ignores_exclusions")]
+    {
+        let _ = state;
+        true // RED CONTROL ONLY: terminal commands run unasked whatever is excluded
+    }
+}
