+fn qa_ff_check(h: &HookInput, a: &Action) {
+    let ff = OwnerInputFacts {
+        sandbox_flag_not_false: a.sandbox_disabled,
+        cwd_not_absolute: matches!(&a.cwd, NormPath::Uncertain { raw, .. } if raw.is_empty()),
+    };
+    let real = owner_input_facts(h);
+    use std::io::Write as _;
+    let line = format!("{} {:?} {:?} cwd={:?} tool={:?} input={}\n", if ff == real { "SAME" } else { "DIFF" }, ff, real, h.cwd, h.tool_name, h.tool_input);
+    let path = std::env::var("QA_FF_LOG").unwrap();
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap();
+    f.write_all(line.as_bytes()).unwrap();
