+
+/// QA-POLICY-NEXT instrumentation (scratch only): the BASE body of `fixture_facts`, verbatim (7fc6188 :47-52).
+pub fn fixture_facts_base(a: &Action) -> OwnerInputFacts {
+    OwnerInputFacts {
+        sandbox_flag_not_false: a.sandbox_disabled,
+        cwd_not_absolute: matches!(&a.cwd, NormPath::Uncertain { raw, .. } if raw.is_empty()),
+    }
+}
+
+/// QA-POLICY-NEXT instrumentation: every call compares the guarded helper with the base body and logs SAME/DIFF/FIRE.
+pub fn fixture_facts(a: &Action) -> OwnerInputFacts {
+    let base = fixture_facts_base(a);
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| fixture_facts_guarded(a)));
+    let v = match &r {
+        Ok(f) if *f == base => "SAME",
+        Ok(_) => "DIFF",
+        Err(_) => "FIRE",
+    };
+    if let Ok(p) = std::env::var("QPX_FF_LOG") {
+        use std::io::Write;
+        let t = std::thread::current().name().unwrap_or("?").to_string();
+        let mut f = std::fs::OpenOptions::new().create(true).append(true).open(p).unwrap();
+        let line = format!("{v}\t{t}\t{:?}\n", a.cwd);
+        let _ = f.write_all(line.as_bytes()); // one write per line (O_APPEND), so threads do not interleave
+    }
+    match r {
+        Ok(f) => f,
+        Err(e) => std::panic::resume_unwind(e),
+    }
+}
+
 pub fn with_owner(a: &Action, st: &State, m: &OwnerAllow, s: Surface) -> Decision {
