+    /// QA SCRATCH VARIANT: the length of the longest prefix of `d` that, trimmed of trailing `.`
+    /// and `-`, passes [`email_domain_ok`] (one linear pass), or `None`.
+    fn email_longest_ok(d: &[u8]) -> Option<usize> {
+        let mut best = None;
+        let mut done = 0usize;
+        let mut empty = false;
+        let mut ls = 0usize;
+        let mut alpha = true;
+        for t in 1..=d.len() {
+            let c = d[t - 1];
+            if c == b'.' {
+                if t - 1 == ls {
+                    empty = true;
+                }
+                done += 1;
+                ls = t;
+                alpha = true;
+                continue;
+            }
+            if !c.is_ascii_alphabetic() {
+                alpha = false;
+            }
+            if c == b'-' || empty || done == 0 {
+                continue;
+            }
+            let cur = &d[ls..t];
+            if (cur.len() >= 2 && alpha) || (cur.len() >= 4 && cur[..4].eq_ignore_ascii_case(b"xn--")) {
+                best = Some(t);
+            }
+        }
+        best
+    }
