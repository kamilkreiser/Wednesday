diff --git a/systemTest/__tests__/generated_guard_restore.test.sh b/systemTest/__tests__/generated_guard_restore.test.sh
new file mode 100755
index 000000000..6ead09dad
--- /dev/null
+++ b/systemTest/__tests__/generated_guard_restore.test.sh
@@ -0,0 +1,189 @@
+#!/usr/bin/env bash
+# =============================================================================
+# TESTS for support/generated_guard.sh's RESTORE path (KS-1735)
+# =============================================================================
+# The defect: `generated_guard_restore()` copied the stash back with an
+# unchecked `cp` and then `rm -rf`'d the scratch directory regardless, so a
+# failed restore left generated/ empty or partial, deleted the ONLY copy, said
+# nothing, and did not move the suite's exit status. The two inline copies of
+# this guard (`pre_suite.test.sh`, `quarantine_call_sites.test.sh`) were
+# hardened for exactly this under KS 1027 (items 1 and 2) and KS 1714; this
+# file was written under KS 1167 as "the same guard for suites written after
+# them" and carried the KS 992 snapshot check only.
+#
+# HOW: the guard is a sourced file that installs an EXIT trap, so each cell
+# drives it in a CHILD bash process (a throwaway driver that sources the guard
+# and exits with a chosen status) and then reads three things the parent can
+# see: the child's exit status, what it wrote to stderr, and whether the stash
+# directory still holds the sentinel.
+#
+# $FIXTURES is a parameter of the guard, so every cell points it at its OWN
+# throwaway directory. No cell reads or writes the repo's real
+# systemTest/fixtures/generated.
+#
+# The instrument is a fake `cp` first on PATH that fails ONLY for a chosen
+# destination suffix and execs the real `cp` for everything else. Cell 1 is its
+# positive control: a guard that cannot be made to fail proves nothing about
+# the branch that handles failure.
+#
+# Usage: bash systemTest/__tests__/generated_guard_restore.test.sh
+# =============================================================================
+
+set -uo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+GUARD="$HERE/support/generated_guard.sh"
+
+PASS=0; FAIL=0
+ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
+bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n     %s\n' "$1" "${2:-}"; }
+
+[ -f "$GUARD" ] || { printf 'generated_guard_restore.test.sh: cannot find %s\n' "$GUARD" >&2; exit 2; }
+
+# A private scratch root, so a parallel suite's cleanup cannot reach these and
+# this suite cannot reach anyone else's.
+WORK="$(mktemp -d "/tmp/ks1735.XXXXXX")" || exit 2
+cleanup() { rm -rf "$WORK"; }
+trap cleanup EXIT
+
+# --- the instrument ----------------------------------------------------------
+# $1 = destination suffix to refuse (e.g. "/generated/" or "/stash/")
+make_fake_cp() {
+  mkdir -p "$WORK/fakebin"
+  cat > "$WORK/fakebin/cp" <<FAKE
+#!/bin/bash
+# KS-1735 instrument: fail ONLY when the destination (last argument) ends in $1.
+for last; do :; done
+echo "cp \$*" >> "$WORK/cp-calls.log"
+case "\$last" in
+  *$1) echo "fake cp: refusing a copy into \$last" >&2; exit 1 ;;
+esac
+exec /bin/cp "\$@"
+FAKE
+  chmod +x "$WORK/fakebin/cp"
+}
+
+# Drives the guard in a child process.
+#   $1 = label (its own fixtures dir + output files)
+#   $2 = the status the driven suite itself exits with
+#   $3 = "fake" to put the instrument first on PATH, anything else for a clean run
+# Sets: DRV_RC, DRV_OUT (file), DRV_STASH (the guard's own stash path)
+drive() {
+  DRV_LABEL="$1"
+  mkdir -p "$WORK/$DRV_LABEL/fixtures/generated"
+  echo "sentinel $DRV_LABEL" > "$WORK/$DRV_LABEL/fixtures/generated/SENTINEL.txt"
+  cat > "$WORK/$DRV_LABEL/driver.sh" <<DRIVER
+#!/usr/bin/env bash
+set -uo pipefail
+FIXTURES="$WORK/$DRV_LABEL/fixtures"
+. "$GUARD"
+# Report the guard's own scratch paths so the parent can check stash survival
+# WITHOUT depending on any message the guard prints — the unfixed guard prints
+# none, and a cell that read the path out of the message could not go red.
+printf '%s\n' "\$GENERATED_GUARD_STASH" > "$WORK/$DRV_LABEL/stash-path"
+exit $2
+DRIVER
+  chmod +x "$WORK/$DRV_LABEL/driver.sh"
+  : > "$WORK/cp-calls.log"
+  DRV_OUT="$WORK/$DRV_LABEL/out.txt"
+  if [ "${3:-clean}" = fake ]; then
+    PATH="$WORK/fakebin:$PATH" /usr/bin/env bash "$WORK/$DRV_LABEL/driver.sh" > "$DRV_OUT" 2>&1
+  else
+    /usr/bin/env bash "$WORK/$DRV_LABEL/driver.sh" > "$DRV_OUT" 2>&1
+  fi
+  DRV_RC=$?
+  DRV_STASH="$(cat "$WORK/$DRV_LABEL/stash-path" 2>/dev/null)"
+  DRV_GEN="$WORK/$DRV_LABEL/fixtures/generated"
+}
+
+echo "== CONTROL: the instrument fails the chosen destination and ONLY that one =="
+make_fake_cp "/generated/"
+mkdir -p "$WORK/ctl/a" "$WORK/ctl/generated"
+echo hi > "$WORK/ctl/a/f.txt"
+if PATH="$WORK/fakebin:$PATH" cp -R "$WORK/ctl/a/." "$WORK/ctl/generated/" 2>/dev/null; then
+  bad "the fake cp REFUSES a copy into a /generated/ destination" "it succeeded — the instrument is inert and every cell below is meaningless"
+else
+  ok "the fake cp REFUSES a copy into a /generated/ destination"
+fi
+mkdir -p "$WORK/ctl/elsewhere"
+if PATH="$WORK/fakebin:$PATH" cp -R "$WORK/ctl/a/." "$WORK/ctl/elsewhere/" 2>/dev/null \
+   && [ -f "$WORK/ctl/elsewhere/f.txt" ]; then
+  ok "the fake cp passes every OTHER destination through to the real cp"
+else
+  bad "the fake cp passes every OTHER destination through to the real cp" "it refused one it should not have — the instrument is too broad"
+fi
+
+echo "== CONTROL: a clean run restores generated/, removes the stash, keeps rc 0 =="
+drive clean0 0 clean
+[ "$DRV_RC" -eq 0 ] && ok "a clean run exits 0" || bad "a clean run exits 0" "rc=$DRV_RC"
+if [ -f "$DRV_GEN/SENTINEL.txt" ]; then ok "a clean run puts the sentinel back in generated/"; else bad "a clean run puts the sentinel back in generated/" "generated/ holds: [$(ls "$DRV_GEN" 2>/dev/null | tr '\n' ' ')]"; fi
+if [ -n "$DRV_STASH" ] && [ ! -d "$DRV_STASH" ]; then ok "a clean run removes the scratch directory"; else bad "a clean run removes the scratch directory" "stash=[$DRV_STASH] still present"; fi
+
+echo "== KS-1735: a FAILED restore is REPORTED on stderr =="
+make_fake_cp "/generated/"
+drive failrep 0 fake
+if [ "$(grep -c '/generated/$' "$WORK/cp-calls.log")" -ge 1 ]; then
+  ok "the instrument actually intercepted the restore copy"
+else
+  bad "the instrument actually intercepted the restore copy" "no cp call into a /generated/ destination was logged — the cells below would pass for the wrong reason"
+fi
+if grep -q 'restoring .* FAILED' "$DRV_OUT"; then
+  ok "a failed restore says so (names the directory and that it may be EMPTY)"
+else
+  bad "a failed restore says so (names the directory and that it may be EMPTY)" "stderr was silent — this is the KS-1735 defect; output: [$(tr '\n' '|' < "$DRV_OUT")]"
+fi
+
+echo "== KS-1735: a FAILED restore KEEPS the stash — it is the only copy left =="
+if [ -n "$DRV_STASH" ] && [ -f "$DRV_STASH/SENTINEL.txt" ]; then
+  ok "the stash and its contents survive a failed restore"
+else
+  bad "the stash and its contents survive a failed restore" "stash=[$DRV_STASH] present=$(test -d "$DRV_STASH" && echo yes || echo NO) — the only copy was deleted, this is the KS-1735 defect"
+fi
+if grep -q 'KEPT at' "$DRV_OUT"; then
+  ok "the message names where the kept stash is"
+else
+  bad "the message names where the kept stash is" "no 'KEPT at' line — an operator is told nothing about where the copy went"
+fi
+
+echo "== KS-1735: a failed restore moves a PASSING suite's exit status off 0 =="
+if [ "$DRV_RC" -ne 0 ]; then
+  ok "a suite that exited 0 reports non-zero when its restore failed (rc=$DRV_RC)"
+else
+  bad "a suite that exited 0 reports non-zero when its restore failed" "rc=0 — the runner scores this suite as passed while the developer's generated/ is gone"
+fi
+
+echo "== KS-1735: a FAILING suite keeps its OWN status, not a flattened 1 =="
+make_fake_cp "/generated/"
+drive failrc 3 fake
+if [ "$DRV_RC" -eq 3 ]; then
+  ok "a suite that exited 3 still reports 3 after a failed restore"
+else
+  bad "a suite that exited 3 still reports 3 after a failed restore" "rc=$DRV_RC — the suite's own failure was overwritten"
+fi
+
+echo "== KS-1027 item 2: a failed SNAPSHOT keeps its partial stash too =="
+make_fake_cp "/stash/"
+drive snapfail 0 fake
+if [ "$(grep -c '/stash/$' "$WORK/cp-calls.log")" -ge 1 ]; then
+  ok "the instrument intercepted the snapshot copy"
+else
+  bad "the instrument intercepted the snapshot copy" "no cp call into a /stash/ destination was logged"
+fi
+if grep -q 'KS-992' "$DRV_OUT"; then
+  ok "a failed snapshot refuses to restore and says so (KS-992)"
+else
+  bad "a failed snapshot refuses to restore and says so (KS-992)" "output: [$(tr '\n' '|' < "$DRV_OUT")]"
+fi
+if [ -n "$DRV_STASH" ] && [ -d "$DRV_STASH" ]; then
+  ok "the PARTIAL stash survives a failed snapshot"
+else
+  bad "the PARTIAL stash survives a failed snapshot" "stash=[$DRV_STASH] was deleted — KS-1027 item 2"
+fi
+if [ -f "$DRV_GEN/SENTINEL.txt" ]; then
+  ok "a failed snapshot leaves generated/ exactly as the run left it"
+else
+  bad "a failed snapshot leaves generated/ exactly as the run left it" "the guard deleted it after failing to save it"
+fi
+
+printf 'generated_guard_restore.test.sh: %d passed, %d failed\n' "$PASS" "$FAIL"
+[ "$FAIL" -eq 0 ]
diff --git a/systemTest/__tests__/support/generated_guard.sh b/systemTest/__tests__/support/generated_guard.sh
index 5529a5d8f..5c9b46a11 100644
--- a/systemTest/__tests__/support/generated_guard.sh
+++ b/systemTest/__tests__/support/generated_guard.sh
@@ -11,6 +11,14 @@
 # whether a copy is actually held; an ABSENT generated/ is fine (nothing to lose); only a cp
 # that was attempted and FAILED flips it, and then restore refuses to delete and says so.
 #
+# KS-1735: restore's OWN cp was still unchecked, and `rm -rf $GENERATED_GUARD_TMP` ran either
+# way — so a failed restore left generated/ empty or partial, deleted the only copy, said
+# nothing, and left the suite's exit status alone. Both failure paths now KEEP the scratch
+# directory and name it, and a failed restore exits non-zero (the suite's own status when it had
+# one). The cost, as the inline copies accepted under KS 1027: on a failure the scratch directory
+# survives the run, and the sourcing suite's temp files survive with it. That is the trade — a
+# leaked temp directory is recoverable, a deleted snapshot is not.
+#
 # Requires: $FIXTURES (absolute path to systemTest/fixtures). Provides: $GENERATED_GUARD_TMP,
 # a scratch directory removed on exit, for the sourcing suite's own temp files.
 
@@ -26,18 +34,24 @@ if [ -d "$GENERATED_GUARD_GEN" ]; then
 fi
 
 generated_guard_restore() {
+  local rc=$?
   if [ "$generated_guard_snapshot_ok" -ne 1 ]; then
     printf '  !! KS-992: the snapshot of %s FAILED, so this suite will not restore it.\n' "$GENERATED_GUARD_GEN" >&2
     printf '  !! generated/ is being left exactly as the run left it — a guard that\n' >&2
     printf '  !! cannot restore must not delete. Check it by hand.\n' >&2
-    rm -rf "$GENERATED_GUARD_TMP"
+    printf '  !! KS-1027: the partial snapshot is KEPT at: %s\n' "$GENERATED_GUARD_STASH" >&2
     return
   fi
   # Put back exactly what was there: the snapshot if the directory existed, nothing if it did not.
   rm -rf "$GENERATED_GUARD_GEN"
   if [ "$generated_guard_existed" -eq 1 ]; then
     mkdir -p "$GENERATED_GUARD_GEN"
-    cp -R "$GENERATED_GUARD_STASH/." "$GENERATED_GUARD_GEN/" 2>/dev/null
+    if ! cp -R "$GENERATED_GUARD_STASH/." "$GENERATED_GUARD_GEN/" 2>/dev/null; then
+      printf '  !! KS-1027: restoring %s FAILED — it may now be EMPTY.\n' "$GENERATED_GUARD_GEN" >&2
+      printf '  !! the snapshot is KEPT at: %s — copy it back by hand.\n' "$GENERATED_GUARD_STASH" >&2
+      if [ "$rc" -eq 0 ]; then exit 1; fi
+      exit "$rc"
+    fi
   fi
   rm -rf "$GENERATED_GUARD_TMP"
 }
