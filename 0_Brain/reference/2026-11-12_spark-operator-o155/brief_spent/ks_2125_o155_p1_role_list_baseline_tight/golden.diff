+++ b/Blockchain/Dev/packages/shared/src/__tests__/ks2125-role-list-baseline-is-tight-for-oauth-and-users.test.ts
@@ -0,0 +1,59 @@
+import { describe, it, expect } from 'vitest';
+import { existsSync, readFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// KS-2125: the KS-1536 guard's G2 rule lets a file hold FEWER inline platform-role lists than its frozen baseline, so a baseline
+// number that is too high is slack: one new list can then pass unseen. This test pins the baseline of the two auth route files whose
+// number was found loose (oauth.ts and users.ts) EQUAL to the number of lists the file really holds, counted the way the guard counts.
+// The counting rule below is a copy of the sweep() list rule in ks1536-one-role-vocabulary.test.ts (same LIST and SPELLING patterns,
+// same 1200-character cap, same tenant_scope_bypass exclusion). It reads only these two files, so it walks no tree.
+
+function findDevRoot(start: string): string {
+  let dir = start;
+  for (let i = 0; i < 12; i++) {
+    if (existsSync(join(dir, 'services')) && existsSync(join(dir, 'packages')) && existsSync(join(dir, 'frontend'))) return dir;
+    const parent = resolve(dir, '..');
+    if (parent === dir) break;
+    dir = parent;
+  }
+  throw new Error(`[ks2125 guard] could not locate the Dev root from ${start}`);
+}
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const TREE_TOP = findDevRoot(HERE);
+const SPELLING = /['"`](?:super_?admin|system_?admin|platform_?admin)['"`]/i;
+const LIST = /\[[^[\]]*?\]|\([^()]*?\)/gs;
+const NOT_A_ROLE_LINE = /tenant_scope_bypass/;
+const OAUTH = 'services/auth/src/routes/oauth.ts';
+const USERS = 'services/auth/src/routes/users.ts';
+
+function countLists(text: string): number {
+  return (text.match(LIST) ?? []).filter((m) => m.length <= 1200 && SPELLING.test(m) && !NOT_A_ROLE_LINE.test(m)).length;
+}
+
+const baseline = JSON.parse(readFileSync(join(HERE, 'ks1536-inline-role-lists.baseline.json'), 'utf8')) as Record<string, number>;
+const oauthCount = countLists(readFileSync(join(TREE_TOP, OAUTH), 'utf8'));
+const usersCount = countLists(readFileSync(join(TREE_TOP, USERS), 'utf8'));
+
+describe('KS-2125 the role-list baseline is tight for oauth.ts and users.ts', () => {
+  it('control ks2125 C0 the counter tells a role list from other text', () => {
+    expect(countLists("const R = ['super_admin', 'platform_admin'];")).toBe(1);
+    expect(countLists("const A = ['SUPER_ADMIN']; const B = new Set(['SYSTEM_ADMIN']);")).toBe(2);
+    expect(countLists("set_config('app.tenant_scope_bypass', 'platform_admin', true);")).toBe(0);
+    expect(countLists("const R = ['ORG_ADMIN', 'VERIFIER'];")).toBe(0);
+  });
+
+  it('control ks2125 C1 the counter reaches the real route files and finds lists in both', () => {
+    expect(oauthCount).toBeGreaterThan(0);
+    expect(usersCount).toBeGreaterThan(0);
+  });
+
+  it('RED ks2125 R1 the oauth.ts baseline equals the number of lists the file holds', () => {
+    expect(baseline[OAUTH]).toBe(oauthCount);
+  });
+
+  it('RED ks2125 R2 the users.ts baseline equals the number of lists the file holds', () => {
+    expect(baseline[USERS]).toBe(usersCount);
+  });
+});
