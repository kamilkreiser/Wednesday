diff --git a/Blockchain/Dev/services/prism/src/db.ts b/Blockchain/Dev/services/prism/src/db.ts
--- a/Blockchain/Dev/services/prism/src/db.ts
+++ b/Blockchain/Dev/services/prism/src/db.ts
@@ -36,5 +36,12 @@
     pool.on('error', (err: Error) => {
-      dbLog('error', 'DB pool unexpected error', { error: err.message });
+      let reason: string | null | undefined;
+      try {
+        const m = err?.message;
+        reason = m === undefined || m === null ? m : String(m);
+      } catch {
+        reason = 'unreadable thrown value';
+      }
+      dbLog('error', 'DB pool unexpected error', { error: reason });
     });
   }
   return pool;
@@ -96,6 +103,13 @@
     await onDbReady();
   } catch (err: any) {
     // Boot work failing must not un-flag an otherwise reachable DB.
-    dbLog('error', 'DB ready boot work failed', { error: err?.message });
+    let reason: string | null | undefined;
+    try {
+      const m = err?.message;
+      reason = m === undefined || m === null ? m : String(m);
+    } catch {
+      reason = 'unreadable thrown value';
+    }
+    dbLog('error', 'DB ready boot work failed', { error: reason });
   }
 }

