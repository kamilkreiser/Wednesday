+/** The caller's own bearer: the mocked auth ignores it, and originate forwards it to anchoring. */
+const CALLER_BEARER = 'Bearer ks1717-caller-a.header.sig';
+const OTHER_BEARER = 'Bearer ks1717-caller-b.header.sig';
+
+type Recorded = { method: string; url: string; headers: http.IncomingHttpHeaders; raw: Buffer };
+const recorded: Recorded[] = [];
