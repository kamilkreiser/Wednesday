diff --git a/Blockchain/Dev/scripts/__tests__/ks1456_run_migrations_failed_run_names_no_closed_defect.test.sh b/Blockchain/Dev/scripts/__tests__/ks1456_run_migrations_failed_run_names_no_closed_defect.test.sh
