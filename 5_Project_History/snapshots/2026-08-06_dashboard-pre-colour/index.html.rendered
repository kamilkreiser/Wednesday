ss="tintsel" data-tile="chat" title="tile background tint"><option value="none" selected>no tint</option><option value="slate" style="background:#eef1f6">slate</option><option value="moss" style="background:#eef3ea">moss</option><option value="plum" style="background:#f4eef5">plum</option><option value="sand" style="background:#f6f2e6">sand</option><option value="teal" style="background:#e9f2f1">teal</option></select><input type="checkbox" class="sepchk" data-tile="chat" title="separator above this tile" checked><input type="text" class="seplab" data-tile="chat" maxlength="40" placeholder="section label" value=""></div><div class="cprow"><label><input type="checkbox" data-kind="tile" value="tickets" checked> Tickets by Project</label><select class="tintsel" data-tile="tickets" title="tile background tint"><option value="none" selected>no tint</option><option value="slate" style="background:#eef1f6">slate</option><option value="moss" style="background:#eef3ea">moss</option><option value="plum" style="background:#f4eef5">plum</option><option value="sand" style="background:#f6f2e6">sand</option><option value="teal" style="background:#e9f2f1">teal</option></select><input type="checkbox" class="sepchk" data-tile="tickets" title="separator above this tile"><input type="text" class="seplab" data-tile="tickets" maxlength="40" placeholder="section label" value=""></div><div class="cprow"><label><input type="checkbox" data-kind="tile" value="email" checked> Email flags</label><select class="tintsel" data-tile="email" title="tile background tint"><option value="none" selected>no tint</option><option value="slate" style="background:#eef1f6">slate</option><option value="moss" style="background:#eef3ea">moss</option><option value="plum" style="background:#f4eef5">plum</option><option value="sand" style="background:#f6f2e6">sand</option><option value="teal" style="background:#e9f2f1">teal</option></select><input type="checkbox" class="sepchk" data-tile="email" title="separator above this tile"><input type="text" class="seplab" data-tile="email" maxlength="40" placeholder="section label" value=""></div><div class="cprow"><label><input type="checkbox" data-kind="tile" value="news" checked> News</label><select class="tintsel" data-tile="news" title="tile background tint"><option value="none" selected>no tint</option><option value="slate" style="background:#eef1f6">slate</option><option value="moss" style="background:#eef3ea">moss</option><option value="plum" style="background:#f4eef5">plum</option><option value="sand" style="background:#f6f2e6">sand</option><option value="teal" style="background:#e9f2f1">teal</option></select><input type="checkbox" class="sepchk" data-tile="news" title="separator above this tile" checked><input type="text" class="seplab" data-tile="news" maxlength="40" placeholder="section label" value="World &amp; News"></div><div class="cprow"><label><input type="checkbox" data-kind="tile" value="parkinglot" checked> Parking lot</label><select class="tintsel" data-tile="parkinglot" title="tile background tint"><option value="none" selected>no tint</option><option value="slate" style="background:#eef1f6">slate</option><option value="moss" style="background:#eef3ea">moss</option><option value="plum" style="background:#f4eef5">plum</option><option value="sand" style="background:#f6f2e6">sand</option><option value="teal" style="background:#e9f2f1">teal</option></select><input type="checkbox" class="sepchk" data-tile="parkinglot" title="separator above this tile"><input type="text" class="seplab" data-tile="parkinglot" maxlength="40" placeholder="section label" value=""></div></div>
 <div class="cpcol"><h4>Sources</h4><label><input type="checkbox" data-kind="group" value="datasec" checked> Datasec</label><label><input type="checkbox" data-kind="group" value="secuura" checked> Secuura</label><label><input type="checkbox" data-kind="group" value="personal" checked> Personal</label><label><input type="checkbox" data-kind="group" value="family" checked> Family</label></div>
